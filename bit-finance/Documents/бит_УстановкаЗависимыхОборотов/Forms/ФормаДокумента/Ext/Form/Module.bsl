&НаКлиенте
Процедура Подключаемый_КомандаЗаполнитьИзСоответствия(Команда)
	
	Если ДеревоЗависимостей.ПолучитьЭлементы().Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИДВидаСоответствия = Команда.Имя;
	ИДВидаСоответствия = СтрЗаменить(ИДВидаСоответствия, "КомандаЗаполнитьИзСоответствия_", "");
	ИДВидаСоответствия = СтрЗаменить(ИДВидаСоответствия, "_", "-");
	Зависимости = ЗависимостиИзСоответствия(ИДВидаСоответствия);
	
	Для каждого СтрокаОсновнойСтатьи Из ДеревоЗависимостей.ПолучитьЭлементы() Цикл
		ОсновнаяСтатья  = СтрокаОсновнойСтатьи.СтатьяОборотов;
		ЗависимыеСтатьи = Зависимости.Получить(ОсновнаяСтатья);
		Если ЗависимыеСтатьи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ЗависимаяСтатья Из ЗависимыеСтатьи Цикл
			ДобавитьЗависимуюСтатью(СтрокаОсновнойСтатьи, ЗависимаяСтатья);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

