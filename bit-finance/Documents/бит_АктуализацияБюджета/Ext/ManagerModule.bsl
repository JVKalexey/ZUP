// Конец СтандартныеПодсистемы.Печать

// Функция подготавливает параметры проведения.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка.бит_НазначениеСоответствияАналитик - ссылка на документ.
//  Отказ          - Булево - признак обнаружения ошибки и отказа от дальнейших действий.
//
// Возвращаемое значение:
//  Структура - структура параметров проведения.
//
Функция ПодготовитьПараметрыПроведения(ДокументСсылка, Отказ) Экспорт
	
	ПараметрыПроведения = Новый Структура(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Реквизиты.Дата КАК Дата,
	|	Реквизиты.Ссылка КАК Регистратор,
	|	Реквизиты.Сценарий КАК Сценарий,
	|	Реквизиты.ЦФО КАК ЦФО,
	|	Реквизиты.Организация КАК Организация,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	Реквизиты.КурсДокумента КАК КурсДокумента,
	|	Реквизиты.КратностьДокумента КАК КратностьДокумента,
	|	Реквизиты.СторнироватьЗависимыеОбороты КАК СторнироватьЗависимыеОбороты,
	|	Реквизиты.СверхБюджета КАК СверхБюджета,
	|	Реквизиты.Сценарий.ИспользоватьКурсыСценария КАК ИспользоватьКурсыСценария,
	|	Реквизиты.Сценарий.Валюта КАК ВалютаСценария,
	|	Реквизиты.СценарийЭталон КАК СценарийЭталон,
	|	Реквизиты.РежимПринятияКУчету КАК РежимПринятияКУчету,
	|	Реквизиты.СписатьЛимиты КАК СписатьЛимиты
	|ИЗ
	|	Документ.бит_АктуализацияБюджета КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	Результат = Запрос.Выполнить().Выгрузить();
	Реквизиты = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Результат[0]);
	
	Если НЕ бит_ОбщегоНазначения.ВалютаУпрУчетаУстановлена(Истина, ДокументСсылка) Тогда
		Отказ = Истина;
		Возврат ПараметрыПроведения;
	КонецЕсли;

	КурсыВалют = бит_Бюджетирование.КурсыВалютСценария(Реквизиты.Регистратор, 
											Реквизиты.Дата, Новый Структура("Документ, Регл, Упр, Сценарий"));
	
	Реквизиты.Вставить("КурсыВалют", КурсыВалют);
	
	ПриниматьКУчету = Истина;
	ПроводитьПослеУтверждения = бит_ВизированиеСервер.ПриниматьКУчетуПослеУтверждения(
								Метаданные.Документы.бит_АктуализацияБюджета.ПолноеИмя());
	Если ПроводитьПослеУтверждения И Реквизиты.РежимПринятияКУчету = 1 Тогда
		ТекущийСтатус = бит_ВизированиеСервер.ТекущийСтатус(ДокументСсылка);
		Если НЕ Справочники.бит_СтатусыОбъектов.ПроверитьТипСтатуса(ТекущийСтатус,
				Перечисления.бит_ТипыСтатусовОбъектов.Утвержден) Тогда
			ПриниматьКУчету = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыПроведения.Вставить("ТаблицаСторноДоИзменения", Новый ТаблицаЗначений);
	ПараметрыПроведения.Вставить("ТаблицаОборотыПоБюджетам", Новый ТаблицаЗначений);
	ПараметрыПроведения.Вставить("ВозвратЛимита", Новый ТаблицаЗначений);
	
	ПараметрыНастройки 		= Новый Структура("ЦФО, Организация", Реквизиты.ЦФО, Реквизиты.Организация);
	НеУчитыватьСверхБюджета = бит_НастройкиПрограммы.НеУчитыватьСверхБюджетныеОперацииПриКонтролеПоБюджету(
								ПараметрыНастройки, Реквизиты.Дата);
		
	Запрос.УстановитьПараметр("НеУчитыватьСверхБюджета", НеУчитыватьСверхБюджета);
	Запрос.УстановитьПараметр("СинонимБДДС", 			 НСтр("ru='Данные бюджета';en='Budget Data'"));
	Запрос.УстановитьПараметр("СинонимЗависимыеОбороты", НСтр("ru='Зависимые обороты';en='Dependent Line-Items'"));
	Запрос.УстановитьПараметр("СинонимДоИзменения", 	 НСтр("ru='До изменения';en='before the change'"));
	Запрос.УстановитьПараметр("Сценарий", 				 Реквизиты.Сценарий);
	Запрос.УстановитьПараметр("СценарийЭталон", 		 Реквизиты.СценарийЭталон);
	Запрос.УстановитьПараметр("Валюта", 				 Реквизиты.ВалютаДокумента);
	
	Если Реквизиты.СценарийЭталон = Реквизиты.Сценарий Тогда
		СценарииСовпадают = Истина;
	Иначе	
		СценарииСовпадают = Ложь;
	КонецЕсли;
	
	ИнициализироватьКлючиАналитик(Реквизиты);
	
	НомераТаблиц = Новый Структура(); 
	ТекстЗапроса = ТекстЗапросаВременнаяТаблицаДокумента(НомераТаблиц)
				 + ТекстЗапросаТаблицыВалютногоПерерасчета(НомераТаблиц)
				 + ТекстЗапросаКонтрольИсполненияБюджета(НомераТаблиц, СценарииСовпадают)
				 + ТекстЗапросаТаблицаОборотыПоБюджетам(НомераТаблиц, ПриниматьКУчету)
				 + ТекстЗапросаТаблицаСторноДоИзменения(НомераТаблиц, ПриниматьКУчету, СценарииСовпадают);
				 
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.ВыполнитьПакет();
	
	Для каждого НомерТаблицы Из НомераТаблиц Цикл
		ПараметрыПроведения.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла; 	
	ПараметрыПроведения.Вставить("Реквизиты", Реквизиты);
	
	Если Реквизиты.СторнироватьЗависимыеОбороты И ЗначениеЗаполнено(ПараметрыПроведения.ТаблицаСторноДоИзменения) Тогда
		НаборОбороты = РегистрыНакопления.бит_ОборотыПоБюджетам.СоздатьНаборЗаписей();
		НаборОбороты.Загрузить(ПараметрыПроведения.ТаблицаСторноДоИзменения);
		бит_Бюджетирование.СформироватьЗависимыеОборотыПоНаборуЗаписей(ДокументСсылка, НаборОбороты);
		ПараметрыПроведения.ТаблицаСторноДоИзменения = НаборОбороты.Выгрузить();
	КонецЕсли; 
	
	ПодготовитьТаблицыДокументаРасчетыВВалюте(ПараметрыПроведения, Реквизиты);	
	
	ПодготовитьТаблицуИсполнениеБюджетаРасчетыВВалюте(ПараметрыПроведения.ИсполнениеБюджета, 
		ПараметрыПроведения.ИсполнениеБюджетаРеквизиты);
		
	ПодготовитьТаблицуИсполнениеБюджетаРасчетыВВалюте(ПараметрыПроведения.ВозвратЛимита, 
		ПараметрыПроведения.ИсполнениеБюджетаРеквизиты);	
		
	Возврат ПараметрыПроведения;
	
КонецФункции 

// Описывает учетные механизмы используемые в документе для регистрации в механизме проведения.
//
// Параметры:
//  МеханизмыДокумента - Массив - список имен учетных механизмов, для которых будет выполнена
//              регистрация в механизме проведения.
//
Процедура ЗарегистрироватьУчетныеМеханизмы(МеханизмыДокумента) Экспорт
	
	// ++ ЕРП
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиОбновленияИБ

Процедура ДоработатьДанныеРасшифровкиПриПереходеНаНовуюВерсию(Параметры) Экспорт

	ПолноеИмяОбъекта  = ПустаяСсылка().Метаданные().ПолноеИмя();
	ОбновляемыеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);

	Для Каждого СтрокаТаблицы Из ОбновляемыеДанные Цикл
				
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СтрокаТаблицы.Ссылка);
			Блокировка.Заблокировать();
	
			ДокументОбъект 	 	= СтрокаТаблицы.Ссылка.ПолучитьОбъект();
			ПредставлениеСсылки = Строка(ДокументОбъект);
			
			Если ДокументОбъект = Неопределено Тогда
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СтрокаТаблицы.Ссылка);
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;			
			
			ДокументРезультат = ДокументОбъект.ХранилищеДерева.Получить();
			
			ОбъектИзменен = Ложь;
			Для каждого Область Из ДокументРезультат.Области Цикл
				Если ТипЗнч(Область.Расшифровка) <> Тип("Структура") Тогда
					Продолжить;		
				КонецЕсли;	
				
				ИмяКласса = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Область.Расшифровка, "ИмяКласса", "");
				Если ИмяКласса <> "РасшифровкаЯчейкиФормыВвода" Тогда
					Продолжить;		
				КонецЕсли;
				
				ИдентификаторРасшифровки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Область.Расшифровка, "ИдентификаторРасшифровки", "");
				ОбработатьРасшифровку 	 = ПустаяСтрока(ИдентификаторРасшифровки);
				
				Если НЕ ОбработатьРасшифровку Тогда
					Продолжить;		
				КонецЕсли;
				
				СмежныеОбласти = Новый Структура;
				СмежныеОбласти.Вставить("СП", "");
				СмежныеОбласти.Вставить("КП", "");
				СмежныеОбласти.Вставить("СФ", "");
				СмежныеОбласти.Вставить("КФ", "");		
				
				ЧастиИмени = СтрРазделить(Область.Расшифровка.Имя, "_");
				Если ЧастиИмени.Количество() > 2 Тогда
					Префикс = ЧастиИмени[0];
					// Если префикс подойдет к одному из ключей структуры, значит это наша область.
					Если СмежныеОбласти.Свойство(Префикс) Тогда
						СмежныеОбласти[Префикс] = Область.Расшифровка.Имя;
						Для каждого КлючЗначение Из СмежныеОбласти Цикл
							Если КлючЗначение.Ключ = Префикс Тогда
								Продолжить;					
							КонецЕсли;
							ЧастиИмени[0] 	= КлючЗначение.Ключ;
							ИмяКандидата	= СтрСоединить(ЧастиИмени, "_");
							РезультатПоиска = ДокументРезультат.Области.Найти(ИмяКандидата);
							Если РезультатПоиска <> Неопределено Тогда
								СмежныеОбласти[КлючЗначение.Ключ] = ИмяКандидата;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;

				Область.Расшифровка.Вставить("СмежныеОбласти", 			 СмежныеОбласти);
				Область.Расшифровка.Вставить("ИдентификаторРасшифровки", Область.Расшифровка.Имя);
				Область.Расшифровка.Вставить("ИдентификаторСтроки", 	 "");
				Область.Расшифровка.Вставить("ЦветФона", 				 Область.ЦветФона);
				
				ЗначенияГруппировок = Новый Массив;
				Если ТипЗнч(Область.Расшифровка.Измерения) = Тип("Структура") Тогда
					Для каждого КлючЗначение Из Область.Расшифровка.Измерения Цикл
						ЗначенияГруппировок.Добавить(КлючЗначение.Значение);
					КонецЦикла;
				Иначе
					ЗначенияГруппировок.Добавить(Область.Расшифровка.Значение);
				КонецЕсли;
				Область.Расшифровка.ИдентификаторСтроки = бит_ВводБюджета.ИдентификаторРасшифровки(ЗначенияГруппировок, Область.Расшифровка.Период);
				
				ОбъектИзменен = Истина;
			КонецЦикла;
			
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СтрокаТаблицы.Ссылка);
			КонецЕсли;
		
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();

			ОбновлениеИнформационнойБазы.ЗаписатьОшибкуВЖурналРегистрации(СтрокаТаблицы.Ссылка, ПредставлениеСсылки, 
				ИнформацияОбОшибке());	
		КонецПопытки;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Процедура ЗаполнитьРазрезыАктуализацииПриПереходеНаНовуюВерсию(Параметры) Экспорт
	
	ИмяПроцедуры	     = "ЗаполнитьРазрезыАктуализацииПриПереходеНаНовуюВерсию";
	МетаданныеОбъекта    = ПустаяСсылка().Метаданные();
	ПредставлениеОбъекта = МетаданныеОбъекта.Представление();
	ПолноеИмяОбъекта 	 = МетаданныеОбъекта.ПолноеИмя();
	ОбновляемыеДанные	 = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
		
	ПроблемныхОбъектов = 0;
	ОбработаноОбъектов = 0;

	Для Каждого СтрокаТаблицы Из ОбновляемыеДанные Цикл
				
		ПредставлениеСсылки = Строка(СтрокаТаблицы.Ссылка);
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СтрокаТаблицы.Ссылка);
			Блокировка.Заблокировать();
	
			ДокументОбъект = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
			
			Если ДокументОбъект = Неопределено Тогда
				ОтменитьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			ОбъектИзменен = Ложь;
			НастройкаФормы = ДокументОбъект.НастройкаФормы;
			Если ЗначениеЗаполнено(НастройкаФормы) Тогда
				ДанныеНастройки = Справочники.бит_НастройкиФормВводаБюджета.ПодготовитьНастройки(НастройкаФормы);
								
				Если ЗначениеЗаполнено(ДанныеНастройки.ИмяРазворачивать) Тогда
					ОсновнойРазрез  = "Контроль" + ДанныеНастройки.ИмяРазворачивать;
					ДокументОбъект[ОсновнойРазрез] = Истина;
					ОбъектИзменен = Истина;
				КонецЕсли;
			КонецЕсли;
						
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СтрокаТаблицы.Ссылка);
			КонецЕсли;
			
			ОбработаноОбъектов  = ОбработаноОбъектов + 1;
			ЗафиксироватьТранзакцию();
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОшибкуВЖурналРегистрации(СтрокаТаблицы.Ссылка, ПредставлениеСсылки, 
				ИнформацияОбОшибке());	
		КонецПопытки;
	КонецЦикла;
	
	Если ОбработаноОбъектов = 0 Тогда
		ТекстСообщения = НСтр("ru='Процедуре ""%1"" не удалось обработать некоторые ""%2"" (пропущены): %3';
							  |en='Procedure ""%1"" failed to process some documents ""%2"" (skipped): %3'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ИмяПроцедуры, ПредставлениеОбъекта, ПроблемныхОбъектов);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация, МетаданныеОбъекта,, ТекстСообщения);
	Иначе
		ТекстСообщения = НСтр("ru='Процедура ""%1"" обработала очередную порцию ""%2"": %3';
							  |en='Procedure ""%1"" processed the next batch of documents ""%2"": %3'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ИмяПроцедуры, ПредставлениеОбъекта, ОбработаноОбъектов);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Информация, МетаданныеОбъекта,, ТекстСообщения);
	КонецЕсли;	

	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеРасшифроки(Параметры) Экспорт

	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = ПустаяСсылка().Метаданные().ПолноеИмя();
	ПараметрыВыборки.СпособВыборки 		 = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
