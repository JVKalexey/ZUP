					бит_Бюджетирование.ДоработатьЯчейку(ПараметрыДоработки);					
					ТабДок.Присоединить(Обл);
				КонецЕсли; 
			КонецЕсли;  // ФлДваРесурса.
		КонецЦикла; // Периоды.
		
		ТекНом = Ном; // Фиксируем номер строки до входа в рекурсивный вызов.
		Ном = Ном + 1;	
		
		ИменаПодчиненныхЯчеек = ОбойтиДерево(СтрокаДерева, Области, Периоды, Ном, Параметры, ДопПараметры);
		
		// Установим формулы для вычисления итогов по группам.
		Если ИменаПодчиненныхЯчеек.Количество() > 0 Тогда
			// После выхода из подчиненного вызова сбрасываем параметры проверяющие объединение ячеек.
			ДанныеВрем = бит_Бюджетирование.КонструкторСтруктурыПроверкиОбъединения(ИзмеренияРазворачивать, Настройки.ВыводитьКодификатор);
			Для каждого ТекОписание Из Периоды Цикл
				Если Настройки.УчетКоличество Тогда
					 бит_Бюджетирование.УстановитьФормулуИтоговПоГруппе(ТабДок, ИменаПодчиненныхЯчеек,
					 	ТекОписание.ИмяКоличество, ИдИзмерений);
					 бит_Бюджетирование.УстановитьФормулуИтоговПоГруппе(ТабДок, ИменаПодчиненныхЯчеек,
					 	ТекОписание.ИмяКоличествоФакт, ИдИзмерений);
				КонецЕсли; 
				Если Настройки.УчетСумма Тогда
					 бит_Бюджетирование.УстановитьФормулуИтоговПоГруппе(ТабДок, ИменаПодчиненныхЯчеек,
					 	ТекОписание.ИмяСумма, ИдИзмерений);
					 бит_Бюджетирование.УстановитьФормулуИтоговПоГруппе(ТабДок, ИменаПодчиненныхЯчеек,
					 	ТекОписание.ИмяСуммаФакт, ИдИзмерений);
				КонецЕсли; 
			КонецЦикла; // Периоды - установка формул.
		КонецЕсли;
		
	КонецЦикла; // По строкам дерева данного уровня.
	
	Если Настройки.ОбъединятьЯчейки Тогда
		// Вызова процедуры объединения для объединения ячеек в случае завершения группировки.
		Сч = 1;
		Для каждого Имя Из ИзмеренияРазворачивать Цикл
			// Объединение ограничено 1 разворотом, чтобы избежать смещения в сетке табличного документа.
			Если Сч = 1 И КоличествоРазворачивать > 1 Тогда
				// Объединяем ячейки с повторяющимися значениями аналитик.
				ЕстьПодчиненныеСтроки = ?(ТипЗнч(СтрокаВерх) = Тип("ДеревоЗначений"), Истина, Ложь);
				бит_Бюджетирование.ПроверитьВыполнитьОбъединениеЯчеек(ТабДок, ДанныеВрем, Имя, "НереальноеЗначение", ЕстьПодчиненныеСтроки, Истина);
			КонецЕсли; 
			Сч = Сч +1;
		КонецЦикла;  // По именам измерений.
	КонецЕсли; 
	
	Возврат ИменаЯчеек;
	
КонецФункции

