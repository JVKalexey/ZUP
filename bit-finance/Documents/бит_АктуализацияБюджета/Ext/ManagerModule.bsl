	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));

КонецПроцедуры

#КонецОбласти

#Область ФормированиеДерева

// Процедура обновляет дерево данных.
//
// Параметры:
//  ПараметрыОбновления	 - Структура - см. НовыеПараметрыОбновеления.
// 
// Возвращаемое значение:
//  Структура - Структура параметров:
//  * ТабДок - ТабличныйДокумент - Табличный документ данных бюджета.
//  * ФактическиеДанные - ТаблицаЗначений - Данные для ТЧ ФактическиеДанные.
//  * БДДС - ТаблицаЗначений - Данные для ТЧ БДДС.
//  * ДоИзменения - ТаблицаЗначений - Данные для ТЧ ДоИзменения.
//
Функция ОбновитьДеревоДанных(ПараметрыОбновления) Экспорт
	
	ТабДок				= ПараметрыОбновления.ТабДок;
	НастройкаФормы		= ПараметрыОбновления.НастройкаФормы;
	Настройки			= ПараметрыОбновления.Настройки;
	ТекстЗапроса		= ПараметрыОбновления.ТекстЗапроса;
	Сценарий			= ПараметрыОбновления.Сценарий;
	СценарийЭталон		= ПараметрыОбновления.СценарийЭталон;
	
	Бюджет = Настройки.Бюджет;
	Если ЗначениеЗаполнено(Бюджет) И Справочники.бит_Бюджеты.БюджетЗапрещенВПланировании(Бюджет) Тогда
		ТекстИсключения = НСтр("ru = 'Выполнение операции остановлено.
								|Бюджет настройки формы ввода не должен содержать дубли статей оборотов.';
								|en = 'The operation is stopped.
								|Budget setting entry forms should not contain duplicates revolutions articles.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ОсновноеИзмерение = Настройки.ИмяРазворачивать;
	
	Если Настройки.Версия_2 Тогда
		
		ПараметрыПередачи = бит_ВводБюджета.НовыеПараметрыПосроенияМакетаБюджета();
		ЗаполнитьЗначенияСвойств(ПараметрыПередачи, ПараметрыОбновления);
		
		ПараметрыПередачи.МестоИспользования 	= "бит_АктуализацияБюджета";
		ПараметрыПередачи.СхемаКомпоновкиДанных = ПараметрыОбновления.СхемаКомпоновкиСтруктура;
		ПараметрыПередачи.НастройкиКомпоновщика = ПараметрыОбновления.НастройкиКомпоновщикаСтруктура;

		РезультатОбновления 	   = бит_ВводБюджета.РезультатПостроенияМакетаБюджета(НастройкаФормы, ПараметрыПередачи);
		ПараметрыОбновления.ТабДок = РезультатОбновления.ДокументРезультат;
		
		ЗначенияГруппировок 	= РезультатОбновления.ЗначенияГруппировок;
		ЗначенияОсновногоОтбора = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначенияГруппировок, 
									ОсновноеИзмерение, Новый Массив);
	Иначе	
		ЗначенияОсновногоОтбора = ОбновитьДеревоДанныхДинамическийМакет(ПараметрыОбновления);
	КонецЕсли;	
	
	РезультатСКД = ДанныеБюджетаДляАктуализации(ЗначенияОсновногоОтбора, ПараметрыОбновления);
	
	ДоИзменения = РезультатСКД.СкопироватьКолонки();
	Если СценарийЭталон = Сценарий Тогда
		ДоИзменения = РезультатСКД.СкопироватьКолонки();
		Для каждого СтрокаТаблицы Из РезультатСКД Цикл
			Если СтрокаТаблицы.Сумма <> 0 ИЛИ СтрокаТаблицы.Количество <> 0 Тогда
				ЗаполнитьЗначенияСвойств(ДоИзменения.Добавить(), СтрокаТаблицы);			
			КонецЕсли;
		КонецЦикла;

		ДоИзменения.Колонки.Удалить("Сумма");
		ДоИзменения.Колонки.Удалить("Количество");
		
		Переименовать = Новый Структура(); 
		Переименовать.Вставить("КоличествоДоИзменения",		"Количество");
		Переименовать.Вставить("СуммаДоИзменения",			"Сумма");
		Переименовать.Вставить("СуммаРеглДоИзменения",		"СуммаРегл");
		Переименовать.Вставить("СуммаУпрДоИзменения",		"СуммаУпр");
		Переименовать.Вставить("СуммаСценарийДоИзменения",	"СуммаСценарий");
		
		Для каждого Колонки Из Переименовать Цикл
			ДоИзменения.Колонки[Колонки.Ключ].Имя = Колонки.Значение;
		КонецЦикла;
	КонецЕсли; 
	
	РезультатСКД.Колонки.Добавить("ИД", Новый ОписаниеТипов("Строка"));
	Для каждого СтрокаТаблицы Из РезультатСКД Цикл	
		СтрокаТаблицы.ИД = Строка(Новый УникальныйИдентификатор);	
	КонецЦикла; 
	
	// Установка значений в дерево.
	УстановитьЗначенияВДерево(РезультатСКД, ПараметрыОбновления);
	
	Результат = Новый Структура;
	Результат.Вставить("ТабДок",			ПараметрыОбновления.ТабДок);	
	Результат.Вставить("ФактическиеДанные",	Новый ТаблицаЗначений);	
	Результат.Вставить("БДДС",				РезультатСКД);
	Результат.Вставить("ДоИзменения",		ДоИзменения);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеБюджетаДляАктуализации(ЗначенияОсновногоОтбора, ПараметрыОбновления)
	
	ИмяИзмерения		 		= ПараметрыОбновления.Настройки.ИмяРазворачивать;
	Периодичность		 		= ПараметрыОбновления.Периодичность;
	ДатаЗапроса			 		= ПараметрыОбновления.Дата;
	ДатаАктуализации	 		= ПараметрыОбновления.ДатаАктуализации;
	НачалоПериода		 		= ПараметрыОбновления.ДатаНачалаПланирования;
	КонецПериода		 		= ПараметрыОбновления.ДатаОкончанияПланирования;
	ВалютаДокумента		 		= ПараметрыОбновления.ВалютаДокумента;
	СценарийЭталон		 		= ПараметрыОбновления.СценарийЭталон;
	Сценарий			 		= ПараметрыОбновления.Сценарий;
	СценарийФакт		 		= ПараметрыОбновления.СценарийФакт;
	КоличествоИнтервалов		= ПараметрыОбновления.ПродолжительностьИнтервала;
	СКД				  			= ПараметрыОбновления.СхемаКомпоновкиДанные;
	НастройкиКомпоновщикаДанные = ПараметрыОбновления.НастройкиКомпоновщикаДанные;
	
	Компоновщик		 = Новый КомпоновщикНастроекКомпоновкиДанных;
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД);
	
	Компоновщик.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	НастройкиКомпоновки = Компоновщик.ПолучитьНастройки();
	
	ВычисляемоеПоле = СКД.ВычисляемыеПоля.Найти("Измерение");
	СКД.ВычисляемыеПоля.Найти("Измерение").ОграничениеИспользования.Условие = Ложь;
	
	бит_ОтчетыБФКлиентСервер.СкопироватьОтборКомпоновкиДанных(СКД, НастройкиКомпоновки, 
		НастройкиКомпоновщикаДанные); 
	
	бит_ОтчетыБФКлиентСервер.ДобавитьОтбор(НастройкиКомпоновки, "Измерение",
		ЗначенияОсновногоОтбора, ВидСравненияКомпоновкиДанных.ВСписке);
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = КонецПериода;
	Иначе	
		КонецПериода = бит_ОбщегоНазначенияКлиентСервер.ПолучитьПериодПоСдвигу(НачалоПериода,
							КоличествоИнтервалов - 1, Периодичность);
	КонецЕсли; 
	
	ГраницаАктуализации = бит_ОбщегоНазначенияКлиентСервер.ПолучитьНачалоПериода(ДатаАктуализации, Периодичность) - 1;
	КонецПериодаФакт	= бит_ОбщегоНазначенияКлиентСервер.ПолучитьКонецПериода(ГраницаАктуализации, Периодичность);
	
	Если НЕ ЗначениеЗаполнено(СценарийФакт) Тогда
		СценарийФакт = Справочники.СценарииПланирования.ФАКТ;
	КонецЕсли; 
	
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "ВалютаДокумента", 	 ВалютаДокумента);
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "ДатаЗапроса", 		 ДатаЗапроса);
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "НачалоПериода", 		 НачалоПериода);
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "КонецПериода", 		 КонецПериода);
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "КонецПериодаФакт", 	 КонецПериодаФакт);
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "Сценарий", 			 СценарийЭталон);
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "СценарийАктуализация", Сценарий);
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "СценарийФакт", 		 СценарийФакт);
	
	ПараметрыВыгрузкиСКД = бит_ОтчетыБФСервер.ПараметрыВыгрузитьРезультатСКД();
	ПараметрыВыгрузкиСКД.СхемаКомпоновки	 = СКД;
	ПараметрыВыгрузкиСКД.НастройкиКомпоновки = НастройкиКомпоновки;
	ПараметрыВыгрузкиСКД.ТипРезультата 		 = "ТаблицаЗначений";
	
	РезультатСКД = бит_ОтчетыБФСервер.ВыгрузитьРезультатСКД(ПараметрыВыгрузкиСКД);
	РезультатСКД.Индексы.Добавить("Измерение, Период");
	Возврат РезультатСКД;

КонецФункции

// Процедура восстанавливает дерево по данным.
//
// Параметры:
//  ПараметрыВосстановления	 - Структура - см. НовыеПараметрыВосстановления.
// 
// Возвращаемое значение:
//  Структура - Структура параметров:
//  * ТабДок - ТабличныйДокумент - Табличный документ данных бюджета.
//
Функция ВосстановитьДеревоПоДанным(ПараметрыВосстановления) Экспорт

	ТабДок				= ПараметрыВосстановления.ТабДок;
	НастройкаФормы		= ПараметрыВосстановления.НастройкаФормы;
	Настройки			= ПараметрыВосстановления.Настройки;
	ТекстЗапроса		= ПараметрыВосстановления.ТекстЗапроса;
	БДДС				= ПараметрыВосстановления.БДДС;
	
	Бюджет = Настройки.Бюджет;
	Если ЗначениеЗаполнено(Бюджет) И Справочники.бит_Бюджеты.БюджетЗапрещенВПланировании(Бюджет) Тогда
		ВызватьИсключение НСтр("ru='Выполнение операции остановлено.
								|Бюджет настройки формы ввода не должен содержать дубли статей оборотов.';
							   	|en='The operation is stopped.
								|Budget setting entry forms should not contain duplicates revolutions articles.'");
	КонецЕсли;
	
	ИмяИзмерения = Настройки.ИмяРазворачивать;
	
	Если Настройки.Версия_2 Тогда		
		ПараметрыПередачи = бит_ВводБюджета.НовыеПараметрыПосроенияМакетаБюджета();
		ЗаполнитьЗначенияСвойств(ПараметрыПередачи, ПараметрыВосстановления);
		
		ПараметрыПередачи.МестоИспользования 	= "бит_АктуализацияБюджета";
		ПараметрыПередачи.СхемаКомпоновкиДанных = ПараметрыВосстановления.СхемаКомпоновкиСтруктура;
		ПараметрыПередачи.НастройкиКомпоновщика = ПараметрыВосстановления.НастройкиКомпоновщикаСтруктура;
		
		РезультатОбновления = бит_ВводБюджета.РезультатПостроенияМакетаБюджета(НастройкаФормы, ПараметрыПередачи);
		
		ПараметрыВосстановления.ТабДок = РезультатОбновления.ДокументРезультат;
		
		ЗначенияГруппировок = РезультатОбновления.ЗначенияГруппировок;
		МассивОтбор 		= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначенияГруппировок, ИмяИзмерения, Новый Массив);

	Иначе	
		МассивОтбор = ОбновитьДеревоДанныхДинамическийМакет(ПараметрыВосстановления);
	КонецЕсли;
	
	УстановитьЗначенияВДерево(БДДС, ПараметрыВосстановления);
	
	Результат = Новый Структура;
	Результат.Вставить("ТабДок", ПараметрыВосстановления.ТабДок);	
	
	Возврат Результат;
	
КонецФункции

// Процедура выполняет актуализацию.
//
// Параметры:
//  ПараметрыАктуализации	 - Структура - см. НовыеПараметрыАктуализации.
// 
// Возвращаемое значение:
//  Структура - Структура параметров:
//  * БДДС - ТаблицаЗначений - Данные для ТЧ БДДС.
//
Функция ВыполнитьАктуализацию(ПараметрыАктуализации) Экспорт
	
	АктуализироватьПо		  = ПараметрыАктуализации.АктуализироватьПо;
	ДатаАктуализации   		  = ПараметрыАктуализации.ДатаАктуализации;
	ОсновноеИзмерение  		  = ПараметрыАктуализации.Настройки.ИмяРазворачивать;
	СпособАктуализации 		  = ПараметрыАктуализации.СпособАктуализации;
	СуммовойУчет 	  		  = ПараметрыАктуализации.Настройки.УчетСумма;
	КоличественныйУчет		  = ПараметрыАктуализации.Настройки.УчетКоличество;
	ПропускатьФактБольшеПлана = ПараметрыАктуализации.НеАктуализироватьФактБольшеПлана;
	ПрофильРаспределения	  = ПараметрыАктуализации.ПрофильРаспределения;
	ИсключитьПериодыБезПлана  = ПараметрыАктуализации.ИсключитьПериодыБезПлана;
	АналитикиДляПодстановки   = ПараметрыАктуализации.АналитикиДляПодстановки;
		
	СКД 			 = ПолучитьМакет("ДанныеДляАктуализации");
	Компоновщик		 = Новый КомпоновщикНастроекКомпоновкиДанных;
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД);
	
	Компоновщик.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	НастройкиКомпоновки = Компоновщик.ПолучитьНастройки();
	
	НастройкиКомпоновки.Структура.Очистить();
	
	ИменаПолейАктуализации = Новый Массив;
	ИзмеренияАктуализации  = Новый Структура;
	
	Для каждого СтрокаТаблицы Из АктуализироватьПо Цикл
		Если СтрокаТаблицы.ИспользоватьРазрез Тогда
			ИмяПоля		= СтрЗаменить(СтрокаТаблицы.ИмяРеквизита, "Контроль", "");
			СинонимПоля = ПараметрыАктуализации.Настройки.Измерения[ИмяПоля].Синоним;
			
			ИменаПолейАктуализации.Добавить(ИмяПоля);
			ИзмеренияАктуализации.Вставить(ИмяПоля, СинонимПоля);
		КонецЕсли;
	КонецЦикла;								
	
	ГруппировкаПоляАктуализации = бит_ОтчетыБФСервер.НоваяГруппировка(НастройкиКомпоновки.Структура,,
									ТипГруппировкиКомпоновкиДанных.Элементы, Ложь);
	
	Для каждого ПолеАктуализации Из ИменаПолейАктуализации Цикл
		бит_ОтчетыБФСервер.НовоеПолеГруппировки(ГруппировкаПоляАктуализации, ПолеАктуализации, 
			ТипГруппировкиКомпоновкиДанных.Элементы);
	КонецЦикла;								
	
	ГруппировкаДетальныеЗаписи = бит_ОтчетыБФСервер.НоваяГруппировка(ГруппировкаПоляАктуализации,,
										ТипГруппировкиКомпоновкиДанных.Элементы, Ложь);
											
	ДанныеДляАктуализации = ДанныеДляАктуализации(ПараметрыАктуализации);
	
	Периоды = ДанныеДляАктуализации.Периоды;
	Данные	= ДанныеДляАктуализации.Данные;
	
	ВнешниеНаборы = Новый Структура("Данные", Данные);
	
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "ДатаАктуализации", ДатаАктуализации);
	
	Индекс = 1;
	Для каждого ДанныеПериода Из Периоды Цикл
		КодПериода = СтрШаблон("Период%1", Индекс);
		бит_ОтчетыБФСервер.ДобавитьПараметр(СКД, КодПериода,, ДанныеПериода.Период);

		НовоеПоле = СКД.ВычисляемыеПоля.Добавить();
		НовоеПоле.ПутьКДанным = ДанныеПериода.Сумма;
		НовоеПоле.Выражение   = СтрШаблон("ВЫБОР КОГДА Период = &%1 ТОГДА Сумма ИНАЧЕ 0 КОНЕЦ", КодПериода);
		НовоеПоле.ТипЗначения = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3);
		бит_ОтчетыБФСервер.НовоеПолеВыбора(НастройкиКомпоновки, НовоеПоле.ПутьКДанным);
		
		НовоеПолеИтога = СКД.ПоляИтога.Добавить();
		НовоеПолеИтога.ПутьКДанным = НовоеПоле.ПутьКДанным;
		НовоеПолеИтога.Выражение   = СтрШаблон("СУММА(%1)", НовоеПоле.ПутьКДанным);
		
		НовоеПоле = СКД.ВычисляемыеПоля.Добавить();
		НовоеПоле.ПутьКДанным = ДанныеПериода.Количество;
		НовоеПоле.Выражение = СтрШаблон("ВЫБОР КОГДА Период = &%1 ТОГДА Количество ИНАЧЕ 0 КОНЕЦ", КодПериода);
		НовоеПоле.ТипЗначения = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3);
		бит_ОтчетыБФСервер.НовоеПолеВыбора(НастройкиКомпоновки, НовоеПоле.ПутьКДанным);
		
		НовоеПолеИтога = СКД.ПоляИтога.Добавить();
		НовоеПолеИтога.ПутьКДанным = НовоеПоле.ПутьКДанным;
		НовоеПолеИтога.Выражение   = СтрШаблон("СУММА(%1)", НовоеПоле.ПутьКДанным);
		
		НовоеПоле = СКД.ВычисляемыеПоля.Добавить();
		НовоеПоле.ПутьКДанным = ДанныеПериода.СуммаФакт;
		НовоеПоле.Выражение   = СтрШаблон("ВЫБОР КОГДА Период = &%1 ТОГДА СуммаФакт ИНАЧЕ 0 КОНЕЦ", КодПериода);
		НовоеПоле.ТипЗначения = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3);
		бит_ОтчетыБФСервер.НовоеПолеВыбора(НастройкиКомпоновки, НовоеПоле.ПутьКДанным);
		
		НовоеПолеИтога = СКД.ПоляИтога.Добавить();
		НовоеПолеИтога.ПутьКДанным = НовоеПоле.ПутьКДанным;
		НовоеПолеИтога.Выражение   = СтрШаблон("СУММА(%1)", НовоеПоле.ПутьКДанным);
		
		НовоеПоле = СКД.ВычисляемыеПоля.Добавить();
		НовоеПоле.ПутьКДанным = ДанныеПериода.КоличествоФакт;
		НовоеПоле.Выражение = СтрШаблон("ВЫБОР КОГДА Период = &%1 ТОГДА КоличествоФакт ИНАЧЕ 0 КОНЕЦ", КодПериода);
		НовоеПоле.ТипЗначения = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3);
		бит_ОтчетыБФСервер.НовоеПолеВыбора(НастройкиКомпоновки, НовоеПоле.ПутьКДанным);
		
		НовоеПолеИтога = СКД.ПоляИтога.Добавить();
		НовоеПолеИтога.ПутьКДанным = НовоеПоле.ПутьКДанным;
		НовоеПолеИтога.Выражение   = СтрШаблон("СУММА(%1)", НовоеПоле.ПутьКДанным);
				
		Индекс = Индекс + 1;
	КонецЦикла;
		
	ПараметрыВыгрузкиСКД = бит_ОтчетыБФСервер.ПараметрыВыгрузитьРезультатСКД();
	ПараметрыВыгрузкиСКД.СхемаКомпоновки	 = СКД;
	ПараметрыВыгрузкиСКД.НастройкиКомпоновки = НастройкиКомпоновки;
	ПараметрыВыгрузкиСКД.ТипРезультата 		 = "ДеревоЗначений";
	ПараметрыВыгрузкиСКД.ВнешниеНаборыДанных = ВнешниеНаборы;
	
	РезультатСКД = бит_ОтчетыБФСервер.ВыгрузитьРезультатСКД(ПараметрыВыгрузкиСКД);
	
	БДДС = ПараметрыАктуализации.БДДС.СкопироватьКолонки();
	
	Ресурсы = Новый Массив;
	Если СуммовойУчет Тогда
		Ресурсы.Добавить("Сумма");
	КонецЕсли;
	Если КоличественныйУчет Тогда
		Ресурсы.Добавить("Количество");
	КонецЕсли;
	
	БазаПрофиля = Новый Соответствие;
	Если ЗначениеЗаполнено(ПрофильРаспределения) Тогда
		БазаПрофиля = Справочники.бит_ПрофилиРаспределенияПоПериодам.ПолучитьКоэффициенты(ПрофильРаспределения, "К");
	КонецЕсли;
	
	ПараметрыРаспределения = Новый Структура;
	ПараметрыРаспределения.Вставить("СпособАктуализации", 		 СпособАктуализации);
	ПараметрыРаспределения.Вставить("ДатаАктуализации", 		 ДатаАктуализации);
	ПараметрыРаспределения.Вставить("ПропускатьФактБольшеПлана", ПропускатьФактБольшеПлана);
	ПараметрыРаспределения.Вставить("БазаПрофиля", 				 БазаПрофиля);
	ПараметрыРаспределения.Вставить("ИзмеренияАктуализации", 	 ИзмеренияАктуализации);
	ПараметрыРаспределения.Вставить("ИсключитьПериодыБезПлана",  ИсключитьПериодыБезПлана);
	ПараметрыРаспределения.Вставить("ОсновноеИзмерение",  		 ОсновноеИзмерение);
	ПараметрыРаспределения.Вставить("БудущиеПериоды",  		 	 Периоды);
	ПараметрыРаспределения.Вставить("АналитикиДляПодстановки",	 АналитикиДляПодстановки);
	
	Отказ = Ложь;
	Для каждого СтрокаТаблицы Из РезультатСКД.Строки Цикл						
		Для каждого ИмяРесурса Из Ресурсы  Цикл			
			ОбработатьРаспределениеФакта(СтрокаТаблицы, ИмяРесурса, ПараметрыРаспределения);
		КонецЦикла;
	КонецЦикла;
	
	БДДС.Очистить();
	
	Стек = Новый Массив; 
	Для каждого СтрокаТаблицы Из РезультатСКД.Строки Цикл
		
		Стек.Добавить(СтрокаТаблицы);
	
		Пока Стек.Количество() > 0 Цикл
			
			ТекущийОбъект = Стек.Получить(Стек.ВГраница());
			Стек.Удалить(Стек.ВГраница());
						
			Если ТекущийОбъект.Строки.Количество() = 0 Тогда
				Если ТекущийОбъект.СуммаОбработано ИЛИ ТекущийОбъект.КоличествоОбработано Тогда
					Для каждого ДанныеПериода Из Периоды Цикл
						Если ДанныеПериода.Период >= ДатаАктуализации Тогда
							ТекущийОбъект.Сумма		 = ТекущийОбъект.Сумма 		
													 + ?(ТекущийОбъект.СуммаОбработано, ТекущийОбъект[ДанныеПериода.Сумма], 0);
							ТекущийОбъект.Количество = ТекущийОбъект.Количество 
													 + ?(ТекущийОбъект.КоличествоОбработано, ТекущийОбъект[ДанныеПериода.Количество], 0);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если ТекущийОбъект.Сумма = 0 И ТекущийОбъект.Количество = 0 
				   И ТекущийОбъект.СуммаФакт = 0 И ТекущийОбъект.КоличествоФакт = 0 Тогда
					Продолжить;			
				КонецЕсли;

				ЗаполнитьЗначенияСвойств(БДДС.Добавить(), ТекущийОбъект);
			КонецЕсли;
			
			Для каждого Элемент Из ТекущийОбъект.Строки Цикл
				Стек.Добавить(Элемент);
			КонецЦикла; 
		КонецЦикла;
	КонецЦикла; 
	
	БДДС.Сортировать("НомерСтроки возр");
	
	Результа = Новый Структура;
	Результа.Вставить("БДДС", БДДС);
	
	Возврат Результа;
	
КонецФункции

// Параметры для функций обновления данных.
// 
// Возвращаемое значение:
//  Структура - Структура параметров:
//  * ТабДок - ТабличныйДокумент - Заготовка под макет.
//  * НастройкаФормы - СправочникСсылка.бит_НастройкиФормВводаБюджета - Выбранная настройка формы ввода бюджета.
//  * Настройки - Структура - Свойства настройки формы ввода бюджета.
//  * ТекстЗапроса - Строка - Текст запроса для актуализации.
//  * Сценарий - СправочникСсылка.СценарииПланирования - Сценарий.
//  * СценарийЭталон - СправочникСсылка.СценарииПланирования - Сценарий эталон.
//  * СценарийФакт - СправочникСсылка.СценарииПланирования - Сценарий факт.
//  * СхемаКомпоновкиСтруктура - СхемаКомпоновкиДанных - Схема компоновки данных.
//  * НастройкиКомпоновщикаСтруктура - НастройкиКомпоновкиДанных - Настройки компоновки данных.
//  * СхемаКомпоновкиДанные - СхемаКомпоновкиДанных - Схема компоновки данных.
//  * НастройкиКомпоновщикаДанные - НастройкиКомпоновкиДанных - Настройки компоновки данных.
//  * Дата - Дата - Дата документа.
//  * Периодичность - ПеречислениеСсылка.бит_ПериодичностьПланирования - Периодичность планирования.
//  * ДатаНачалаПланирования - Дата - Дата начала планирования.
//  * ДатаОкончанияПланирования - Дата - Дата окончания планирования.
//  * ПродолжительностьИнтервала - Число - Количество интервалов.
//  * ДатаАктуализации - Дата - Дата актуализации.
//  * ВалютаДокумента - СправочникСсылка.Валюты - Валюта документа.
//
Функция НовыеПараметрыОбновления() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ТабДок",							Новый ТабличныйДокумент());
	Параметры.Вставить("НастройкаФормы",					Справочники.бит_НастройкиФормВводаБюджета.ПустаяСсылка());
	Параметры.Вставить("Настройки",							Новый Структура);
	Параметры.Вставить("ТекстЗапроса",						"");
	Параметры.Вставить("Сценарий",							Справочники.СценарииПланирования.ПустаяСсылка());
	Параметры.Вставить("СценарийЭталон",					Справочники.СценарииПланирования.ПустаяСсылка());
	Параметры.Вставить("СценарийФакт",						Справочники.СценарииПланирования.ПустаяСсылка());
	Параметры.Вставить("СхемаКомпоновкиСтруктура",			Новый СхемаКомпоновкиДанных);
	Параметры.Вставить("НастройкиКомпоновщикаСтруктура",	Новый НастройкиКомпоновкиДанных);
	Параметры.Вставить("СхемаКомпоновкиДанные",				Новый СхемаКомпоновкиДанных);
	Параметры.Вставить("НастройкиКомпоновщикаДанные",		Новый НастройкиКомпоновкиДанных);
	Параметры.Вставить("Дата",								Дата(1,1,1));
	Параметры.Вставить("Периодичность",						Перечисления.бит_ПериодичностьПланирования.ПустаяСсылка());
	Параметры.Вставить("ДатаНачалаПланирования",			Дата(1,1,1));
	Параметры.Вставить("ДатаОкончанияПланирования",			Дата(1,1,1));
	Параметры.Вставить("ПродолжительностьИнтервала",		12);
	Параметры.Вставить("ДатаАктуализации",					Дата(1,1,1));
	Параметры.Вставить("ВалютаДокумента",					Справочники.Валюты.ПустаяСсылка());
	
	Возврат Параметры;
	
КонецФункции

// Параметры для функций восстановления данных.
// 
// Возвращаемое значение:
//  Структура - Структура параметров:
//  * ТабДок - ТабличныйДокумент - Заготовка под макет.
//  * НастройкаФормы - СправочникСсылка.бит_НастройкиФормВводаБюджета - Выбранная настройка формы ввода бюджета.
//  * Настройки - Структура - Свойства настройки формы ввода бюджета.
//  * ТекстЗапроса - Строка - Текст запроса для актуализации.
//  * СхемаКомпоновкиСтруктура - СхемаКомпоновкиДанных - Схема компоновки данных.
//  * НастройкиКомпоновщикаСтруктура - НастройкиКомпоновкиДанных - Настройки компоновки данных.
//  * Периодичность - ПеречислениеСсылка.бит_ПериодичностьПланирования - Периодичность планирования.
//  * ДатаНачалаПланирования - Дата - Дата начала планирования.
//  * ДатаОкончанияПланирования - Дата - Дата окончания планирования.
//  * ПродолжительностьИнтервала - Число - Количество интервалов.
//  * ДатаАктуализации - Дата - Дата актуализации.
//  * БДДС - ТаблицаЗначений - Данные ТЧ БДДС.
//  * ФактическиеДанные - ТаблицаЗначений - Данные ТЧ ФактическиеДанные.
//
Функция НовыеПараметрыВосстановления() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ТабДок",							Новый ТабличныйДокумент());
	Параметры.Вставить("НастройкаФормы",					Справочники.бит_НастройкиФормВводаБюджета.ПустаяСсылка());
	Параметры.Вставить("Настройки",							Новый Структура);
	Параметры.Вставить("ТекстЗапроса",						"");
	Параметры.Вставить("СхемаКомпоновкиСтруктура",			Новый СхемаКомпоновкиДанных);
	Параметры.Вставить("НастройкиКомпоновщикаСтруктура",	Новый НастройкиКомпоновкиДанных);
	Параметры.Вставить("Периодичность",						Перечисления.бит_ПериодичностьПланирования.ПустаяСсылка());
	Параметры.Вставить("ДатаНачалаПланирования",			Дата(1,1,1));
	Параметры.Вставить("ДатаОкончанияПланирования",			Дата(1,1,1));
	Параметры.Вставить("ПродолжительностьИнтервала",		12);
	Параметры.Вставить("ДатаАктуализации",					Дата(1,1,1));
	Параметры.Вставить("БДДС",								Новый ТаблицаЗначений);
	Параметры.Вставить("ФактическиеДанные",					Новый ТаблицаЗначений);
	
	Возврат Параметры;
	
КонецФункции

// Параметры для функций актуализации данных.
// 
// Возвращаемое значение:
//  Структура - Структура параметров:
//  * Настройки - Структура - свойства настройки формы ввода бюджета.
//  * Периодичность - ПеречислениеСсылка.бит_ПериодичностьПланирования - Периодичность планирования.
//  * ПродолжительностьИнтервала - Число - Количество интервалов.
//  * ДатаАктуализации - Дата - Дата актуализации.
//  * ДатаНачалаПланирования - Дата - Дата начала планирования.
//  * СпособАктуализации -  ПеречислениеСсылка.бит_СпособыАктуализации - Способ актуализации.
//  * ПрофильРаспределения - СправочникСсылка.бит_ПрофилиРаспределенияПоПериодам - Профиль распределения.
//  * НеАктуализироватьФактБольшеПлана - Булево - Свойство документа Актуализации.
//  * БДДС - ТаблицаЗначений - Данные ТЧ БДДС, нужны только для восстановления.
//  * ФактическиеДанные - ТаблицаЗначений - Данные ТЧ ФактическиеДанные.
//
Функция НовыеПараметрыАктуализации() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("АналитикиДляПодстановки",			Новый Структура);
	Параметры.Вставить("Настройки",							Новый Структура);
 	Параметры.Вставить("Периодичность",						Перечисления.бит_ПериодичностьПланирования.ПустаяСсылка());
 	Параметры.Вставить("ПродолжительностьИнтервала",		12);
	Параметры.Вставить("ДатаАктуализации",					Дата(1,1,1));
	Параметры.Вставить("ДатаНачалаПланирования",			Дата(1,1,1));
	Параметры.Вставить("ДатаОкончанияПланирования",			Дата(1,1,1));
	Параметры.Вставить("СпособАктуализации",				Перечисления.бит_СпособыАктуализации.ПустаяСсылка());
	Параметры.Вставить("ПрофильРаспределения",				Справочники.бит_ПрофилиРаспределенияПоПериодам.ПустаяСсылка());
	Параметры.Вставить("НеАктуализироватьФактБольшеПлана",	Ложь);
	Параметры.Вставить("БДДС",								Новый ТаблицаЗначений);
	Параметры.Вставить("АктуализироватьПо",					Новый ТаблицаЗначений);
	Параметры.Вставить("ИсключитьПериодыБезПлана",			Ложь);
	
	Возврат Параметры;
	
КонецФункции

// Параметры для функций актуализации данных.
//
// Параметры:
//  АктуализацияБюджета	 - ДокументСсылка, ДокументОбъект	 - Ссылка или объект документа Актуализация бюджета.
//  Настройки			 - Структура						 - Свойства настройки формы ввода бюджета.
//  ТолькоПоУмолчанию	 - Булево							 - ограничивает выбор способа заполнения.
// 
// Возвращаемое значение:
//  Результат - Структура - аналитики для подстановки в строки БДДС.
//
Функция АналитикиБДДСДляПодстановки(АктуализацияБюджета, Настройки, ТолькоПоУмолчанию = Ложь) Экспорт
	
	МетаОбъект 		 = Документы.бит_АктуализацияБюджета.ПустаяСсылка().Метаданные();
	ИменаПоУмолчанию = Настройки.СпособыЗаполнения[Перечисления.бит_СпособыЗаполненияИзмеренийВФормахВвода.ПоУмолчанию];
	Если НЕ ТолькоПоУмолчанию Тогда
		Для каждого ИмяИзмерения Из Настройки.СпособыЗаполнения[Перечисления.бит_СпособыЗаполненияИзмеренийВФормахВвода.ПоУмолчаниюРедактирование] Цикл
			ИменаПоУмолчанию.Добавить(ИмяИзмерения);
		КонецЦикла;
	КонецЕсли;
		
	Индекс = ИменаПоУмолчанию.ВГраница();
	Пока Индекс >= 0 Цикл
		ТекЗначение = ИменаПоУмолчанию[Индекс];
		Если НЕ бит_РаботаСМетаданными.ЕстьРеквизит(ТекЗначение, МетаОбъект) 
			ИЛИ НЕ бит_РаботаСМетаданными.ЕстьРеквизитТабЧасти(ТекЗначение, МетаОбъект, "БДДС") Тогда
			ИменаПоУмолчанию.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(АктуализацияБюджета) Тогда
		РеквизитыАктуализации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктуализацияБюджета, ИменаПоУмолчанию);
	Иначе	
		РеквизитыАктуализации = Новый Структура(СтрСоединить(ИменаПоУмолчанию, ","));
		ЗаполнитьЗначенияСвойств(РеквизитыАктуализации, АктуализацияБюджета); 
	КонецЕсли;
	
	Результат  = Новый Структура;
	
	Для каждого Измерение Из РеквизитыАктуализации Цикл
		Если ЗначениеЗаполнено(Измерение.Значение) Тогда
			Результат.Вставить(Измерение.Ключ, Измерение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

#КонецОбласти

Процедура СформироватьДвиженияОборотыПоБюджетам(ДанныеБюджета, Реквизиты, Движения, Отказ) Экспорт 
	
	Для каждого СтрокаТаблицы Из ДанныеБюджета Цикл
		Движение = Движения.бит_ОборотыПоБюджетам.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, СтрокаТаблицы);
	КонецЦикла; 
	Движения.бит_ОборотыПоБюджетам.Записывать = Истина;
	
КонецПроцедуры

Процедура СформироватьДвиженияБюджетирование(ДанныеБюджета, Реквизиты, Движения, Отказ) Экспорт 
	
	Если ЗначениеЗаполнено(ДанныеБюджета) Тогда
		бит_Бюджетирование.СформироватьПроводкиБюджетирования(ДанныеБюджета,
			Движения.бит_Бюджетирование, Ложь);
	КонецЕсли;
	Движения.бит_Бюджетирование.Записывать = Истина;
	
КонецПроцедуры

// Инициализирует компоновщик, используемый для фильтрации структуры дерева.
// 
Функция ИнициализироватьКомпоновщикСтруктура(Знач ТекстЗапроса, КомпоновщикСтруктура, УникальныйИдентификатор) Экспорт
	
	Возврат Документы.бит_ФормаВводаБюджета.ИнициализироватьКомпоновщик(ТекстЗапроса,
				КомпоновщикСтруктура, УникальныйИдентификатор);
	
