Процедура ПодготовитьТаблицуИсполнениеБюджетаРасчетыВВалюте(ИсполнениеБюджета, ИсполнениеБюджетаРеквизиты)

	Если НЕ ЗначениеЗаполнено(ИсполнениеБюджета) ИЛИ НЕ ЗначениеЗаполнено(ИсполнениеБюджетаРеквизиты) Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = ИсполнениеБюджетаРеквизиты[0];
	
	КурсВалютыДокумента = Новый Структура;
	КурсВалютыДокумента.Вставить("Валюта", 	  Реквизиты.Валюта);
	КурсВалютыДокумента.Вставить("Курс", 	  Реквизиты.Курс);
	КурсВалютыДокумента.Вставить("Кратность", Реквизиты.Кратность);
	
	КурсВалютыСценария = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Реквизиты.ВалютаСценария, Реквизиты.Дата);
	
	Для каждого СтрокаТаблицы Из ИсполнениеБюджета Цикл
		СтрокаТаблицы.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
								СтрокаТаблицы.Сумма, КурсВалютыДокумента, КурсВалютыСценария);
	КонецЦикла;																	

КонецПроцедуры
 
Процедура ПодготовитьТаблицыДокументаРасчетыВВалюте(ПараметрыПроведения, Реквизиты)

	Если ПараметрыПроведения.ТаблицаОборотыПоБюджетам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Сценарии		  = ПараметрыПроведения.Сценарии;
	ТаблицаПериодов	  = ПараметрыПроведения.ТаблицаПериодов;
	ОборотыПоБюджетам = ПараметрыПроведения.ТаблицаОборотыПоБюджетам;
	КурсыПоПериодам	  = Неопределено;
	
	Если ТаблицаПериодов.Количество() >= 1000 Тогда
		ТаблицаПериодов.Индексы.Добавить("Сценарий");
	КонецЕсли; 
	
	Если ОборотыПоБюджетам.Количество() >= 1000 Тогда
		ОборотыПоБюджетам.Индексы.Добавить("Сценарий");
	КонецЕсли;

	Если Реквизиты.ИспользоватьКурсыСценария Тогда
		Для каждого СтрокаТаблицы Из Сценарии Цикл
			
			Отбор	= Новый Структура("Сценарий", СтрокаТаблицы.Сценарий);
			Периоды = ТаблицаПериодов.Скопировать(Отбор);
			Валюты  =  бит_Бюджетирование.ЗаполнитьСтруктуруПараметровПолученияКурсовПоПериодам(СтрокаТаблицы.Сценарий, Реквизиты.ВалютаДокумента);
		
			КурсыПоПериодам = бит_КурсыВалют.ПолучитьКурсыВалютПоПериодам(Периоды, Валюты, СтрокаТаблицы.Сценарий);
			
			НайденныеСтроки = ОборотыПоБюджетам.НайтиСтроки(Отбор);
			бит_Бюджетирование.ВыполнитьПересчетыВТаблицеОборотов(НайденныеСтроки, 
								КурсыПоПериодам, Реквизиты.КурсыВалют);

		КонецЦикла; 
	Иначе
		
		бит_Бюджетирование.ВыполнитьПересчетыВТаблицеОборотов(ОборотыПоБюджетам, 
								Неопределено, Реквизиты.КурсыВалют);
	КонецЕсли;
							
КонецПроцедуры

Процедура ИнициализироватьКлючиАналитик(Реквизиты)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Реквизиты.Регистратор);
	Запрос.УстановитьПараметр("Сценарий", 	 Реквизиты.Сценарий);

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеБюджета.ЦФО КАК ЦФО,
	|	&Сценарий КАК Сценарий
	|ПОМЕСТИТЬ ДанныеБюджета
	|ИЗ
	|	Документ.бит_АктуализацияБюджета.БДДС КАК ДанныеБюджета
	|ГДЕ
	|	ДанныеБюджета.Ссылка = &Регистратор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗависимыеОбороты.ЦФО,
	|	&Сценарий
	|ИЗ
	|	Документ.бит_АктуализацияБюджета.ЗависимыеОбороты КАК ЗависимыеОбороты
	|ГДЕ
	|	ЗависимыеОбороты.Ссылка = &Регистратор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоИзменения.ЦФО,
	|	&Сценарий
	|ИЗ
	|	Документ.бит_АктуализацияБюджета.ДоИзменения КАК ДоИзменения
	|ГДЕ
	|	ДоИзменения.Ссылка = &Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеБюджета.Сценарий КАК Сценарий,
	|	ДанныеБюджета.ЦФО КАК ЦФО
	|ПОМЕСТИТЬ УникальныеДанныеБюджета
	|ИЗ
	|	ДанныеБюджета КАК ДанныеБюджета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УникальныеДанныеБюджета.Сценарий КАК Сценарий,
	|	УникальныеДанныеБюджета.ЦФО КАК ЦФО,
	|	АналитикаСценарийЦФО.КлючАналитики КАК КлючАналитики
	|ИЗ
	|	УникальныеДанныеБюджета КАК УникальныеДанныеБюджета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_АналитикаСценарийЦФО КАК АналитикаСценарийЦФО
	|		ПО УникальныеДанныеБюджета.Сценарий = АналитикаСценарийЦФО.Сценарий
	|			И УникальныеДанныеБюджета.ЦФО = АналитикаСценарийЦФО.ЦФО
	|ГДЕ
	|	АналитикаСценарийЦФО.КлючАналитики ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Справочники.бит_КлючиСценарийЦФО.КлючиСценарийЦФОДокумента(Выборка);
	КонецЦикла;

КонецПроцедуры

Функция НовыеПараметрыШапки()
	
	ПараметрыШапки = Новый Структура;
	ПараметрыШапки.Вставить("Периодичность");
	ПараметрыШапки.Вставить("ПродолжительностьИнтервала");
	ПараметрыШапки.Вставить("ДатаНачалаПланирования");
	ПараметрыШапки.Вставить("ДатаОкончанияПланирования");
	ПараметрыШапки.Вставить("ДатаАктуализации");
	
	Возврат ПараметрыШапки;
	
КонецФункции

Функция ДанныеДляАктуализации(ПараметрыАктуализации)

	ДанныеДокумента		 	  = ПараметрыАктуализации.БДДС;
	НачалоПериода 		 	  = ПараметрыАктуализации.ДатаНачалаПланирования;
	КонецПериода		 	  = ПараметрыАктуализации.ДатаОкончанияПланирования;
	Периодичность			  = ПараметрыАктуализации.Периодичность;
	КоличествоИнтервалов 	  = ПараметрыАктуализации.ПродолжительностьИнтервала;
	ДатаАктуализации	 	  = ПараметрыАктуализации.ДатаАктуализации;
	ПропускатьФактБольшеПлана = ПараметрыАктуализации.НеАктуализироватьФактБольшеПлана;;
	АктуализироватьПо		  = ПараметрыАктуализации.АктуализироватьПо;
	ОсновноеИзмерение  		  = ПараметрыАктуализации.Настройки.ИмяРазворачивать;
	ИсключитьПериодыБезПлана  = ПараметрыАктуализации.ИсключитьПериодыБезПлана;
	СпособАктуализации		  = ПараметрыАктуализации.СпособАктуализации;
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = КонецПериода;
	Иначе	
		КонецПериода = бит_ОбщегоНазначенияКлиентСервер.ПолучитьПериодПоСдвигу(НачалоПериода,
							КоличествоИнтервалов - 1, Периодичность);
	КонецЕсли;
		
	Периоды = СеткаПериодов(НачалоПериода, КонецПериода, ДатаАктуализации, Периодичность);	
				
	ДанныеДляАктуализации = Новый Структура;
	ДанныеДляАктуализации.Вставить("Данные",  ДанныеДокумента);
	ДанныеДляАктуализации.Вставить("Периоды", Периоды);
	
	Возврат ДанныеДляАктуализации;
	
КонецФункции

// Функция формирует таблицу с сеткой дат по периоду актуализации данных.
//
// Параметры:
//  НачалоПериода	 - Дата	 - начало периода.
//  КонецПериода	 - Дата	 - конец периода.
//  Периодичность	 - ПеречислениеСсылка.бит_ПериодичностьПланирования	 - перидичность планирования.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с одной колонкой "Период". Содежит список периодов в диапазоне актуализации данных.
//
Функция СеткаПериодов(НачалоПериода, КонецПериода, ДатаАктуализации, Периодичность)

	СеткаПериодов = Новый ТаблицаЗначений;
	СеткаПериодов.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	СеткаПериодов.Колонки.Добавить("Сумма",  ОбщегоНазначения.ОписаниеТипаСтрока(50));
	СеткаПериодов.Колонки.Добавить("СуммаФакт",  ОбщегоНазначения.ОписаниеТипаСтрока(50));
	СеткаПериодов.Колонки.Добавить("Количество",  ОбщегоНазначения.ОписаниеТипаСтрока(50));
	СеткаПериодов.Колонки.Добавить("КоличествоФакт",  ОбщегоНазначения.ОписаниеТипаСтрока(50));
	СеткаПериодов.Колонки.Добавить("БудущийПериод",  Новый ОписаниеТипов("Булево"));
	
	ТекущаяДата = ДатаАктуализации;
	Сч = 1;
	Пока ТекущаяДата <= КонецПериода Цикл
		НоваяСтрока = СеткаПериодов.Добавить();
		НоваяСтрока.Период 		   = ТекущаяДата;
		НоваяСтрока.Сумма 		   = "Сумма" + Формат(Сч, "ЧГ=");
		НоваяСтрока.СуммаФакт 	   = "СуммаФакт" + Формат(Сч, "ЧГ=");
		НоваяСтрока.Количество 	   = "Количество" + Формат(Сч, "ЧГ=");
		НоваяСтрока.КоличествоФакт = "КоличествоФакт" + Формат(Сч, "ЧГ=");
		НоваяСтрока.БудущийПериод  = (ТекущаяДата >= ДатаАктуализации);
		ТекущаяДата = бит_ОбщегоНазначенияКлиентСервер.ПолучитьПериодПоСдвигу(ТекущаяДата, 1, Периодичность);
		Сч = Сч + 1;
	КонецЦикла;
	
    Возврат СеткаПериодов;
	
КонецФункции

Функция ПредставлениеВидаУчета(ИмяРесурса)

	ВидУчета = ?(ИмяРесурса = "Сумма", НСтр("ru = 'суммовом'"), НСтр("ru = 'количественном'"));
	Возврат ВидУчета;
	
КонецФункции

Функция НоваяСтрокаДетали(Детали, Периоды, ДанныеЗаполнения)

	НоваяСтрока = Детали.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Детали.Родитель);
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения.АналитикиДляПодстановки);
	
	НоваяСтрока.ИД 		  = Строка(Новый УникальныйИдентификатор);
	НоваяСтрока.Измерение = НоваяСтрока[ДанныеЗаполнения.ОсновноеИзмерение];
	НоваяСтрока.Период	  = ДанныеЗаполнения.Период;
	
	Для каждого ТекущийПериод Из Периоды Цикл
		НоваяСтрока[ТекущийПериод.Сумма] 	  = 0;
		НоваяСтрока[ТекущийПериод.Количество] = 0;
		НоваяСтрока[ТекущийПериод.СуммаФакт] 	  = 0;
		НоваяСтрока[ТекущийПериод.КоличествоФакт] = 0;
	КонецЦикла;

	НоваяСтрока.Сумма 	   	   = 0;
	НоваяСтрока.Количество 	   = 0;
	НоваяСтрока.СуммаФакт	   = 0;
	НоваяСтрока.КоличествоФакт = 0;
	НоваяСтрока.НомерСтроки    = 0;
	
	Возврат НоваяСтрока;
	
КонецФункции 

Функция РаспределитьСуммуПропорциональноКоэффициентам(РаспределяемаяСумма, Коэффициенты, Точность = 2)

	Результат = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
							РаспределяемаяСумма, Коэффициенты, Точность);
							
	Если Результат = Неопределено Тогда
		Результат = Новый Массив;
		Индекс = Коэффициенты.ВГраница();
		Пока Индекс >= 0 Цикл
			Результат.Добавить(0);	
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;						

	Возврат Результат;
	
КонецФункции

Процедура ОбработатьРаспределениеФакта(КоллекцияСтрок, ИмяРесурса, ПараметрыРаспределения)
		
	СпособАктуализации		  = ПараметрыРаспределения.СпособАктуализации;
	ДатаАктуализации  		  = ПараметрыРаспределения.ДатаАктуализации;
	ПропускатьФактБольшеПлана = ПараметрыРаспределения.ПропускатьФактБольшеПлана;
	БазаПрофиля				  = ПараметрыРаспределения.БазаПрофиля;
	ИзмеренияАктуализации	  = ПараметрыРаспределения.ИзмеренияАктуализации;
	ИсключитьПериодыБезПлана  = ПараметрыРаспределения.ИсключитьПериодыБезПлана;
	ОсновноеИзмерение		  = ПараметрыРаспределения.ОсновноеИзмерение;
	БудущиеПериоды			  = ПараметрыРаспределения.БудущиеПериоды;
	АналитикиДляПодстановки	  = ПараметрыРаспределения.АналитикиДляПодстановки;
	
	РесурсБазаРаспределения = ИмяРесурса + "БазаРаспределения";
	РесурсОтлонение			= ИмяРесурса + "Отклонение";
	РесурсФакт				= ИмяРесурса + "Факт";
	РесурсОстатокПлан		= ИмяРесурса + "ОстатокПлан";			
	
	СуммаИБазаРаспределения = СуммаИБазаРаспределения(КоллекцияСтрок, ИмяРесурса, ПараметрыРаспределения);
	Если СуммаИБазаРаспределения.Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДетальныеЗаписи = КоллекцияСтрок.Строки;
	Для каждого СтрокаДетали Из ДетальныеЗаписи Цикл
		Если СтрокаДетали[РесурсОтлонение] <> 0 Тогда
			СтрокаДетали[ИмяРесурса] = СтрокаДетали[РесурсФакт];
		КонецЕсли;
	КонецЦикла;

	КоэффициентыГруппировки = СуммаИБазаРаспределения.Коэффициенты;
	МожноРаспределить	    = СуммаИБазаРаспределения.МожноРаспределить;
	Результат				= СуммаИБазаРаспределения.Результат;
	
	ТочностьОкругления = ?(ИмяРесурса = "Сумма", 2, 3);
							
	ИндексБудущийПериод = 0;					
	Для каждого БудущийПериод Из БудущиеПериоды Цикл
		
		КоэффициентыПериода			= Новый Массив;
		ДетальныеЗаписиДляИзменения = Новый Массив;
		
		// Сумма по детальным записям всегда распределяется пропорционально.
		ДобавитьСтроку = Истина;
		Для каждого СтрокаДетали Из ДетальныеЗаписи Цикл
			Если СтрокаДетали.Период > БудущийПериод.Период Тогда
				// Детальные записи отсортированны по периоду на стороне СКД.
				Прервать;
			ИначеЕсли СтрокаДетали.Период <> БудущийПериод.Период Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьСтроку = Ложь;
			ТекущаяСтрока  = СтрокаДетали; 
			Если ТекущаяСтрока[БудущийПериод[ИмяРесурса]] = 0 Тогда
				Коэффициент = 0;
			Иначе	
				Коэффициент = ТекущаяСтрока[БудущийПериод[ИмяРесурса]];
			КонецЕсли;	
			ДетальныеЗаписиДляИзменения.Добавить(ТекущаяСтрока);
			КоэффициентыПериода.Добавить(Коэффициент);
		КонецЦикла;
		
		Если ДобавитьСтроку Тогда
			ДанныеЗаполнения = Новый Структура;
			ДанныеЗаполнения.Вставить("ОсновноеИзмерение", 		 ОсновноеИзмерение);
			ДанныеЗаполнения.Вставить("Период", 		   		 БудущийПериод.Период);
			ДанныеЗаполнения.Вставить("АналитикиДляПодстановки", АналитикиДляПодстановки);
			
			ТекущаяСтрока = НоваяСтрокаДетали(ДетальныеЗаписи, БудущиеПериоды, ДанныеЗаполнения);
			Если ТекущаяСтрока[БудущийПериод[ИмяРесурса]] = 0 Тогда
				Коэффициент = ?(ИсключитьПериодыБезПлана, 0, 1);
			Иначе	
				Коэффициент = ТекущаяСтрока[БудущийПериод[ИмяРесурса]];
			КонецЕсли;
			ДетальныеЗаписиДляИзменения.Добавить(ТекущаяСтрока);
			КоэффициентыПериода.Добавить(Коэффициент);
		КонецЕсли;			
			
		РаспределяемаяСумма = Результат[ИндексБудущийПериод];
		РезультатДетали		= РаспределитьСуммуПропорциональноКоэффициентам(
								РаспределяемаяСумма, КоэффициентыПериода, ТочностьОкругления);
				
		ИндексДетальныеЗаписи = 0;					
		Для каждого СтрокаДетали Из ДетальныеЗаписиДляИзменения Цикл
			СуммаДетали = РезультатДетали[ИндексДетальныеЗаписи];
			
			СтрокаДетали[БудущийПериод[ИмяРесурса]] = СтрокаДетали[БудущийПериод[ИмяРесурса]] + СуммаДетали;
			СтрокаДетали[ИмяРесурса + "Обработано"] = Истина;
			СтрокаДетали[ИмяРесурса] 				= 0;
			ИндексДетальныеЗаписи = ИндексДетальныеЗаписи + 1;
		КонецЦикла;	
		ИндексБудущийПериод = ИндексБудущийПериод + 1;
	КонецЦикла;
			
КонецПроцедуры

Функция СуммаИБазаРаспределения(КоллекцияСтрок, ИмяРесурса, ПараметрыРаспределения)

	БудущиеПериоды 			  = ПараметрыРаспределения.БудущиеПериоды;
	СпособАктуализации 		  = ПараметрыРаспределения.СпособАктуализации;
	ИсключитьПериодыБезПлана  = ПараметрыРаспределения.ИсключитьПериодыБезПлана;
	БазаПрофиля				  = ПараметрыРаспределения.БазаПрофиля;
	ОсновноеИзмерение		  = ПараметрыРаспределения.ОсновноеИзмерение;
	ИзмеренияАктуализации	  = ПараметрыРаспределения.ИзмеренияАктуализации;
	ПропускатьФактБольшеПлана = ПараметрыРаспределения.ПропускатьФактБольшеПлана;
	
	РесурсБазаРаспределения = ИмяРесурса + "БазаРаспределения";
	РесурсОтлонение			= ИмяРесурса + "Отклонение";
	РесурсФакт				= ИмяРесурса + "Факт";
	РесурсОстатокПлан		= ИмяРесурса + "ОстатокПлан";		
	
	Отклонение	  	  = КоллекцияСтрок[РесурсОтлонение];
	Запланировано	  = КоллекцияСтрок[РесурсОстатокПлан];
	БазаРаспределения = КоллекцияСтрок[РесурсБазаРаспределения];
	План			  = КоллекцияСтрок[ИмяРесурса];
	Факт			  = КоллекцияСтрок[РесурсФакт];
	
	ПланПрошлогоПериода = БазаРаспределения - Запланировано;
	НетДанных			= (ПланПрошлогоПериода = 0 И Факт = 0);
	Отказ = Ложь;
	
	Если НетДанных Тогда
		// Нет данных - распределять нечего.
		Отказ = Истина;			
	КонецЕсли;

	СуммаИБазаРаспределения = Новый Структура;
	СуммаИБазаРаспределения.Вставить("Коэффициенты", 	  Новый Массив);
	СуммаИБазаРаспределения.Вставить("МожноРаспределить", 0);
	СуммаИБазаРаспределения.Вставить("Отказ",			  Истина);
	СуммаИБазаРаспределения.Вставить("Результат",		  Новый Массив);
	
	ФактБольшеПлана = ((План - Запланировано) < Факт);
	Если ФактБольшеПлана И ПропускатьФактБольшеПлана Тогда
		Отказ = Истина;	
	КонецЕсли;

	Если Отказ Тогда
		Возврат СуммаИБазаРаспределения;
	КонецЕсли;	
	
	ЧастиИзмерений = Новый Массив;
	Для каждого КлючЗначение Из ИзмеренияАктуализации Цикл
		Если ЗначениеЗаполнено(КоллекцияСтрок[КлючЗначение.Ключ]) Тогда
			ПредставлениеЗначения = Строка(КоллекцияСтрок[КлючЗначение.Ключ]);
		Иначе	
			ПредставлениеЗначения = НСтр("ru = '<не заполнено>'");
		КонецЕсли;
		ОписаниеИзмерения = СтрШаблон("""%1"" (%2)", ПредставлениеЗначения, Строка(КлючЗначение.Значение));
		ЧастиИзмерений.Добавить(ОписаниеИзмерения);
	КонецЦикла;
	
	// Проверка, что отрицательное отлонение (по модолю) меньше или равно остатку плана.
	Если Отклонение < 0 И Запланировано < - Отклонение Тогда
		
		ЧастиИзмерений = Новый Массив;
		Для каждого КлючЗначение Из ИзмеренияАктуализации Цикл
			ОписаниеИзмерения = СтрШаблон("""%1"" (%2)", КоллекцияСтрок[КлючЗначение.Ключ], Строка(КлючЗначение.Значение));
			ЧастиИзмерений.Добавить(ОписаниеИзмерения);
		КонецЦикла;

		ВидУчета		 = ПредставлениеВидаУчета(ИмяРесурса);
		ЗапланированоСтр = ?(ИмяРесурса = "Сумма", Формат(Запланировано, "ЧДЦ=2; ЧН="), Формат(Запланировано, "ЧДЦ=3; ЧН=")); 
		ОтклонениеСтр	 = ?(ИмяРесурса = "Сумма", Формат(Отклонение, "ЧДЦ=2; ЧН="), Формат(Отклонение, "ЧДЦ=3; ЧН=")); 
		
		ТекстСообщения = НСтр("ru = 'Актуализировать %1 невозможно по причине: остаток запланированных средств в %2 выражении меньше отклонения. Остаток плана: %3, отклонение %4.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, СтрСоединить(ЧастиИзмерений, ", "), ВидУчета,  
							ЗапланированоСтр, ОтклонениеСтр);

		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;

	Если Отказ Тогда
		Возврат СуммаИБазаРаспределения;
	КонецЕсли;
	
	Коэффициенты 	  = Новый Массив;
	ИтогоКоэффициенты = 0;
	СчетчикПериодов   = 1;

	Для каждого БудущийПериод Из БудущиеПериоды Цикл
		Если СпособАктуализации = Перечисления.бит_СпособыАктуализации.Пропорционально Тогда 
			Коэффициент = КоллекцияСтрок[БудущийПериод[ИмяРесурса]];
		ИначеЕсли СпособАктуализации = Перечисления.бит_СпособыАктуализации.Равномерно Тогда	
			Если ИсключитьПериодыБезПлана И КоллекцияСтрок[БудущийПериод[ИмяРесурса]] = 0 Тогда
				Коэффициент = 0;
			Иначе	
				Коэффициент = 1;
			КонецЕсли;
		ИначеЕсли СпособАктуализации = Перечисления.бит_СпособыАктуализации.ПоПрофилю Тогда
			Коэффициент		  = 0;
			Если БазаПрофиля.Получить(СчетчикПериодов) <> Неопределено Тогда
				Коэффициент = БазаПрофиля.Получить(СчетчикПериодов);
				Если ИсключитьПериодыБезПлана И КоллекцияСтрок[БудущийПериод[ИмяРесурса]] = 0 Тогда
					Коэффициент = 0;
				КонецЕсли;
			КонецЕсли;
			СчетчикПериодов = СчетчикПериодов + 1; 
		КонецЕсли;
		ИтогоКоэффициенты = ИтогоКоэффициенты + Коэффициент;
		Коэффициенты.Добавить(Коэффициент);
	КонецЦикла;
	
	// Проверка, что итогова сумма коэффицентов по профилю равна 1.
	Если СпособАктуализации = Перечисления.бит_СпособыАктуализации.ПоПрофилю И ИтогоКоэффициенты <> 1 Тогда
		
		ИтогоКоэффициенты = 0;
		ВидУчета		  = ПредставлениеВидаУчета(ИмяРесурса);
		
		ТекстСообщения = НСтр("ru = 'Актуализировать %1 невозможно по причине: в периодах, попадающих в профиль распределения, нет запланированных средств в %2 выражении.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, СтрСоединить(ЧастиИзмерений, ", "), ВидУчета);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;	

	Если Отказ Тогда
		Возврат СуммаИБазаРаспределения;
	КонецЕсли;
	
	// Проверка, что есть база распределения.
	Если ИтогоКоэффициенты = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Актуализировать %1 невозможно по причине: коэффициенты базы распределения нулевые.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, СтрСоединить(ЧастиИзмерений, ", "));	
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат СуммаИБазаРаспределения;
	КонецЕсли;
	
	МожноРаспределить  = Отклонение;
	ТочностьОкругления = ?(ИмяРесурса = "Сумма", 2, 3);
	Результат		   = РаспределитьСуммуПропорциональноКоэффициентам(
							МожноРаспределить, Коэффициенты, ТочностьОкругления);
							
	// Проверка, что результат распределения отрицательного отклонения не будет превышать остаток ресурса в периоде.
	Если Отклонение < 0 Тогда
		ИндексПериода = 0;
		Для каждого БудущийПериод Из БудущиеПериоды Цикл
			ВеличинаОтклонения = - Результат[ИндексПериода]; 
			ПланПериода		   = КоллекцияСтрок[БудущийПериод[ИмяРесурса]];
			Если ВеличинаОтклонения > ПланПериода Тогда
				
				ВидУчета		 = ПредставлениеВидаУчета(ИмяРесурса);
				ЗапланированоСтр = ?(ИмяРесурса = "Сумма", Формат(ПланПериода, "ЧДЦ=2; ЧН="), Формат(ПланПериода, "ЧДЦ=3; ЧН=")); 
				ОтклонениеСтр	 = ?(ИмяРесурса = "Сумма", Формат(ВеличинаОтклонения, "ЧДЦ=2; ЧН="), Формат(ВеличинаОтклонения, "ЧДЦ=3; ЧН=")); 
				ПериодСтр 		 = Формат(БудущийПериод.Период, "ДЛФ=D");
				
				ТекстСообщения = НСтр("ru = 'Актуализировать %1 невозможно по причине: в периоде %2 остаток запланированных средств в %3 выражении меньше отклонения. Остаток плана: %4, отклонение %5.'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, СтрСоединить(ЧастиИзмерений, ", "), ПериодСтр, ВидУчета, ЗапланированоСтр, ОтклонениеСтр);	
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);			
			КонецЕсли;
			ИндексПериода = ИндексПериода + 1;
		КонецЦикла;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат СуммаИБазаРаспределения;	
	КонецЕсли;
	
	СуммаИБазаРаспределения.Коэффициенты 	  = Коэффициенты;
	СуммаИБазаРаспределения.МожноРаспределить = МожноРаспределить;
	СуммаИБазаРаспределения.Отказ  			  = Отказ;
	СуммаИБазаРаспределения.Результат  		  = Результат;
	
	Возврат СуммаИБазаРаспределения;

КонецФункции

#КонецОбласти

#КонецЕсли
