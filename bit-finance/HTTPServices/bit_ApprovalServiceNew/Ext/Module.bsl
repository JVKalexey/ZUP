		|</html>";
		
		ШаблонHTMLДокумента = СтрЗаменить(ШаблонHTMLДокумента, "%title%", Заголовок);
		ТелоHTMLДокумента  = ТелоHTMLДокумента(ОбъектСсылка, ДопАналитики);
		Результат = СтрЗаменить(ШаблонHTMLДокумента, "%body%", ТелоHTMLДокумента);
 	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТелоHTMLДокумента(ОбъектСсылка, ДопАналитики)
	
	ИменаТабличныхЧастей = ИменаТабличныхЧастей(ОбъектСсылка);
	Если НЕ ЗначениеЗаполнено(ИменаТабличныхЧастей) Тогда
		ТелоHTMLДокумента = НСтр("ru = '<h3>У объекта нет табличной части(ей).</h3>';
		                         |en = '<h3>The object does not have any table part(s).</h3>'");
		Возврат ТелоHTMLДокумента;
	КонецЕсли;

	МетаОбъект = ОбъектСсылка.Метаданные();
	
	ИсключитьСтолбцы = Новый Массив;
	ИсключитьСтолбцы.Добавить("ИД");
	ИсключитьСтолбцы.Добавить("ИД_Прогноз");
	ИсключитьСтолбцы.Добавить("ИДВладельца");
	ИсключитьСтолбцы.Добавить("КоэффициентРаспределения");
	ИсключитьСтолбцы.Добавить("УдалитьНазначениеПлатежа");
	ИсключитьСтолбцы.Добавить("Расчетная");
	ИсключитьСтолбцы.Добавить("Удалить_Сценарий");
	ИсключитьСтолбцы.Добавить("Служебный");
	
	// Обход табличных частей объекта.
	СтрокиТелаHTMLДокумента = Новый Массив;
	Для каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
		
		Попытка
			МетаТабличнаяЧасть = МетаОбъект.ТабличныеЧасти[ИмяТабличнойЧасти];
		Исключение
			ТелоHTMLДокумента = НСтр("ru = '<h3>Табличной части с именем ""%1"" не существует.</h3>';
			                         |en = '<h3>The table part named ""%1"" does not exist.</h3>'");
			ТелоHTMLДокумента = СтрШаблон(ТелоHTMLДокумента, ИмяТабличнойЧасти);
			Возврат ТелоHTMLДокумента;
		КонецПопытки;
		
		// Заголовок табличной части
		ЗаголовокТабличнойЧасти = "<h3>%1</h3>";
		ЗаголовокТабличнойЧасти = СтрШаблон(ЗаголовокТабличнойЧасти, МетаТабличнаяЧасть.Синоним);
		СтрокиТелаHTMLДокумента.Добавить(ЗаголовокТабличнойЧасти);
		
		// Табличная часть.
		СтрокиТелаHTMLДокумента.Добавить("<table>");
		
		// Добавление первой строки, названия колонок.
		СтрокиТелаHTMLДокумента.Добавить("<tr>");
		КолонкиТаблицы = Новый Массив;
		Для каждого КолонкаТаблицы Из МетаТабличнаяЧасть.Реквизиты Цикл
			
			Если НЕ ИсключитьСтолбцы.Найти(КолонкаТаблицы.Имя) = Неопределено 
				ИЛИ НЕ СтрНайти(КолонкаТаблицы.Имя, "_Старый") = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяКолонки = КолонкаТаблицы.Синоним;
			
			// Проверка на аналитику.
			НайденнаяАналитика = Неопределено;
			ДопАналитики.Свойство(КолонкаТаблицы.Имя, НайденнаяАналитика);
			Если ЗначениеЗаполнено(НайденнаяАналитика) Тогда
				Если НайденнаяАналитика.Используется Тогда
					ИмяКолонки = НайденнаяАналитика.Синоним;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ЗаголовокТаблицы = СтрШаблон("<th>%1</th>", ИмяКолонки);
			СтрокиТелаHTMLДокумента.Добавить(ЗаголовокТаблицы);
			
			КолонкиТаблицы.Добавить(КолонкаТаблицы.Имя);
		КонецЦикла;
		СтрокиТелаHTMLДокумента.Добавить("</tr>");
		
	    // Добавление строк с данными табличной части.
		Для каждого ТекущаяСтрока Из ОбъектСсылка[ИмяТабличнойЧасти] Цикл
			СтрокиТелаHTMLДокумента.Добавить("<tr>");
			Для каждого КолонкаТаблицы Из КолонкиТаблицы Цикл
				ДанныеКолонки = ТекущаяСтрока[КолонкаТаблицы];
				ДанныеКолонки = СтрШаблон("<td>%1</td>", ДанныеКолонки);
				СтрокиТелаHTMLДокумента.Добавить(ДанныеКолонки);
			КонецЦикла;
			СтрокиТелаHTMLДокумента.Добавить("</tr>");
		КонецЦикла;
		
		СтрокиТелаHTMLДокумента.Добавить("</table>");
		СтрокиТелаHTMLДокумента.Добавить("</br>");		
	КонецЦикла;

	ТелоHTMLДокумента = СтрСоединить(СтрокиТелаHTMLДокумента, Символы.ПС);
	
	Возврат ТелоHTMLДокумента;
	
КонецФункции

Функция ИменаТабличныхЧастей(ОбъектСсылка)
	
	ИменаТабличныхЧастей = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.бит_АктуализацияБюджета")
		ИЛИ ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.бит_ФормаВводаБюджета")
		ИЛИ ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.бит_КорректировкаБюджета") Тогда
		
		ИменаТабличныхЧастей.Добавить("БДДС");
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.бит_ВерсияОтчета") Тогда
		
		ИменаТабличныхЧастей.Добавить("ПараметрыХранение");
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.бит_ДополнительныеУсловияПоДоговору") Тогда
		
		ИменаТабличныхЧастей.Добавить("ГрафикПлатежей");
		ИменаТабличныхЧастей.Добавить("ГрафикНачислений");
		ИменаТабличныхЧастей.Добавить("ГрафикВыдачиТраншей");
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.бит_КорректировкаКонтрольныхЗначений") Тогда
		
		ИменаТабличныхЧастей.Добавить("УвеличениеЛимита");
		ИменаТабличныхЧастей.Добавить("УменьшениеЛимита");
	Иначе
		бит_МобильноеПриложениеПереопределяемый.ИменаТабличныхЧастей(ОбъектСсылка, ИменаТабличныхЧастей);
	КонецЕсли;
	
	Возврат ИменаТабличныхЧастей;

КонецФункции

#КонецОбласти

#Область ОстаткиПоБюджету

Функция ПолучитьОстаткиПоБюджету(ДанныеЗапроса)
	
	Если НЕ ТипЗнч(ДанныеЗапроса) = Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если бит_МобильноеПриложениеПереопределяемый.ЭтоСправочник(ДанныеЗапроса.ObjectType) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипДокумента            = ДанныеЗапроса.ObjectType;
	УникальныйИдентификатор = Новый УникальныйИдентификатор(ДанныеЗапроса.Id);
	ОбъектСсылка            = Документы[ТипДокумента].ПолучитьСсылку(УникальныйИдентификатор);
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДеревоИнформация = бит_МобильноеПриложениеПереопределяемый.ДанныеОбъекта(ОбъектСсылка);
	
	Если НЕ ЗначениеЗаполнено(ДеревоИнформация) Тогда
		ТекстСообщения = НСтр("ru = 'По данному объекту нет дополнительной информации.';
                              |en = 'There is no additional information on this property.'");
		Возврат ТекстСообщения;
	КонецЕсли;
	
	Результат = Новый Массив;
	Для каждого Строка Из ДеревоИнформация.Строки Цикл
		
		Если СтрСравнить(Строка.Имя, "СуммаДокумента") = 0 Тогда
			Имя      = "DocumentSums";
			Описание = Строка.ИмяПараметра;
		ИначеЕсли СтрСравнить(Строка.Имя, "СведенияОбОплате") = 0 Тогда
			Имя      = "PaymentDetails";
			Описание = Строка.ИмяПараметра;
		ИначеЕсли СтрСравнить(Строка.Имя, "ОстаткиПобюджету") = 0 Тогда
			Имя      = "Balances";
			Описание = Строка.ИмяПараметра;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Раздел = Новый Структура("Name, Description, Details", Имя, Описание);
		Детали = Новый Массив;
		
		Для каждого строка2 Из Строка.Строки Цикл
			Если строка2.ЭтоГруппа Тогда
				СтатьиОборотов = Новый Массив;
				Для каждого строка3 Из строка2.Строки Цикл
					Entry = Новый Структура("Name, Value", строка3.ИмяПараметра, Строка(строка3.ЗначениеПараметра));
					СтатьиОборотов.Добавить(Entry);
				КонецЦикла;
				Detail = Новый Структура("Name, Entries", строка2.ИмяПараметра, СтатьиОборотов);
			Иначе
				Detail = Новый Структура("Name, Value", строка2.ИмяПараметра, Строка(строка2.ЗначениеПараметра));
			КонецЕсли;
			Детали.Добавить(Detail);
		КонецЦикла;
		
		Раздел.Details = Детали;
		Результат.Добавить(Раздел);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

Функция ИнформацияОСервисеПолная()
	
	УстановитьПривилегированныйРежим(Истина);
	СисИнфо                                 = бит_ОбщегоНазначения.ПолучитьСведенияОПрограмме();
	ИнформацияОСервисе                      = Новый Структура("ServiceVersion, ConfigurationName, ConfigurationVersion");
	ИнформацияОСервисе.ServiceVersion       = ВерсияСервиса();
	ИнформацияОСервисе.ConfigurationName    = СисИнфо.Имя_1С;
	ИнформацияОСервисе.ConfigurationVersion = СисИнфо.НомерРелиза_1С;
	
	Возврат ИнформацияОСервисе;
	
КонецФункции

Функция ПолучитьСоставДопАналитик()
	
	ДопАналитики          = ПолучитьНазначенияДополнительныхИзмерений();
	МаксКолвоДопАналитик  = бит_МеханизмДопИзмерений.ПолучитьМаксимальноеКоличествоДополнительныхИзмерений();
	ДопАналитикиСтруктура = Новый Структура;
	
	Для Номер = 1 По МаксКолвоДопАналитик Цикл
		АналитикаСтруктура = Новый Структура("Синоним, Используется", "", Ложь);
		ДопАналитикиСтруктура.Вставить("Аналитика_"+Номер, АналитикаСтруктура);
	КонецЦикла;
	
	Для каждого Аналитика Из ДопАналитики Цикл
		Если НЕ ДопАналитикиСтруктура.Свойство(Аналитика) = Неопределено Тогда
			ДопАналитикиСтруктура[Аналитика.Name].Синоним = Аналитика.Description;
			ДопАналитикиСтруктура[Аналитика.Name].Используется = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДопАналитикиСтруктура;
	
КонецФункции

Функция ДополнительныеРеквизитыОбъекта(ОбъектСсылка)
	
	// N.B. Требуется рефакторинг.
	МетаОбъект  = ОбъектСсылка.Метаданные();
	Результат   = Новый Массив;
	ИмяТаблицы  = "ДополнительныеРеквизиты";
	МетаТаблица = МетаОбъект.ТабличныеЧасти.Найти(ИмяТаблицы);
	Если НЕ МетаТаблица = Неопределено Тогда
		Для каждого ТекущаяСтрока Из ОбъектСсылка[ИмяТаблицы] Цикл
			// Мобильное приложение чувствительно к регистру ключей этой структуры!!!!
			ДополнительныйРеквизит             = Новый Структура("ID, Description, Value");
			ДополнительныйРеквизит.Id          = XMLСтрока(ТекущаяСтрока.Свойство);
			ДополнительныйРеквизит.Description = ТекущаяСтрока.Свойство.Заголовок;
			ДополнительныйРеквизит.Value       = Строка(ТекущаяСтрока.Значение);
			Результат.Добавить(ДополнительныйРеквизит);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

