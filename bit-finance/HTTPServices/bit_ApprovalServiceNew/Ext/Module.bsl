// 
// Возвращаемое значение:
//  HTTPСервисОтвет - Ответ с информацией в теле, см. общий макет бит_ОписаниеСервисаМобильногоВизирования.
//
Функция ВложенияОбъекта(Запрос)
	
	ИмяСобытия = НСтр("ru = 'approval/v1/object_file_data'; en = 'approval/v1/object_file_data'",
