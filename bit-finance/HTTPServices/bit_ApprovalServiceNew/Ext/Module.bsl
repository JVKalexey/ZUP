// Обработчик метода POST /v1/task/{Action}/.
// Применить действие к задаче (Создать, Обновить, Принять, Выполнить).
//
// Параметры:
//  Запрос	 - HTTPСервисЗапрос	 - Запрос от мобильного приложения,
//  	см. общий макет бит_ОписаниеСервисаМобильногоВизирования.
// 
// Возвращаемое значение:
//  HTTPСервисОтвет - Ответ с информацией в теле см. общий макет бит_ОписаниеСервисаМобильногоВизирования.
//
Функция ДействиеСЗадачей(Запрос)
	
	ИмяСобытия = НСтр("ru = 'approval/v1/task'; en = 'approval/v1/task'", ОбщегоНазначения.КодОсновногоЯзыка());
	Action     = Запрос.ПараметрыURL.Получить("Action");
	Ответ      = Неопределено;
	Если Константы.бит_РежимОтладкиВебСервисов.Получить() Тогда
		ТекстСообщения = НСтр("ru = 'HTTP-сервис bit_ApprovalServiceNew. Вызов метода Task.
                               |Действие: %1';
                               |en = 'HTTP service bit_ApprovalServiceNew. Call the Task method.
                               |Action: %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Action);
		ЗарегистрироватьИнформацию(ИмяСобытия, ТекстСообщения);
	КонецЕсли;
	
	Если СтрСравнить(Action, "accept") = 0 Тогда
		Ответ = ПринятьЗадачуЗапрос(Запрос);
	ИначеЕсли СтрСравнить(Action, "perform") = 0 Тогда
		Ответ = ВыполнитьЗадачуЗапрос(Запрос);
	ИначеЕсли СтрСравнить(Action, "update") = 0 Тогда
		Ответ = ОбновитьЗадачуЗапрос(Запрос);
	ИначеЕсли СтрСравнить(Action, "create") = 0 Тогда
		Ответ = СоздатьЗадачуЗапрос(Запрос);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

