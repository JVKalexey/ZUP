		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_СобственныеКонтрагенты.Контрагент
ПОМЕСТИТЬ СобствКонтрагенты
ИЗ
	РегистрСведений.бит_СобственныеКонтрагенты КАК бит_СобственныеКонтрагенты
ГДЕ
	бит_СобственныеКонтрагенты.ВидСвязи = ЗНАЧЕНИЕ(Перечисление.бит_ВидыСобственныхКонтрагентов.Организация)
	И бит_СобственныеКонтрагенты.Объект В
			(ВЫБРАТЬ
				СоставПериметра.Организация
			ИЗ
				РегистрСведений.бит_му_СоставПериметровКонсолидации.СрезПоследних(&amp;КонецПериода, ПериметрКонсолидации = &amp;ПериметрКонсолидации) КАК СоставПериметра
			ГДЕ
				(КОНЕЦПЕРИОДА(СоставПериметра.ДатаОкончания, ДЕНЬ) &gt;= &amp;КонецПериодаДата
					ИЛИ СоставПериметра.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
				И СоставПериметра.ТипКонсолидации = ЗНАЧЕНИЕ(Перечисление.бит_му_ТипыКонсолидации.Обычная))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_му_ВыбытиеОСОбороты.Регистратор КАК ДокументВыбытия,
	СобствКонтрагенты.Контрагент КАК Контрагент,
	бит_му_ВыбытиеОСОбороты.Организация,
	//++ ЕРП
	//ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ИнвентарныйНомер,
	бит_му_ВыбытиеОСОбороты.ОсновноеСредство.ИнвентарныйНомер КАК ИнвентарныйНомер,
	//-- ЕРП
	бит_му_ВыбытиеОСОбороты.ОсновноеСредство,
	бит_му_ВыбытиеОСОбороты.СтоимостьМУОборот КАК СтоимостьМУ,
	бит_му_ВыбытиеОСОбороты.СтоимостьУпрОборот КАК СтоимостьУпр,
	бит_му_ВыбытиеОСОбороты.СтоимостьРеглОборот КАК СтоимостьРегл,
	бит_му_ВыбытиеОСОбороты.СебестоимостьМУОборот КАК СебестоимостьМУ,
	бит_му_ВыбытиеОСОбороты.СебестоимостьУпрОборот КАК СебестоимостьУпр,
	бит_му_ВыбытиеОСОбороты.СебестоимостьРеглОборот КАК СебестоимостьРегл,
	бит_му_ВыбытиеОСОбороты.СтоимостьМУОборот - бит_му_ВыбытиеОСОбороты.СебестоимостьМУОборот КАК ОклонениеАбсолютноеМУ,
	бит_му_ВыбытиеОСОбороты.СтоимостьУпрОборот - бит_му_ВыбытиеОСОбороты.СебестоимостьУпрОборот КАК ОклонениеАбсолютноеУпр,
	бит_му_ВыбытиеОСОбороты.СтоимостьРеглОборот - бит_му_ВыбытиеОСОбороты.СебестоимостьРеглОборот КАК ОклонениеАбсолютноеРегл,
	ВЫБОР
		КОГДА бит_му_ВыбытиеОСОбороты.СебестоимостьМУОборот &lt;&gt; 0
			ТОГДА 100 * (бит_му_ВыбытиеОСОбороты.СтоимостьМУОборот - бит_му_ВыбытиеОСОбороты.СебестоимостьМУОборот) / бит_му_ВыбытиеОСОбороты.СебестоимостьМУОборот
		ИНАЧЕ ВЫБОР
				КОГДА бит_му_ВыбытиеОСОбороты.СтоимостьМУОборот &lt;&gt; 0
					ТОГДА -100
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК ОклонениеОтносительноеМУ,
	ВЫБОР
		КОГДА бит_му_ВыбытиеОСОбороты.СебестоимостьУпрОборот &lt;&gt; 0
			ТОГДА 100 * (бит_му_ВыбытиеОСОбороты.СтоимостьУпрОборот - бит_му_ВыбытиеОСОбороты.СебестоимостьУпрОборот) / бит_му_ВыбытиеОСОбороты.СебестоимостьУпрОборот
		ИНАЧЕ ВЫБОР
				КОГДА бит_му_ВыбытиеОСОбороты.СтоимостьУпрОборот &lt;&gt; 0
					ТОГДА -100
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК ОклонениеОтносительноеУпр,
	ВЫБОР
		КОГДА бит_му_ВыбытиеОСОбороты.СебестоимостьРеглОборот &lt;&gt; 0
			ТОГДА 100 * (бит_му_ВыбытиеОСОбороты.СтоимостьРеглОборот - бит_му_ВыбытиеОСОбороты.СебестоимостьРеглОборот) / бит_му_ВыбытиеОСОбороты.СебестоимостьРеглОборот
		ИНАЧЕ ВЫБОР
				КОГДА бит_му_ВыбытиеОСОбороты.СтоимостьРеглОборот &lt;&gt; 0
					ТОГДА -100
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК ОклонениеОтносительноеРегл
{ВЫБРАТЬ
	Контрагент}
ИЗ
	РегистрНакопления.бит_му_ВыбытиеОС.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор,
			Организация В
				(ВЫБРАТЬ
					СоставПериметра.Организация
				ИЗ
					РегистрСведений.бит_му_СоставПериметровКонсолидации.СрезПоследних(&amp;КонецПериода, ПериметрКонсолидации = &amp;ПериметрКонсолидации) КАК СоставПериметра
				ГДЕ
					(КОНЕЦПЕРИОДА(СоставПериметра.ДатаОкончания, ДЕНЬ) &gt;= &amp;КонецПериодаДата
						ИЛИ СоставПериметра.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
					И СоставПериметра.ТипКонсолидации = ЗНАЧЕНИЕ(Перечисление.бит_му_ТипыКонсолидации.Обычная))) КАК бит_му_ВыбытиеОСОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ СобствКонтрагенты КАК СобствКонтрагенты
		ПО бит_му_ВыбытиеОСОбороты.Контрагент = СобствКонтрагенты.Контрагент
		//++ ЕРП
		//ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(&amp;КонецПериода, ) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
		//ПО бит_му_ВыбытиеОСОбороты.ОсновноеСредство = ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
		//-- ЕРП
{ГДЕ
	СобствКонтрагенты.Контрагент}
;

