&НаКлиенте
Функция ПараметрыПереходаКНовомуОтчету()

	ПараметрыПередачи = бит_ОтчетыКлиент.ПараметрыПереходаКНовомуОтчету(); 
	ПараметрыПередачи.КлючОбъекта  = "бит_СценарноеПрогнозирование";
