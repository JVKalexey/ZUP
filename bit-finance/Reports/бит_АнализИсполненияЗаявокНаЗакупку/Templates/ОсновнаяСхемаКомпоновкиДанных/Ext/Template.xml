		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПланируемыеЗатратыОстаткиИОбороты.ДокументПланирования,
	ПланируемыеЗатратыОстаткиИОбороты.Номенклатура,
	ПланируемыеЗатратыОстаткиИОбороты.Организация,
	ПланируемыеЗатратыОстаткиИОбороты.ЗаявкаНаЗатраты,
	СУММА(ЕСТЬNULL(ПланируемыеЗатратыОстаткиИОбороты.КоличествоПриход, 0)) КАК КоличествоЗаявлено,
	СУММА(ЕСТЬNULL(ПланируемыеЗатратыОстаткиИОбороты.СуммаПриход, 0)) КАК СуммаЗаявлено,
	ПланируемыеЗатратыОстаткиИОбороты.Характеристика
ПОМЕСТИТЬ остатки
ИЗ
	РегистрНакопления.бит_пз_ПланируемыеЗатраты.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ТИПЗНАЧЕНИЯ(ДокументПланирования) = ТИП(Документ.бит_пз_ЗаявкаНаЗатраты)) КАК ПланируемыеЗатратыОстаткиИОбороты

СГРУППИРОВАТЬ ПО
	ПланируемыеЗатратыОстаткиИОбороты.ДокументПланирования,
	ПланируемыеЗатратыОстаткиИОбороты.ЗаявкаНаЗатраты,
	ПланируемыеЗатратыОстаткиИОбороты.Номенклатура,
	ПланируемыеЗатратыОстаткиИОбороты.Организация,
	ПланируемыеЗатратыОстаткиИОбороты.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПланируемыеЗатратыОстаткиИОбороты.Номенклатура,
	ПланируемыеЗатратыОстаткиИОбороты.Организация,
	ПланируемыеЗатратыОстаткиИОбороты.ЗаявкаНаЗатраты,
	СУММА(ЕСТЬNULL(ПланируемыеЗатратыОстаткиИОбороты.КоличествоРасход, 0)) КАК КоличествоИсполнено,
	СУММА(ЕСТЬNULL(ПланируемыеЗатратыОстаткиИОбороты.СуммаРасход, 0)) КАК СуммаИсполнено,
	ПланируемыеЗатратыОстаткиИОбороты.Характеристика
ПОМЕСТИТЬ факт
ИЗ
	РегистрНакопления.бит_пз_ПланируемыеЗатраты.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, , ) КАК ПланируемыеЗатратыОстаткиИОбороты
ГДЕ
	ТИПЗНАЧЕНИЯ(ПланируемыеЗатратыОстаткиИОбороты.Регистратор) = ТИП(Документ.бит_пз_ОтражениеФактаЗатрат)

СГРУППИРОВАТЬ ПО
	ПланируемыеЗатратыОстаткиИОбороты.Номенклатура,
	ПланируемыеЗатратыОстаткиИОбороты.Организация,
	ПланируемыеЗатратыОстаткиИОбороты.ЗаявкаНаЗатраты,
	ПланируемыеЗатратыОстаткиИОбороты.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПланируемыеЗатратыОстаткиИОбороты.Номенклатура,
	ПланируемыеЗатратыОстаткиИОбороты.Организация,
	ПланируемыеЗатратыОстаткиИОбороты.ЗаявкаНаЗатраты,
	СУММА(ЕСТЬNULL(ПланируемыеЗатратыОстаткиИОбороты.КоличествоПриход, 0)) КАК КоличествоВключеноВСводнуюЗаявку,
	СУММА(ЕСТЬNULL(ПланируемыеЗатратыОстаткиИОбороты.СуммаПриход, 0)) КАК СуммаВключеноВСводнуюЗаявку,
	ПланируемыеЗатратыОстаткиИОбороты.Характеристика
ПОМЕСТИТЬ сводная
ИЗ
	РегистрНакопления.бит_пз_ПланируемыеЗатраты.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ТИПЗНАЧЕНИЯ(ДокументПланирования) = ТИП(Документ.бит_пз_СводнаяЗаявкаНаЗатраты)) КАК ПланируемыеЗатратыОстаткиИОбороты

СГРУППИРОВАТЬ ПО
	ПланируемыеЗатратыОстаткиИОбороты.Организация,
	ПланируемыеЗатратыОстаткиИОбороты.Номенклатура,
	ПланируемыеЗатратыОстаткиИОбороты.ЗаявкаНаЗатраты,
	ПланируемыеЗатратыОстаткиИОбороты.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	остатки.Номенклатура,
	остатки.Организация,
	остатки.ЗаявкаНаЗатраты,
	ЕСТЬNULL(остатки.КоличествоЗаявлено, 0) - ЕСТЬNULL(факт.КоличествоИсполнено, 0) КАК КоличествоОстаток,
	ЕСТЬNULL(остатки.СуммаЗаявлено, 0) - ЕСТЬNULL(факт.СуммаИсполнено, 0) КАК СуммаОстаток,
	ЕСТЬNULL(остатки.КоличествоЗаявлено, 0) КАК КоличествоЗаявлено,
	ЕСТЬNULL(остатки.СуммаЗаявлено, 0) КАК СуммаЗаявлено,
	остатки.ЗаявкаНаЗатраты.ЖелаемаяДатаПоступления КАК ЖелаемаяДатаПоступления,
	остатки.ЗаявкаНаЗатраты.Важность КАК Важность,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(остатки.Номенклатура) = ТИП(Справочник.Номенклатура)
			ТОГДА остатки.Номенклатура.ЕдиницаИзмерения
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	КОНЕЦ КАК ЕдиницаИзмерения,
	ЕСТЬNULL(сводная.КоличествоВключеноВСводнуюЗаявку, 0) КАК КоличествоВключеноВСводнуюЗаявку,
	ЕСТЬNULL(сводная.СуммаВключеноВСводнуюЗаявку, 0) КАК СуммаВключеноВСводнуюЗаявку,
	ЕСТЬNULL(факт.КоличествоИсполнено, 0) КАК КоличествоИсполнено,
	ЕСТЬNULL(факт.СуммаИсполнено, 0) КАК СуммаИсполнено,
	СтатусыОбъектов.Статус,
	остатки.Характеристика
ИЗ
	остатки КАК остатки
		ЛЕВОЕ СОЕДИНЕНИЕ факт КАК факт
		ПО остатки.Номенклатура = факт.Номенклатура
			И остатки.Организация = факт.Организация
