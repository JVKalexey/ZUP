	бит_Задача.БизнесПроцесс,
	бит_Задача.ТочкаМаршрута,
	бит_Задача.Наименование,
	бит_Задача.Выполнена,
	бит_Задача.Автор,
	бит_Задача.Важность,
	бит_Задача.СрокИсполнения,
	бит_Задача.ДатаПринятияКИсполнению,
	бит_Задача.ДатаНачалаИсполнения,
	бит_Задача.ДатаОкончанияИсполнения,
	бит_Задача.Описание,
	бит_Задача.РезультатВыполнения,
	бит_Задача.Предмет,
	бит_Задача.Состояние,
	бит_Задача.СостояниеПредыдущее,
	бит_Задача.ЗадачаОснование,
	бит_Задача.Алгоритм,
	бит_Задача.АлгоритмПодчиненный,
	бит_Задача.ТочкаАлгоритма,
	бит_Задача.ЭтоПроверочнаяЗадача,
	бит_Задача.Исполнитель,
	бит_Задача.РольИсполнителя,
	бит_Задача.ОбъектАдресации_1,
	бит_Задача.ОбъектАдресации_2,
	бит_Задача.ОбъектАдресации_3,
	1 КАК Количество,
	ВЫБОР
		КОГДА бит_Задача.СрокИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
					КОГДА бит_Задача.ДатаОкончанияИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
							И бит_Задача.ДатаОкончанияИсполнения &gt; бит_Задача.СрокИсполнения
						ТОГДА ИСТИНА
					КОГДА бит_Задача.ДатаОкончанияИсполнения = ДАТАВРЕМЯ(1, 1, 1)
							И &amp;ТекущаяДата &gt; бит_Задача.СрокИсполнения
						ТОГДА ИСТИНА
					ИНАЧЕ ЛОЖЬ
				КОНЕЦ
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Просрочено
ИЗ
	Задача.бит_Задача КАК бит_Задача
ГДЕ
	ВЫБОР
			КОГДА &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			КОГДА &amp;НачалоПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА бит_Задача.Дата &gt;= &amp;НачалоПериода
			КОГДА &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА бит_Задача.Дата &lt;= &amp;КонецПериода
			КОГДА &amp;НачалоПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА бит_Задача.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
		КОНЕЦ</query>
