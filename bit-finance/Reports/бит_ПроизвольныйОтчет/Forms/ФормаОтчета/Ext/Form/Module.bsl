&НаСервере
Процедура ЗаполнитьОтборВОтчете()
	
	ИзмененыНастройки = Истина;	
	СпособКомпоновки  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет.НастройкаОтчета, "СпособКомпоновки");
	КопияОтборВОтчете = Отчет.ОтборВОтчете.Выгрузить();
	
	бит_МеханизмПолученияДанных.ЗаполнитьОтборВОтчете(СпособКомпоновки, КопияОтборВОтчете);	
