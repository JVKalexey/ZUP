&НаСервере
Процедура ИзменениеСодержимогоОбласти(ИмяОбласти,ТекЗначение)
	
	СтрОтбор = Новый Структура("ИмяОбласти",ИмяОбласти); 
	
	МассивСтрок = Отчет.ТаблицаДанныеОтчета.НайтиСтроки(СтрОтбор);
	
	НовоеЗначение = ТекЗначение;
	
	// Есть строки данных, соответствующие на данной области.
	Если МассивСтрок.Количество()>0 Тогда
		
		Если ТекЗначение = 0 Тогда
			// Удаляем данные
			Для каждого Элемент Из МассивСтрок Цикл
				Отчет.ТаблицаДанныеОтчета.Удалить(Элемент);
			КонецЦикла; 
		Иначе	
			
			// Пропорционально изменяем данные
			ИтСумма = 0;
			
			Для каждого СтрокаТаблицы Из МассивСтрок Цикл
				ИтСумма = ИтСумма+СтрокаТаблицы.ЗначениеПоказателя;
			КонецЦикла; 
			
			ИтСуммаНов = 0;
			
			Для каждого СтрокаТаблицы Из МассивСтрок Цикл
				Коэфф = ?(ИтСумма <> 0, СтрокаТаблицы.ЗначениеПоказателя/ИтСумма, 0);
				
				СтрокаТаблицы.ЗначениеПоказателя  = НовоеЗначение * Коэфф;
				СтрокаТаблицы.РучнаяКорректировка = Истина;				
				
				ИтСуммаНов = ИтСуммаНов + СтрокаТаблицы.ЗначениеПоказателя;
			КонецЦикла; 
			
			Дельта = НовоеЗначение-ИтСуммаНов;
			
			Если Дельта <> 0 Тогда
				СтрокаТаблицы.ЗначениеПоказателя  = СтрокаТаблицы.ЗначениеПоказателя+Дельта;
				СтрокаТаблицы.РучнаяКорректировка = Истина;
			КонецЕсли; 
		КонецЕсли; 
	Иначе
		
		// В таблице данных нет строк данных, соответствующих данной области.
		НоваяСтрока = Отчет.ТаблицаДанныеОтчета.Добавить();
		НоваяСтрока.ЗначениеПоказателя  = ТекЗначение;
		НоваяСтрока.РучнаяКорректировка = Истина;
		
		ЗаполнитьНовуюСтроку(НоваяСтрока.ПолучитьИдентификатор(),ИмяОбласти);
		
	КонецЕсли; 
	
	бит_МеханизмПолученияДанных.ВыполнитьРасчет(Отчет.НастройкаОтчета,Результат,Отчет.ТаблицаДанныеОтчета);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНовуюСтроку(ИдСтроки,ИмяОбласти)
	
	ТекущаяСтрока = Отчет.ТаблицаДанныеОтчета.НайтиПоИдентификатору(ИдСтроки);
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		
		
		бит_МеханизмПолученияДанных.ЗаполнитьНовуюСтрокуТаблицыДанных(ТекущаяСтрока
		                                                                , ИмяОбласти
																		, Отчет.ТаблицаДанныеОтчета
																		, Отчет.НастройкаОтчета
																		, Отчет.ФорматЧисел
																		, Отчет.Язык);
		
		// Заполнение значений по-умолчанию
		ЗначенияПоУмолчанию = Новый Структура;
		Для каждого КиЗ Из ЗначенияПоУмолчанию Цикл
			ИмяАналитики = КиЗ.Ключ;
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока[ИмяАналитики]) Тогда
				ТекущаяСтрока[ИмяАналитики] = КиЗ.Значение;
			КонецЕсли; 
		КонецЦикла; // Заполнение значений по-умолчанию
	КонецЕсли; 
	
КонецПроцедуры // ЗаполнитьНовуюСтроку()

&НаКлиенте
Процедура НачатьФормированиеОтчета()

	Отказ = Ложь;
	
	ПериодЗаполненПравильно = бит_ОбщегоНазначенияКлиентСервер.ВременнойИнтервалКорректный(
								Отчет.СтандартныйПериод.ДатаНачала, Отчет.СтандартныйПериод.ДатаОкончания);
								
	Если НЕ ПериодЗаполненПравильно Тогда
		Отказ = Истина;	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Отчет.НастройкаОтчета) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("ПОЛЕ" , "Заполнение", НСтр("ru = 'Настройка'; en = 'adjustment'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "НастройкаОтчета", "Отчет", Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененыНастройки = Ложь;
	ОбработатьИзменениеНастроек(ЭтотОбъект);

	ДлительнаяОперация = ЗапуститьОтложенноеФормированиеОтчета();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения 	   = НСтр("ru = 'Идет формирование отчета...'"); 
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтложенноеФормированиеОтчетаЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ЗапуститьОтложенноеФормированиеОтчета()
		
	НаименованиеЗадания = НСтр("ru = 'Формирование произвольного отчета.'; en = 'Generating a Custom report'");
	ВыполняемыйМетод	= "Отчеты.бит_ПроизвольныйОтчет.РезультатФормированияОтчета";

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	
	ПараметрыЗаполнения = Отчеты.бит_ПроизвольныйОтчет.НовыеПараметрыФормированияОтчета();
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, Отчет);
	
	ПараметрыЗаполнения.ОтборВОтчете 		= Отчет.ОтборВОтчете.Выгрузить();
	ПараметрыЗаполнения.ТаблицаПараметры	= Отчет.ТаблицаПараметры.Выгрузить();
	ПараметрыЗаполнения.ТаблицаДанныеОтчета = Отчет.ТаблицаДанныеОтчета.Выгрузить();
	ПараметрыЗаполнения.ДатаНачала			= Отчет.СтандартныйПериод.ДатаНачала;
	ПараметрыЗаполнения.ДатаОкончания		= Отчет.СтандартныйПериод.ДатаОкончания;
	ПараметрыЗаполнения.Результат			= Результат;
	
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ВыполняемыйМетод, 
						ПараметрыЗаполнения);
						
	Возврат ФоновоеЗадание;

КонецФункции

&НаКлиенте
Процедура ОтложенноеФормированиеОтчетаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыполнения.Статус = "Ошибка" Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка при выполнении, по причине: %1'"); 
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(ТекстСообщения, РезультатВыполнения.КраткоеПредставлениеОшибки));
	Иначе	
		ОтложенноеФормированиеОтчетаЗавершениеНаСервере(РезультатВыполнения.АдресРезультата);
	КонецЕсли; 
	
	Для каждого Сообщение Из РезультатВыполнения.Сообщения Цикл
		ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение.Текст, Сообщение.КлючДанных);		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ОтложенноеФормированиеОтчетаЗавершениеНаСервере(АдресРезультата)

	РезультатФормирования = ПолучитьИзВременногоХранилища(АдресРезультата);
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Результат = РезультатФормирования.Результат;
	Отчет.ТаблицаДанныеОтчета.Загрузить(РезультатФормирования.ДанныеОтчета);
	
КонецПроцедуры

