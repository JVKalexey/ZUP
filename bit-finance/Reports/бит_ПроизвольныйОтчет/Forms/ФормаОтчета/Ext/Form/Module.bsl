
#Область ОписаниеПеременных

&НаКлиенте
Перем мТекущийВидПараметра; // Служит для передачи вида параметра между обработчиками.

&НаКлиенте
Перем СоответствиеРезультатов; // Хранит соответствие результатов формирования отчета.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПодготовитьФормуНаСервере(Отказ);
	бит_ИскусственныйИнтеллект.ДобавитьКомандыВзаимодействия(ЭтотОбъект, Элементы.ПодменюОтправить);
															
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если СформироватьПриОткрытии Тогда
		ПодключитьОбработчикОжидания("ОжиданиеЗавершенияОткрытияФормы", 0.5, Истина); 	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "АктивизироватьОбласть" И Источник = УникальныйИдентификатор Тогда
		АктивизироватьОбласть(Параметр);
	ИначеЕсли ИмяСобытия = "ИзменениеПериода" И Параметр = УникальныйИдентификатор Тогда
		ИзмененыНастройки = Истина;
		ОбработатьИзменениеНастроек(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
	БухгалтерскиеОтчетыКлиент.НачатьРасчетСуммыВыделенныхЯчеек(
		Элементы.Результат,
		ЭтотОбъект,
		"Подключаемый_РезультатПриАктивизацииПодключаемый");
	
КонецПроцедуры // РезультатПриАктивизацииОбласти()

&НаКлиенте
Процедура РезультатПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	Если Область.СодержитЗначение 
		 И ТипЗнч(Область.Значение) = Тип("Число") Тогда
		 
		ИзменениеСодержимогоОбласти(Область.Имя,Область.Значение);
			
	КонецЕсли;
	
КонецПроцедуры // РезультатПриИзмененииСодержимогоОбласти()

&НаКлиенте
Процедура НастройкаПулаПодключенийПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КурсПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	ИзменениеВалютыСервер();
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОтчетаПриИзменении(Элемент)
	
	НастройкаОтчетаПриИзмененииНаСервере();
	
	ИзмененыНастройки = Истина;
	ОбработатьИзменениеНастроек(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЯзыкПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматЧиселПриИзменении(Элемент)
	
	бит_МеханизмПолученияДанныхВызовСервера.УстановитьФорматВывода(
		Отчет.НастройкаОтчета, Результат, Отчет.ФорматЧисел, Отчет.Язык);
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматЧиселНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	КонструктовФормата = Новый КонструкторФорматнойСтроки(Отчет.ФорматЧисел);
	
	КонструктовФормата.ДоступныеТипы = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,2));
	
	ДопПараметры = Новый Структура("КонструктовФормата", КонструктовФормата);
	ОбработчикКФ = Новый ОписаниеОповещения("КонструктовФорматаОткрытьЗавершение", ЭтотОбъект, ДопПараметры);
	КонструктовФормата.Показать(ОбработчикКФ);
		
КонецПроцедуры

// Обработчик завершения редактирования форматной строки.
//  См. Синтакс-помощник: КонструкторФорматнойСтроки.Показать().
//
&НаКлиенте
Процедура КонструктовФорматаОткрытьЗавершение(НастройкиФормата, ДопПараметры) Экспорт
	
	Если НастройкиФормата <> Неопределено Тогда
		Отчет.ФорматЧисел = ДопПараметры.КонструктовФормата.Текст;
		бит_МеханизмПолученияДанныхВызовСервера.УстановитьФорматВывода(Отчет.НастройкаОтчета, 
			Результат, Отчет.ФорматЧисел, Отчет.Язык);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияОднаДатаПриИзменении(Элемент)
	
	ОпределитьДатуНачалаДляМСФО();
	ИзмененыНастройки = Истина;
	ОбработатьИзменениеНастроек(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	ОбработатьИзменениеНастроек(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	ОбработатьИзменениеНастроек(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УстановитьЗаголовокОрганизации(ЭтотОбъект);
	
	ИзмененыНастройки = Истина;
	ОбработатьИзменениеНастроек(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	бит_РаботаСДиалогамиКлиент.НачалоВыбораСоставного(ЭтотОбъект, Элемент, Отчет, "Организация",
		СписокТиповОрганизация,СтандартнаяОбработка);
													   
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	Элемент.ВыбиратьТип = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалятьПримечанияПриИзменении(Элемент)
	
	ВыполнитьУдалениеПримечаний();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтборВОтчете

&НаКлиенте
Процедура ОтборВОтчетеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = Элементы.ОтборВОтчете.ТекущиеДанные;	
	
	Если ТекущаяСтрока.Значение = Неопределено Тогда
		Элементы.ОтборВОтчетеЗначение.ВыбиратьТип = Истина;
	Иначе	
		Элементы.ОтборВОтчетеЗначение.ВыбиратьТип = Ложь;
	КонецЕсли;
	
	Если НЕ НоваяСтрока Тогда
		бит_МеханизмПолученияДанныхКлиентСервер.УстановитьСвойствоВыборГруппИЭлементов(Элементы.ОтборВОтчетеЗначение, 
			ТекущаяСтрока.ВидСравнения);
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура ОтборВОтчетеВидСравненияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОтборВОтчете.ТекущиеДанные;
	ОтборВОтчетеВидСравненияПриИзмененииСервер(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВОтчетеЗначениеОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.ОтборВОтчетеЗначение.ВыбиратьТип = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВОтчетеЗначениеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОтборВОтчете.ТекущиеДанные;
	ОтборВОтчетеЗначениеПриИзмененииСервер(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВОтчетеПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПараметры

&НаКлиенте
Процедура ТаблицаПараметрыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ТаблицаПараметры.ТекущиеДанные;	 	
	
	Если НоваяСтрока И НЕ Копирование Тогда  		
		ТекущиеДанные.ВидПараметра = ПредопределенноеЗначение("Перечисление.бит_ВидыПараметровЗапроса.Значение");   			
	КонецЕсли; 
	
	мТекущийВидПараметра = ТекущиеДанные.ВидПараметра;
	
	ОграничитьОписаниеТиповПараметра();
	
КонецПроцедуры // ТаблицаПараметрыПриНачалеРедактирования()

&НаКлиенте
Процедура ТаблицаПараметрыВидПараметраПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаПараметры.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ИД = Элементы.ТаблицаПараметры.ТекущиеДанные.ПолучитьИдентификатор();
		ИзменитьВидПараметра(ИД, мТекущийВидПараметра);
		
		мТекущийВидПараметра = ТекущиеДанные.ВидПараметра;
		
		ОграничитьОписаниеТиповПараметра();
				
	КонецЕсли;
	
КонецПроцедуры // ТаблицаПараметрыВидПараметраПриИзменении()

&НаКлиенте
Процедура ТаблицаПараметрыЗначениеПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные        = Элементы.ТаблицаПараметры.ТекущиеДанные;	
	мТекущийВидПараметра = ТекущиеДанные.ВидПараметра;
	
	Если мТекущийВидПараметра = ПредопределенноеЗначение("Перечисление.бит_ВидыПараметровЗапроса.Выражение") Тогда  		
		СтандартнаяОбработка = Ложь;			
	КонецЕсли;
	
КонецПроцедуры // ТаблицаПараметрыЗначениеПараметраНачалоВыбора()

&НаКлиенте
Процедура ТаблицаПараметрыЗначениеПараметраОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаПараметры.ТекущиеДанные;
	
	Если ТекущиеДанные.ВидПараметра = ПредопределенноеЗначение("Перечисление.бит_ВидыПараметровЗапроса.Значение") Тогда		
		Элементы.ТаблицаПараметрыЗначениеПараметра.ВыбиратьТип = Истина;
	КонецЕсли;
	
КонецПроцедуры // ТаблицаПараметрыЗначениеПараметраОчистка()

&НаКлиенте
Процедура ТаблицаПараметрыПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
		
	СкрытьНастройки();
	ОчиститьСообщения();
	НачатьФормированиеОтчета();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПериод(Команда)
	
	бит_РаботаСДиалогамиКлиент.ОткрытьДиалогСтандартногоПериода(Отчет, "СтандартныйПериод", , УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКопиюРезультата(Команда)
	
	бит_ОтчетыКлиент.ПоказатьКопиюРезультата(Результат);	
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметры(Команда)
	
	Если Отчет.ТаблицаПараметры.Количество() > 0 Тогда
		ОбработкаОповещения = Новый ОписаниеОповещения("ОбновитьПараметрыЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Продолжить?'; 
						|en = 'The tabular part will be cleared before filling in. Continue?'");
		ПоказатьВопрос(ОбработкаОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ОбновитьТаблицуПараметров();
	КонецЕсли; 
		
КонецПроцедуры

// Обработчик завершения выбора диалога вопрос.
//  См. Синтакс-помощник: ПоказатьВопрос().
//
&НаКлиенте
Процедура ОбновитьПараметрыЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда    		
		ОбновитьТаблицуПараметров();   		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборы(Команда)
	
	Если ЗначениеЗаполнено(Отчет.ОтборВОтчете) Тогда
		ОбработкаОповещения = Новый ОписаниеОповещения("ОбновитьОтборыЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Продолжить?'; 
						|en = 'The tabular part will be cleared before filling in. Continue?'");
		ПоказатьВопрос(ОбработкаОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьОтборВОтчете();
	КонецЕсли; 
		
КонецПроцедуры

// Обработчик завершения выбора диалога вопрос.
//  См. Синтакс-помощник: ПоказатьВопрос().
//
&НаКлиенте
Процедура ОбновитьОтборыЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда    		
		ЗаполнитьОтборВОтчете();   		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПримечания(Команда)
	
	ВыполнитьУдалениеПримечаний();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЭкземпляр(Команда)
	
	// Упакуем объект в структуру.
	ПараметрыОтчета = ПараметрыПроизвольногоОтчета(); 
	
	// Создадим параметры формы.
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПараметрыОтчета", ПараметрыОтчета);
	
	ОткрытьФорму("Справочник.бит_ЭкземплярыОтчетов.ФормаОбъекта",ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРасшифроватьЯчейку(Команда)
	
	ОткрытьФормуРасшифровки();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРасшифроватьВсе(Команда)
	
	ОткрытьФормуРасшифровки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРасшифроватьОтчетом(Команда)
	
	РасшифроватьОтчетом();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗакрытьРасшифровки(Команда)
	
	бит_ПолучениеДанныхКлиент.ЗакрытьРасшифровки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНастройки(Команда)
	
	ОткрытьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьНастройки(Команда)
	
	ОбработатьИзменениеНастроек(ЭтотОбъект);
	
	Элементы.Сформировать.КнопкаПоУмолчанию = Истина;
	СкрытьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВариант(Команда)
	
	ПараметрыФормы = ПараметрыХраненияНастроек();
	ПараметрыФормы.Вставить("СтруктураНастройки" , СохраняемыеНастройки());
	
	Оповещение = Новый ОписаниеОповещения("СохранитьВариантЗавершение",ЭтотОбъект);
	ОткрытьФорму("ХранилищеНастроек.бит_ХранилищеНастроек.ФормаСохранения", ПараметрыФормы, 
		ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Обработчик завершения открытия формы.
//  См. Синтакс-помощник: ОткрытьФорму().
// 
&НаКлиенте
Процедура СохранитьВариантЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		УстановитьЗаголовок(Результат, ЭтотОбъект);
		СохранитьВариантЗавершениеНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВариант(Команда)
						
	ПараметрыФормы = ПараметрыХраненияНастроек();
	Оповещение	   = Новый ОписаниеОповещения("ВыбратьВариантЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("ХранилищеНастроек.бит_ХранилищеНастроек.ФормаЗагрузки", ПараметрыФормы, 
		ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
КонецПроцедуры

// Обработчик завершения открытия формы.
//  См. Синтакс-помощник: ОткрытьФорму().
// 
&НаКлиенте 
Процедура ВыбратьВариантЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;	
	
	ВыбратьВариантЗавершениеНаСервере("", Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыбратьВариант(Команда)

	ВыбратьВариантЗавершениеНаСервере(Команда.Имя, Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьЭталонТабличногоДокумента(Команда)
	
	#Если ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда
		Результат.Записать(ИмяФайлаТабличногоДокумента(Истина));
	#Иначе	
		ПоказатьПредупреждение(, НСтр("ru='Сравнение файлов возможно только в толстом клиенте'"));
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СравнитьСЭталономТабличныйДокумент(Команда)

	#Если ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда
		Результат.Записать(ИмяФайлаТабличногоДокумента(Ложь));
		СравнениеФайлов = Новый СравнениеФайлов;
		СравнениеФайлов.ПервыйФайл = ИмяФайлаТабличногоДокумента(Истина);
		СравнениеФайлов.ВторойФайл = ИмяФайлаТабличногоДокумента(Ложь);
		СравнениеФайлов.СпособСравнения = СпособСравненияФайлов.ТабличныйДокумент;
		СравнениеФайлов.ПоказатьРазличия();
	#Иначе
		ПоказатьПредупреждение(, НСтр("ru='Сравнение файлов возможно только в толстом клиенте'"));
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура СтандартныеНастройки(Команда)
	
	Если НЕ ЗначениеЗаполнено(Отчет.НастройкаОтчета) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("ПОЛЕ" , "Заполнение",НСтр("ru = 'Настройка'; en = 'adjustment'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "НастройкаОтчета", "Отчет");
		Возврат;
	КонецЕсли;
	
	НастройкаОтчетаПриИзмененииНаСервере();
	
	ИзмененыНастройки = Истина;
	ОбработатьИзменениеНастроек(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыСнятьФлажки(Команда)
	
	бит_РаботаСДиалогамиКлиент.ОбработатьФлагиТаблицы(Отчет.ОтборВОтчете, "Использование", 0, Элементы.ОтборВОтчете);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыУстановитьФлажки(Команда)
	
	бит_РаботаСДиалогамиКлиент.ОбработатьФлагиТаблицы(Отчет.ОтборВОтчете, "Использование", 1, Элементы.ОтборВОтчете);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтчет(Команда)

	Контекст = Новый Структура;
	Контекст.Вставить("ИндексФорматовСохраненияОтчета", Новый Соответствие);

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = ДоступныеФорматыСохраненияОтчета(Контекст.ИндексФорматовСохраненияОтчета);
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = НСтр("ru = 'Сохранение результата отчета'");

	Обработчик = Новый ОписаниеОповещения("СохранитьОтчетПослеВыбораИмениФайла", ЭтотОбъект, Контекст);
	ФайловаяСистемаКлиент.ПоказатьДиалогВыбора(Обработчик, Диалог);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПоПочте(Команда)
	
	ПоказатьДиалогОтправкиПоПочте();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	ЭтоОтчетМСФО = (Форма.ТипОтчета = ПредопределенноеЗначение("Перечисление.бит_ТипыПроизвольныхОтчетов.ОтчетностьМСФО"));
	Элементы	 = Форма.Элементы;
	
	Элементы.Организация.Видимость		  = ЭтоОтчетМСФО;
	Элементы.ГруппаПериодНаДату.Видимость = ЭтоОтчетМСФО;
	Элементы.ГруппаПериод.Видимость       = НЕ ЭтоОтчетМСФО;
	
	УстановитьЗаголовокОрганизации(Форма);

КонецПроцедуры

&НаСервере
Процедура ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервере()
	
	СуммаОтчета = БухгалтерскиеОтчетыВызовСервера.ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		Результат, КэшВыделеннойОбласти);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РезультатПриАктивизацииПодключаемый()
	
	НеобходимоВычислятьНаСервере = Ложь;
	БухгалтерскиеОтчетыКлиент.ВычислитьСуммуВыделенныхЯчеекТабличногоДокумента(
		СуммаОтчета, Результат, Элементы.Результат, КэшВыделеннойОбласти, НеобходимоВычислятьНаСервере);
	
	Если НеобходимоВычислятьНаСервере Тогда
		ВычислитьСуммуВыделенныхЯчеекТабличногоДокументаВКонтекстеНаСервере();
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_РезультатПриАктивизацииПодключаемый");
	
КонецПроцедуры

// Процедура выполняет активизацию области табличного документа.
// 
// Параметры:
//  ИмяОбласти - Строка.
// 
&НаКлиенте
Процедура АктивизироватьОбласть(ИмяОбласти)

	Обл = Результат.Области.Найти(ИмяОбласти);
	
	Если НЕ Обл = Неопределено Тогда
		
		Элементы.Результат.ТекущаяОбласть = Обл;
			
	КонецЕсли; 

КонецПроцедуры

// Процедура ограничивает описание типов в строке таблица параметров.
// 
&НаКлиенте
Процедура ОграничитьОписаниеТиповПараметра()

	ТекущиеДанные = Элементы.ТаблицаПараметры.ТекущиеДанные;
	
	Если мТекущийВидПараметра = ПредопределенноеЗначение("Перечисление.бит_ВидыПараметровЗапроса.Выражение") Тогда
			
		ОписаниеОграничение = Строка500;
		
	Иначе
		
		Если ТекущиеДанные.ЗначениеПараметра = Неопределено Тогда  		
			Элементы.ТаблицаПараметрыЗначениеПараметра.ВыбиратьТип = Истина; 		
		Иначе	                                                        		
			Элементы.ТаблицаПараметрыЗначениеПараметра.ВыбиратьТип = Ложь;  		
		КонецЕсли; 
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СписокЗначений"));
		Если ЗначениеЗаполнено(ТекущиеДанные.ДоступныеТипы) Тогда
			ОписаниеОграничение = Новый ОписаниеТипов(ТекущиеДанные.ДоступныеТипы, МассивТипов);
		Иначе		
			ОписаниеОграничение = Новый ОписаниеТипов(СсылкиИБазовыеТипы, МассивТипов);
		КонецЕсли;
		
	КонецЕсли;	
	
	// Ограничим тип значения
	Элементы.ТаблицаПараметрыЗначениеПараметра.ОграничениеТипа = ОписаниеОграничение;  

КонецПроцедуры // ОграничитьОписаниеТиповПараметра()

// Процедура открывает форму расшифровки.
// 
// Параметры:
//  ОткрытьВсе - Булево.
// 
&НаКлиенте
Процедура ОткрытьФормуРасшифровки(ОткрытьВсе = Ложь)
	
	ТекущаяОбласть = Элементы.Результат.ТекущаяОбласть;
	Если ТипЗнч(ТекущаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИмяОбласти",				ТекущаяОбласть.Имя);
		ПараметрыФормы.Вставить("НастройкаОтчета",			Отчет.НастройкаОтчета);
		ПараметрыФормы.Вставить("ДатаНачала",				Отчет.СтандартныйПериод.ДатаНачала);
		ПараметрыФормы.Вставить("ДатаОкончания",			Отчет.СтандартныйПериод.ДатаОкончания);
		ПараметрыФормы.Вставить("ФорматЧисел",				Отчет.ФорматЧисел);
		ПараметрыФормы.Вставить("ОткрытьВсе",				ОткрытьВсе);
		ПараметрыФормы.Вставить("ВалютаДокумента",			Отчет.ВалютаДокумента);
		ПараметрыФормы.Вставить("КурсДокумента",			Отчет.КурсДокумента);
		ПараметрыФормы.Вставить("КратностьДокумента",		Отчет.КратностьДокумента);
		ПараметрыФормы.Вставить("Организация",				Отчет.Организация);
		ПараметрыФормы.Вставить("ИмяФормыВладельца" ,		ИмяФормы);
		ПараметрыФормы.Вставить("НастройкаПулаПодключений", Отчет.НастройкаПулаПодключений);		
		
		УпаковатьТаблицы(ПараметрыФормы);
		
		КлючУникальностиФормы = ?(ОткрытьВсе, Строка(Отчет.НастройкаОтчета), ТекущаяОбласть.Имя);
		ОткрытьФорму("Обработка.бит_РасшифровкаПроизвольногоОтчета.Форма", ПараметрыФормы, ЭтаФорма, КлючУникальностиФормы);
	КонецЕсли;
	
КонецПроцедуры

// Процедура открывает отчет-расшифровку.
// 
&НаКлиенте
Процедура РасшифроватьОтчетом()

	ТекущаяОбласть = Элементы.Результат.ТекущаяОбласть;
	Если ТипЗнч(ТекущаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ИмяОбласти"     	 , ТекущаяОбласть.Имя);
		ПараметрыФормы.Вставить("НастройкаОтчета"	 , Отчет.НастройкаОтчета);
		ПараметрыФормы.Вставить("ДатаНачала"     	 , Отчет.СтандартныйПериод.ДатаНачала);
		ПараметрыФормы.Вставить("ДатаОкончания"  	 , Отчет.СтандартныйПериод.ДатаОкончания);
		ПараметрыФормы.Вставить("ФорматЧисел"    	 , Отчет.ФорматЧисел);
		ПараметрыФормы.Вставить("ВалютаДокумента"	 , Отчет.ВалютаДокумента);
		ПараметрыФормы.Вставить("КурсДокумента"  	 , Отчет.КурсДокумента);
		ПараметрыФормы.Вставить("КратностьДокумента", Отчет.КратностьДокумента);
		ПараметрыФормы.Вставить("Организация"       , Отчет.Организация);
		ПараметрыФормы.Вставить("Язык"              , Отчет.Язык);
		ПараметрыФормы.Вставить("РежимРасшифровки"  , Истина);
		
		УпаковатьТаблицы(ПараметрыФормы);		
		
		ОткрытьФорму("Отчет.бит_ПроизвольныйОтчет.Форма", ПараметрыФормы, ЭтотОбъект, Строка(ТекущаяОбласть.Имя));
	Иначе
		
		ТекстСообщения = НСтр("ru='Не выбрана ячейка для которой следует вывести расшифровку.';
							  |en='Cell which should be interpreted isn’t selected'");		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервереВРежимеРасшифровки(Отказ)
		
	Перем ОтчетРасшифровка;
		
	ПоказательОтчета = Справочники.бит_ПоказателиПроизвольныхОтчетов.НайтиПоКоду(Отчет.ИмяОбластиРасшифровки,,,Отчет.НастройкаОтчета);
	
	Если ЗначениеЗаполнено(ПоказательОтчета) Тогда
		ОтчетРасшифровка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоказательОтчета, "ЭлементДанных.ОтчетРасшифровка");
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ОтчетРасшифровка) Тогда
		ТекстСообщения = НСтр("ru='Для ячейки %1 расшифровка отчетом не предусмотрена.';
							  |en='For cell %1 transcript by report is not available.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения,Отчет.ИмяОбластиРасшифровки);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	
		
	Отчет.НастройкаОтчета = ОтчетРасшифровка;
	РеквизитыНастройки	  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет.НастройкаОтчета,
							"ФорматЧисел, Язык, СпособКомпоновки, ТипОтчета");
		
	ТипОтчета = РеквизитыНастройки.ТипОтчета;
	
	// Восстановим отбор из элемента данных.
	ОтборВОтчете	 = Отчет.ОтборВОтчете.Выгрузить();
	ОтборСохраненный = ПоказательОтчета.ЭлементДанных.ХранилищеОтборВОтчете.Получить();
	Если ТипЗнч(ОтборСохраненный) = Тип("ТаблицаЗначений") Тогда
		ОтборВОтчете = ОтборСохраненный;
	Иначе
		СпособКомпоновки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетРасшифровка, "СпособКомпоновки");
		бит_МеханизмПолученияДанных.ЗаполнитьОтборВОтчете(СпособКомпоновки, ОтборВОтчете); 
	КонецЕсли; 
	
	Если Параметры.Свойство("ОтборВОтчете") Тогда
		// Копируем отбор из отчета
		КопияОтборВОтчете = бит_ОбщегоНазначения.РаспаковатьТаблицуЗначений(Параметры.ОтборВОтчете);
		Если ТипЗнч(КопияОтборВОтчете) = Тип("ТаблицаЗначений") Тогда
			
			Для каждого СтрокаТаблицы Из КопияОтборВОтчете Цикл
				// Настройка расшифровки имеет более высокий приоритет, чем переданные параметры.
				СтрокаОтбора = ОтборВОтчете.Найти(СтрокаТаблицы.Имя,"Имя");
				Если СтрокаОтбора <> Неопределено Тогда
					Если НЕ СтрокаОтбора.Использование Тогда
						ЗаполнитьЗначенияСвойств(СтрокаОтбора,СтрокаТаблицы);
					КонецЕсли; 
				Иначе	
					НоваяСтрока = ОтборВОтчете.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицы);
				КонецЕсли; 
			КонецЦикла; 
		КонецЕсли; 
	КонецЕсли; 
	Отчет.ОтборВОтчете.Загрузить(ОтборВОтчете);
	
	ТаблицаПараметры = Отчет.ТаблицаПараметры.Выгрузить();
	Если Параметры.Свойство("ТаблицаПараметры") Тогда
		// Копируем параметры из отчета
		КопияТаблицаПараметры = бит_ОбщегоНазначения.РаспаковатьТаблицуЗначений(Параметры.ТаблицаПараметры);
		Если ТипЗнч(КопияТаблицаПараметры) = Тип("ТаблицаЗначений") Тогда
			Для каждого СтрокаТаблицы Из КопияТаблицаПараметры Цикл
				НоваяСтрока = ТаблицаПараметры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицы);
			КонецЦикла; 
		КонецЕсли; 
	КонецЕсли; 
	Отчет.ТаблицаПараметры.Загрузить(ТаблицаПараметры);
	
	УстановитьЗаголовок("", ЭтотОбъект);
	УправлениеФормой(ЭтотОбъект);
	
	СформироватьПриОткрытии = Истина;

КонецПроцедуры

&НаСервере
Процедура УпаковатьТаблицы(ПараметрыПередачи)
	
	ПараметрыПередачи.Вставить("ТаблицаДанныеОтчета", 
		бит_ОбщегоНазначения.УпаковатьТаблицуЗначений(Отчет.ТаблицаДанныеОтчета.Выгрузить()));
	
	ПараметрыПередачи.Вставить("ОтборВОтчете", 
		бит_ОбщегоНазначения.УпаковатьТаблицуЗначений(Отчет.ОтборВОтчете.Выгрузить()));
	
	ПараметрыПередачи.Вставить("ТаблицаПараметры", 
		бит_ОбщегоНазначения.УпаковатьТаблицуЗначений(Отчет.ТаблицаПараметры.Выгрузить()));
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокОрганизации(Форма)

	Отчет 	 = Форма.Отчет;
	Элементы = Форма.Элементы;
	
	Если Отчет.Организация = Неопределено Тогда
		Элементы.Организация.Заголовок = НСтр("ru='Организация/Периметр';en='Organization/Perimeter'");
	ИначеЕсли ТипЗнч(Отчет.Организация) = Тип("СправочникСсылка.Организации") Тогда
		Элементы.Организация.Заголовок = НСтр("ru='Организация';en='Organization'");
	Иначе	
		Элементы.Организация.Заголовок = НСтр("ru='Периметр';en='Perimeter'");
	КонецЕсли;
		
КонецПроцедуры

