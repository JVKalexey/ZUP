Процедура НастройкаОтчетаПриИзмененииНаСервере()
	
	ТипОтчета = Неопределено;
	
	Отчет.ОтборВОтчете.Очистить();
	Отчет.ТаблицаПараметры.Очистить();
	Отчет.ТаблицаДанныеОтчета.Очистить();

	РеквизитыНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет.НастройкаОтчета,
							"ФорматЧисел, Язык, СпособКомпоновки, ТипОтчета");
	
	ЗаполнитьЗначенияСвойств(Отчет, РеквизитыНастройки);
	
	ТипОтчета = РеквизитыНастройки.ТипОтчета;
	
	КопияОтборВОтчете 	  = Отчет.ОтборВОтчете.Выгрузить();
	КопияТаблицаПараметры = Отчет.ТаблицаПараметры.Выгрузить();
	
	бит_МеханизмПолученияДанных.ЗаполнитьОтборВОтчете(РеквизитыНастройки.СпособКомпоновки, КопияОтборВОтчете);
	бит_МеханизмПолученияДанных.ОбновитьТаблицуПараметров(РеквизитыНастройки.СпособКомпоновки, КопияТаблицаПараметры, Истина);
	
	Отчет.ОтборВОтчете.Загрузить(КопияОтборВОтчете);
	Отчет.ТаблицаПараметры.Загрузить(КопияТаблицаПараметры);
	
	УстановитьЗаголовок("", ЭтотОбъект);
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

