&НаСервере
Функция ПараметрыПроизвольногоОтчета()
	
	ПараметрыОтчета = Новый Структура;
	
	Для Каждого МетаРеквизит Из Метаданные.Отчеты.бит_ПроизвольныйОтчет.Реквизиты Цикл	
		 ПараметрыОтчета.Вставить(МетаРеквизит.Имя,Отчет[МетаРеквизит.Имя]);	
	КонецЦикла;
	
	// Для СтандартногоПериода необходимо передавать представление.
	ПараметрыОтчета.СтандартныйПериод = бит_ОбщегоНазначенияКлиентСервер.ИмяВариантаСтандартногоПериода(Отчет.СтандартныйПериод.Вариант);
	
	// Упакуем ТабличныйДокумент Результат
	ТД = Новый ТабличныйДокумент;
	ТД.ФиксацияСверху = Результат.ФиксацияСверху;
	ТД.ФиксацияСлева  = Результат.ФиксацияСлева;
	ТД.Вывести(Результат);
	
	ПараметрыОтчета.Вставить("ТабДокРезультат", ТД);
	
	Возврат ПараметрыОтчета;
	
КонецФункции

&НаСервере
Функция СохраняемыеНастройки()

	СохраняемыеНастройки = Отчеты.бит_ПроизвольныйОтчет.НовыеСохраняемыеНастройки();
	ЗаполнитьЗначенияСвойств(СохраняемыеНастройки, Отчет);
	
	НастройкаПериода = Отчет.СтандартныйПериод.Вариант;
	Если НастройкаПериода = ВариантСтандартногоПериода.ПроизвольныйПериод Тогда
		НастройкаПериода = ВариантСтандартногоПериода.ЭтотГод;
	КонецЕсли;
	
	СохраняемыеНастройки.ВариантПериода   = НастройкаПериода;
	СохраняемыеНастройки.ОтборВОтчете	  = Новый ХранилищеЗначения(Отчет.ОтборВОтчете.Выгрузить(), Новый СжатиеДанных(9));
	СохраняемыеНастройки.ТаблицаПараметры = Новый ХранилищеЗначения(Отчет.ТаблицаПараметры.Выгрузить(), Новый СжатиеДанных(9)); 
	
	Возврат СохраняемыеНастройки;
	
КонецФункции

&НаСервере
Процедура ПрименитьНастройки(ВариантОтчета)

	ШаблонНастроек 		 = Отчеты.бит_ПроизвольныйОтчет.НовыеСохраняемыеНастройки();
	ТипОтчета 	 		 = Неопределено;
	КлючТекущегоВарианта = "";
	
	Если ЗначениеЗаполнено(ВариантОтчета) Тогда
		
		РеквизитыВарианта 	 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВариантОтчета, "ХранилищеНастроек, КлючНастройки");
		СохраненныеНастройки = РеквизитыВарианта.ХранилищеНастроек.Получить();
		
		Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(ШаблонНастроек, СохраненныеНастройки);
		КонецЕсли; 
		КлючТекущегоВарианта = КлючВарианта(РеквизитыВарианта.КлючНастройки);	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Отчет, ШаблонНастроек,, "ОтборВОтчете, ТаблицаПараметры");
	
	Отчет.СтандартныйПериод = Новый СтандартныйПериод(ШаблонНастроек.ВариантПериода);
	
	Отчет.ОтборВОтчете.Очистить();
	Отчет.ТаблицаПараметры.Очистить();
	Отчет.ТаблицаДанныеОтчета.Очистить();
	
	КопияОтборВОтчете = ШаблонНастроек.ОтборВОтчете.Получить();
	Если ТипЗнч(КопияОтборВОтчете) = Тип("ТаблицаЗначений") Тогда
		Отчет.ОтборВОтчете.Загрузить(КопияОтборВОтчете);
	КонецЕсли;
	
	КопияПараметры = ШаблонНастроек.ТаблицаПараметры.Получить();
	Если ТипЗнч(КопияПараметры) = Тип("ТаблицаЗначений") Тогда
		Отчет.ТаблицаПараметры.Загрузить(КопияПараметры);
	КонецЕсли;	

	Если ЗначениеЗаполнено(Отчет.НастройкаОтчета) Тогда
		
		РеквизитыНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет.НастройкаОтчета, "ТипОтчета, СпособКомпоновки");
		ТипОтчета		   = РеквизитыНастройки.ТипОтчета;
		
		// Уточним состав таблиц настройки отчета.
		КопияОтборВОтчете 	  = Отчет.ОтборВОтчете.Выгрузить();
		КопияТаблицаПараметры = Отчет.ТаблицаПараметры.Выгрузить();
		
		бит_МеханизмПолученияДанных.ЗаполнитьОтборВОтчете(РеквизитыНастройки.СпособКомпоновки, КопияОтборВОтчете);
		бит_МеханизмПолученияДанных.ОбновитьТаблицуПараметров(РеквизитыНастройки.СпособКомпоновки, КопияТаблицаПараметры, Ложь);
		
		Для каждого СтрокаТаблицы Из КопияОтборВОтчете Цикл
			ПараметрыПоиска = Новый Структура("Имя", СтрокаТаблицы.Имя);
			РезультатПоиска = Отчет.ОтборВОтчете.НайтиСтроки(ПараметрыПоиска);
			Если НЕ ЗначениеЗаполнено(РезультатПоиска) Тогда
				ЗаполнитьЗначенияСвойств(Отчет.ОтборВОтчете.Добавить(), СтрокаТаблицы);			
			КонецЕсли;	
		КонецЦикла; 
		
		Для каждого СтрокаТаблицы Из КопияТаблицаПараметры Цикл
			ПараметрыПоиска = Новый Структура("ИмяПараметра", СтрокаТаблицы.ИмяПараметра);
			РезультатПоиска = Отчет.ТаблицаПараметры.НайтиСтроки(ПараметрыПоиска);
			Если НЕ ЗначениеЗаполнено(РезультатПоиска) Тогда
				ЗаполнитьЗначенияСвойств(Отчет.ТаблицаПараметры.Добавить(), СтрокаТаблицы);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	УстановитьЗаголовок(ВариантОтчета, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки()

	Элементы.РазделыОтчета.ТекущаяСтраница	 	  = Элементы.НастройкиОтчета;
	Элементы.ПрименитьНастройки.КнопкаПоУмолчанию = Истина;	

КонецПроцедуры

&НаКлиенте
Процедура СкрытьНастройки()
	
	Элементы.РазделыОтчета.ТекущаяСтраница = Элементы.Отчет;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере(Отказ)
			
	КлючТекущегоВарианта	  = "";
	СсылкиИБазовыеТипы = бит_ОбщегоНазначения.ОписаниеПроизвольногоТипа();
	Строка500		  		  = ОбщегоНазначения.ОписаниеТипаСтрока(500);
	
	СписокТиповОрганизация.Добавить(Тип("СправочникСсылка.Организации"));
	Если Метаданные.Справочники.Найти("бит_му_ПериметрыКонсолидации") <> Неопределено Тогда
		СписокТиповОрганизация.Добавить(Тип("СправочникСсылка.бит_му_ПериметрыКонсолидации"), 
										НСтр("ru='Периметры консолидации';en='Perimeter (IFRS)'"));	
	КонецЕсли;	

	ВидыСравнения = бит_МеханизмПолученияДанных.СформироватьСписокВыбораДляОтборовВОтчете();
	Для каждого Элемент Из ВидыСравнения Цикл
		ЗаполнитьЗначенияСвойств(Элементы.ОтборВОтчетеВидСравнения.СписокВыбора.Добавить(), Элемент);	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Параметры.НастройкаОтчета) Тогда
		
		Отчет.ВалютаДокумента		= Параметры.ВалютаДокумента;
		Отчет.ДатаНачала			= Параметры.ДатаНачала;
		Отчет.ДатаОкончания 		= Параметры.ДатаОкончания;
		Отчет.ИмяОбластиРасшифровки = Параметры.ИмяОбласти;
		Отчет.КурсДокумента			= Параметры.КурсДокумента;
		Отчет.КратностьДокумента	= Параметры.КратностьДокумента;
		Отчет.НастройкаОтчета		= Параметры.НастройкаОтчета;
		Отчет.Организация			= Параметры.Организация;
		Отчет.РежимРасшифровки		= Параметры.РежимРасшифровки;
		Отчет.ФорматЧисел			= Параметры.ФорматЧисел;
		Отчет.Язык					= Параметры.Язык;
		
		Если ЗначениеЗаполнено(Отчет.ДатаНачала) Тогда		
			Отчет.СтандартныйПериод.ДатаНачала    = Отчет.ДатаНачала;		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отчет.ДатаОкончания) Тогда		
			Отчет.СтандартныйПериод.ДатаОкончания = КонецДня(Отчет.ДатаОкончания);		
		КонецЕсли;
		
		Если Отчет.РежимРасшифровки Тогда
			ПриСозданииНаСервереВРежимеРасшифровки(Отказ);
		Иначе
			НастройкаОтчетаПриИзмененииНаСервере();
			
			ОбновитьМенюВариантовОтчета();
			ИзмененыНастройки = Истина;
			ОбработатьИзменениеНастроек(ЭтотОбъект);
		КонецЕсли; 
		
	Иначе
				
		ВариантПоУмолчанию = бит_ОтчетыСервер.НайтиНастройкуПоУмолчаниюДляОбъекта(НастраиваемыйОбъект());
		ПрименитьНастройки(ВариантПоУмолчанию);
		
		ОбновитьМенюВариантовОтчета();
		ИзмененыНастройки = Истина;
		ОбработатьИзменениеНастроек(ЭтотОбъект);

	КонецЕсли;	
	
	УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Функция ПараметрыХраненияНастроек()

	ПараметрыХранения = Новый Структура;
	ПараметрыХранения.Вставить("ТипНастройки",		  ПредопределенноеЗначение("Перечисление.бит_ТипыСохраненныхНастроек.Отчеты"));
	ПараметрыХранения.Вставить("НастраиваемыйОбъект", НастраиваемыйОбъект());

	Возврат ПараметрыХранения;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НастраиваемыйОбъект()

	Возврат "Отчет.бит_ПроизвольныйОтчет_СКД";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбработатьИзменениеНастроек(Форма)

	Состояние = ?(Форма.ИзмененыНастройки, "Неактуальность", "НеИспользовать");
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Форма.Элементы.Результат, Состояние);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовок(ВариантОтчета, Форма)

	Отчет = Форма.Отчет;	
	
	Если ЗначениеЗаполнено(Отчет.НастройкаОтчета) Тогда
		Заголовок = Строка(Отчет.НастройкаОтчета) + " %1";
	Иначе	
		Заголовок = НСтр("ru = 'Произвольный отчет %1'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВариантОтчета) Тогда
		Заголовок = СтрШаблон(Заголовок, "(" + Строка(ВариантОтчета) + ")");
	Иначе	
		Заголовок = СтрШаблон(Заголовок, "");
	КонецЕсли;
	
	Если Отчет.РежимРасшифровки Тогда
		Заголовок = Заголовок + " " + НСтр("ru = '(Расшифровка)'; en = '(Decoding)'");
	КонецЕсли;
	
	Форма.Заголовок = Заголовок;

КонецПроцедуры

&НаСервере
Процедура ВыбратьВариантЗавершениеНаСервере(ИмяКоманды, ВариантОтчета)

	Перем РезультатПоиска;
	
	Если ЗначениеЗаполнено(ИмяКоманды) Тогда
		РезультатПоиска = КомандыВариантовОтчета.НайтиСтроки(Новый Структура("ИмяКоманды", ИмяКоманды));
	Иначе	
		РезультатПоиска = КомандыВариантовОтчета.НайтиСтроки(Новый Структура("ВариантОтчета", ВариантОтчета));	
	КонецЕсли;
	
	Если РезультатПоиска = Неопределено Тогда
		ОбновитьМенюВариантовОтчета();
		ВыбратьВариантЗавершениеНаСервере(ИмяКоманды, ВариантОтчета)
	КонецЕсли;
	
	ПрименитьНастройки(РезультатПоиска[0].ВариантОтчета);
	УправлениеФормой(ЭтотОбъект);
	ПометитьТекущийВариант(ЭтотОбъект, РезультатПоиска[0].ИмяКоманды);
	
	ИзмененыНастройки = Истина;
	ОбработатьИзменениеНастроек(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ОбновитьМенюВариантовОтчета()

	Индекс = Элементы.ГруппаВариантыОтчета.ПодчиненныеЭлементы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Кнопка = Элементы.ГруппаВариантыОтчета.ПодчиненныеЭлементы.Получить(Индекс);
		Элементы.Удалить(Кнопка);	
		Индекс = Индекс - 1;
	КонецЦикла;
	
	ВариантыОтчета = бит_ОтчетыСервер.ПроверитьДоступностьВариантовНастроек(НастраиваемыйОбъект(), Ложь);
	
	МассивИсключений   		   = ВариантыОтчета.МассивИсключений;
	МассивДоступныхНастроек    = ВариантыОтчета.МассивДоступныхНастроек;
		     	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбщийКлюч"  			   		, НастраиваемыйОбъект());
	Запрос.УстановитьПараметр("МассивИсключений"			, МассивИсключений);
	Запрос.УстановитьПараметр("МассивДоступныхНастроек"		, МассивДоступныхНастроек);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СохраненныеНастройки.Наименование КАК Наименование,
	|	бит_СохраненныеНастройки.КлючОбъекта КАК КлючОбъекта,
	|	бит_СохраненныеНастройки.КлючНастройки КАК КлючНастройки,
	|	бит_СохраненныеНастройки.Ссылка КАК Ссылка,
	|	бит_СохраненныеНастройки.ИспользоватьПриОткрытии КАК ИспользоватьПриОткрытии
	|ИЗ
	|	Справочник.бит_СохраненныеНастройки КАК бит_СохраненныеНастройки
	|ГДЕ
	|	бит_СохраненныеНастройки.КлючОбъекта ПОДОБНО &ОбщийКлюч
	|	И НЕ бит_СохраненныеНастройки.КлючНастройки В (&МассивИсключений)
	|	И (НЕ бит_СохраненныеНастройки.КлючОбъекта В (&МассивИсключений)
	|			ИЛИ бит_СохраненныеНастройки.КлючНастройки В (&МассивДоступныхНастроек))
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_СохраненныеНастройки.КлючОбъекта,
	|	бит_СохраненныеНастройки.Наименование";

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
			
	Пока Выборка.Следующий() Цикл
		
		КлючВарианта	= КлючВарианта(Выборка.КлючНастройки);
		ИмяКоманды 		= СтрШаблон("Подключаемый_ВыбратьВариант%1", КлючВарианта);
		ТекущаяКоманда  = Команды.Найти(ИмяКоманды);
		
		Если ТекущаяКоманда = Неопределено Тогда
			ТекущаяКоманда = Команды.Добавить(ИмяКоманды);
			ТекущаяКоманда.Действие  = "Подключаемый_ВыбратьВариант";
			ТекущаяКоманда.Заголовок = Выборка.Наименование;
			
			НоваяСтрока = КомандыВариантовОтчета.Добавить();
			НоваяСтрока.КлючВарианта  = КлючВарианта;
			НоваяСтрока.ИмяКоманды	  = ИмяКоманды;
			НоваяСтрока.ВариантОтчета = Выборка.Ссылка;
		КонецЕсли;
		
		НоваяКнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы.ГруппаВариантыОтчета);
		НоваяКнопка.ИмяКоманды = ИмяКоманды;
		НоваяКнопка.Заголовок  = ТекущаяКоманда.Заголовок;
		НоваяКнопка.Пометка	   = (КлючТекущегоВарианта = КлючВарианта);				
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Функция КлючВарианта(КлючНастройки)

	Возврат СтрЗаменить(КлючНастройки, "-", "_");

КонецФункции

&НаСервере
Процедура СохранитьВариантЗавершениеНаСервере(ВариантОтчета)

	РеквизитыНастройки 	 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВариантОтчета, "ХранилищеНастроек, КлючНастройки");
	КлючТекущегоВарианта = КлючВарианта(РеквизитыНастройки.КлючНастройки);	

	ОбновитьМенюВариантовОтчета();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПометитьТекущийВариант(Форма, ИмяКоманды)

	Элементы = Форма.Элементы;
	Для каждого Элемент Из Элементы.ГруппаВариантыОтчета.ПодчиненныеЭлементы Цикл
		Элемент.Пометка = (Элемент.ИмяКоманды = ИмяКоманды);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяФайлаТабличногоДокумента(Эталон)
	
#Если ТолстыйКлиентУправляемоеПриложение Или ТолстыйКлиентОбычноеПриложение Тогда
	
	ИмяФайла = ?(ПустаяСтрока(Заголовок), УникальныйИдентификатор, Заголовок);
	
	Если Эталон Тогда
		ИмяФайла = ИмяФайла + " " + НСтр("ru = '(Эталон)'") + ".xml";
	Иначе	
		ИмяФайла = ИмяФайла + ".xml";
	КонецЕсли;

	Возврат КаталогВременныхФайлов() + ИмяФайла;
	
#КонецЕсли

КонецФункции

&НаКлиенте
Процедура ОжиданиеЗавершенияОткрытияФормы()

	НачатьФормированиеОтчета();

КонецПроцедуры

#Область СохранениеРезультатаОтчета

&НаКлиенте
Процедура СохранитьОтчетПослеСохраненияРезультатаОтчета(Результат, ПолноеИмяФайлаОтчета) Экспорт

	Если Результат <> Истина Тогда
		Возврат;
	КонецЕсли;

	Обработчик = Новый ОписаниеОповещения("СохранитьОтчетПриВыбореИмениФайлаОтчета", ЭтотОбъект, ПолноеИмяФайлаОтчета);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Отчет сохранен в файл'"), Обработчик, ПолноеИмяФайлаОтчета);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтчетПриВыбореИмениФайлаОтчета(ПолноеИмяФайлаОтчета) Экспорт

	ФайловаяСистемаКлиент.ОткрытьФайл(ПолноеИмяФайлаОтчета);

КонецПроцедуры

&НаКлиенте
Функция ФорматыСохраненияОтчета(Знач ПолноеИмяФайлаОтчета, ИндексФорматовСохраненияОтчета)

	ОписаниеПолногоИмениФайла = СтрРазделить(ПолноеИмяФайлаОтчета, ПолучитьРазделительПути());
	ИмяФайлаОтчета = ОписаниеПолногоИмениФайла[ОписаниеПолногоИмениФайла.ВГраница()];

	ОписаниеИмениФайла = СтрРазделить(ИмяФайлаОтчета, ".");
	РасширениеФайлаОтчета = ОписаниеИмениФайла[ОписаниеИмениФайла.ВГраница()];

	Возврат ИндексФорматовСохраненияОтчета[РасширениеФайлаОтчета];

КонецФункции

&НаСервереБезКонтекста
Функция ДоступныеФорматыСохраненияОтчета(ИндексФорматовСохраненияОтчета)

	ДоступныеФорматы = Новый Массив;

	ФорматыСохранения = СтандартныеПодсистемыСервер.НастройкиФорматовСохраненияТабличногоДокумента();

	ФорматСохраненияTXT = ФорматыСохранения.Найти(ТипФайлаТабличногоДокумента.TXT, "ТипФайлаТабличногоДокумента");
	ФорматСохраненияANSITXT = ФорматыСохранения.Найти(ТипФайлаТабличногоДокумента.ANSITXT,
		"ТипФайлаТабличногоДокумента");

	Если ФорматСохраненияTXT <> Неопределено И ФорматСохраненияANSITXT <> Неопределено Тогда
		ФорматыСохранения.Удалить(ФорматСохраненияANSITXT);
	КонецЕсли;

	ТекущийФорматСохранения = Новый Массив;

	Для Каждого ФорматСохранения Из ФорматыСохранения Цикл

		РасширениеФорматаСохранения = "*." + ФорматСохранения.Расширение;
		ПредставлениеФорматаСохранения = СтрЗаменить(ФорматСохранения.Представление, "." + ФорматСохранения.Расширение,
			РасширениеФорматаСохранения);

		ТекущийФорматСохранения.Добавить(ПредставлениеФорматаСохранения);
		ТекущийФорматСохранения.Добавить(РасширениеФорматаСохранения);

		ДоступныеФорматы.Добавить(СтрСоединить(ТекущийФорматСохранения, "|"));

		ТекущийФорматСохранения.Очистить();

		ИндексФорматовСохраненияОтчета.Вставить(ФорматСохранения.Расширение,
			ФорматСохранения.ТипФайлаТабличногоДокумента);

	КонецЦикла;

	Возврат СтрСоединить(ДоступныеФорматы, "|");

КонецФункции

&НаСервереБезКонтекста
Функция СписокДоступныхФорматовСохраненияОтчета(ИндексФорматовСохраненияОтчета)

	ДоступныеФорматы = Новый СписокЗначений;

	ФорматыСохранения = СтандартныеПодсистемыСервер.НастройкиФорматовСохраненияТабличногоДокумента();

	Для Каждого ФорматСохранения Из ИндексФорматовСохраненияОтчета Цикл
		НайденноеОписание = ФорматыСохранения.Найти(ФорматСохранения.Ключ, "Расширение");
		ДоступныеФорматы.Добавить(НайденноеОписание.Расширение, НайденноеОписание.Представление,,
			НайденноеОписание.Картинка);
	КонецЦикла;

	Возврат ДоступныеФорматы;

КонецФункции

&НаКлиенте
Процедура СохранитьОтчетПослеВыбораИмениФайла(РезультатВыбора, Контекст) Экспорт

	Если ТипЗнч(РезультатВыбора) = Тип("Массив") И РезультатВыбора.Количество() > 0 Тогда
		ПолноеИмяФайлаОтчета = РезультатВыбора[0];
	ИначеЕсли ТипЗнч(РезультатВыбора) = Тип("Строка") Тогда
		ПолноеИмяФайлаОтчета = РезультатВыбора;
	Иначе
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПолноеИмяФайлаОтчета) Тогда
		Контекст.Вставить("ПолноеИмяФайлаОтчета", ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(
			Заголовок));
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораФорматаСохранения", ЭтотОбъект, Контекст);
		СписокФорматов = СписокДоступныхФорматовСохраненияОтчета(Контекст.ИндексФорматовСохраненияОтчета);
		ФорматПоУмолчанию = СписокФорматов.НайтиПоЗначению("mxl");
		СписокФорматов.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗакрытии, НСтр("ru='Выберите формат сохранения'"),
			ФорматПоУмолчанию);
	Иначе
		Контекст.Вставить("ПолноеИмяФайлаОтчета", ПолноеИмяФайлаОтчета);
		ВыбранныйЭлемент = Новый Структура("Значение");
		ПослеВыбораФорматаСохранения(ВыбранныйЭлемент, Контекст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФорматаСохранения(ВыбранныйЭлемент, Контекст) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяФайлаОтчета = Контекст.ПолноеИмяФайлаОтчета;
	Если ВыбранныйЭлемент.Значение <> Неопределено Тогда
		ПолноеИмяФайлаОтчета = ПолноеИмяФайлаОтчета + "." + ВыбранныйЭлемент.Значение;
	КонецЕсли;

	Обработчик = Новый ОписаниеОповещения("СохранитьОтчетПослеСохраненияРезультатаОтчета", ЭтотОбъект,
		ПолноеИмяФайлаОтчета);

	ФорматыСохранения = ФорматыСохраненияОтчета(ПолноеИмяФайлаОтчета, Контекст.ИндексФорматовСохраненияОтчета);
	РезультатОтчета = СкопироватьТабличныйДокумент(Результат);
	РезультатОтчета.НачатьЗапись(Обработчик, ПолноеИмяФайлаОтчета, ФорматыСохранения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СкопироватьТабличныйДокумент(ТабличныйДокумент)

	ПотокВПамяти = Новый ПотокВПамяти;
	ТабличныйДокумент.Записать(ПотокВПамяти);
	ПотокВПамяти.Перейти(0, ПозицияВПотоке.Начало);

	Результат = Новый ТабличныйДокумент;
	Результат.Прочитать(ПотокВПамяти, СпособЧтенияЗначенийТабличногоДокумента.Значение);

	Возврат Результат;

КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ПоказатьДиалогОтправкиПоПочте()
	
	РезультатОтчета = СкопироватьТабличныйДокумент(Результат);
	
	Вложение = Новый Структура;
	Вложение.Вставить("АдресВоВременномХранилище", ПоместитьВоВременноеХранилище(РезультатОтчета,
		УникальныйИдентификатор));
	Вложение.Вставить("Представление", Заголовок);

	СписокВложений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение);

	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		МодульРаботаСПочтовымиСообщениямиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль(
			"РаботаСПочтовымиСообщениямиКлиент");
		ПараметрыОтправки = МодульРаботаСПочтовымиСообщениямиКлиент.ПараметрыОтправкиПисьма();
		ПараметрыОтправки.Тема = Заголовок;
		ПараметрыОтправки.Вложения = СписокВложений;
		МодульРаботаСПочтовымиСообщениямиКлиент.СоздатьНовоеПисьмо(ПараметрыОтправки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура бит_Подключаемый_ДобавитьОписаниеОтчетаДляИИ(Команда)
	
	ОповещениеОДобавленииОписания = Новый ОписаниеОповещения("бит_ОповещениеОДобавленииОписанияОтчетаДляИИ", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.бит_ОписаниеОтчетовДляИИ.ФормаЗаписи", бит_ПараметрыОписанияОтчетаДляИИ(),,,,,
		ОповещениеОДобавленииОписания);
	
КонецПроцедуры
	
&НаСервере
Функция бит_ПараметрыОписанияОтчетаДляИИ()

	ЗначенияЗаполнения = Новый Структура;
	
	ПолноеИмяОтчета = РеквизитФормыВЗначение("Отчет").Метаданные().ПолноеИмя();
	ЗначенияЗаполнения.Вставить("Отчет",
		Справочники.бит_ОбъектыСистемы.ОбъектСистемыПоПолномуИмени(ПолноеИмяОтчета));
	ЗначенияЗаполнения.Вставить("ВариантОтчета", Заголовок);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ОтчетТабличныйДокумент", Результат);
	
	Возврат ПараметрыФормы;
	
КонецФункции	
	
&НаКлиенте
Процедура бит_ОповещениеОДобавленииОписанияОтчетаДляИИ(Результат, ДополнительныеПараметры) Экспорт
	
	бит_ОповещениеОДобавленииОписанияОтчетаДляИИНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура бит_ОповещениеОДобавленииОписанияОтчетаДляИИНаСервере()
	
	бит_ИскусственныйИнтеллект.ДобавитьКомандыОбсужденияВариантовСИИ(ЭтотОбъект, Элементы.ПодменюОтправить);
	
КонецПроцедуры

&НаКлиенте
Процедура бит_Подключаемый_ОбсудитьСИИ(Команда)

	бит_ИскусственныйИнтеллектКлиентСервер.ОбсудитьОтчетСИИ(ЭтотОбъект, Команда, Результат, Заголовок);
	
КонецПроцедуры

#КонецОбласти
