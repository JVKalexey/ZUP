Процедура ЗаполнитьОписаниеРесурсов(ПараметрыМодификации)
	
	ОписаниеРесурсов = ПараметрыМодификации.ОписаниеРесурсов;
	
	НовоеОписание = ОписаниеРесурсов.Добавить();
	НовоеОписание.ИмяРесурса = "Показатели.Сумма";
	НовоеОписание.ВидРесурса = "Сумма";
	
	НовоеОписание = ОписаниеРесурсов.Добавить();
	НовоеОписание.ИмяРесурса = "Показатели.Количество";
	НовоеОписание.ВидРесурса = "Количество";
	
