#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	УстановитьЗаголовкиПолейДопИзмерений();
	
	ПараметрКоличество 	  	= бит_ОтчетыБФКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ВыводитьКоличество");
	ПараметрНарастающийИтог = бит_ОтчетыБФКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "НарастающийИтог");
	ПараметрДополнятьПериод = бит_ОтчетыБФКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ДополнятьПериоды");
	
	ПоказателиОтчета = Новый Соответствие;
	ПоказателиОтчета.Вставить("Показатели.Сумма", 				 Новый Структура("Использование", Истина));
	ПоказателиОтчета.Вставить("Показатели.СуммаНарастающийИтог", Новый Структура("Использование", ПараметрНарастающийИтог.Значение));
	ПоказателиОтчета.Вставить("Показатели.Количество", 			 Новый Структура("Использование", ПараметрКоличество.Значение));
	ПоказателиОтчета.Вставить("Показатели.КоличествоНарастающийИтог", 
		Новый Структура("Использование", ПараметрКоличество.Значение И ПараметрНарастающийИтог.Значение));

	// Динамический период.
	бит_ОтчетыБФСервер.НастроитьДинамическийПериод(СхемаКомпоновкиДанных, КомпоновщикНастроек, ПараметрДополнятьПериод.Значение);
	
	НастройкиКомпоновкиДанных = КомпоновщикНастроек.ПолучитьНастройки();
	
	бит_ОтчетыБФСервер.НастроитьПоляВыбора(ПоказателиОтчета, НастройкиКомпоновкиДанных);
	Если НастройкиКомпоновкиДанных.Структура.Количество() > 0 
	   И ТипЗнч(НастройкиКомпоновкиДанных.Структура[0]) = Тип("ТаблицаКомпоновкиДанных") Тогда
		бит_ОтчетыБФСервер.НастроитьПоляВыбора(ПоказателиОтчета, НастройкиКомпоновкиДанных.Структура[0]);
	КонецЕсли;
		
	ОтображатьПустыеСтроки = бит_ОтчетыБФКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ОтображатьПустыеСтроки").Значение;
	
	// Добавление данных по расчетам.
	ИзменитьСКДДляРасчетов(СхемаКомпоновкиДанных, КомпоновщикНастроек);	
	
	// Вывод результата.
	ДокументРезультат.Очистить();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных, ДанныеРасшифровки);
	
	СкорректироватьСвязиНаборовДанныхМакетаКомпоновки(МакетКомпоновки, ОтображатьПустыеСтроки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПоБюджету = бит_ОтчетыБФКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "ПоБюджету").Значение;
	Если ПоБюджету Тогда
		Бюджет = бит_ОтчетыБФКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Бюджет").Значение;
		Если НЕ ЗначениеЗаполнено(Бюджет) Тогда
			ТекстСообщения = НСтр("ru = 'Не установлен ""Бюджет"".';en='""Budget"" is not set'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , ,Отказ); 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

