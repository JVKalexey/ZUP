			ТОГДА НАЧАЛОПЕРИОДА(ВыработкаВНАОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(ВыработкаВНАОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(ВыработкаВНАОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(ВыработкаВНАОбороты.Период, ГОД)
		ИНАЧЕ НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
	КОНЕЦ КАК Период,
	ВыработкаВНАОбороты.Организация,
	ВыработкаВНАОбороты.ОбъектВНА,
	ВыработкаВНАОбороты.КоличествоОборот
ИЗ
	РегистрНакопления.бит_му_ВыработкаВНА.Обороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, Месяц {(&amp;Периодичность)}) КАК ВыработкаВНАОбороты</query>
