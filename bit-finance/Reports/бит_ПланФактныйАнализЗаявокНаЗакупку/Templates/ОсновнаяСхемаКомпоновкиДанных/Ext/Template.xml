		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СУММА(ЕСТЬNULL(ПланируемыеЗатраты.КоличествоПриход, 0)) КАК КоличествоПлан,
	СУММА(ЕСТЬNULL(ПланируемыеЗатраты.СуммаПриход, 0)) КАК СуммаПлан,
	СУММА(0) КАК КоличествоФакт,
	СУММА(0) КАК СуммаФакт,
	ПланируемыеЗатраты.ДокументПланирования,
	ПланируемыеЗатраты.Номенклатура,
	ПланируемыеЗатраты.Организация,
	ПланируемыеЗатраты.ЗаявкаНаЗатраты,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(ПланируемыеЗатраты.ПериодДень, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(ПланируемыеЗатраты.ПериодДень, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(ПланируемыеЗатраты.ПериодДень, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(ПланируемыеЗатраты.ПериодДень, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(ПланируемыеЗатраты.ПериодДень, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(ПланируемыеЗатраты.ПериодДень, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(ПланируемыеЗатраты.ПериодДень, ГОД)
		ИНАЧЕ ПланируемыеЗатраты.ПериодДень
	КОНЕЦ КАК Период,
	ПланируемыеЗатраты.Характеристика
ПОМЕСТИТЬ Заявка
ИЗ
	РегистрНакопления.бит_пз_ПланируемыеЗатраты.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, Авто, , ТИПЗНАЧЕНИЯ(ДокументПланирования) = ТИП(Документ.бит_пз_ЗаявкаНаЗатраты)) КАК ПланируемыеЗатраты
ГДЕ
	ТИПЗНАЧЕНИЯ(ПланируемыеЗатраты.Регистратор) = ТИП(Документ.бит_пз_ЗаявкаНаЗатраты)

СГРУППИРОВАТЬ ПО
