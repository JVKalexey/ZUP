
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьКомпоновщикОтбораСтатей();
	Отчет.НаДату = ТекущаяДатаСеанса();
	ОбновитьДеревоСтатей();
	
	УстановитьУсловноеОформление();
	УстановитьОтборыЗависимыхОборотов();
	НастроитьОтображениеДополнительныхАналитик();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтметкиРежимаПросмотра();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаСервере
Процедура СценарийПриИзмененииНаСервере()
	
	ОбновитьДеревоСтатей();
	
КонецПроцедуры

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	СценарийПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура НаДатуПриИзмененииНаСервере()
	
	ОбновитьДеревоСтатей();
	
КонецПроцедуры

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	НаДатуПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОтборЗависимостиПриИзмененииНаСервере()
	
	ОбновитьДеревоСтатей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЗависимостиПриИзменении(Элемент)
	
	ОтборЗависимостиПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтатьиОборотов

&НаКлиенте
Процедура СтатьиОборотовПриАктивизацииСтроки(Элемент)
	
	ОтключитьОбработчикОжидания("СтатьиОборотовОжиданиеАктивизацииОбласти");
	ПодключитьОбработчикОжидания("СтатьиОборотовОжиданиеАктивизацииОбласти",0.1,Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура СтатьиОборотовОжиданиеАктивизацииОбласти()
	
	РежимДерева = (Элементы.СтатьиОборотов.Отображение = ОтображениеТаблицы.Дерево);
	Элементы.СтатьиОборотовРазвернутьВсе.Доступность = РежимДерева;
	Элементы.СтатьиОборотовСвернутьВсе.Доступность   = РежимДерева;
	
	ТекущиеДанные = Элементы.СтатьиОборотов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ТекущаяСтатьяОборотов = Неопределено;
	Иначе
		ТекущаяСтатьяОборотов = ТекущиеДанные.СтатьяОборотов;
	КонецЕсли;
	
	УстановитьОтборыЗависимыхОборотов();
	
КонецПроцедуры

&НаКлиенте
Процедура СтатьиОборотовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СтатьиОборотов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(,ТекущиеДанные.СтатьяОборотов);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗависимыеОбороты

&НаКлиенте
Процедура ЗависимыеОборотыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанныеЗависимых = Элемент.ТекущиеДанные;
	Если ТекущиеДанныеЗависимых = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Регистратор = ТекущиеДанныеЗависимых.Регистратор;
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.бит_УстановкаЗависимыхОборотов") Тогда
		СтандартнаяОбработка = Ложь;
		
		КлючАвтопозиционирования = Новый Структура;
		КлючАвтопозиционирования.Вставить("Ссылка", Регистратор); 
		КлючАвтопозиционирования.Вставить("СтатьяОборотов", ТекущаяСтатьяОборотов);
		КлючАвтопозиционирования.Вставить("СтатьяОборотов_Зависимый", ТекущиеДанныеЗависимых.СтатьяОборотов_Зависимый);
		НомерСтрокиЗависимыхОборотов = НомерСтрокиЗависимыхОборотов(КлючАвтопозиционирования);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", Регистратор);
		ПараметрыФормы.Вставить("НомерТекущейСтроки", НомерСтрокиЗависимыхОборотов);
	
		ОткрытьФорму("Документ.бит_УстановкаЗависимыхОборотов.Форма.ФормаДокумента", ПараметрыФормы, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКомпоновщикОтборовСтатейОборотовНастройкиОтбор

&НаКлиенте
Процедура КомпоновщикОтборовСтатейОборотовНастройкиОтборПриИзменении(Элемент)
	
	КомпоновщикОтборовСтатейОборотовНастройкиОтборПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДанныеОтчета(Команда)
	
	ОбновитьДеревоСтатей();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	РекурсивнаяРазверткаСвертка(СтатьиОборотов, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	РекурсивнаяРазверткаСвертка(СтатьиОборотов, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВызовОтборовСтатейОборотов(Команда)
	
	Элементы.КомпоновщикОтборовСтатейОборотовНастройкиОтбор.Видимость = НЕ Элементы.КомпоновщикОтборовСтатейОборотовНастройкиОтбор.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимПросмотраТолькоЭлементы(Команда)
	
	Если ТолькоЭлементы Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СтатьиОборотов.Отображение = ОтображениеТаблицы.Список;
	
	ТолькоЭлементы = Истина;
	ОбновитьДеревоСтатей();
	
	УстановитьОтметкиРежимаПросмотра();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимПросмотраСписок(Команда)
	
	Элементы.СтатьиОборотов.Отображение = ОтображениеТаблицы.Список;
	
	Если ТолькоЭлементы Тогда
		ТолькоЭлементы = Ложь;
		ОбновитьДеревоСтатей();
	КонецЕсли;
	
	УстановитьОтметкиРежимаПросмотра();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимПросмотраДерево(Команда)
	
	Элементы.СтатьиОборотов.Отображение = ОтображениеТаблицы.Дерево;
	
	Если ТолькоЭлементы Тогда
		ТолькоЭлементы = Ложь;
		ОбновитьДеревоСтатей();
	КонецЕсли;
	
	УстановитьОтметкиРежимаПросмотра();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимПросмотраИерархическийСписок(Команда)
	
	Элементы.СтатьиОборотов.Отображение = ОтображениеТаблицы.ИерархическийСписок;
	
	Если ТолькоЭлементы Тогда
		ТолькоЭлементы = Ложь;
		ОбновитьДеревоСтатей();
	КонецЕсли;
	
	УстановитьОтметкиРежимаПросмотра();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РаботаСОтборамиСтатейОборотов

&НаСервере
Процедура ИнициализироватьКомпоновщикОтбораСтатей()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	СКДОтбораСтатейОборотов = ОтчетОбъект.ПолучитьМакет("ОтборСтатейОборотов");
	
	КомпоновщикОтборовСтатейОборотов.ЗагрузитьНастройки(СКДОтбораСтатейОборотов.НастройкиПоУмолчанию);
	
	АдресСКДОтбораСтатейОборотов = ПоместитьВоВременноеХранилище(СКДОтбораСтатейОборотов, УникальныйИдентификатор);
	КомпоновщикОтборовСтатейОборотов.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКДОтбораСтатейОборотов));
	
КонецПроцедуры

&НаСервере
Функция ОтборныеСтатьиОборотов()
	
	НастройкиКомпоновщика = КомпоновщикОтборовСтатейОборотов.Настройки;
	ЕстьОтборы = Ложь;
	Для каждого ЭлементОтбора Из НастройкиКомпоновщика.Отбор.Элементы Цикл
		Если ЭлементОтбора.Использование Тогда
			ЕстьОтборы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьОтборы Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СКДОтбораСтатейОборотов = ПолучитьИзВременногоХранилища(АдресСКДОтбораСтатейОборотов);    
	
	// Формируем макет, с помощью компоновщика макета.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СКДОтбораСтатейОборотов, НастройкиКомпоновщика,,,
							Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	// Выполним компоновку с помощью процессора компоновки.
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ОтборныеСтатьи = ТаблицаРезультат.ВыгрузитьКолонку("СтатьяОборотов");
	
	Возврат ОтборныеСтатьи;
	
КонецФункции

#КонецОбласти

&НаСервере
Процедура ОбновитьДеревоСтатей()
	
	ФильтрСтатейПоОтбору = ОтборныеСтатьиОборотов();
	
	ТекущаяСтатьяОборотов = Неопределено;
	
	ДеревоСтатей = РеквизитФормыВЗначение("СтатьиОборотов");
	ДеревоСтатей.Строки.Очистить();
	
	Запрос       = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатьиОборотов.Ссылка КАК СтатьяОборотов,
	|	СтатьиОборотов.ЭтоГруппа КАК ЭтоГруппа,
	|	СтатьиОборотов.Наименование КАК Наименование,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗависимыеОбороты.СтатьяОборотов_Зависимый ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) КАК ЕстьЗависимость,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗависимыеОбороты.СтатьяОборотов_Зависимый ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьНеустановленные,
	|	СтатьиОборотов.Кодификатор КАК Кодификатор,
	|	СтатьиОборотов.ТипСтатьи КАК ТипСтатьи
	|ИЗ
	|	Справочник.бит_СтатьиОборотов КАК СтатьиОборотов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЗависимыеОбороты КАК ЗависимыеОбороты
	|		ПО (ЗависимыеОбороты.СтатьяОборотов = СтатьиОборотов.Ссылка)
	|			И (ЗависимыеОбороты.СценарийЗависимый = ЗНАЧЕНИЕ(Справочник.СценарииПланирования.ПустаяСсылка))
	|			И (ЗависимыеОбороты.Сценарий = &Сценарий)
	|			И (&НаДату >= ЗависимыеОбороты.Период)
	|			И (&НаДату <= ЗависимыеОбороты.ДатаОкончания
	|				ИЛИ ЗависимыеОбороты.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|ГДЕ
	|	НЕ СтатьиОборотов.ЭтоГруппа
	|	И НЕ СтатьиОборотов.ПометкаУдаления
	|	И (&ОтборЗависимости = 0
	|			ИЛИ &ОтборЗависимости = 1
	|				И ЗависимыеОбороты.СтатьяОборотов_Зависимый ЕСТЬ НЕ NULL 
	|			ИЛИ &ОтборЗависимости = 2
	|				И ЗависимыеОбороты.СтатьяОборотов_Зависимый ЕСТЬ NULL)
	|	И &ПереопределяемыйФильтрСтатей
	|
	|СГРУППИРОВАТЬ ПО
	|	СтатьиОборотов.Ссылка,
	|	СтатьиОборотов.ЭтоГруппа,
	|	СтатьиОборотов.Наименование,
	|	СтатьиОборотов.Кодификатор,
	|	СтатьиОборотов.ТипСтатьи
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоГруппа УБЫВ,
	|	Наименование";
	Если ФильтрСтатейПоОтбору = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПереопределяемыйФильтрСтатей", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
									"&ПереопределяемыйФильтрСтатей",
									"СтатьиОборотов.Ссылка В (&ФильтрСтатейПоОтбору)");
		Запрос.УстановитьПараметр("ФильтрСтатейПоОтбору", ФильтрСтатейПоОтбору);;
	КонецЕсли;
	Если НЕ ТолькоЭлементы Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ИТОГИ
		|	МАКСИМУМ(ЕстьЗависимость),
		|	МАКСИМУМ(ЕстьНеустановленные)
		|ПО
		|	СтатьяОборотов ИЕРАРХИЯ";
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Сценарий", Отчет.Сценарий);
	Запрос.УстановитьПараметр("НаДату", Отчет.НаДату);
	Запрос.УстановитьПараметр("ОтборЗависимости", Отчет.ОтборЗависимости);
	Если ТолькоЭлементы Тогда
		ВыборкаСтатей = Запрос.Выполнить().Выбрать();
	Иначе
		ВыборкаСтатей = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "СтатьяОборотов");
	КонецЕсли;
	ЗаполнитьСтатьиРекурсивно(ДеревоСтатей.Строки, ВыборкаСтатей);
	
	ЗначениеВРеквизитФормы(ДеревоСтатей, "СтатьиОборотов");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСтатьиРекурсивно(КоллекцияСтрокДерева, ВыборкаСтатей)
	
	Пока ВыборкаСтатей.Следующий() Цикл
		НоваяСтрокаДерева = КоллекцияСтрокДерева.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, ВыборкаСтатей);
		
		НоваяСтрокаДерева.ИдентификаторКартинки = ?(ВыборкаСтатей.ЭтоГруппа, 1, 2);
			
		Если ВыборкаСтатей.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоИерархии Тогда
			ВыборкаВложенногоУровня = ВыборкаСтатей.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "СтатьяОборотов");
			ЗаполнитьСтатьиРекурсивно(НоваяСтрокаДерева.Строки, ВыборкаВложенногоУровня);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборыЗависимыхОборотов()
	
	ЭлементыПараметров = ЗависимыеОбороты.Параметры.Элементы;
	
	ПараметрСценарий = ЭлементыПараметров.Найти("Сценарий");
	ПараметрСценарий.Значение      = Отчет.Сценарий;
	ПараметрСценарий.Использование = Истина;
	
	ПараметрСтатьяОборотов = ЭлементыПараметров.Найти("СтатьяОборотов");
	ПараметрСтатьяОборотов.Значение      = ТекущаяСтатьяОборотов;
	ПараметрСтатьяОборотов.Использование = Истина;
	
	ПараметрДатаОкончания = ЭлементыПараметров.Найти("ДатаОкончания");
	ПараметрДатаОкончания.Значение      = Отчет.НаДату;
	ПараметрДатаОкончания.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СтатьиОборотов.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СтатьиОборотов.ЕстьЗависимость");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СтатьиОборотов.ЕстьНеустановленные");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.бит_ФонПодписьВерна);
	
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СтатьиОборотов.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СтатьиОборотов.ЕстьЗависимость");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СтатьиОборотов.ЕстьНеустановленные");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.бит_ЦветФонаПредупреждения);
	
КонецПроцедуры

&НаКлиенте
Процедура РекурсивнаяРазверткаСвертка(РодительскийЭлемент, Развернуть)
	
	ЭлементыДерева = РодительскийЭлемент.ПолучитьЭлементы();
	Для каждого ЭлементДерева Из ЭлементыДерева Цикл
		РекурсивнаяРазверткаСвертка(ЭлементДерева, Развернуть);
		Если Развернуть Тогда
        	Элементы.СтатьиОборотов.Развернуть(ЭлементДерева.ПолучитьИдентификатор());
		Иначе
			Элементы.СтатьиОборотов.Свернуть(ЭлементДерева.ПолучитьИдентификатор());
		КонецЕсли;
    КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура КомпоновщикОтборовСтатейОборотовНастройкиОтборПриИзмененииНаСервере()
	
	ОбновитьДеревоСтатей();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтображениеДополнительныхАналитик()
	
	ИзмеренияДоп       = бит_Бюджетирование.ПолучитьИзмеренияБюджетирования("Дополнительные", "Синоним"); 
	НастройкиИзмерений = бит_МеханизмДопИзмеренийПовтИсп.НастройкиДополнительныхИзмерений();
	
	ШаблонЭлементаАналитики          = "ЗависимыеОбороты%1";
	ШаблонСинонимаЗависимойАналитики = НСтр("ru='%1 зависимый'");
	Для каждого ИзмерениеБюджетирования Из ИзмеренияДоп Цикл
		ИмяИзмерения                  = ИзмерениеБюджетирования.Ключ;
		ИмяЭлементаАналитики          = СтрШаблон(ШаблонЭлементаАналитики, ИмяИзмерения);
		ИмяЭлементаЗависимойАналитики = ИмяЭлементаАналитики + "_Зависимый";
		НастройкаИзмерения            = НастройкиИзмерений.Получить(ИмяИзмерения);
		Если НастройкаИзмерения = Неопределено Тогда
			Элементы[ИмяЭлементаАналитики].Видимость          = Ложь;
			Элементы[ИмяЭлементаЗависимойАналитики].Видимость = Ложь;
		Иначе
			Элементы[ИмяЭлементаАналитики].Видимость          = Истина;
			Элементы[ИмяЭлементаАналитики].Заголовок          = НастройкаИзмерения.Синоним;
			Элементы[ИмяЭлементаЗависимойАналитики].Видимость = Истина;
			Элементы[ИмяЭлементаЗависимойАналитики].Заголовок = СтрШаблон(ШаблонСинонимаЗависимойАналитики,
																	НастройкаИзмерения.Синоним);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НомерСтрокиЗависимыхОборотов(КлючАвтопозиционирования)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗависимыеОбороты.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.бит_УстановкаЗависимыхОборотов.ЗависимыеОбороты КАК ЗависимыеОбороты
	|ГДЕ
	|	&ПараметрыПоиска";
	ПараметрыПоиска = Новый Массив;
	ШаблонПоиска    = "ЗависимыеОбороты.%1 = &%1";
	Для каждого ЭлементОтбора Из КлючАвтопозиционирования Цикл
		КлючПоиска     = ЭлементОтбора.Ключ;
		ЗначениеПоиска = ЭлементОтбора.Значение;
		ПараметрыПоиска.Добавить(СтрШаблон(ШаблонПоиска, КлючПоиска));
		Запрос.УстановитьПараметр(КлючПоиска, ЗначениеПоиска);
	КонецЦикла;
	ТекстПоиска  = СтрСоединить(ПараметрыПоиска, Символы.ПС + Символы.Таб + "И ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПараметрыПоиска", ТекстПоиска);
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.НомерСтроки;
	
КонецФункции

&НаКлиенте
Процедура УстановитьОтметкиРежимаПросмотра()
	
	ОтображениеСписка = Элементы.СтатьиОборотов.Отображение;
	
	Элементы.СтатьиОборотовРежимПросмотраТолькоЭлементы.Пометка = ТолькоЭлементы;
	Элементы.СтатьиОборотовРежимПросмотраСписок.Пометка = НЕ ТолькоЭлементы
								И (ОтображениеСписка = ОтображениеТаблицы.Список);
	Элементы.СтатьиОборотовРежимПросмотраДерево.Пометка = НЕ ТолькоЭлементы
								И (ОтображениеСписка = ОтображениеТаблицы.Дерево);
	Элементы.СтатьиОборотовРежимПросмотраИерархическийСписок.Пометка = НЕ ТолькоЭлементы
								И (ОтображениеСписка = ОтображениеТаблицы.ИерархическийСписок);
	
КонецПроцедуры

