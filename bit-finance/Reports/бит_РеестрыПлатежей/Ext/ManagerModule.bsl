// Поключаемая из СКД функция. Число параметров больше 4, что бы не усложнять вызов из СКД.
//
Функция Получатель(ФормаОплаты, ХозОперация, ПеречислениеСотрудникуЧерезБанк, ФизЛицо, Контрагент) Экспорт
	
	// См. Документы.бит_кзн_ПлатежнаяПозиция.ФормаДокумента.УправлениеФормой.
	ПараметрыОтображения = бит_Казначейство.ПодготовитьПараметрыВидимости(ХозОперация);
	ОплатаЧерезБанк		 = (ФормаОплаты = Перечисления.бит_ВидыДенежныхСредств.Безналичные);
	
	Если ПараметрыОтображения.ЕстьКонтрагент ИЛИ (ОплатаЧерезБанк И ПеречислениеСотрудникуЧерезБанк) Тогда
		Получатель = Контрагент;
	ИначеЕсли ПараметрыОтображения.ФизЛицо Тогда	
	    Получатель = ФизЛицо;
	Иначе
		Получатель = Контрагент;
	КонецЕсли;

	Возврат Получатель;

КонецФункции

