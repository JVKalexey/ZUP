		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_ГрафикиДоговоровОбороты.Период КАК Период,
	бит_ГрафикиДоговоровОбороты.Сценарий КАК Сценарий,
	бит_ГрафикиДоговоровОбороты.ЦФО КАК ЦФО,
	бит_ГрафикиДоговоровОбороты.СтатьяОборотов КАК СтатьяОборотов,
	бит_ГрафикиДоговоровОбороты.ТипСтатьи КАК ТипСтатьи,
	бит_ГрафикиДоговоровОбороты.СтатьяОборотов.РасходДоход КАК Направление,
	бит_ГрафикиДоговоровОбороты.ДокументРегистратор КАК ДокументРегистратор,
	бит_ГрафикиДоговоровОбороты.ДоговорКонтрагента.Контрагент КАК Контрагент,
	бит_ГрафикиДоговоровОбороты.ДоговорКонтрагента КАК ДоговорКонтрагента,
	бит_ГрафикиДоговоровОбороты.Аналитика_1 КАК Аналитика_1,
	бит_ГрафикиДоговоровОбороты.Аналитика_2 КАК Аналитика_2,
	бит_ГрафикиДоговоровОбороты.Аналитика_3 КАК Аналитика_3,
	бит_ГрафикиДоговоровОбороты.Аналитика_4 КАК Аналитика_4,
	бит_ГрафикиДоговоровОбороты.Аналитика_5 КАК Аналитика_5,
	бит_ГрафикиДоговоровОбороты.Аналитика_6 КАК Аналитика_6,
	бит_ГрафикиДоговоровОбороты.Аналитика_7 КАК Аналитика_7,
	СУММА(ВЫБОР
			КОГДА бит_ГрафикиДоговоровОбороты.СтатьяОборотов.РасходДоход = ЗНАЧЕНИЕ(Перечисление.бит_РасходДоход.Расходование)
				ТОГДА -бит_ГрафикиДоговоровОбороты.СуммаРеглОборот
			ИНАЧЕ бит_ГрафикиДоговоровОбороты.СуммаРеглОборот
		КОНЕЦ) КАК СуммаРеглОборот,
	СУММА(ВЫБОР
			КОГДА бит_ГрафикиДоговоровОбороты.СтатьяОборотов.РасходДоход = ЗНАЧЕНИЕ(Перечисление.бит_РасходДоход.Расходование)
				ТОГДА -бит_ГрафикиДоговоровОбороты.СуммаБезНДСРеглОборот
			ИНАЧЕ бит_ГрафикиДоговоровОбороты.СуммаБезНДСРеглОборот
		КОНЕЦ) КАК СуммаБезНДСРеглОборот,
	СУММА(ВЫБОР
			КОГДА бит_ГрафикиДоговоровОбороты.СтатьяОборотов.РасходДоход = ЗНАЧЕНИЕ(Перечисление.бит_РасходДоход.Расходование)
				ТОГДА -бит_ГрафикиДоговоровОбороты.СуммаУпрОборот
			ИНАЧЕ бит_ГрафикиДоговоровОбороты.СуммаУпрОборот
		КОНЕЦ) КАК СуммаУпрОборот,
	СУММА(ВЫБОР
			КОГДА бит_ГрафикиДоговоровОбороты.СтатьяОборотов.РасходДоход = ЗНАЧЕНИЕ(Перечисление.бит_РасходДоход.Расходование)
				ТОГДА -бит_ГрафикиДоговоровОбороты.СуммаБезНДСУпрОборот
			ИНАЧЕ бит_ГрафикиДоговоровОбороты.СуммаБезНДСУпрОборот
		КОНЕЦ) КАК СуммаБезНДСУпрОборот,
	СУММА(ВЫБОР
			КОГДА бит_ГрафикиДоговоровОбороты.СтатьяОборотов.РасходДоход = ЗНАЧЕНИЕ(Перечисление.бит_РасходДоход.Расходование)
				ТОГДА -бит_ГрафикиДоговоровОбороты.СуммаСценарийОборот
			ИНАЧЕ бит_ГрафикиДоговоровОбороты.СуммаСценарийОборот
		КОНЕЦ) КАК СуммаСценарийОборот,
	СУММА(ВЫБОР
			КОГДА бит_ГрафикиДоговоровОбороты.СтатьяОборотов.РасходДоход = ЗНАЧЕНИЕ(Перечисление.бит_РасходДоход.Расходование)
				ТОГДА -бит_ГрафикиДоговоровОбороты.СуммаБезНДССценарийОборот
			ИНАЧЕ бит_ГрафикиДоговоровОбороты.СуммаБезНДССценарийОборот
		КОНЕЦ) КАК СуммаБезНДССценарийОборот,
	бит_ГрафикиДоговоровОбороты.СоставляющаяПлатежа КАК СоставляющаяПлатежа,
	бит_ГрафикиДоговоровОбороты.Аналитика_8,
	бит_ГрафикиДоговоровОбороты.Аналитика_9,
	бит_ГрафикиДоговоровОбороты.Аналитика_10,
	бит_ГрафикиДоговоровОбороты.Аналитика_11,
	бит_ГрафикиДоговоровОбороты.Аналитика_12
{ВЫБРАТЬ
	Период,
	Сценарий.*,
	ЦФО.*,
	СтатьяОборотов.*,
	ТипСтатьи.*,
	Направление.*,
	ДокументРегистратор.*,
	ДоговорКонтрагента.*,
	Аналитика_1.*,
	Аналитика_2.*,
	Аналитика_3.*,
	Аналитика_4.*,
	Аналитика_5.*,
	Аналитика_6.*,
	Аналитика_7.*,
	СуммаРеглОборот,
	СуммаБезНДСРеглОборот,
	СуммаУпрОборот,
	СуммаБезНДСУпрОборот,
	СуммаСценарийОборот,
	СуммаБезНДССценарийОборот,
	СоставляющаяПлатежа.*}
ИЗ
	РегистрНакопления.бит_ГрафикиДоговоров.Обороты(
			&amp;НачалоПериода {(&amp;НачалоПериода)},
			&amp;КонецПериода {(&amp;КонецПериода)},
			Месяц {(&amp;Периодичность)},
			ВЫБОР
				КОГДА &amp;ИспользоватьОтборПоРегистратору
