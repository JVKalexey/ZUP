	бит_Задача.РольИсполнителя,
	бит_Задача.ОбъектАдресации_1,
	бит_Задача.ОбъектАдресации_2,
	бит_Задача.ОбъектАдресации_3
ИЗ
	Задача.бит_Задача КАК бит_Задача
ГДЕ
	ВЫБОР
			КОГДА &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			КОГДА &amp;НачалоПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА бит_Задача.Дата &gt;= &amp;НачалоПериода
			КОГДА &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА бит_Задача.Дата &lt;= &amp;КонецПериода
			КОГДА &amp;НачалоПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
					И &amp;КонецПериода &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА бит_Задача.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
		КОНЕЦ</query>
