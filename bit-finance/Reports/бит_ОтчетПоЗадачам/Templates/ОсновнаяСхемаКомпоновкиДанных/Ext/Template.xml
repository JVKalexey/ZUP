	<calculatedField>
		<dataPath>ПросроченоДней</dataPath>
		<expression>ВЫБОР
		КОГДА СрокИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
					КОГДА ДатаОкончанияИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
							И ДатаОкончанияИсполнения &gt; СрокИсполнения
						ТОГДА РАЗНОСТЬДАТ(СрокИсполнения, ДатаОкончанияИсполнения, "ДЕНЬ")
					КОГДА ДатаОкончанияИсполнения = ДАТАВРЕМЯ(1, 1, 1)
							И &amp;ТекущаяДата &gt; СрокИсполнения
						ТОГДА РАЗНОСТЬДАТ(СрокИсполнения, &amp;ТекущаяДата, "ДЕНЬ")
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Просрочено (дней)</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Overdue (in days)</v8:content>
