			</v8:DateQualifiers>
		</valueType>
	</calculatedField>
	<calculatedField>
		<dataPath>Просрочено</dataPath>
		<expression>ВЫБОР
		КОГДА СрокИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
					КОГДА ДатаОкончанияИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
							И ДатаОкончанияИсполнения &gt; СрокИсполнения
						ТОГДА ИСТИНА
					КОГДА ДатаОкончанияИсполнения = ДАТАВРЕМЯ(1, 1, 1)
							И &amp;ТекущаяДата &gt; СрокИсполнения
						ТОГДА ИСТИНА
					ИНАЧЕ ЛОЖЬ
				КОНЕЦ
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
