		<field xsi:type="DataSetFieldField">
			<dataPath>Период</dataPath>
			<field>Период</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Period</v8:content>
				</v8:item>
			</title>
			<presentationExpression>ВЫБОР
	КОГДА Не Формат(Период, "ДЛФ=D") = ""
		ТОГДА
			ВЫБОР
				КОГДА &amp;Периодичность = 0
					ТОГДА НСтр("ru = 'За период'; en = 'Over a period'")
				КОГДА &amp;Периодичность = 6
					ТОГДА Формат(Период, "ДЛФ=D")
				КОГДА &amp;Периодичность = 7
					ТОГДА СтрШаблон("%1 %2", Формат(Период, "ДЛФ=D"), НСтр("ru = '(неделя)'; en = '(week)'"))
				КОГДА &amp;Периодичность = 8
					ТОГДА СтрШаблон("%1 %2", Формат(Период, "ДЛФ=D"), НСтр("ru = '(декада)'; en = '(decade)'"))
				КОГДА &amp;Периодичность = 9
					ТОГДА Формат(Период, "ДФ='MMMM yyyy'")
				КОГДА &amp;Периодичность = 10
					ТОГДА СтрШаблон("%1 %2 %3 %4", Формат(Период, "ДФ=q"), НСтр("ru = 'квартал'; en = 'quarter'"), Формат(Период, "ДФ=yyyy"), НСтр("ru = 'г.'; en = 'y.'"))
				КОГДА &amp;Периодичность = 11
					ТОГДА 
					ВЫБОР 
                            			КОГДА Формат(Период, "ДФ=q") = "3" ИЛИ Формат(Период, "ДФ=q") = "4"
                                		ТОГДА СтрШаблон("%1 %2 %3", НСтр("ru = '2-ое полугодие'; en = '2nd half-year'"), Формат(Период, "ДФ=yyyy"), НСтр("ru = 'г.'; en = 'y.'"))
                            			ИНАЧЕ СтрШаблон("%1 %2 %3", НСтр("ru = '1-ое полугодие'; en = '1nd half-year'"), Формат(Период, "ДФ=yyyy"), НСтр("ru = 'г.'; en = 'y.'"))
                        		КОНЕЦ
				КОГДА &amp;Периодичность = 12
					ТОГДА СтрШаблон("%1 %2", Формат(Период, "ДФ=yyyy"), НСтр("ru = 'г.'; en = 'y.'"))
				ИНАЧЕ Формат(Период, "ДЛФ=D")
			КОНЕЦ
	ИНАЧЕ ""
КОНЕЦ</presentationExpression>
		</field>
