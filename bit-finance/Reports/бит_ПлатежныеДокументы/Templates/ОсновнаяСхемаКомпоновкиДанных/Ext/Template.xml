		<item xsi:type="DataSetQuery">
			<name>ОтражениеФактаСписания</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДокументПланирования</dataPath>
				<field>ДокументПланирования</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ПлатежныйДокумент</dataPath>
				<field>ПлатежныйДокумент</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Позиция</dataPath>
				<field>Позиция</field>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	бит_кзн_ПлатежнаяПозиция.Ссылка КАК Позиция,
	бит_кзн_ПлатежнаяПозиция.ДокументПланирования КАК ДокументПланирования,
	бит_ОтражениеФактаДДС.ДокументОснование КАК ПлатежныйДокумент
ИЗ
	Документ.бит_кзн_ПлатежнаяПозиция КАК бит_кзн_ПлатежнаяПозиция
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОтражениеФактаДДС.ФактическиеДанные КАК бит_ОтражениеФактаДДСФактическиеДанные
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОтражениеФактаДДС КАК бит_ОтражениеФактаДДС
			ПО бит_ОтражениеФактаДДСФактическиеДанные.Ссылка = бит_ОтражениеФактаДДС.Ссылка
		ПО бит_кзн_ПлатежнаяПозиция.Ссылка = бит_ОтражениеФактаДДСФактическиеДанные.Позиция
ГДЕ
	бит_кзн_ПлатежнаяПозиция.ВидПлана = ЗНАЧЕНИЕ(Перечисление.бит_кзн_ВидыПланов.План)</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>ОтражениеФактаПоступления</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Позиция</dataPath>
				<field>Позиция</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Позиция</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДокументПланирования</dataPath>
				<field>ДокументПланирования</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ПлатежныйДокумент</dataPath>
				<field>ПлатежныйДокумент</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Платежный документ</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	бит_кзн_ПозицияПоступления.Ссылка КАК Позиция,
	бит_кзн_ПозицияПоступления.ДокументПланирования КАК ДокументПланирования,
	бит_ОтражениеФактаДДС.ДокументОснование КАК ПлатежныйДокумент
ИЗ
	Документ.бит_кзн_ПозицияПоступления КАК бит_кзн_ПозицияПоступления
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОтражениеФактаДДС.ФактическиеДанные КАК бит_ОтражениеФактаДДСФактическиеДанные
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОтражениеФактаДДС КАК бит_ОтражениеФактаДДС
			ПО бит_ОтражениеФактаДДСФактическиеДанные.Ссылка = бит_ОтражениеФактаДДС.Ссылка
		ПО бит_кзн_ПозицияПоступления.Ссылка = бит_ОтражениеФактаДДСФактическиеДанные.Позиция
ГДЕ
	бит_кзн_ПозицияПоступления.ВидПлана = ЗНАЧЕНИЕ(Перечисление.бит_кзн_ВидыПланов.План)</query>
		</item>
