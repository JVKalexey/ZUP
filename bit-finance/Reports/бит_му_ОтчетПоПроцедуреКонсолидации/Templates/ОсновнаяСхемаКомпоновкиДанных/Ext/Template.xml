	бит_Дополнительный_2Обороты.СуммаУпрОборотКт КАК СуммаУпрОборотКт
ИЗ
	СоставПериметра КАК СоставПериметра
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.бит_Дополнительный_2.ОстаткиИОбороты(
				&amp;НачалоПериода,
				&amp;КонецПериода,
				,
				,
				,
				,
				Организация В
					(ВЫБРАТЬ
						СоставПериметра.Организация
					ИЗ
						СоставПериметра КАК СоставПериметра) {(Организация)}) КАК бит_Дополнительный_2ОстаткиИОбороты
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.бит_Дополнительный_2.Обороты(
					&amp;НачалоПериода,
					&amp;КонецПериода,
					,
					,
					,
					Организация В
						(ВЫБРАТЬ
							СоставПериметра.Организация
						ИЗ
							СоставПериметра КАК СоставПериметра),
					,
					) КАК бит_Дополнительный_2Обороты
			ПО бит_Дополнительный_2ОстаткиИОбороты.Счет = бит_Дополнительный_2Обороты.Счет
				И бит_Дополнительный_2ОстаткиИОбороты.Организация = бит_Дополнительный_2Обороты.Организация
		ПО СоставПериметра.Организация = бит_Дополнительный_2ОстаткиИОбороты.Организация
;

