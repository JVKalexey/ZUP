		КОГДА &amp;Периодичность = 11
			ТОГДА Полугодие
		КОГДА &amp;Периодичность = 12
			ТОГДА Год
		ИНАЧЕ Месяц
	КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Period</v8:content>
			</v8:item>
		</title>
		<presentationExpression>ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА Формат(День, "ДЛФ=D")
		КОГДА &amp;Периодичность = 7
			ТОГДА СтрШаблон("%1 (%2)", Формат(Неделя, "ДЛФ=D"), НСтр("ru = 'неделя'; en = 'week'"))
		КОГДА &amp;Периодичность = 8
			ТОГДА СтрШаблон("%1 (%2)", Формат(Декада, "ДЛФ=D"), НСтр("ru = 'декада'; en = 'decade'"))
		КОГДА &amp;Периодичность = 9
			ТОГДА Формат(Месяц, "ДФ='MMMM yyyy'")
		КОГДА &amp;Периодичность = 10
			ТОГДА СтрШаблон("%1 %2 %3 %4", Формат(Квартал, "ДФ=q"), НСтр("ru = 'квартал'; en = 'quarter'"), Формат(Квартал, "ДФ=yyyy"), НСтр("ru = 'г.'; en = 'y.'"))
		КОГДА &amp;Периодичность = 11
			ТОГДА (ВЫБОР КОГДА МЕСЯЦ(Полугодие) = 01 ТОГДА СтрШаблон("1 %1 %2", НСтр("ru = 'полугодие'; en = 'half a year'"), Формат(Полугодие, "ДФ=yyyy")) ИНАЧЕ СтрШаблон("2 %1 %2", НСтр("ru = 'полугодие'; en = 'half a year'"), Формат(Полугодие, "ДФ=yyyy")) КОНЕЦ)
		КОГДА &amp;Периодичность = 12
			ТОГДА СтрШаблон("%1 %2", Формат(Год, "ДФ=yyyy"), НСтр("ru = 'г.'; en = 'y.'"))
		ИНАЧЕ Формат(День, "ДЛФ=D")
	КОНЕЦ</presentationExpression>
