
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТекущийОбъект") Тогда
		// АПК:68-выкл
		ОбработкаОбъект = ДанныеФормыВЗначение(Параметры.ТекущийОбъект, Тип("ОбработкаОбъект.бит_РабочееМестоКазначея"));
		// АПК:68-вкл
		ЗначениеВДанныеФормы(ОбработкаОбъект, Объект);
	КонецЕсли; 
	
	Параметры.Свойство("ЦветБудущий",	  ЦветБудущий);
	Параметры.Свойство("ЦветВыходной",	  ЦветВыходной);
	Параметры.Свойство("ЦветЗапрет",	  ЦветЗапрет);
	Параметры.Свойство("ЦветИнформация",  ЦветИнформация);
	Параметры.Свойство("ЦветОперативный", ЦветОперативный);
	Параметры.Свойство("ЦветПрошлый",	  ЦветПрошлый);

	ЗаполнитьСписокРежимовОстатков(); 
		
	УстановитьЗаголовокФормы(ЭтотОбъект);
	
	ИспользоватьПрогнозы = ПолучитьФункциональнуюОпцию("бит_кзн_ИспользоватьПрогнозыПлатежейИПоступлений");
	
	Если НЕ ИспользоватьПрогнозы Тогда
		Элементы.ВыводитьПрогнозыПлатежей.Видимость = Ложь;
		Объект.ВыводитьПрогнозыПлатежей 			= Ложь;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

