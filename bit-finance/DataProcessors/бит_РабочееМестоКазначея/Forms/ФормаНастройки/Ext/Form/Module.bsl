#Область ОбработчикиКомандФормы

// Процедура - действие команды "Готово".
// 
&НаКлиенте
Процедура Готово(Команда)
	
	Отказ = Ложь;
	Если НЕ ПериодЗаполненПравильно(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;

	Если Объект.ВыделятьВыходныеДни И НЕ ЗначениеЗаполнено(Объект.Календарь) Тогда
		ТекстПояснения = НСтр("ru = 'Для выделения выходных дней необходимо выбрать производственный календарь.'");
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("ПОЛЕ" , "КОРРЕКТНОСТЬ", НСтр("ru = 'Календарь'"),,, ТекстПояснения);	
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Календарь", "Объект", Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 

	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("Команда"      ,"ОК");
	ПараметрыПередачи.Вставить("ТекущийОбъект",Объект);
	ПараметрыПередачи.Вставить("ИзмененЦвет"  ,ИзмененЦвет);
	ПараметрыПередачи.Вставить("ИзмененРазмер",ИзмененРазмер);
	
	ПараметрыПередачи.Вставить("ЦветБудущий",	  ЦветБудущий);
	ПараметрыПередачи.Вставить("ЦветВыходной",	  ЦветВыходной);
	ПараметрыПередачи.Вставить("ЦветЗапрет",	  ЦветЗапрет);
	ПараметрыПередачи.Вставить("ЦветИнформация",  ЦветИнформация);
	ПараметрыПередачи.Вставить("ЦветОперативный", ЦветОперативный);
	ПараметрыПередачи.Вставить("ЦветПрошлый",	  ЦветПрошлый);
	
	Закрыть(ПараметрыПередачи);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПериод(Команда)
	
	Диалог 			= Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период 	= Новый СтандартныйПериод(Объект.НачалоПериода, КонецДня(Объект.КонецПериода));
	РезультатВыбора = Ждать Диалог.РедактироватьАсинх();

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.НачалоПериода = РезультатВыбора.ДатаНачала;
	Объект.КонецПериода  = РезультатВыбора.ДатаОкончания;
	
	УстановитьЗаголовокФормы(ЭтотОбъект); 

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокФормы(Форма)

	Объект = Форма.Объект;

	ЗаголовокОтчета = СтрШаблон(НСтр("ru='Рабочее место казначения %1';en='Workplace kaznacheniya %1'"),
		БухгалтерскиеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(Объект.НачалоПериода, Объект.КонецПериода));
	
	Форма.Заголовок = ЗаголовокОтчета;

КонецПроцедуры

