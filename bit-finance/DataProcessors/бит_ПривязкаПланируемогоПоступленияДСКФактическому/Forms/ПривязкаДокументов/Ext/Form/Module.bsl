#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура СвязанныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле <> Элементы.СвязанныеДокументыПометка Тогда
		ТекущиеДанные = СвязанныеДокументы.НайтиПоИдентификатору(ВыбраннаяСтрока);
		ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДокументыПометкаПриИзменении(Элемент)
	
	ПометитьПривязанныйДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДокументыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("СвязанныеДокументыПриАктивизацииСтрокиОжидание", 0.5, Истина);
	
КонецПроцедуры

#КонецОбласти

