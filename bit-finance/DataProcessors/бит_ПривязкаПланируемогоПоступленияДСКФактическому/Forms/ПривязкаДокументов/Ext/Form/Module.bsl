&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	// АПК:277-выкл Проектное решение вызвать функционал другой подсистемы.
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СвязанныеДокументыПометка");
	// АПК:277-вкл
	ГруппаИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, 
					ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли); 
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИ,
		"СвязанныеДокументы.Основной", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИ,
		"СвязанныеДокументы.Обработано", ВидСравненияКомпоновкиДанных.Равно, Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПодсказкуСпискаИКнопкуПоУмолчанию(Форма, Событие)

	Элементы = Форма.Элементы;
	
	КнопкиФормы = Новый Массив;
	КнопкиФормы.Добавить(Элементы.ФормаНайтиСвязанные);
	КнопкиФормы.Добавить(Элементы.ФормаПривязатьДокументы);
	
	Если Событие = "Открытие" Тогда
		ТекстСообщения = НСтр("ru = 'Задайте условия отбора и поиска и нажмите ""Найти документы"".';
								|en = 'Set the selection and search conditions and click ""Find documents"".'");
		КнопкаПоУмолчанию = Элементы.ФормаНайтиСвязанные;
	ИначеЕсли Событие = "ИзмененыПравилаОтбораИПоиска" Тогда
		ТекстСообщения = НСтр("ru = 'Заданы условия отбора и поиска. Нажмите ""Найти документы"".'; 
							|en = 'The selection and search conditions are set. Click on ""Find documents"".'");
		КнопкаПоУмолчанию = Элементы.ФормаНайтиСвязанные;
	ИначеЕсли Событие = "ВыполненПоиск" Тогда
		ТекстСообщения = НСтр("ru = 'Отметьте связанные документы и нажмите ""Привязать документы"".';
							|en = 'Mark the related documents and click ""Link documents"".'");
		КнопкаПоУмолчанию = Элементы.ФормаПривязатьДокументы;
	ИначеЕсли Событие = "ОбработкаЗавершена" Тогда
		ТекстСообщения = НСтр("ru = 'Обработка завершена. Для отбора и поиска новых документов нажмите ""Найти документы"".';
								|en = 'Processing is completed. To select and search for new documents, click ""Find documents"".'");
		КнопкаПоУмолчанию = Элементы.ФормаНайтиСвязанные;	
	КонецЕсли;

	Для каждого КнопкаФормы Из КнопкиФормы Цикл
		КнопкаФормы.КнопкаПоУмолчанию = (КнопкаФормы = КнопкаПоУмолчанию);
		КнопкаФормы.Видимость		  = (КнопкаФормы = КнопкаПоУмолчанию);
	КонецЦикла;
	
	Элементы.ФормаСнятьПометки.Видимость 	  = (Событие <> "ОбработкаЗавершена");
	Элементы.ФормаОбновитьДокументы.Видимость = (Событие = "ВыполненПоиск");
	
	Элементы.СвязанныеДокументы.РасширеннаяПодсказка.Заголовок = ТекстСообщения;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьСвязанныеДокументыИерархически(Знач СтрокаДанных = Неопределено)
	
	Если СтрокаДанных <> Неопределено Тогда
		Элементы.СвязанныеДокументы.Развернуть(СтрокаДанных, Истина);
		Возврат;
	КонецЕсли;
	
	// Все первого уровня
	ВсеСтроки = Элементы.СвязанныеДокументы;
	Для Каждого ДанныеСтроки Из СвязанныеДокументы.ПолучитьЭлементы() Цикл 
		ВсеСтроки.Развернуть(ДанныеСтроки.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьСвязанныеДокументыИерархически(Знач СтрокаДанных = Неопределено)
	
	Если СтрокаДанных <> Неопределено Тогда
		Элементы.СвязанныеДокументы.Свернуть(СтрокаДанных);
		Возврат;
	КонецЕсли;
	
	// Все первого уровня
	ВсеСтроки = Элементы.СвязанныеДокументы;
	Для Каждого ДанныеСтроки Из СвязанныеДокументы.ПолучитьЭлементы() Цикл 
		ВсеСтроки.Свернуть(ДанныеСтроки.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СвязанныеДокументыПриАктивизацииСтрокиОжидание()

	ТекущиеДанные = Элементы.СвязанныеДокументы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РазвернутьСвязанныеДокументыИерархически(ТекущиеДанные.ПолучитьИдентификатор());	

КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкиИерархически(Коллекция)

	Для каждого СтрокаТаблицы Из Коллекция Цикл
		СтрокаТаблицы.Пометка = Ложь;
		СнятьПометкиИерархически(СтрокаТаблицы.ПолучитьЭлементы());
	КонецЦикла;

КонецПроцедуры

#КонецОбласти