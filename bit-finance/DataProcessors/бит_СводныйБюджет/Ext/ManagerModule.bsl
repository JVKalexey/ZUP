// Функция - Конструктор параметра функции ЗаполнитьСводныйБюджет.
// 
// Возвращаемое значение:
//  Структура - параметры получения табличных документов:
//   * НастройкиКомпоновщика  - НастройкиКомпоновкиДанных  - настройки компоновщика данных для СКД
//   * СхемаКомпоновкиДанных - Строка - адрес хранения СКД
//
Функция НовыеПараметрыЗаполненияСводногоБюджета() Экспорт
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("НастройкиКомпоновщика", Новый НастройкиКомпоновкиДанных);
	ПараметрыЗаполнения.Вставить("СхемаКомпоновкиДанных", Неопределено);
	ПараметрыЗаполнения.Вставить("Сценарий",              Справочники.СценарииПланирования.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Периодичность",         Перечисления.бит_ПериодичностьПланирования.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Период",                Новый СтандартныйПериод);
	ПараметрыЗаполнения.Вставить("Валюта",                Справочники.Валюты.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ВыводитьСумму",         Ложь);
	ПараметрыЗаполнения.Вставить("ВыводитьКоличество",    Ложь);
	ПараметрыЗаполнения.Вставить("ВыводитьКодификатор",   Истина);
	ПараметрыЗаполнения.Вставить("ПоляГруппировок",       Новый ТаблицаЗначений);
	ПараметрыЗаполнения.Вставить("ВариантВывода",         0);
	ПараметрыЗаполнения.Вставить("ОтборБюджет",           Справочники.бит_Бюджеты.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Сортировка",            "Кодификатор");
	ПараметрыЗаполнения.Вставить("ИспользоватьКоэффициентыСтатей", Ложь);
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

// Процедура получает при помощи СКД таблицу сводного бюджета.
//
// Параметры:
//  ПараметрыЗаполнения	 - Структура - см. НовыеПараметрыЗаполненияСводногоБюджета().
//  АдресВХранилище		 - Строка	 - Адрес временного хранилища результатов заполнения таблицы.
//
Процедура ЗаполнитьСводныйБюджет(ПараметрыЗаполнения, АдресВХранилище = "") Экспорт
	
	РезультатЗаполнения = Новый Структура;
	РезультатЗаполнения.Вставить("ДанныеРасшифровки");
	РезультатЗаполнения.Вставить("РезультатТабличныйДокумент");
	РезультатЗаполнения.Вставить("ТаблицаИерархии");
	РезультатЗаполнения.Вставить("СхемаКомпоновкиДанных");
	РезультатЗаполнения.Вставить("КолонкаИтогСумма", 0);
	РезультатЗаполнения.Вставить("КолонкаИтогКоличество", 0);
	РезультатЗаполнения.Вставить("СтрокаОбщиеИтоги", 0);
	
	Схема     = ПараметрыЗаполнения.СхемаКомпоновкиДанных;
	Настройки = ПараметрыЗаполнения.НастройкиКомпоновщика;
	
	НастроитьПоляИГруппировки(Настройки, ПараметрыЗаполнения);
	НастроитьСортировкуСтатей(Настройки, ПараметрыЗаполнения);
	УстановитьПараметрыСхемы(Схема, Настройки, ПараметрыЗаполнения);
	
	СводнаяТаблицаБюджета = СводнаяТаблицаБюджета(ПараметрыЗаполнения);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("СводнаяТаблицаБюджета", СводнаяТаблицаБюджета);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	
	РезультатЗаполнения.СхемаКомпоновкиДанных = Схема;
		
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.ОтображатьПроцентВывода = Истина;
	РезультатТабличныйДокумент = Новый ТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(РезультатТабличныйДокумент); 	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	РезультатЗаполнения.ДанныеРасшифровки          = ДанныеРасшифровки;
	РезультатЗаполнения.РезультатТабличныйДокумент = РезультатТабличныйДокумент;
	
	РезультатЗаполнения.ТаблицаИерархии = ИерархияТабличногоДокумента(РезультатТабличныйДокумент);
	
	РезультатЗаполнения.СтрокаОбщиеИтоги = РезультатТабличныйДокумент.ВысотаТаблицы;
	КоличествоКолонок = РезультатТабличныйДокумент.ШиринаТаблицы;
	Если ПараметрыЗаполнения.ВыводитьСумму
		И ПараметрыЗаполнения.ВыводитьКоличество Тогда
		РезультатЗаполнения.КолонкаИтогСумма      = КоличествоКолонок - 1;
		РезультатЗаполнения.КолонкаИтогКоличество = КоличествоКолонок;
	ИначеЕсли ПараметрыЗаполнения.ВыводитьСумму Тогда
		РезультатЗаполнения.КолонкаИтогСумма      = КоличествоКолонок;
	ИначеЕсли ПараметрыЗаполнения.ВыводитьКоличество Тогда
		РезультатЗаполнения.КолонкаИтогКоличество = КоличествоКолонок;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(РезультатЗаполнения, АдресВХранилище);
	
КонецПроцедуры

// Функция - Конструктор параметра функции СформироватьБюджетныеОперации.
// 
// Возвращаемое значение:
//  Структура - параметры получения табличных документов:
//   * НастройкиКомпоновщика  - НастройкиКомпоновкиДанных  - настройки компоновщика данных для СКД
//   * СхемаКомпоновкиДанных - Строка - адрес хранения СКД
//
Функция НовыеПараметрыФормированияБюджетныхОпераций() Экспорт
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Сценарий",             Справочники.СценарииПланирования.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Валюта",               Справочники.Валюты.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ТаблицаБюджта",        Новый ТаблицаЗначений);
	ПараметрыЗаполнения.Вставить("АналитикиДетализации", Новый Массив);
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

// Процедура получает при помощи СКД таблицу сводного бюджета.
//
// Параметры:
//  ПараметрыЗаполнения	 - Структура - см. НовыеПараметрыФормированияБюджетныхОпераций().
//  АдресВХранилище		 - Строка	 - Адрес временного хранилища результатов заполнения таблицы.
//
Процедура СформироватьБюджетныеОперации(ПараметрыЗаполнения, АдресВХранилище = "") Экспорт
	
	РезультатЗаполнения = Новый Структура;
	РезультатЗаполнения.Вставить("СозданныеДокументы");
	
	Сценарий             = ПараметрыЗаполнения.Сценарий;
	Валюта               = ПараметрыЗаполнения.Валюта;
	ТаблицаБюджта        = ПараметрыЗаполнения.ТаблицаБюджта;
	АналитикиДетализации = ПараметрыЗаполнения.АналитикиДетализации;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ПоляТаблицыБюджета
	|ПОМЕСТИТЬ ТаблицаБюджта
	|ИЗ
	|	&ТаблицаБюджта КАК ТаблицаБюджта";
	ШаблонПоляВыборки = "ТаблицаБюджта.%1 КАК %1";
	ПоляВыборки       = Новый Массив;
	Для каждого КолонкаБюджета Из ТаблицаБюджта.Колонки Цикл
		Если НЕ ЗначениеЗаполнено(КолонкаБюджета.ТипЗначения) Тогда
			Продолжить;
		КонецЕсли;
		ПоляВыборки.Добавить(СтрШаблон(ШаблонПоляВыборки, КолонкаБюджета.Имя));
	КонецЦикла;
	ПоляТаблицыБюджета = СтрСоединить(ПоляВыборки, "," + Символы.ПС + Символы.Таб);
	ТекстЗапроса       = СтрЗаменить(ТекстЗапроса, "&ПоляТаблицыБюджета", ПоляТаблицыБюджета);
	Запрос.Текст       = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаБюджта", ТаблицаБюджта);
	Запрос.Выполнить();
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ПоляТаблицыБюджета
	|ИЗ
	|	ТаблицаБюджта КАК ТаблицаБюджта";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляТаблицыБюджета", ПоляТаблицыБюджета);
	
	КоличествоГруппировок          = АналитикиДетализации.Количество();
	РазбиватьДокументыПоАналитикам = (КоличествоГруппировок > 0);
	
	Если РазбиватьДокументыПоАналитикам Тогда
		ТекстЗапроса = ТекстЗапроса +
		"
		|ИТОГИ ПО
		|	" + СтрСоединить(АналитикиДетализации, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;	
	Запрос.Текст     = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	
	СозданныеДокументы = Новый СписокЗначений;
	Если НЕ РазбиватьДокументыПоАналитикам Тогда
		ПараметрыБюджетнойОперации = Новый Структура;
		ПараметрыБюджетнойОперации.Вставить("Сценарий",        Сценарий);
		ПараметрыБюджетнойОперации.Вставить("ВалютаДокумента", Валюта);
		ВыборкаБюджета = РезультатЗапроса.Выбрать();
		СформироватьБюджетнуюОперацию(ВыборкаБюджета, ПараметрыБюджетнойОперации, СозданныеДокументы);
	Иначе
		ПараметрыБюджетнойОперации = Новый Структура(СтрСоединить(АналитикиДетализации, ","));
		ПараметрыБюджетнойОперации.Вставить("Сценарий",        Сценарий);
		ПараметрыБюджетнойОперации.Вставить("ВалютаДокумента", Валюта);
		СформироватьБюджетнуюОперациюРекурсивно(РезультатЗапроса, ПараметрыБюджетнойОперации, 1, КоличествоГруппировок, СозданныеДокументы);
	КонецЕсли;
	РезультатЗаполнения.СозданныеДокументы = СозданныеДокументы;
	
	ПоместитьВоВременноеХранилище(РезультатЗаполнения, АдресВХранилище);
	
КонецПроцедуры

Функция НаименованиеОбъектаСохраняемыхНастроек() Экспорт
	
	Возврат Метаданные.Обработки.бит_СводныйБюджет.ПолноеИмя();
	
КонецФункции

Функция НовыеПараметрыЗаполненияДанныхБюджетаПоАналитикам() Экспорт
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ТаблицаИзменений", Новый ТаблицаЗначений);
	ПараметрыЗаполнения.Вставить("НачалоПериода",    '00010101');
	ПараметрыЗаполнения.Вставить("ОкончаниеПериода", '00010101');
	ПараметрыЗаполнения.Вставить("Сценарий",         Справочники.СценарииПланирования.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Валюта",           Справочники.Валюты.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Аналитики",        Новый Структура);
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

Процедура ЗаполнитьДанныеБюджетаПоАналитикам(ТаблицаПриемник, ПараметрыЗаполнения) Экспорт
	
	ЗаполнитьБюджетПоДаннымРегистра(ТаблицаПриемник, ПараметрыЗаполнения);
	
	Для каждого СтрокаИстоник Из ПараметрыЗаполнения.ТаблицаИзменений Цикл
		НоваяСтрокаПриемника = ТаблицаПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПриемника, СтрокаИстоник);
	КонецЦикла;
	
КонецПроцедуры

Функция ПриведеннаяСхемаКомпоновки(НастройкаПолей = Неопределено) Экспорт
	
	СхемаКомпоновкиДанных = Обработки.бит_СводныйБюджет.ПолучитьМакет("СхемаКомпоновкиДанных");
	ДобавитьПоляАналитикВНаборДанных(СхемаКомпоновкиДанных);
	УстановитьОграниченияАналитик(СхемаКомпоновкиДанных, НастройкаПолей);
	Возврат СхемаКомпоновкиДанных;
	
КонецФункции

Функция ФормироватьВРазрезеБюджета(ВариантВывода) Экспорт
	
	Возврат (ВариантВывода = 1);
	
КонецФункции

#КонецОбласти

