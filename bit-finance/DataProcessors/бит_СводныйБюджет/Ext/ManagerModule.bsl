Функция ИерархияТабличногоДокумента(ТабличныйДокумент)
	
	ТипЧисло        = Новый ОписаниеТипов("Число");
	ТаблицаИерархии = Новый ТаблицаЗначений;
	ТаблицаИерархии.Колонки.Добавить("Группа",    ТипЧисло);
	ТаблицаИерархии.Колонки.Добавить("Начало",    ТипЧисло);
	ТаблицаИерархии.Колонки.Добавить("Окончание", ТипЧисло);
	
	ДокументXDTO = СериализаторXDTO.ЗаписатьXDTO(ТабличныйДокумент);
	ТаблицаГрупп = ДокументXDTO.vg;
	Для каждого СтрокаГруппы Из ТаблицаГрупп Цикл
		НачалоГруппы    = СтрокаГруппы.b;
		ОкончаниеГруппы = СтрокаГруппы.e;
		
		СтрокаИерархии = ТаблицаИерархии.Добавить();
		СтрокаИерархии.Группа = НачалоГруппы;
		СтрокаИерархии.Начало = НачалоГруппы + 1;
		Если ЗначениеЗаполнено(ОкончаниеГруппы) Тогда
			СтрокаИерархии.Окончание = ОкончаниеГруппы + 1;
		Иначе
			СтрокаИерархии.Окончание = НачалоГруппы + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаИерархии;
	
КонецФункции

Процедура НастроитьПоляИГруппировки(Настройки, ПараметрыЗаполнения)
	
	ПолеСумма      = Новый ПолеКомпоновкиДанных("Сумма");
	ПолеКоличество = Новый ПолеКомпоновкиДанных("Количество");
	Для каждого ВыбранноеПоле Из Настройки.Выбор.Элементы Цикл
		Если ВыбранноеПоле.Поле = ПолеСумма Тогда
			ВыбранноеПоле.Использование = ПараметрыЗаполнения.ВыводитьСумму;
		ИначеЕсли ВыбранноеПоле.Поле = ПолеКоличество Тогда
			ВыбранноеПоле.Использование = ПараметрыЗаполнения.ВыводитьКоличество;
		КонецЕсли;
	КонецЦикла;
	
	КоллекцияЭлементовСтруктуры = Настройки.Структура[0].Строки;
	КоллекцияЭлементовСтруктуры.Очистить();
	
	Для каждого СтрокаГруппировки Из ПараметрыЗаполнения.ПоляГруппировок Цикл
		Если НЕ СтрокаГруппировки.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяГруппировка = КоллекцияЭлементовСтруктуры.Добавить();
		НоваяГруппировка.Использование = Истина;
		
		КоллекцияПолей = НоваяГруппировка.ПоляГруппировки.Элементы;
		
		ПолеГруппировки = КоллекцияПолей.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных(СтрокаГруппировки.ИмяПоля);
		ПолеГруппировки.ТипГруппировки = СтрокаГруппировки.ТипГруппировки;
		ПолеГруппировки.Использование  = Истина;
		
		НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
		
		КоллекцияЭлементовСтруктуры    = НоваяГруппировка.Структура;
	КонецЦикла;
	
КонецПроцедуры

Процедура НастроитьСортировкуСтатей(Настройки, ПараметрыЗаполнения)
	
	ЭлементыПорядка = Настройки.Порядок.Элементы;
	ЭлементыПорядка.Очистить();
	
	ЭлементСортировки = ЭлементыПорядка.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ШаблонСортировки = "%1.%2";
	Если ФормироватьВРазрезеБюджета(ПараметрыЗаполнения.ВариантВывода) Тогда
		ПолеСортировки = "СтатьяБюджета";
	Иначе
		ПолеСортировки = "СтатьяОборотов";
	КонецЕсли;
	ПолеСортировки = СтрШаблон(ШаблонСортировки, ПолеСортировки, ПараметрыЗаполнения.Сортировка);
	ЭлементСортировки.Поле = Новый ПолеКомпоновкиДанных(ПолеСортировки);
	
	ЭлементыПорядка.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
КонецПроцедуры

Процедура УстановитьПараметрыСхемы(Схема, Настройки, ПараметрыЗаполнения)
	
	Если Настройки.ПараметрыДанных.Элементы.Найти("ВыводитьКодификатор") = Неопределено Тогда
		Схема.Параметры.ВыводитьКодификатор.Значение = ПараметрыЗаполнения.ВыводитьКодификатор;
	Иначе
		ПараметрыДанных = Настройки.ПараметрыДанных;
		ПараметрыДанных.УстановитьЗначениеПараметра("ВыводитьКодификатор", ПараметрыЗаполнения.ВыводитьКодификатор);
	КонецЕсли;
	
КонецПроцедуры

Функция СводнаяТаблицаБюджета(ПараметрыЗаполнения)
	
	ТаблицаПериодов = ТаблицаПериодов(ПараметрыЗаполнения);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПериодов.НачалоПериода КАК НачалоПериода,
	|	ТаблицаПериодов.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТаблицаПериодов.ПредставлениеПериода КАК ПредставлениеПериода
	|ПОМЕСТИТЬ ТаблицаПериодов
	|ИЗ
	|	&ТаблицаПериодов КАК ТаблицаПериодов";
	Запрос.УстановитьПараметр("ТаблицаПериодов", ТаблицаПериодов);
	Запрос.Выполнить();
	
	ТекстЗапроса = ТекстЗапросаМатрицаИзмеренийСводнойТаблицы(ПараметрыЗаполнения);
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаВыборкиПолейСводнойТаблицы(ПараметрыЗаполнения);
	
	Запрос.УстановитьПараметр("Сценарий",         ПараметрыЗаполнения.Сценарий);
	Запрос.УстановитьПараметр("НачалоПериода",    ПараметрыЗаполнения.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ПараметрыЗаполнения.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Валюта",           ПараметрыЗаполнения.Валюта);
	Запрос.УстановитьПараметр("ОтборБюджет",      ПараметрыЗаполнения.ОтборБюджет);
	
	ПериодичностьОборотов = бит_Бюджетирование.ПериодДляРазворотаТаблицыЗапроса(ПараметрыЗаполнения.Периодичность);
	ТекстЗапроса          = СтрЗаменить(ТекстЗапроса, "Декада", ПериодичностьОборотов);
	Запрос.Текст          = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();
	
КонецФункции

Функция ТаблицаПериодов(ПараметрыЗаполнения)
	
	ТаблицаПериодов = Новый ТаблицаЗначений;
	ТипДата         = Новый ОписаниеТипов("Дата", , ,
						Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ТаблицаПериодов.Колонки.Добавить("Период",           ТипДата);
	ТаблицаПериодов.Колонки.Добавить("НачалоПериода",    ТипДата);
	ТаблицаПериодов.Колонки.Добавить("ОкончаниеПериода", ТипДата);
	ТаблицаПериодов.Колонки.Добавить("ПредставлениеПериода", Новый ОписаниеТипов("Строка", ,
															 Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	Периодичность = ПараметрыЗаполнения.Периодичность;
	ДатаНачала    = ПараметрыЗаполнения.Период.ДатаНачала;
	ДатаОкончания = ПараметрыЗаполнения.Период.ДатаОкончания;
	
	ПараметрыДаты = Перечисления.бит_ПериодичностьПланирования.ПараметрыДатыПоПериодичности(ДатаНачала, Периодичность);
	Пока ПараметрыДаты.ДатаНачала <= ДатаОкончания Цикл
		НоваяСтрокаПериода = ТаблицаПериодов.Добавить();
		НоваяСтрокаПериода.Период               = ПараметрыДаты.ДатаНачала;
		НоваяСтрокаПериода.НачалоПериода        = ПараметрыДаты.ДатаНачала;
		НоваяСтрокаПериода.ОкончаниеПериода     = ПараметрыДаты.ДатаОкончания;
		НоваяСтрокаПериода.ПредставлениеПериода = ПредставлениеПериода(ПараметрыДаты.ДатаНачала,
													ПараметрыДаты.ДатаОкончания);
		
		ПараметрыДаты = Перечисления.бит_ПериодичностьПланирования.ПараметрыДатыПоПериодичности(
							ПараметрыДаты.ДатаОкончания + 1, Периодичность);
	КонецЦикла;
	
	Возврат ТаблицаПериодов;
	
КонецФункции

Функция ТекстЗапросаМатрицаИзмеренийСводнойТаблицы(ПараметрыЗаполнения)
	
	ПоляГруппировок = ПараметрыЗаполнения.ПоляГруппировок;
	
	ШаблонВыборкиИзИсточника =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаИсточник.Ссылка КАК %2
	|ПОМЕСТИТЬ Источник_%2
	|ИЗ
	|	%1 КАК ТаблицаИсточник
	|ГДЕ
	|	НЕ ТаблицаИсточник.ПометкаУдаления
	|	И &УсловиеОтбора";
	
	ШаблонПустойВыборки =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗНАЧЕНИЕ(%1.ПустаяСсылка) КАК %2
	|ПОМЕСТИТЬ Источник_%2";
	
	ТаблицыИсточники = Новый Массив;
	ШаблонИсточника  = "Источник_%1 КАК Источник_%1";
	ПоляВыбора       = Новый Массив;
	ШаблонПоляВыбора = "Источник_%1.%1 КАК %1";
	
	ТекстыИсточников = Новый Массив;
	Для каждого СтрокаГруппы Из ПоляГруппировок Цикл
		Если СтрокаГруппы.ИмяПоля = "СтатьяБюджета" Тогда
			ТекстИсточника =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаИсточник.Ссылка КАК СтатьяБюджета,
			|	ТаблицаИсточник.СтатьяОборотов КАК СтатьяОборотов
			|ПОМЕСТИТЬ Источник_СтатьяБюджета
			|ИЗ
			|	Справочник.бит_СтатьиБюджета КАК ТаблицаИсточник
			|ГДЕ
			|	НЕ ТаблицаИсточник.ЭтоГруппа
			|	И НЕ ТаблицаИсточник.ПометкаУдаления
			|	И ТаблицаИсточник.Владелец = &ОтборБюджет";
			ТекстыИсточников.Добавить(ТекстИсточника);
			
			ПоляВыбора.Добавить("Источник_СтатьяБюджета.СтатьяБюджета КАК СтатьяБюджета");
			ПоляВыбора.Добавить("Источник_СтатьяБюджета.СтатьяОборотов КАК СтатьяОборотов");
			
			ТаблицыИсточники.Добавить("Источник_СтатьяБюджета КАК Источник_СтатьяБюджета");
			Продолжить;
		КонецЕсли;
		
		МетаданныеСправочника = Метаданные.НайтиПоПолномуИмени(СтрокаГруппы.ИмяМетаданных);
		
		ТекстИсточника = "";
		УсловиеОтбора  = "";
		Если СтрокаГруппы.Использование Тогда
			ТекстИсточника = ШаблонВыборкиИзИсточника;
			Если МетаданныеСправочника.Иерархический
				И МетаданныеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
				УсловиеОтбора = "НЕ ТаблицаИсточник.ЭтоГруппа";
			Иначе
				УсловиеОтбора = "ИСТИНА";
			КонецЕсли;
			ТекстИсточника = СтрЗаменить(ТекстИсточника, "&УсловиеОтбора", УсловиеОтбора);
		Иначе
			ТекстИсточника = ШаблонПустойВыборки;
		КонецЕсли;
		
		ТекстИсточника = СтрШаблон(ТекстИсточника, СтрокаГруппы.ИмяМетаданных, СтрокаГруппы.ИмяПоля);
		ТекстыИсточников.Добавить(ТекстИсточника);
		
		ТекстВыборкиПоляИсточника = СтрШаблон(ШаблонПоляВыбора, СтрокаГруппы.ИмяПоля);
		ПоляВыбора.Добавить(ТекстВыборкиПоляИсточника);
		
		ТекстВыборкиИсточника = СтрШаблон(ШаблонИсточника, СтрокаГруппы.ИмяПоля);
		ТаблицыИсточники.Добавить(ТекстВыборкиИсточника);
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(ТекстыИсточников, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
	
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	ТаблицаПериодов.НачалоПериода КАК НачалоПериода,
	|	ТаблицаПериодов.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ТаблицаПериодов.ПредставлениеПериода КАК ПредставлениеПериода,
	|	&ПоляВыбора КАК ПоляВыбора
	|ПОМЕСТИТЬ МатрицаИзмерений
	|ИЗ
	|	ТаблицаПериодов КАК ТаблицаПериодов,
	|	&ТаблицыИсточники КАК ТаблицыИсточники
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СтатьяОборотов";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
							"&ПоляВыбора КАК ПоляВыбора",
							СтрСоединить(ПоляВыбора, "," + Символы.ПС + Символы.Таб));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
							"&ТаблицыИсточники КАК ТаблицыИсточники",
							СтрСоединить(ТаблицыИсточники, "," + Символы.ПС + Символы.Таб));
							
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаВыборкиПолейСводнойТаблицы(ПараметрыЗаполнения)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОборотыПоБюджетам.Период КАК Период,
	|	&ПоляВыборкиОборотовБюджета,
	|	ОборотыПоБюджетам.СуммаОборот КАК Сумма,
	|	ОборотыПоБюджетам.КоличествоОборот КАК Количество
	|ПОМЕСТИТЬ ОборотыПоБюджетам
	|ИЗ
	|	РегистрНакопления.бит_ОборотыПоБюджетам.Обороты(&НачалоПериода, &ОкончаниеПериода, Декада, Сценарий = &Сценарий И &ОтборВалюты) КАК ОборотыПоБюджетам";
	
	ПараметрыПересчета = ПараметрыПересчетаСуммыПоВалюте(ПараметрыЗаполнения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"ОборотыПоБюджетам.СуммаОборот",
								ПараметрыПересчета.ТекстПоляВыборкиСуммы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&ОтборВалюты",
								ПараметрыПересчета.ТекстОтбораВалюты);
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	МатрицаИзмерений.НачалоПериода КАК Период,
	|	МатрицаИзмерений.ОкончаниеПериода КАК ОкончаниеПериода,
	|	МатрицаИзмерений.ПредставлениеПериода КАК ПредставлениеПериода,
	|	&ПоляВыборкиИзмерений,
	|	&ПоляВыборкиПоказателей
	|ИЗ
	|	МатрицаИзмерений КАК МатрицаИзмерений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыПоБюджетам КАК ОборотыПоБюджетам
	|		ПО &ПоляСоединения
	|			И МатрицаИзмерений.НачалоПериода = ОборотыПоБюджетам.Период";
	
	ПоляВыборкиОборотовБюджета = Новый Массив;
	ШаблонПоляВыборкиОборотов  = "ОборотыПоБюджетам.%1 КАК %1";
	ПоляВыборкиОборотовБюджета.Добавить(СтрШаблон(ШаблонПоляВыборкиОборотов, "СтатьяОборотов"));
	
	ПоляВыборкиИзмерений       = Новый Массив;
	ШаблонПоляВыборкиИзмерения = "МатрицаИзмерений.%1 КАК %1";
	ШаблонПустогоИзмерения     = "НЕОПРЕДЕЛЕНО КАК %1";
	ПоляВыборкиИзмерений.Добавить(СтрШаблон(ШаблонПоляВыборкиИзмерения, "СтатьяОборотов"));
	Если ФормироватьВРазрезеБюджета(ПараметрыЗаполнения.ВариантВывода) Тогда
		ПоляВыборкиИзмерений.Добавить(СтрШаблон(ШаблонПоляВыборкиИзмерения, "СтатьяБюджета"));
	Иначе
		ПоляВыборкиИзмерений.Добавить(СтрШаблон(ШаблонПустогоИзмерения, "СтатьяБюджета"));
	КонецЕсли;
	
	ПоляСоединения             = Новый Массив;
	ШаблонСоединения           = "МатрицаИзмерений.%1 = ОборотыПоБюджетам.%1";
	ПоляСоединения.Добавить(СтрШаблон(ШаблонСоединения, "СтатьяОборотов"));
	
	ПоляГруппировок            = ПараметрыЗаполнения.ПоляГруппировок;
	ИзмеренияБюджетирования    = Метаданные.РегистрыНакопления.бит_ОборотыПоБюджетам.Измерения;
	Для каждого Измерение Из ИзмеренияБюджетирования Цикл
		ИмяИзмерения = Измерение.Имя;
		Если ИмяИзмерения = "Сценарий" ИЛИ ИмяИзмерения = "Валюта" ИЛИ ИмяИзмерения = "СтатьяОборотов" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ГруппировкаИспользуется(ПоляГруппировок, ИмяИзмерения)	Тогда
			ПоляВыборкиОборотовБюджета.Добавить(СтрШаблон(ШаблонПоляВыборкиОборотов, ИмяИзмерения));
			ПоляВыборкиИзмерений.Добавить(СтрШаблон(ШаблонПоляВыборкиИзмерения, ИмяИзмерения));
			ПоляСоединения.Добавить(СтрШаблон(ШаблонСоединения, ИмяИзмерения));
		Иначе
			ПоляВыборкиИзмерений.Добавить(СтрШаблон(ШаблонПустогоИзмерения, ИмяИзмерения));
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&ПоляВыборкиОборотовБюджета",
								СтрСоединить(ПоляВыборкиОборотовБюджета, "," + Символы.ПС + Символы.Таб));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&ПоляВыборкиИзмерений",
								СтрСоединить(ПоляВыборкиИзмерений, "," + Символы.ПС + Символы.Таб));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&ПоляСоединения",
								СтрСоединить(ПоляСоединения, Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "И "));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляВыборкиПоказателей", ТекстПолейВыборкиПоказателей(ПараметрыЗаполнения));
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ГруппировкаИспользуется(ПоляГруппировок, ИмяГруппировки)
	
	СтрокаГруппировки = ПоляГруппировок.Найти(ИмяГруппировки, "ИмяПоля");
	Если СтрокаГруппировки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтрокаГруппировки.Использование;
	
КонецФункции

Функция ТекстПолейВыборкиПоказателей(ПараметрыЗаполнения)
	
	Если ПараметрыЗаполнения.ИспользоватьКоэффициентыСтатей
		И ФормироватьВРазрезеБюджета(ПараметрыЗаполнения.ВариантВывода) Тогда
		ШаблонПоля =
		"ЕСТЬNULL(ВЫБОР
		|	КОГДА МатрицаИзмерений.СтатьяБюджета.Коэффициент = 0 ТОГДА
		|		1
		|	ИНАЧЕ
		|		МатрицаИзмерений.СтатьяБюджета.Коэффициент
		|КОНЕЦ * ОборотыПоБюджетам.%1, 0) КАК %1";
		Возврат СтрШаблон(ШаблонПоля, "Сумма") + "," + Символы.ПС + СтрШаблон(ШаблонПоля, "Количество");
	КонецЕсли;
	
	Возврат "ЕСТЬNULL(ОборотыПоБюджетам.Сумма, 0) КАК Сумма,
	|	ЕСТЬNULL(ОборотыПоБюджетам.Количество, 0) КАК Количество";
	
КонецФункции

#КонецОбласти

#Область ФормированиеБюджетныхОпераций

Процедура СформироватьБюджетнуюОперацию(ВыборкаБюджета, ПараметрыБюджетнойОперации, СозданныеДокументы)
	
	БюджетнаяОперация = Документы.бит_БюджетнаяОперация.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(БюджетнаяОперация, ПараметрыБюджетнойОперации);
	БюджетнаяОперация.Дата = ТекущаяДатаСеанса();
	БюджетнаяОперация.Заполнить(Неопределено);
	БюджетнаяОперация.ВалютаДокумента = ПараметрыБюджетнойОперации.ВалютаДокумента;
	БюджетнаяОперация.ИзменениеВалютыОбъект();
	ЗаполнитьЗначенияСвойств(БюджетнаяОперация, ПараметрыБюджетнойОперации);
	Пока ВыборкаБюджета.Следующий() Цикл
		НоваяСтрокаБюджета = БюджетнаяОперация.БДДС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаБюджета, ВыборкаБюджета);
	КонецЦикла;
	БюджетнаяОперация.Записать(РежимЗаписиДокумента.Проведение);
	СозданныеДокументы.Добавить(БюджетнаяОперация.Ссылка);
	
КонецПроцедуры

Процедура СформироватьБюджетнуюОперациюРекурсивно(ВыборкаРодитель, ПараметрыБюджетнойОперации, ТекущийУровень, КоличествоГруппировок, СозданныеДокументы)
	
	Выборка = ВыборкаРодитель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		Если ТекущийУровень = КоличествоГруппировок Тогда
			ВыборкаБюджета = Выборка.Выбрать();
			СформироватьБюджетнуюОперацию(ВыборкаБюджета, ПараметрыБюджетнойОперации, СозданныеДокументы);
		Иначе
			СформироватьБюджетнуюОперациюРекурсивно(Выборка, ПараметрыБюджетнойОперации, ТекущийУровень + 1, КоличествоГруппировок, СозданныеДокументы)	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеБюджетаПоАналиткам

Процедура ЗаполнитьБюджетПоДаннымРегистра(ТаблицаПриемник, ПараметрыЗаполнения)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОборотыПоБюджетам.Регистратор КАК Регистратор,
	|	ОборотыПоБюджетам.ЦФО КАК ЦФО,
	|	ОборотыПоБюджетам.СтатьяОборотов КАК СтатьяОборотов,
	|	ОборотыПоБюджетам.Количество КАК Количество,
	|	&РесурсСумма КАК Сумма,
	|	ОборотыПоБюджетам.Комментарий КАК Комментарий,
	|	ИСТИНА КАК ТолькоЧтение,
	|	&ПоляАналитик КАК ПоляАналитик
	|ПОМЕСТИТЬ ОборотыПоБюджетам
	|ИЗ
	|	РегистрНакопления.бит_ОборотыПоБюджетам КАК ОборотыПоБюджетам
	|ГДЕ
	|	ОборотыПоБюджетам.Активность
	|	И ОборотыПоБюджетам.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|	И ОборотыПоБюджетам.Сценарий = &Сценарий
	|	И &ОтборВалюты
	|	И &УсловияАналитик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОборотыПоБюджетам.Регистратор КАК Регистратор,
	|	ОборотыПоБюджетам.ЦФО КАК ЦФО,
	|	ОборотыПоБюджетам.СтатьяОборотов КАК СтатьяОборотов,
	|	ОборотыПоБюджетам.Количество КАК Количество,
	|	ОборотыПоБюджетам.Сумма КАК Сумма,
	|	ОборотыПоБюджетам.Комментарий КАК Комментарий,
	|	ОборотыПоБюджетам.ТолькоЧтение КАК ТолькоЧтение,
	|	СтатусыОбъектов.Статус КАК Статус,
	|	&ПоляАналитик КАК ПоляАналитик
	|ИЗ
	|	ОборотыПоБюджетам КАК ОборотыПоБюджетам
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтатусыОбъектов КАК СтатусыОбъектов
	|		ПО ОборотыПоБюджетам.Регистратор = СтатусыОбъектов.Объект";
	Запрос.УстановитьПараметр("НачалоПериода"   , ПараметрыЗаполнения.НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ПараметрыЗаполнения.ОкончаниеПериода);
	Запрос.УстановитьПараметр("Сценарий"        , ПараметрыЗаполнения.Сценарий);
	Запрос.УстановитьПараметр("Валюта"          , ПараметрыЗаполнения.Валюта);
	
	ПараметрыПересчета = ПараметрыПересчетаСуммыПоВалютеПлоскойТаблицыОборотов(ПараметрыЗаполнения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&РесурсСумма",
								ПараметрыПересчета.ТекстПоляВыборкиСуммы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&ОтборВалюты",
								ПараметрыПересчета.ТекстОтбораВалюты);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
								"&ПоляАналитик КАК ПоляАналитик",
								ТекстЗапросаВыборкиПолейАналитик());
	
	ТекстУсловияАналитик = "ИСТИНА";
	ШаблонУсловия       = "ОборотыПоБюджетам.%1 = &%1";
	УсловияАналитик     = Новый Массив;
	Аналитики           = ПараметрыЗаполнения.Аналитики;
	Для каждого Аналитика Из Аналитики Цикл
		ИмяАналитики = Аналитика.Ключ;
		УсловияАналитик.Добавить(СтрШаблон(ШаблонУсловия, ИмяАналитики));
		Запрос.УстановитьПараметр(ИмяАналитики, Аналитика.Значение);
	КонецЦикла;
	Если УсловияАналитик.Количество() > 0 Тогда
		ТекстУсловияАналитик = СтрСоединить(УсловияАналитик, Символы.ПС + Символы.Таб + "И" + " ");
	КонецЕсли;
	ТекстЗапроса     = СтрЗаменить(ТекстЗапроса, "&УсловияАналитик", ТекстУсловияАналитик);
	Запрос.Текст     = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ТипЗнч(ТаблицаПриемник) = Тип("ТаблицаЗначений") Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрокаПриемника = ТаблицаПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПриемника, Выборка);
		КонецЦикла;
	Иначе
		ДвиженияРегистра = РезультатЗапроса.Выгрузить();
		ТаблицаПриемник.Загрузить(ДвиженияРегистра);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаВыборкиПолейАналитик()
	
	ВыборкиАналитик   = Новый Массив;
	ШаблонВыборкиПоля = "ОборотыПоБюджетам.%1 КАК %1";
	Аналитики         = бит_МеханизмДопИзмерений.Аналитики();
	Для каждого ИмяАналитики Из Аналитики Цикл
		ВыборкиАналитик.Добавить(СтрШаблон(ШаблонВыборкиПоля, ИмяАналитики));
	КонецЦикла;
	ТекстВыборки = СтрСоединить(ВыборкиАналитик, "," + Символы.ПС + Символы.Таб);
	
	Возврат ТекстВыборки;
	
КонецФункции

#КонецОбласти

#Область ЗаполенениеПереопределяемыхАналитик

Процедура ДобавитьПоляАналитикВНаборДанных(СхемаКомпоновкиДанных)
	
	ПоляНабораДанных = СхемаКомпоновкиДанных.НаборыДанных.СводнаяТаблицаБюджета.Поля;
	Аналитики        = бит_МеханизмДопИзмерений.Аналитики(Истина);
	Для каждого ОписаниеАналитики Из Аналитики Цикл
		ИмяПоля = ОписаниеАналитики.Имя;
		
		ПолеАналитикиСКД = ПоляНабораДанных.Найти(ИмяПоля);
		Если ПолеАналитикиСКД <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеАналитикиСКД = ПоляНабораДанных.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеАналитикиСКД.Поле        = ИмяПоля;
		ПолеАналитикиСКД.ПутьКДанным = ИмяПоля;
		Если НЕ ОписаниеАналитики.Используется Тогда
			УстановитьОграниченияИспользованияПоляСКД(ПоляНабораДанных, ИмяПоля);
		Иначе
			ПолеАналитикиСКД.ТипЗначения = ОписаниеАналитики.ТипЗначения;
			ПолеАналитикиСКД.Заголовок   = ОписаниеАналитики.Синоним;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьОграниченияАналитик(СхемаКомпоновкиДанных, НастройкаПолей)
	
	ПоляНабораДанных      = СхемаКомпоновкиДанных.НаборыДанных.СводнаяТаблицаБюджета.Поля;
	НастройкиИзмерений    = бит_МеханизмДопИзмеренийПовтИсп.НастройкиДополнительныхИзмерений();
	КоличествоАналитик    = бит_МеханизмДопИзмерений.ПолучитьМаксимальноеКоличествоДополнительныхИзмерений();
	
	Для Сч = 1 По КоличествоАналитик Цикл
		ИмяАналитики = "Аналитика_"  + Сч;
		
		НастройкиИзмерения = НастройкиИзмерений.Получить(ИмяАналитики);
		Если НастройкиИзмерения = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеАналитикиСКД = ПоляНабораДанных.Найти(ИмяАналитики);
		УстановитьОграниченияИспользованияПоляСКД(ПоляНабораДанных, ИмяАналитики, Ложь);
		ПолеАналитикиСКД.Заголовок   = НастройкиИзмерения.Синоним;
		ПолеАналитикиСКД.ТипЗначения = НастройкиИзмерения.ТипЗначения;
	КонецЦикла;
	
	Если НастройкаПолей <> Неопределено Тогда
		Для каждого СтрокаНастройки Из НастройкаПолей Цикл
			ИмяАналитики     = СтрокаНастройки.ИмяПоля;
			ПолеАналитикиСКД = ПоляНабораДанных.Найти(ИмяАналитики);
			УстановитьОграниченияИспользованияПоляСКД(ПоляНабораДанных, ИмяАналитики, НЕ СтрокаНастройки.Использование);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ПараметрыПересчетаСуммыПоВалюте(ПараметрыЗаполнения)
	
	ПраметрыПересчета = Новый Структура;
	ПраметрыПересчета.Вставить("ТекстПоляВыборкиСуммы", "ОборотыПоБюджетам.СуммаОборот");
	ПраметрыПересчета.Вставить("ТекстОтбораВалюты",     "ИСТИНА");
	
	Если ПараметрыЗаполнения.Валюта = Константы.бит_ВалютаУправленческогоУчета.Получить() Тогда
		ПраметрыПересчета.ТекстПоляВыборкиСуммы = "ОборотыПоБюджетам.СуммаУпрОборот";
	ИначеЕсли ПараметрыЗаполнения.Валюта = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		ПраметрыПересчета.ТекстПоляВыборкиСуммы = "ОборотыПоБюджетам.СуммаРеглОборот";
	ИначеЕсли ПараметрыЗаполнения.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗаполнения.Сценарий,
																						"Валюта") Тогда
		ПраметрыПересчета.ТекстПоляВыборкиСуммы = "ОборотыПоБюджетам.СуммаСценарийОборот";
	Иначе
		ПраметрыПересчета.ТекстОтбораВалюты = "Валюта = &Валюта";
	КонецЕсли;
	
	Возврат ПраметрыПересчета;
	
КонецФункции

Функция ПараметрыПересчетаСуммыПоВалютеПлоскойТаблицыОборотов(ПараметрыЗаполнения)
	
	ПраметрыПересчета = Новый Структура;
	ПраметрыПересчета.Вставить("ТекстПоляВыборкиСуммы", "");
	ПраметрыПересчета.Вставить("ТекстОтбораВалюты",     "ИСТИНА");
	
	ПолеСуммы = "Сумма";
	Если ПараметрыЗаполнения.Валюта = Константы.бит_ВалютаУправленческогоУчета.Получить() Тогда
		ПолеСуммы = "СуммаУпр";
	ИначеЕсли ПараметрыЗаполнения.Валюта = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		ПолеСуммы = "СуммаРегл";
	ИначеЕсли ПараметрыЗаполнения.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗаполнения.Сценарий,
																						"Валюта") Тогда
		ПолеСуммы = "СуммаСценарий";
	Иначе
		ПраметрыПересчета.ТекстОтбораВалюты = "ОборотыПоБюджетам.Валюта = &Валюта";
	КонецЕсли;
	
	ПраметрыПересчета.ТекстПоляВыборкиСуммы = "ОборотыПоБюджетам." + ПолеСуммы;
	
	Возврат ПраметрыПересчета;
	
КонецФункции

Процедура УстановитьОграниченияИспользованияПоляСКД(ПоляНабораДанных, ИмяПоля, Ограничение = Истина)
	
	ПолеАналитикиСКД = ПоляНабораДанных.Найти(ИмяПоля);
	Если ПолеАналитикиСКД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеАналитикиСКД.ОграничениеИспользования.Группировка = Ограничение;
	ПолеАналитикиСКД.ОграничениеИспользования.Поле        = Ограничение;
	ПолеАналитикиСКД.ОграничениеИспользования.Порядок     = Ограничение;
	ПолеАналитикиСКД.ОграничениеИспользования.Условие     = Ограничение;	
	
	ПолеАналитикиСКД.ОграничениеИспользованияРеквизитов.Группировка = Ограничение;
	ПолеАналитикиСКД.ОграничениеИспользованияРеквизитов.Поле        = Ограничение;
	ПолеАналитикиСКД.ОграничениеИспользованияРеквизитов.Порядок     = Ограничение;
	ПолеАналитикиСКД.ОграничениеИспользованияРеквизитов.Условие     = Ограничение;	
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли