#КонецОбласти

&НаКлиенте
Функция ПериодЗаполненПравильно()

	ЗаполненПравильно = Истина;
		
	ПутьКДанным = "";
	Если ИнтервалДатРегистрации.ДатаНачала > ИнтервалДатРегистрации.ДатаОкончания Тогда
		ТекстОшибки = НСтр("ru = 'Конец периода должен быть больше начала'; en = 'The end of the period must be greater than the beginning'");
		ПутьКДанным = "ИнтервалДатРегистрации.ДатаОкончания";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПутьКДанным) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, ПутьКДанным);
		ЗаполненПравильно = Ложь;
	КонецЕсли;
	
	ПутьКДанным = "";
	Если ИнтервалДатСобытий.ДатаНачала > ИнтервалДатСобытий.ДатаОкончания Тогда
		ТекстОшибки = НСтр("ru = 'Конец периода должен быть больше начала'; en = 'The end of the period must be greater than the beginning'");
		ПутьКДанным = "ИнтервалДатСобытий.ДатаОкончания";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПутьКДанным) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, ПутьКДанным);
		ЗаполненПравильно = Ложь;
	КонецЕсли;
	
	Возврат ЗаполненПравильно; 

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	Элементы = Форма.Элементы;
	
	Элементы.НастроитьРасписаниеОтложеннаяТрансляция.Доступность = Форма.ОтложеннаяТрансляцияИспользование;
	Элементы.НастроитьРасписаниеОчисткаОчереди.Доступность 		 = Форма.ОчисткаОчередиИспользование;

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
		
	РежимРегламентногоЗадания 		  = РежимОтложеннаяТрансляция();
	ОтложеннаяТрансляцияИспользование = РежимРегламентногоЗадания.Использование;

	РежимРегламентногоЗадания 	= РежимОчисткаОчередиТрансляции();
	ОчисткаОчередиИспользование = РежимРегламентногоЗадания.Использование;
	
	Если ТипЗнч(Параметры.Отбор) = Тип("Структура") Тогда
		СтандартныеНастройкиОтбораНаСервере();
		Для каждого КлючЗначение Из Параметры.Отбор Цикл
			бит_ОтчетыБФКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, КлючЗначение.Ключ, КлючЗначение.Значение);		
		КонецЦикла;
		ИнтервалДатРегистрации = Новый СтандартныйПериод;
		ИнтервалДатСобытий	   = Новый СтандартныйПериод;
		УстановитьЗаголовок(Неопределено, ЭтотОбъект);
	Иначе
		НастройкаПоУмолчанию = бит_ОтчетыСервер.НайтиНастройкуПоУмолчаниюДляОбъекта(НастраиваемыйОбъект());
		
		ПрименитьНастройки(НастройкаПоУмолчанию);
	КонецЕсли;
	
	Если ОбщегоНазначения.ЭтоВебКлиент() Или ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		УдаляемыйЭлемент = Элементы.КоличествоПоказываемыхСобытий.СписокВыбора.НайтиПоЗначению(10000);
		Элементы.КоличествоПоказываемыхСобытий.СписокВыбора.Удалить(УдаляемыйЭлемент);
		Элементы.КоличествоПоказываемыхСобытий.МаксимальноеЗначение = 1000;
		Если КоличествоПоказываемыхСобытий > 1000 Тогда
			КоличествоПоказываемыхСобытий = 1000;		
		КонецЕсли;
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекущийСписок()
	
	ИзмененыНастройки = Ложь;
	
	СкрытьНастройки();
	НачатьЗаполнениеСпискаОтложеннойТрансляции();
	
КонецПроцедуры

&НаСервере
Функция РежимОтложеннаяТрансляция()

	РежимРегламентногоЗадания = бит_МеханизмТрансляции.РежимОтложеннаяТрансляция();
	Возврат РежимРегламентногоЗадания;

КонецФункции

&НаСервере
Функция РежимОчисткаОчередиТрансляции()

	РежимРегламентногоЗадания = бит_МеханизмТрансляции.РежимОчисткаОчередиТрансляции();
	Возврат РежимРегламентногоЗадания;
	
КонецФункции

&НаКлиенте
Асинх Процедура НачатьИзменениеРасписанияРегламентногоЗадания(ИмяЗадания)
	
	Если ИмяЗадания = "ОтложеннаяТрансляция" Тогда
		СведенияОРегламентномЗадании = РежимОтложеннаяТрансляция();	
	ИначеЕсли ИмяЗадания = "ОчисткаОчереди"Тогда 
		СведенияОРегламентномЗадании = РежимОчисткаОчередиТрансляции();	
	Иначе	
		Возврат;
	КонецЕсли;
							
	Расписание = Новый РасписаниеРегламентногоЗадания;
	ЗаполнитьЗначенияСвойств(Расписание, СведенияОРегламентномЗадании.Расписание);

	Если НЕ СведенияОРегламентномЗадании.РазделениеВключено Тогда
		Диалог	   = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
		Расписание = Ждать Диалог.ОткрытьАсинх();
	КонецЕсли;
	
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	Изменения = Новый Структура;
	Изменения.Вставить("Расписание", Расписание);
	Изменения.Вставить("Использование", Истина);

	Если ИмяЗадания = "ОтложеннаяТрансляция" Тогда
		ОтложеннаяТрансляцияИспользование = Истина;	
		УстановитьРежимОтложеннаяТрансляция(Изменения);
	ИначеЕсли ИмяЗадания = "ОчисткаОчереди" Тогда 
		ОчисткаОчередиИспользование = Истина;
		УстановитьРежимУдалятьПоРасписанию(Изменения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРежимОтложеннаяТрансляция(Изменения)

	бит_МеханизмТрансляции.УстановитьРежимОтложеннаяТрансляция(Изменения);	

КонецПроцедуры

&НаСервере
Процедура УстановитьРежимУдалятьПоРасписанию(Изменения)

	бит_МеханизмТрансляции.УстановитьРежимУдалятьПоРасписанию(Изменения);

КонецПроцедуры

&НаКлиенте
Процедура НачатьПросмотрТекущегоСобытияВОтдельномОкне()

	ТекущиеДанные = Элементы.ОчередьТрансляции.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;

	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ДатаТрансляции");
	ПараметрыПередачи.Вставить("ПоставленоВОчередь");
	ПараметрыПередачи.Вставить("Объект");
	ПараметрыПередачи.Вставить("Источник");
	ПараметрыПередачи.Вставить("Приемник");
	ПараметрыПередачи.Вставить("Организация");
	ПараметрыПередачи.Вставить("Статус");
	ПараметрыПередачи.Вставить("Протокол");
	
	ЗаполнитьЗначенияСвойств(ПараметрыПередачи, ТекущиеДанные);

	ОткрытьФорму("Обработка.бит_ОтложеннаяТрансляция.Форма.Событие", ПараметрыПередачи, ЭтотОбъект, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыОтбораСобытийОчереди()

	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ИнтервалДатРегистрации", ИнтервалДатРегистрации);
	ПараметрыПередачи.Вставить("ИнтервалДатСобытий", ИнтервалДатСобытий);
	ПараметрыПередачи.Вставить("НастройкиОтчета", КомпоновщикНастроек.ПолучитьНастройки());
	ПараметрыПередачи.Вставить("АдресСхемыКомпоновкиДанных", АдресСхемыКомпоновкиДанных);

	Возврат ПараметрыПередачи;
	
КонецФункции

&НаКлиенте
Процедура ИнтервалДатСобытийПриИзменении()

	ИнтервалДатСобытий.Вариант 		 = ВариантСтандартногоПериода.ПроизвольныйПериод;
	ИнтервалДатСобытий.ДатаНачала	 = ИнтервалСобытийДатаНачала;
	ИнтервалДатСобытий.ДатаОкончания = ИнтервалСобытийДатаОкончания;

КонецПроцедуры

&НаКлиенте
Процедура ИнтервалДатРегистрацииПриИзменении()

	ИнтервалДатРегистрации.Вариант		 = ВариантСтандартногоПериода.ПроизвольныйПериод;
	ИнтервалДатРегистрации.ДатаНачала 	 = ИнтервалРегистрацииДатаНачала;
	ИнтервалДатРегистрации.ДатаОкончания = ИнтервалРегистрацииДатаОкончания;

КонецПроцедуры

