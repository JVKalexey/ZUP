&НаКлиентеНаСервереБезКонтекста
Функция НастраиваемыйОбъект()

	Возврат "Обработка.бит_ОтложеннаяТрансляция";

КонецФункции

&НаСервере
Процедура ПрименитьНастройки(НастройкаОтбораСобытий)
	
	Обработки.бит_ОтложеннаяТрансляция.ПрименитьНастройки(
		НастройкаОтбораСобытий, ЭтотОбъект);
			
	ИнтервалРегистрацииДатаНачала	 = ИнтервалДатРегистрации.ДатаНачала;
	ИнтервалРегистрацииДатаОкончания = ИнтервалДатРегистрации.ДатаОкончания;
	ИнтервалСобытийДатаНачала		 = ИнтервалДатСобытий.ДатаНачала;
	ИнтервалСобытийДатаОкончания 	 = ИнтервалДатСобытий.ДатаОкончания;
	
	СтатусыОтбор.Очистить();
	
	Для каждого Запись Из Элементы.СтатусБыстрыйОтбор.СписокВыбора Цикл
		Если ЗначениеЗаполнено(Запись.Значение) Тогда
			РезультатПоиска = Статусы.НайтиПоЗначению(Запись.Значение);
			СтатусыОтбор.Добавить(Запись.Значение, Запись.Представление, (РезультатПоиска <> Неопределено));		
		КонецЕсли;
	КонецЦикла;
	
	СтатусБыстрыйОтбор = ЗначениеСтатусБыстрыйОтбор(СтатусыОтбор);
	
	УстановитьЗаголовок(НастройкаОтбораСобытий, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовок(Настройка, Форма)
	
	Заголовок = НСтр("ru = 'Отложенная трансляция %1'; en = 'Delayed broadcast %1'");
	Если ЗначениеЗаполнено(Настройка) Тогда
		Заголовок = СтрШаблон(Заголовок, "(" + Строка(Настройка) + ")");
	Иначе	
		Заголовок = СтрШаблон(Заголовок, "");
	КонецЕсли;

	Форма.Заголовок = Заголовок;

КонецПроцедуры

// Функция создает структуру, хранящую настройки.
// 
// Возвращаемое значение:
//   СтруктураНастроек - Структура.
// 
&НаСервере
Функция СохраняемыеНастройки()
	
	СохраняемыеНастройки = Обработки.бит_ОтложеннаяТрансляция.НовыеСохраняемыеНастройки();
	ЗаполнитьЗначенияСвойств(СохраняемыеНастройки, ЭтотОбъект);
	
	СохраняемыеНастройки.НастройкиКомпоновкиДанных = КомпоновщикНастроек.ПолучитьНастройки();
	
	Возврат СохраняемыеНастройки;
	
КонецФункции

&НаКлиенте
Процедура СкрытьНастройки()

	Элементы.РазделыОбработки.ТекущаяСтраница 	  = Элементы.СтраницаОбработка;
	Элементы.ПрименитьНастройки.КнопкаПоУмолчанию = Ложь;

	Если ИзмененыНастройки Тогда
		ОбновитьТекущийСписок();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СтандартныеНастройкиОтбораНаСервере()

	Обработки.бит_ОтложеннаяТрансляция.ИнициализироватьКомпоновщик(КомпоновщикНастроек);	

КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеОтбора()

	ПредставлениеОтбора = НСтр("ru = 'Не установлен'");
	
	ЧастиСтроки = Новый Массив;
	
	Если ЗначениеЗаполнено(ИнтервалРегистрацииДатаНачала) ИЛИ ЗначениеЗаполнено(ИнтервалРегистрацииДатаОкончания) Тогда
		ПериодРегистрации = НСтр("ru = 'Зарегистрировано'") + " "
						  + ПредставлениеПериода(ИнтервалРегистрацииДатаНачала, ИнтервалРегистрацииДатаОкончания); 
		ЧастиСтроки.Добавить(ПериодРегистрации);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнтервалСобытийДатаНачала) ИЛИ ЗначениеЗаполнено(ИнтервалСобытийДатаОкончания) Тогда
		ПериодРегистрации = НСтр("ru = 'Транслировано'") + " " 
						  + ПредставлениеПериода(ИнтервалСобытийДатаНачала, ИнтервалСобытийДатаОкончания); 
		ЧастиСтроки.Добавить(ПериодРегистрации);	
	КонецЕсли;
	
	Для каждого Запись Из СтатусыОтбор Цикл
		Если Запись.Пометка Тогда
			ЧастиСтроки.Добавить(Запись.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КомпоновщикНастроек.Настройки.Отбор.Элементы) Тогда
		ЧастиСтроки.Добавить(Строка(КомпоновщикНастроек.Настройки.Отбор));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЧастиСтроки) Тогда
		ПредставлениеОтбора = СтрСоединить(ЧастиСтроки, ", ");
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеСтатусБыстрыйОтбор(Знач СтатусыОтбор)
	
	Помеченные = Новый Массив;
	Для каждого Запись Из СтатусыОтбор Цикл
		Если Запись.Пометка Тогда
			Помеченные.Добавить(Запись.Значение);		
		КонецЕсли;	
	КонецЦикла;
	
	СтатусБыстрыйОтбор = Неопределено;
	Если Помеченные.Количество() = 0 Тогда
		СтатусБыстрыйОтбор = ПредопределенноеЗначение("Перечисление.бит_СтатусыВыполненияОтложеннойТрансляции.ПустаяСсылка");
	ИначеЕсли Помеченные.Количество() = 1 Тогда	
		СтатусБыстрыйОтбор = Помеченные[0];
	КонецЕсли;

	Возврат СтатусБыстрыйОтбор;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеСтатусБыстрыйОтбор()

	Для каждого Запись Из СтатусыОтбор Цикл
		Запись.Пометка = (Запись.Значение = СтатусБыстрыйОтбор);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеПометкиВСпискеОчереди(ЗначениеФлага)

	бит_РаботаСДиалогамиКлиент.ОбработатьФлагиТаблицы(ОчередьТрансляции, 
		"Пометка", ЗначениеФлага, Элементы.ОчередьТрансляции);

КонецПроцедуры

&НаКлиенте
Функция РезультатПоискаВСписке(СтатусДляОперации = Неопределено)
	
	// Для исключения перехода на сервер выполняем сканирование списка.
	
	ПомеченоСтрок = 0;
	ВыбраноСтрок  = 0;
	
	ДанныеДляОбработки = Новый Массив;
	Для каждого СтрокаТаблицы Из ОчередьТрансляции Цикл
		Если НЕ СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;	
		
		ПомеченоСтрок = ПомеченоСтрок + 1;
		
		Если ЗначениеЗаполнено(СтатусДляОперации) И СтрокаТаблицы.Статус <> СтатусДляОперации Тогда
			Продолжить;	
		КонецЕсли;
		ВыбраноСтрок = ВыбраноСтрок + 1;
		
		ДанныеДляОбработки.Добавить(СтрокаТаблицы.ПолучитьИдентификатор());	
	КонецЦикла;
	
	РезультатПоиска = Новый Структура;
	РезультатПоиска.Вставить("ПомеченоСтрок", 	   ПомеченоСтрок);
	РезультатПоиска.Вставить("ВыбраноСтрок", 	   ВыбраноСтрок);
	РезультатПоиска.Вставить("ДанныеДляОбработки", ДанныеДляОбработки);
	
	Возврат РезультатПоиска;
	
КонецФункции

&НаКлиенте
Асинх Функция НовыйСтатус()

	ТекстВопроса = НСтр("ru = 'Как изменить статус выбранных записей?'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусыВыполненияОтложеннойТрансляции.Ожидание"), НСтр("ru = 'Поставить в очередь'"));
	Кнопки.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусыВыполненияОтложеннойТрансляции.Выполнено"), НСтр("ru = 'Отметить выполнение'"));
	Кнопки.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусыВыполненияОтложеннойТрансляции.Ошибка"), НСтр("ru = 'Считать ошибкой'"));
	Кнопки.Добавить(Неопределено, НСтр("ru = 'Отмена'"));
	
	НовыйСтатус = Ждать ВопросАсинх(ТекстВопроса, Кнопки);
	
	Возврат НовыйСтатус;

КонецФункции

#КонецОбласти