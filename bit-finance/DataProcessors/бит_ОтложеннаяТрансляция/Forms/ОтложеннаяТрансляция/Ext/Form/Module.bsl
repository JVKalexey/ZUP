
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ОбновитьТекущийСписок", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КоличествоПоказываемыхСобытийПриИзменении(Элемент)
	
	#Если ВебКлиент ИЛИ МобильныйКлиент Тогда
		КоличествоПоказываемыхСобытий = ?(КоличествоПоказываемыхСобытий > 1000, 1000, КоличествоПоказываемыхСобытий);
	#КонецЕсли
	
	ОбновитьТекущийСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусБыстрыйОтборПриИзменении(Элемент)
	
	ОбработатьИзменениеСтатусБыстрыйОтбор();
	
	ОбновитьТекущийСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусБыстрыйОтборОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеОтбораНажатие(Элемент, СтандартнаяОбработка)
	
	ОткрытьНастройки();
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтложеннаяТрансляцияИспользованиеПриИзменении(Элемент)
	
	ТекущиеПараметрыРегламентногоЗадания = РежимОтложеннаяТрансляция();
	
	Изменения = Новый Структура("Расписание", ТекущиеПараметрыРегламентногоЗадания.Расписание);
	Изменения.Вставить("Использование", ОтложеннаяТрансляцияИспользование);

	Попытка
		УстановитьРежимОтложеннаяТрансляция(Изменения);		
	Исключение
		// Ошибка доступа.
	КонецПопытки;
	
	ОтложеннаяТрансляцияИспользование = Изменения.Использование;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчисткаОчередиИспользованиеПриИзменении(Элемент)

	ТекущиеПараметрыРегламентногоЗадания = РежимОчисткаОчередиТрансляции();
	
	Изменения = Новый Структура("Расписание", ТекущиеПараметрыРегламентногоЗадания.Расписание);
	Изменения.Вставить("Использование", ОчисткаОчередиИспользование);

	Попытка
		УстановитьРежимУдалятьПоРасписанию(Изменения);		
	Исключение
		// Ошибка доступа.
	КонецПопытки;
	
	ОчисткаОчередиИспользование = Изменения.Использование;
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалРегистрацииДатаНачалаПриИзменении(Элемент)
	
	ИнтервалДатРегистрацииПриИзменении();
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалРегистрацииДатаОкончанияПриИзменении(Элемент)
	
	ИнтервалДатРегистрацииПриИзменении();
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалСобытийДатаНачалаПриИзменении(Элемент)
	
	ИнтервалДатСобытийПриИзменении();
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалСобытийДатаОкончанияПриИзменении(Элемент)
	
	ИнтервалДатСобытийПриИзменении();
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОчередьТрансляции

&НаКлиенте
Процедура ОчередьТрансляцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	НачатьПросмотрТекущегоСобытияВОтдельномОкне();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчередьТрансляцииПриАктивизацииПоля(Элемент)

	ДоступенОтборПоЗначениюВТекущейКолонке =
		Элемент.ТекущийЭлемент <> Элементы.ОчередьТрансляцииПоставленоВОчередь
		И Элемент.ТекущийЭлемент <> Элементы.ОчередьТрансляцииДатаТрансляции;
	
	Элементы.УстановитьОтборПоЗначениюКонтекст.Доступность
		= ДоступенОтборПоЗначениюВТекущейКолонке;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчередьТрансляцииПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ОчередьТрансляции.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДоступнаКомандаВыполнитьСейчас = 
		(ТекущиеДанные.Статус = ПредопределенноеЗначение("Перечисление.бит_СтатусыВыполненияОтложеннойТрансляции.Ожидание"));
		
	Элементы.КонтекстноеМенюВыполнитьСейчасКонтекст.Доступность = ДоступнаКомандаВыполнитьСейчас;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКомпоновщикНастройкиОтбор

&НаКлиенте
Процедура КомпоновщикНастройкиОтборПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКомпоновщикНастройкиПорядок

&НаКлиенте
Процедура КомпоновщикНастройкиПорядокПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтатусыОтбор
	
&НаКлиенте
Процедура СтатусыОтборПриИзменении(Элемент)
	
	ИзмененыНастройки = Истина;
	
	СтатусБыстрыйОтбор = ЗначениеСтатусБыстрыйОтбор(СтатусыОтбор);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписок(Команда)
		
	ОбновитьТекущийСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрТекущегоСобытияВОтдельномОкне(Команда)
	
	НачатьПросмотрТекущегоСобытияВОтдельномОкне();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДанныеДляПросмотра(Команда)
	
	ТекущиеДанные = Элементы.ОчередьТрансляции.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.Объект = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Эта запись не связана с данными (см. колонку ""Документ"")'"));
		Возврат;
	КонецЕсли;
	
	Попытка
		ПоказатьЗначение(, ТекущиеДанные.Объект);
	Исключение
		ТекстПредупреждения = НСтр("ru = 'Эта запись связана с данными, но отобразить их невозможно'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПериодРегистрации(Команда)
	
	Диалог 		  = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = ИнтервалДатРегистрации;
	Результат 	  = Ждать Диалог.РедактироватьАсинх();
	
	Если Результат <> Неопределено Тогда
		ИнтервалДатРегистрации			 = Результат;
		ИнтервалРегистрацииДатаНачала	 = ИнтервалДатРегистрации.ДатаНачала;
		ИнтервалРегистрацииДатаОкончания = ИнтервалДатРегистрации.ДатаОкончания;
		
		Если Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОбработка Тогда
			ОбновитьТекущийСписок();
		Иначе	
			ИзмененыНастройки = Истина;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПериодСобыйти(Команда)

	Диалог 		  = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = ИнтервалДатСобытий;
	Результат 	  = Ждать Диалог.РедактироватьАсинх();
	
	Если Результат <> Неопределено Тогда
		ИнтервалДатСобытий			 = Результат;
		ИнтервалСобытийДатаНачала	 = ИнтервалДатСобытий.ДатаНачала;
		ИнтервалСобытийДатаОкончания = ИнтервалДатСобытий.ДатаОкончания;
		
		Если Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОбработка Тогда
			ОбновитьТекущийСписок();
		Иначе	
			ИзмененыНастройки = Истина;
		КонецЕсли;		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНастройки(Команда)

	ОткрытьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоЗначениюВТекущейКолонке(Команда)
	
	ТекущиеДанные = Элементы.ОчередьТрансляции.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПустьКДанным = СтрЗаменить(Элементы.ОчередьТрансляции.ТекущийЭлемент.Имя, "ОчередьТрансляции", "");
	Значение 	 = ТекущиеДанные[ПустьКДанным];
	
	Если Элементы.ОчередьТрансляции.ТекущийЭлемент = Элементы.ОчередьТрансляцииСтатус Тогда
		СтатусыОтбор.ЗаполнитьПометки(Ложь);
		СтатусБыстрыйОтбор = Значение;
		ОбработатьИзменениеСтатусБыстрыйОтбор();
	Иначе	
		бит_ОтчетыБФКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек.Настройки, 
			ПустьКДанным, Значение, ВидСравненияКомпоновкиДанных.Равно);
	КонецЕсли;
		
	ОбновитьТекущийСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОтбор(Команда)
	
	ИнтервалРегистрацииДатаНачала	 = '0001-01-01 00:00:00';
	ИнтервалРегистрацииДатаОкончания = '0001-01-01 00:00:00';
	ИнтервалСобытийДатаНачала 		 = '0001-01-01 00:00:00';
	ИнтервалСобытийДатаОкончания	 = '0001-01-01 00:00:00';
	
	ИнтервалДатРегистрацииПриИзменении();
	ИнтервалДатСобытийПриИзменении();
	
	СтатусБыстрыйОтбор = ПредопределенноеЗначение("Перечисление.бит_СтатусыВыполненияОтложеннойТрансляции.ПустаяСсылка");
	ОбработатьИзменениеСтатусБыстрыйОтбор();
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	
	ОбновитьТекущийСписок();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьСейчас(Команда)
	
	СтатусДляОперации = ПредопределенноеЗначение("Перечисление.бит_СтатусыВыполненияОтложеннойТрансляции.Ожидание");
	РезультатПоиска	  = РезультатПоискаВСписке(СтатусДляОперации);
	
	Если РезультатПоиска.ПомеченоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Пометьте строки'");
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	ИначеЕсли РезультатПоиска.ПомеченоСтрок <> РезультатПоиска.ВыбраноСтрок Тогда	
		
		ТекстСообщения = НСтр("ru = 'Некоторые помеченные строки будут пропущены. 
                               |Только записи в статусе ""Ожидание"" могут быть источником данных для трансляции.
                               |Помечено: %1, отобрано: %2.
                               |Продолжить?'");
		
		ТекстСообщения = СтрШаблон(ТекстСообщения, Формат(РезультатПоиска.ПомеченоСтрок, "ЧН="), 
							Формат(РезультатПоиска.ВыбраноСтрок, "ЧН="));
							
		Результат = Ждать ВопросАсинх(ТекстСообщения, РежимДиалогаВопрос.ДаНет);					
		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;	
		КонецЕсли;		
	КонецЕсли;	

	Если РезультатПоиска.ВыбраноСтрок = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	НачатьОтложеннуюТрансляцию(РезультатПоиска.ДанныеДляОбработки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСейчасКонтекст(Команда)
	
	ТекущиеДанные = Элементы.ОчередьТрансляции.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПомеченныеСтроки = Новый Массив;
	ПомеченныеСтроки.Добавить(ТекущиеДанные.ПолучитьИдентификатор());
	
	НачатьОтложеннуюТрансляцию(ПомеченныеСтроки);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ИзменитьСтатус(Команда)
	
	НовыйСтатус = Ждать НовыйСтатус();
	Если НовыйСтатус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПоиска = РезультатПоискаВСписке();
	
	Если РезультатПоиска.ПомеченоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Пометьте строки'");
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	КонецЕсли;	

	НачатьОтложенноеИзменениеСтатуса(НовыйСтатус, РезультатПоиска.ДанныеДляОбработки);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИзменитьСтатусКонтекст(Команда)
	
	ТекущиеДанные = Элементы.ОчередьТрансляции.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыйСтатус = Ждать НовыйСтатус();
	Если НовыйСтатус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПомеченныеСтроки = Новый Массив;
	ПомеченныеСтроки.Добавить(ТекущиеДанные.ПолучитьИдентификатор());
	
	НачатьОтложенноеИзменениеСтатуса(НовыйСтатус, ПомеченныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура УдалитьОбработанные(Команда)
		
	НачатьОтложеннуюОчисткуОчереди();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьЗначениеПометкиВСпискеОчереди(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьЗначениеПометкиВСпискеОчереди(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеОтложеннаяТрансляция(Команда)
	
	НачатьИзменениеРасписанияРегламентногоЗадания("ОтложеннаяТрансляция");
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеОчисткаОчереди(Команда)
	
	НачатьИзменениеРасписанияРегламентногоЗадания("ОчисткаОчереди");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьНастройки(Команда)
	
	ПараметрыФормы = ПараметрыХраненияНастроек();
	Оповещение	   = Новый ОписаниеОповещения("ВыбратьНастройкиЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("ХранилищеНастроек.бит_ХранилищеНастроек.ФормаЗагрузки", ПараметрыФормы, 
		ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры
	
// Обработчик завершения открытия формы.
//  См. Синтакс-помощник: ОткрытьФорму().
// 
&НаКлиенте 
Процедура ВыбратьНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда        
		ПрименитьНастройки(Результат);
		ОбновитьТекущийСписок();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	Если НЕ ПериодЗаполненПравильно() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = ПараметрыХраненияНастроек();
	ПараметрыФормы.Вставить("СтруктураНастройки" , СохраняемыеНастройки());
	
	Оповещение = Новый ОписаниеОповещения("СохранитьНастройкиЗавершение",ЭтотОбъект);
	ОткрытьФорму("ХранилищеНастроек.бит_ХранилищеНастроек.ФормаСохранения", ПараметрыФормы, 
		ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
	
// Обработчик завершения открытия формы.
//  См. Синтакс-помощник: ОткрытьФорму().
// 
&НаКлиенте
Процедура СохранитьНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		УстановитьЗаголовок(Результат, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьНастройки(Команда)
	
	СкрытьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура СтандартныеНастройкиОтбора(Команда)

	СтандартныеНастройкиОтбораНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОтложенноеЗаполнениеСпискаОтложеннойТрансляции

&НаКлиенте
Процедура НачатьЗаполнениеСпискаОтложеннойТрансляции()

	Если НЕ ПериодЗаполненПравильно() Тогда
		Возврат;	
	КонецЕсли;
	
	СформироватьПредставлениеОтбора();
		
	Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОжиданиеОбработки;
	Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = НСтр("ru = 'Идет заполнение списка документов'");
	
	ДлительнаяОперация = ЗапуститьОтложенноеЗаполнениеСпискаОтложеннойТрансляции();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗаполненияСпискаОтложеннойТрансляции", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ЗапуститьОтложенноеЗаполнениеСпискаОтложеннойТрансляции()
		
	НаименованиеЗадания = НСтр("ru = 'Заполнение списка отложенной трансляции.'");
	ВыполняемыйМетод	= "Обработки.бит_ОтложеннаяТрансляция.СписокОтложеннойТрансляции";

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	
	НастройкиКомпоновкиДанных = КомпоновщикНастроек.ПолучитьНастройки();
	
	Статусы.Очистить();
	Для каждого Запись Из СтатусыОтбор Цикл
		Если Запись.Пометка И  ЗначениеЗаполнено(Запись.Значение) Тогда
			Статусы.Добавить(Запись.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновкиДанных, "ДатаНачалаРегистрации", ИнтервалДатРегистрации.ДатаНачала,
		ЗначениеЗаполнено(ИнтервалДатРегистрации.ДатаНачала));
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновкиДанных, "ДатаОкончанияРегистраци", ИнтервалДатРегистрации.ДатаОкончания, 
		ЗначениеЗаполнено(ИнтервалДатРегистрации.ДатаОкончания));
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновкиДанных, "ДатаНачалаОбработки", ИнтервалДатСобытий.ДатаНачала,
		ЗначениеЗаполнено(ИнтервалДатСобытий.ДатаНачала));
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновкиДанных, "ДатаОкончанияОбработки", ИнтервалДатСобытий.ДатаОкончания, 
		ЗначениеЗаполнено(ИнтервалДатСобытий.ДатаОкончания));
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновкиДанных, "Статусы",
		Статусы, ЗначениеЗаполнено(Статусы));
	бит_ОтчетыБФКлиентСервер.УстановитьПараметр(НастройкиКомпоновкиДанных, "КоличествоПоказываемыхСобытий",
		КоличествоПоказываемыхСобытий);
		
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ВыполняемыйМетод, 
						НастройкиКомпоновкиДанных);
						
	Возврат ФоновоеЗадание;

КонецФункции

// Обработка оповещения. Подробности см.ДлительныеОперацииКлиент.ОжидатьЗавершение.
//
&НаКлиенте
Процедура ПослеЗаполненияСпискаОтложеннойТрансляции(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если Результат.Статус <> "Выполнено" Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка при выполнении: %1'"); 
		ПоказатьПредупреждение(, СтрШаблон(ТекстСообщения, Результат.КраткоеПредставлениеОшибки));
	Иначе
		ПослеЗаполненияСпискаОтложеннойТрансляцииНаСервере(Результат.АдресРезультата);	
	КонецЕсли; 
	
	Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОбработка;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаполненияСпискаОтложеннойТрансляцииНаСервере(АдресРезультата)

	ТаблицаДокументов = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	ОчередьТрансляции.Загрузить(ТаблицаДокументов);
			
КонецПроцедуры

#КонецОбласти

#Область ОтложенноеИзменениеСтуса

&НаКлиенте
Процедура НачатьОтложенноеИзменениеСтатуса(НовыйСтатус, ВыбранныеСтроки)

	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Пометьте строки'");
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОжиданиеОбработки;
	Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = НСтр("ru = 'Идет изменение статусов записей очереди отложенной трансляции'");

	ДлительнаяОперация = ЗапуститьОтложенноеИзменениеСтатуса(НовыйСтатус, ВыбранныеСтроки);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеИзмененияСтатуса", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьОтложенноеИзменениеСтатуса(НовыйСтатус, ВыбранныеСтроки)

	НаименованиеЗадания = НСтр("ru = 'Изменение статусов записей очереди отложенной трансляции.'");
	ВыполняемыйМетод	= "Обработки.бит_ОтложеннаяТрансляция.ВыполнитьИзменениеСтатусаЗаписей";

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	
	ПараметрыМетода = Обработки.бит_ОтложеннаяТрансляция.ПараметрыОтложеннойУстановкиСтатуса();
		
	Для каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		СтрокаТаблицы = ОчередьТрансляции.НайтиПоИдентификатору(ВыбраннаяСтрока); 
		НоваяСтрока = ПараметрыМетода.ДокументыДляОбработки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы); 
		НоваяСтрока.НовыйСтатус = НовыйСтатус;
	КонецЦикла;
		
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ВыполняемыйМетод, 
						ПараметрыМетода);
						
	Возврат ФоновоеЗадание;	

КонецФункции

// Обработка оповещения. Подробности см.ДлительныеОперацииКлиент.ОжидатьЗавершение.
//
&НаКлиенте
Процедура ПослеИзмененияСтатуса(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если Результат.Статус <> "Выполнено" Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка при выполнении: %1'"); 
		ПоказатьПредупреждение(, СтрШаблон(ТекстСообщения, Результат.КраткоеПредставлениеОшибки));
	Иначе
		ОбновитьТекущийСписок();	
	КонецЕсли; 	

	Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОбработка;
	
КонецПроцедуры

#КонецОбласти

#Область ОтложеннаяТрансляция

&НаКлиенте
Процедура НачатьОтложеннуюТрансляцию(ВыбранныеСтроки)

	Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОжиданиеОбработки;
	Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = НСтр("ru = 'Идет трансляция помеченных документов'");

	ДлительнаяОперация = ЗапуститьОтложеннуюТрансляцию(ВыбранныеСтроки);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыполненияОтложеннойТрансляции", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ЗапуститьОтложеннуюТрансляцию(ВыбранныеСтроки)

	НаименованиеЗадания = НСтр("ru = 'Отложенная трансляция'; en = 'Postponed Transformation'");
	ВыполняемыйМетод	= "Обработки.бит_ОтложеннаяТрансляция.НачатьОтложеннуюТрансляцию";

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	
	ТаблицаФормы = РеквизитФормыВЗначение("ОчередьТрансляции");
	ДокументыДляОбработки = ТаблицаФормы.СкопироватьКолонки();
	
	Для каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		СтрокаТаблицы = ОчередьТрансляции.НайтиПоИдентификатору(ВыбраннаяСтрока); 
		ЗаполнитьЗначенияСвойств(ДокументыДляОбработки.Добавить(), СтрокаТаблицы); 
	КонецЦикла;
			
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ВыполняемыйМетод, 
						ДокументыДляОбработки);
						
	Возврат ФоновоеЗадание;		

КонецФункции

// Обработка оповещения. Подробности см.ДлительныеОперацииКлиент.ОжидатьЗавершение.
//
&НаКлиенте
Процедура ПослеВыполненияОтложеннойТрансляции(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если Результат.Статус <> "Выполнено" Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка при выполнении: %1'"); 
		ПоказатьПредупреждение(, СтрШаблон(ТекстСообщения, Результат.КраткоеПредставлениеОшибки));
	Иначе
		ОбновитьТекущийСписок();	
	КонецЕсли; 	
	
	Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОбработка;
	
	Оповестить("ВыполненаОтложеннаяТрансляция",, ВладелецФормы);
	
КонецПроцедуры

#КонецОбласти

#Область ОтложеннаяОчисткаОчереди

&НаКлиенте
Процедура НачатьОтложеннуюОчисткуОчереди()

	Элементы.РазделыОбработки.ТекущаяСтраница = Элементы.СтраницаОжиданиеОбработки;
	Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = НСтр("ru = 'Идет очистка очереди отложенной трансляции'");

	ДлительнаяОперация = ЗапуститьОтложеннуюОчисткуОчереди();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыполненияОчисткиОчереди", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция ЗапуститьОтложеннуюОчисткуОчереди()

	НаименованиеЗадания = НСтр("ru = 'Очистка очереди трансляции.'; en = 'Transformation Queue Cleanup'");
	ВыполняемыйМетод	= "Обработки.бит_ОтложеннаяТрансляция.НачатьОтложеннуюОчисткуОчереди";

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
				
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ВыполняемыйМетод);
						
	Возврат ФоновоеЗадание;		

КонецФункции

// Обработка оповещения. Подробности см.ДлительныеОперацииКлиент.ОжидатьЗавершение.
//
&НаКлиенте
Процедура ПослеВыполненияОчисткиОчереди(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
