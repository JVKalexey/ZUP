#Область ЗаполнениеСпискаОтложеннойТрансляции

Функция СписокОтложеннойТрансляции(НастройкиКомпоновкиДанных) Экспорт
	
	КоличествоПоказываемыхСобытий = 0;
	
	ПараметрКоличествоСобытий = бит_ОтчетыБФКлиентСервер.ПолучитьПараметр(НастройкиКомпоновкиДанных, "КоличествоПоказываемыхСобытий");
	Если ПараметрКоличествоСобытий <> Неопределено Тогда
		КоличествоПоказываемыхСобытий = ПараметрКоличествоСобытий.Значение;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = Обработки.бит_ОтложеннаяТрансляция.ПолучитьМакет("СобытияОчередиТрансляции");
	
	Если КоличествоПоказываемыхСобытий <> 0 Тогда
		ТекстЗапроса  = СхемаКомпоновкиДанных.НаборыДанных.Список.Запрос;
		ЧтоЗаменить   = "ВЫБРАТЬ РАЗРЕШЕННЫЕ";
		НаЧтоЗаменить = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(КоличествоПоказываемыхСобытий, "ЧГ=0");
		ТекстЗапроса  = СтрЗаменить(ТекстЗапроса, ЧтоЗаменить, НаЧтоЗаменить);
		СхемаКомпоновкиДанных.НаборыДанных.Список.Запрос = ТекстЗапроса;
	КонецЕсли;
		
	ПараметрыВыполнения = бит_ОтчетыБФСервер.ПараметрыВыгрузитьРезультатСКД();
	ПараметрыВыполнения.СхемаКомпоновки 	= СхемаКомпоновкиДанных;
	ПараметрыВыполнения.НастройкиКомпоновки = НастройкиКомпоновкиДанных; 
	
	Результат = бит_ОтчетыБФСервер.ВыгрузитьРезультатСКД(ПараметрыВыполнения);
	
	Возврат Результат;

КонецФункции

#КонецОбласти

