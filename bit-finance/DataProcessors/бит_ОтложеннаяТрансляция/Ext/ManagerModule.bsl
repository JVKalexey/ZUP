#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#Область ОтложеннаяТрансляция

Функция НачатьОтложеннуюТрансляцию(ОбъектыВОчереди = Неопределено) Экспорт

	ИдентификаторЗадания = ИдентификаторЗаданияОтложеннаяТрансляция(); 
	ВыполняемыйМетод     = "Обработки.бит_ОтложеннаяТрансляция.ВыполнитьОтложеннуюТрансляцию";
	
	Результат = НовыйРезультатДлительнойОперации();
	
	Если ОжидатьЗавершенияВыполнения(ИдентификаторЗадания) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыВыполнения  = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторЗадания);
	ПараметрыВыполнения.КлючФоновогоЗадания = Строка(ИдентификаторЗадания);
	ПараметрыВыполнения.ОжидатьЗавершение   = Неопределено;
	
	ТранслироватьБезНастроек = Ложь;
	
	Если ОбъектыВОчереди = Неопределено Тогда
		СтатусДляОтбора			 = Перечисления.бит_СтатусыВыполненияОтложеннойТрансляции.Ожидание;
		ОбъектыВОчереди			 = ДанныеДляОбработкиРегламентнымЗаданием(СтатусДляОтбора);
		ТранслироватьБезНастроек = Истина;
	КонецЕсли;
	
	РазмерСписка = ОбъектыВОчереди.Количество();
	
	Если РазмерСписка = 0 Тогда
		Результат.Статус = "Выполнено";                    	
		Возврат Результат;	
	КонецЕсли;            
	
	КоличествоПотоков = ДлительныеОперации.ДопустимоеКоличествоПотоков();
	
	Если КоличествоПотоков = 1 Тогда
		РазмерыПакетов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(РазмерСписка);
	Иначе	
		Коэффициенты = Новый Массив;
		Для Индекс = 1 По КоличествоПотоков Цикл
			Коэффициенты.Добавить(1);	
		КонецЦикла;
		РазмерыПакетов = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
							РазмерСписка, Коэффициенты, 0);
	КонецЕсли;
	
	// Удалим пакеты нулевой длины.
	Индекс = РазмерыПакетов.ВГраница();
	Пока Индекс >= 0 Цикл
		Если РазмерыПакетов.Получить(Индекс) = 0 Тогда
			РазмерыПакетов.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Пакеты 		 = Новый Массив;
	Счетчик 	 = 0;
	ИндексПакета = 0;
	РазмерПакета = РазмерыПакетов[ИндексПакета];
	ПорцияДанных = ОбъектыВОчереди.СкопироватьКолонки();

	Для каждого СтрокаТаблицы Из ОбъектыВОчереди Цикл
		Если Счетчик = РазмерПакета Тогда
			Пакеты.Добавить(ПорцияДанных);
			
			Счетчик 	 = 0;
			ИндексПакета = ИндексПакета + 1;
			РазмерПакета = ?(РазмерыПакетов.ВГраница() <= ИндексПакета, РазмерыПакетов[ИндексПакета], 0);
			ПорцияДанных = ОбъектыВОчереди.СкопироватьКолонки();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПорцияДанных.Добавить(), СтрокаТаблицы);
		Счетчик	= Счетчик + 1;
	КонецЦикла;
	
	Если ПорцияДанных.Количество() > 0 Тогда
		Пакеты.Добавить(ПорцияДанных);
	КонецЕсли;
	
	НаборПараметровФункции = Новый Соответствие;
	ВерхняяГраницаПакетов  = Пакеты.ВГраница();
	
	Для ИндексПакета = 0 По ВерхняяГраницаПакетов Цикл
		
		ПараметрыФункции  = ПараметрыОтложеннойТрансляции();
		ПараметрыФункции.ДокументыДляОбработки	  = Пакеты[ИндексПакета];
		ПараметрыФункции.ТранслироватьБезНастроек = ТранслироватьБезНастроек;
		
		ТекущиеПараметрыФункции = Новый Массив;
		ТекущиеПараметрыФункции.Добавить(ПараметрыФункции);
		
		НаборПараметровФункции.Вставить(ИндексПакета, ТекущиеПараметрыФункции);
	КонецЦикла;
	
	Возврат ДлительныеОперации.ВыполнитьФункциюВНесколькоПотоков(ВыполняемыйМетод, ПараметрыВыполнения, НаборПараметровФункции);
		
КонецФункции

