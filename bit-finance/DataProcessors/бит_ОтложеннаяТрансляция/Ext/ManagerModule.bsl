// Функция инициализирует компоновщик для получения записей 
// регистра сведений бит_ОчередьТрансляции для последующей обработки.
// 
// Параметры:
//  Компоновщик                - КомпоновщикНастроекСхемыКомпоновкиДанных.
//  НастройкиКомпоновкиДанных  - Сохраненые ранее настройки компоновки данных.
// 
// Возвращаемое значение:
//   АдресСхемыКомпоновкиДанных   - Строка.
// 
Процедура ИнициализироватьКомпоновщик(Компоновщик, НастройкиКомпоновкиДанных = Неопределено) Экспорт

	СхемаКомпоновкиДанных = Обработки.бит_ОтложеннаяТрансляция.ПолучитьМакет("СобытияОчередиТрансляции");
	
	Если ТипЗнч(НастройкиКомпоновкиДанных)= Тип("НастройкиКомпоновкиДанных") Тогда
		// Полями выбора пользователь не управляет, но они сохраняются.
		// При изменении полей на стороне поставщика это обеспечивает "правильный" набор.
		НастройкиКомпоновкиДанных.Выбор.Элементы.Очистить();
		ШаблонКоллекции = СхемаКомпоновкиДанных.НастройкиПоУмолчанию.Выбор.Элементы;
		Коллекция		= НастройкиКомпоновкиДанных.Выбор.Элементы; 
		Для каждого Элемент Из ШаблонКоллекции Цикл
			НовоеПоле = Коллекция.Добавить(ТипЗнч(Элемент));
			ЗаполнитьЗначенияСвойств(НовоеПоле, Элемент);	
		КонецЦикла;
	КонецЕсли;
	
	бит_ОтчетыБФСервер.ИнициализироватьКомпоновщикНастроек(Компоновщик, СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных); 
	
КонецПроцедуры

Процедура ПрименитьНастройки(Настройки, Обработка) Экспорт

	ШаблонНастроек = НовыеСохраняемыеНастройки();

	Если ЗначениеЗаполнено(Настройки) Тогда
		
		РеквизитыНастройки 	 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Настройки, "ХранилищеНастроек");
		СохраненныеНастройки = РеквизитыНастройки.ХранилищеНастроек.Получить();
		
		Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(ШаблонНастроек, СохраненныеНастройки);
		КонецЕсли;  		
	КонецЕсли;
	
	ИнициализироватьКомпоновщик(Обработка.КомпоновщикНастроек, ШаблонНастроек.НастройкиКомпоновкиДанных);
	
	ЗаполнитьЗначенияСвойств(Обработка, ШаблонНастроек);
	
	Если ШаблонНастроек.ИнтервалДатРегистрации.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод Тогда
		Обработка.ИнтервалДатРегистрации = Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня);
	Иначе	
		Обработка.ИнтервалДатРегистрации = Новый СтандартныйПериод(ШаблонНастроек.ИнтервалДатРегистрации.Вариант);
	КонецЕсли;

	Если ШаблонНастроек.ИнтервалДатСобытий.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод Тогда
		Обработка.ИнтервалДатСобытий = Новый СтандартныйПериод('0001-01-01', '0001-01-01');
	Иначе	
		Обработка.ИнтервалДатСобытий = Новый СтандартныйПериод(ШаблонНастроек.ИнтервалДатСобытий.Вариант);
	КонецЕсли;
	
КонецПроцедуры

Функция НовыеСохраняемыеНастройки() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ИнтервалДатРегистрации", 		Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня));
	Настройки.Вставить("ИнтервалДатСобытий", 			Новый СтандартныйПериод(ВариантСтандартногоПериода.ПроизвольныйПериод));
	Настройки.Вставить("НастройкиКомпоновкиДанных",		Неопределено);  
	Настройки.Вставить("Статусы",						Новый СписокЗначений);  
	Настройки.Вставить("КоличествоПоказываемыхСобытий", 200);
	
	Возврат Настройки;
	
КонецФункции

Функция НовыеПараметрыОбъекта() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ИнтервалДатРегистрации", 		Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня));
	Настройки.Вставить("ИнтервалДатСобытий", 	 		Новый СтандартныйПериод(ВариантСтандартногоПериода.ПроизвольныйПериод));
	Настройки.Вставить("КомпоновщикНастроек",	 		Новый КомпоновщикНастроекКомпоновкиДанных);  
	Настройки.Вставить("КоличествоПоказываемыхСобытий", 200);
	Настройки.Вставить("Статус",						Перечисления.бит_СтатусыВыполненияОтложеннойТрансляции.ПустаяСсылка());  
	
	Возврат Настройки;
	
КонецФункции

