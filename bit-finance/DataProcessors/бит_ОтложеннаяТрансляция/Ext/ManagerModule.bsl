Функция ДанныеДляОбработкиРегламентнымЗаданием(СтатусДляОтбора)
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	ИнициализироватьКомпоновщик(Компоновщик);
	НастроитьКомпоновщикДляРегламентногоЗадания(Компоновщик, СтатусДляОтбора);
	
	Результат = СписокОтложеннойТрансляции(Компоновщик.ПолучитьНастройки());
	
	Возврат Результат;
	
КонецФункции

Процедура НастроитьКомпоновщикДляРегламентногоЗадания(Компоновщик, СтатусДляОтбора)
	
	Если СтатусДляОтбора = Перечисления.бит_СтатусыВыполненияОтложеннойТрансляции.Выполнено Тогда
		
		// Очистка очереди.
		ПравоеЗначение = Новый Массив;		
		ПравоеЗначение.Добавить(Перечисления.бит_СтатусыВыполненияОтложеннойТрансляции.Выполнено);
		бит_ОтчетыБФКлиентСервер.УстановитьПараметр(Компоновщик.Настройки, "Статусы", ПравоеЗначение);
		
		Компоновщик.Настройки.Структура.Очистить();
		Группировка = бит_ОтчетыБФКлиентСервер.ДобавитьГруппировкуВКореньСтруктуры(Компоновщик, "Объект");
		бит_ОтчетыБФСервер.НовоеПолеГруппировки(Группировка, "Статус");
		
	ИначеЕсли СтатусДляОтбора = Перечисления.бит_СтатусыВыполненияОтложеннойТрансляции.Ожидание Тогда
		
		// Трансляция.
		ПравоеЗначение = Новый Массив;
		ПравоеЗначение.Добавить(Перечисления.бит_СтатусыВыполненияОтложеннойТрансляции.Ожидание);
		бит_ОтчетыБФКлиентСервер.УстановитьПараметр(Компоновщик.Настройки, "Статусы", ПравоеЗначение);
		
		Компоновщик.Настройки.Структура.Очистить();
		бит_ОтчетыБФКлиентСервер.ДобавитьГруппировкуВКореньСтруктуры(Компоновщик, "Объект");
		
	КонецЕсли;

КонецПроцедуры

Функция ОжидатьЗавершенияВыполнения(ИдентификаторЗадания)
	
	ОжидатьЗавершения = Ложь;
	Задание			  = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	Если Задание <> Неопределено Тогда
		Задание = Задание.ОжидатьЗавершенияВыполнения(1);
		ОжидатьЗавершения = (Задание.Состояние = СостояниеФоновогоЗадания.Активно);
	КонецЕсли;
	
	Возврат ОжидатьЗавершения;
	
КонецФункции

