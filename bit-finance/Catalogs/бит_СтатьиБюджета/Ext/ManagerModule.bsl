КонецФункции 

Функция СписокСмежностиПоискаЦикла(Бюджет)

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Владелец", Бюджет);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_СтатьиБюджетаПараметрыРасчета.Ссылка КАК Ссылка,
	|	бит_СтатьиБюджетаПараметрыРасчета.ЗначениеПараметра КАК ЗначениеПараметра
	|ИЗ
	|	Справочник.бит_СтатьиБюджета.ПараметрыРасчета КАК бит_СтатьиБюджетаПараметрыРасчета
	|ГДЕ
	|	бит_СтатьиБюджетаПараметрыРасчета.Ссылка.Владелец = &Владелец
	|	И бит_СтатьиБюджетаПараметрыРасчета.ЗначениеПараметра.ЭтоРасчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокСмежности = Новый Соответствие;
	Пока Выборка.СледующийПоЗначениюПоля("Ссылка") Цикл
		Пока Выборка.Следующий() Цикл
			ПараметрРасчета = Выборка.ЗначениеПараметра;
			Если СписокСмежности[ПараметрРасчета] = Неопределено Тогда
				СмежныеВершины = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.Ссылка);
				СписокСмежности.Вставить(ПараметрРасчета, СмежныеВершины); 
			Иначе	
				СписокСмежности[ПараметрРасчета].Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокСмежности;
	
КонецФункции

Функция ПоискЦиклаВГлубину(Вершина, СписокСмежности, МаршрутЦикла, СтатусыВершин)
	
	Результат = Ложь;
	МаршрутЦикла.Добавить(Вершина);
	
	СтатусыВершин[Вершина] = Истина; // Вершина на проверке. 
	СмежныеВершины = СписокСмежности[Вершина]; 
	
	Если ЗначениеЗаполнено(СмежныеВершины) Тогда
		Для каждого СмежнаяВершина Из СмежныеВершины Цикл
			Если СписокСмежности.Получить(СмежнаяВершина) = Неопределено Тогда
				// Достигнут конец маршрута.
				Продолжить;
			ИначеЕсли СтатусыВершин[СмежнаяВершина] = Неопределено Тогда
				// Переход на уровень ниже.
				Результат = ПоискЦиклаВГлубину(СмежнаяВершина, СписокСмежности, МаршрутЦикла, СтатусыВершин);
			ИначеЕсли СтатусыВершин[СмежнаяВершина] = Истина Тогда
				// Найден цикл, возврат к вершине в состоянии проверки.
				МаршрутЦикла.Добавить(СмежнаяВершина);
				Результат = Истина;
			КонецЕсли;
			
			Если Результат = Истина Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Если Результат = Ложь Тогда
		// Вершина проверена.
		СтатусыВершин[Вершина] = Ложь;
		МаршрутЦикла.Удалить(МаршрутЦикла.ВГраница());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СообщитьОЦиклическихСсылках(МаршрутЦикла, Отказ)

	ТекстСообщения = НСтр("ru='Найдены циклические ссылки:
							|%1.';
							|en='Cyclic links found:
							|%1.'");
	
	ЯчейкиМаршрута = Новый Массив();
	// Последний элемент повторяется в маршруте образуя цикл.
	ВГраница = МаршрутЦикла.ВГраница();
	НачалоЦикла = МаршрутЦикла.Найти(МаршрутЦикла[ВГраница]);
	Для Инд = НачалоЦикла По ВГраница Цикл
		ТекВершина = МаршрутЦикла[Инд];
		ЯчейкиМаршрута.Добавить(ТекВершина);
	КонецЦикла; 
	
	Разделитель = " > ";
	СтрЯчейки = СтрСоединить(ЯчейкиМаршрута, Разделитель);
	ТекстСообщения = СтрШаблон(ТекстСообщения, СтрЯчейки); 	
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	
КонецПроцедуры 

Функция СоответствующаяСтатья(СтатьяИсточника, СоответствиеСтатей)
	
	ПустаяСтатья = Справочники.бит_СтатьиБюджета.ПустаяСсылка();
	Если СтатьяИсточника = ПустаяСтатья Тогда
		Возврат ПустаяСтатья;
	КонецЕсли;
		
	СтатьяПриемника = СоответствиеСтатей.Получить(СтатьяИсточника);
	Если СтатьяПриемника = Неопределено Тогда
		СтатьяПриемника = Справочники.бит_СтатьиБюджета.ПолучитьСсылку();
		СоответствиеСтатей.Вставить(СтатьяИсточника, СтатьяПриемника);
	КонецЕсли;
	
	Возврат СтатьяПриемника;
	
КонецФункции

