
#Область ОписаниеПеременных

&НаКлиенте
Перем мБуфер;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов.
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов.
	
	// СтандартныеПодсистемы.Обновление версии ИБ
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Обновление версии ИБ

	// Стандартные действия при создании на сервере.
	бит_РаботаСДиалогамиСервер.ФормаОбъектаПриСозданииНаСервере(Отказ, СтандартнаяОбработка, ЭтотОбъект, Объект);
	
	Если Отказ Тогда 		
		Возврат;    		
	КонецЕсли; 
		
	Если Параметры.Ключ.Пустая() Тогда
		ЗаполнитьКэшЗначений();
		ДоработатьТаблицуИзмерения();
		ПрочитатьДополнительныеИтоги(Объект);
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда	
			ОбъектНастроек = Параметры.ЗначениеКопирования.ПолучитьОбъект();
			ПрочитатьДанныеВХранилищах(ОбъектНастроек);
		Иначе
			ОбъектНастроек = РеквизитФормыВЗначение("Объект");
			ПрочитатьДанныеВХранилищах(ОбъектНастроек);
		КонецЕсли;
		
		ТекущаяДатаНачалаПланирования     = Объект.ДатаНачалаПланирования;
		ТекущаяДатаОкончанияПланирования  = Объект.ДатаОкончанияПланирования;
		ТекущаяПериодичность              = Объект.ПериодичностьПланирования;
		ТекущаяПродолжительностьИнтервала = Объект.ПродолжительностьИнтервала;
		ТекущийБюджет					  = Объект.Бюджет;
		ТекущиеНастройкиГруппировок 		  = НастройкиГруппировокБюджета(ЭтотОбъект);
	КонецЕсли;
	
	Элементы.Измерения.ОтборСтрок = Новый ФиксированнаяСтруктура("Отключено", Ложь);
	
	// Это свойство не отображается, но не дает привычно редактировать список значений.
	Элементы.КомпоновщикНастройкиОтборПравоеЗначение.РасширенноеРедактированиеМножественныхЗначений = Ложь;
	
	УстановитьУсловноеОформление();	
	ЗаполнитьМакетыОформления();
	УправлениеФормой(ЭтотОбъект);
	УстановитьПараметрыВыбораСпособаЗаполнения(ЭтотОбъект);
	
	// Редактор формул.
	бит_РедакторФормулСервер.рф_ИнициализацияРедактораФормул(ЭтотОбъект, Истина);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьКэшЗначений();
	ДоработатьТаблицуИзмерения();
	ПрочитатьДополнительныеИтоги(ТекущийОбъект);
	ПрочитатьДанныеВХранилищах(ТекущийОбъект);
	
	ТекущаяДатаНачалаПланирования     = ТекущийОбъект.ДатаНачалаПланирования;
	ТекущаяДатаОкончанияПланирования  = ТекущийОбъект.ДатаОкончанияПланирования;
	ТекущаяПериодичность              = ТекущийОбъект.ПериодичностьПланирования;
	ТекущаяПродолжительностьИнтервала = ТекущийОбъект.ПродолжительностьИнтервала;
	ТекущийБюджет					  = ТекущийОбъект.Бюджет;
	ТекущиеНастройкиГруппировок		  	  = НастройкиГруппировокБюджета(ЭтотОбъект);

	ПроверитьВозможностьРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СписокСмежности	  = бит_БюджетированиеКлиентСервер.СписокСмежности(ТабДокДанные);
	РезультатПроверки = бит_Бюджетирование.ЕстьЦиклыВФормулах(ТабДокДанные, СписокСмежности);
	Если РезультатПроверки.ЕстьЦикл Тогда
		ОбщегоНазначения.СообщитьПользователю(РезультатПроверки.ТекстСообщения,,, Отказ);
	КонецЕсли;

	Если ТекущийОбъект.Вид = Перечисления.бит_ВидыНастроекФормВводаБюджета.ФиксированныйМакет Тогда
		Если ТабДокДанные.ВысотаТаблицы = 0 ИЛИ Элементы.ТабДокДанные.ОтображениеСостояния.Видимость Тогда
			ТекстСообщения = НСтр("ru='Пред записью заполните макет.';
								  |en='Previous retaining element, create a layout.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "ТабДокДанные",, Отказ);
		КонецЕсли; 
	КонецЕсли; 

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НадоОбновитьТекстЗапроса Тогда
		ТекущийОбъект.ТекстЗапроса = ТекущийОбъект.СФормироватьТекстЗапроса();
		НадоОбновитьТекстЗапроса   = Ложь;
		
		Если СтрСравнить(Объект.ТекстЗапроса, ТекущийОбъект.ТекстЗапроса) <> 0 Тогда
			ИнициироватьКомпоновщик(ТекущийОбъект, Ложь);
		КонецЕсли; 
	КонецЕсли;
	
	СохранитьЦветаОформления(ТекущийОбъект);
		
	ТекущийОбъект.СохранитьДерево(ТабДокДанные);	
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("НастройкиКомпоновщика", Компоновщик.ПолучитьНастройки());
	
	ТекущийОбъект.СохранитьНастройкиПостроителя(СтруктураНастройки);
	ТекущийОбъект.СохранитьСписокСмежностиВХранилище(СписокСмежности);
	
	ЗаполнитьДополнительныеИтоги(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ДоработатьТаблицуИзмерения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если ЭтотОбъект.рфРедакторФормулОткрыт И ЭтотОбъект.рфФормула <> ЭтотОбъект.рфСтараяФормула Тогда
	  	ТекстСообщения = НСтр("ru='Не закончен ввод формулы.
								  |Для окончания ввода закройте окно редактора или нажмите кнопку ""=""(равно) в окне редактора.';
							  |en='Not finished a formula.
							 	  |To finish, I close the editor window, or press the ""="" (equal) in the editor window.'");
	  	ПоказатьПредупреждение(,ТекстСообщения, , НСтр("ru='Редактор формулы';en='Formula Editor'"));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПараметрНормНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТолькоВалюты", Истина);
	ОткрытьФорму("ПланВидовХарактеристик.бит_ВидыПроизвольныхПараметров.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Модифицированность 
		 И (ТекущаяСтраница.Имя = "ГруппаСтраницаОтбор" 
		    ИЛИ ТекущаяСтраница.Имя = "ГруппаСтраницаМакет") Тогда
		
		Если НадоОбновитьТекстЗапроса Тогда
			ОбновитьТекстЗапроса(); 		
		КонецЕсли;
		
		УправлениеФормой(ЭтотОбъект);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура БюджетПриИзменении(Элемент)
	
	УправлениеФормой(ЭтотОбъект);

	ОчиститьОтборПоСвязямПараметровВыбора();
	УстановитьСостояниеПоляТабличногоДокумента(Истина);
	
	// Поменялся принцип заполнения - по бюджету / по статьям.
	Если ЗначениеЗаполнено(ТекущийБюджет) И НЕ ЗначениеЗаполнено(Объект.Бюджет)
		ИЛИ НЕ ЗначениеЗаполнено(ТекущийБюджет) И ЗначениеЗаполнено(Объект.Бюджет) Тогда
	
		НадоОбновитьТекстЗапроса = Истина;
	КонецЕсли;	
	
	ТекущийБюджет = Объект.Бюджет;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПриИзменении(Элемент)
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДатаНачалаПланированияПриИзменении(Элемент)
		
	Результат = Ждать ЗадатьВопросОбОчисткеДанных();
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОчиститьМакет();
		ТекущаяДатаНачалаПланирования = Объект.ДатаНачалаПланирования;
		ПериодПланирования.ДатаНачала = Объект.ДатаНачалаПланирования;
	Иначе	
		Объект.ДатаНачалаПланирования = ТекущаяДатаНачалаПланирования;
		ПериодПланирования.ДатаНачала = Объект.ДатаНачалаПланирования;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДатаОкончанияПланированияПриИзменении(Элемент)
		
	Результат = Ждать ЗадатьВопросОбОчисткеДанных();
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОчиститьМакет();
		ТекущаяДатаОкончанияПланирования = Объект.ДатаОкончанияПланирования;
		ПериодПланирования.ДатаОкончания  = Объект.ДатаОкончанияПланирования;	
	Иначе	
		Объект.ДатаОкончанияПланирования = ТекущаяДатаОкончанияПланирования;
		ПериодПланирования.ДатаОкончания = Объект.ДатаОкончанияПланирования;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабДокДанныеОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Если бит_БюджетированиеКлиентСервер.ЭтоРасшифровкаИзмеренияФВБ(Расшифровка) И ЗначениеЗаполнено(Расшифровка.Значение) Тогда
			ПоказатьЗначение(,Расшифровка.Значение);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ФормулаПредставлениеПриИзменении(Элемент)
	
	Формула = ФормулаПредставление;
	// Формирование формулы по представлению.
	МассивАргументы = бит_СтрокиКлиентСервер.РазобратьФормулу(ФормулаПредставление);
	Для Каждого Аргумент Из МассивАргументы Цикл
		АргументПоиска = СтрЗаменить(Аргумент, " ", "");
		АргументПоиска = СтрЗаменить(Аргумент, Символы.НПП, "");
		ОблАрг = ТабДокДанные.Область(АргументПоиска);
		Если бит_БюджетированиеКлиентСервер.ЭтоПрямоугольнаяОбласть(ОблАрг) Тогда
			Формула = СтрЗаменить(Формула, Аргумент, ОблАрг.Имя);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура Цвет_ГруппаПриИзменении(Элемент)
	
	Объект.ИспользоватьЦветГруппы = Истина;
	УстановитьСостояниеПоляТабличногоДокумента(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Цвет_ЯчейкаПриИзменении(Элемент)
	
	Объект.ИспользоватьЦветЯчейки = Истина;
	УстановитьСостояниеПоляТабличногоДокумента(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Цвет_ФормулаПриИзменении(Элемент)
	
	Объект.ИспользоватьЦветФормулы = Истина;
	УстановитьСостояниеПоляТабличногоДокумента(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Цвет_АргументПриИзменении(Элемент)
	
	Объект.ИспользоватьЦветАргумента = Истина;
	УстановитьСостояниеПоляТабличногоДокумента(Истина);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПериодичностьПланированияПриИзменении(Элемент)
		
	Результат = Ждать ЗадатьВопросОбОчисткеДанных();
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОчиститьМакет();
		ТекущаяПериодичность = Объект.ПериодичностьПланирования;
	Иначе	
		Объект.ПериодичностьПланирования = ТекущаяПериодичность;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПродолжительностьИнтервалаПриИзменении(Элемент)
	
	Результат = Ждать ЗадатьВопросОбОчисткеДанных();
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОчиститьМакет();
		ТекущаяПродолжительностьИнтервала = Объект.ПродолжительностьИнтервала;
	Иначе	
		Объект.ПродолжительностьИнтервала = ТекущаяПродолжительностьИнтервала;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗащитаЯчейкиПриИзменении(Элемент)
	
	Для каждого ТекущаяОбласть Из ТабДокДанные.ВыделенныеОбласти Цикл
		Если бит_БюджетированиеКлиентСервер.ЭтоПрямоугольнаяОбласть(ТекущаяОбласть) Тогда
			ШиринаОбласти = ТекущаяОбласть.Право - ТекущаяОбласть.Лево;
			ВысотаОбласти = ТекущаяОбласть.Низ   - ТекущаяОбласть.Верх;
			Для Колонка = 0 По ШиринаОбласти Цикл
				Лево = ТекущаяОбласть.Лево + Колонка;
				Для Строка = 0 По ВысотаОбласти Цикл
					Верх 	= ТекущаяОбласть.Верх + Строка;
					Область = ТабДокДанные.Область(Верх, Лево, Верх, Лево);
					Если бит_БюджетированиеКлиентСервер.ЭтоРасшифровкаЯчейкиФВБ(Область.Расшифровка)
						И (Область.Расшифровка.Вид = бит_БюджетированиеКлиентСервер.ВидРасшифровкиФВБЗначение()
						ИЛИ Область.Расшифровка.Вид = бит_БюджетированиеКлиентСервер.ВидРасшифровкиФВБФормула()) Тогда
						Область.Защита  = ЗащитаЯчейки;
						Модифицированность = Истина;
					КонецЕсли;
				КонецЦикла; 
			КонецЦикла; 
		КонецЕсли;
	КонецЦикла;  

КонецПроцедуры

&НаКлиенте
Процедура МакетОформленияПриИзменении(Элемент)
	
	Если ПустаяСтрока(Объект.МакетОформления) Тогда
		Объект.МакетОформления = Элементы.МакетОформления.СписокВыбора[0].Значение;	
	КонецЕсли;
	
	УстановитьСостояниеПоляТабличногоДокумента(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Учет_КоличествоПриИзменении(Элемент)
	
	УстановитьСостояниеПоляТабличногоДокумента(Истина);
	
КонецПроцедуры

