// Выполняет поиск строк в таблице сканированием, что бы исключить переход на сервер в клиентских алгоритмах.
//
&НаКлиентеНаСервереБезКонтекста
Функция НайтиСтрокиСканированием(Таблица, Фильтры)

	РезультатПоиска = Новый Массив;	
	Для каждого СтрокаТаблицы Из Таблица Цикл
		Успех = Ложь;
		Для каждого КлючЗначение Из Фильтры Цикл
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") 
			   И КлючЗначение.Значение.Найти(СтрокаТаблицы[КлючЗначение.Ключ]) <> Неопределено Тогда
				Успех = Истина;
			ИначеЕсли СтрокаТаблицы[КлючЗначение.Ключ] = КлючЗначение.Значение Тогда
				Успех = Истина;
			Иначе	
				Успех = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Успех Тогда
			РезультатПоиска.Добавить(СтрокаТаблицы);	
		КонецЕсли;	
	КонецЦикла;

	Возврат РезультатПоиска;
	
КонецФункции

&НаСервере
Процедура СохранитьЦветаОформления(ТекущийОбъект)
	
	Перем ЦветаОформления;
	
	ЦветаОформления = Справочники.бит_НастройкиФормВводаБюджета.НовыеЦветаОформления();
	ЗаполнитьЗначенияСвойств(ЦветаОформления, ЭтотОбъект);
	ТекущийОбъект.ЦветаОформления = Новый ХранилищеЗначения(ЦветаОформления, Новый СжатиеДанных(9));

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеПоляТабличногоДокумента(Показать)

	ОтображениеСостояния = Элементы.ТабДокДанные.ОтображениеСостояния;
	
	Если ТабДокДанные.ВысотаТаблицы > 0 И Показать Тогда
		ОтображениеСостояния.Видимость                      = Истина;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		ОтображениеСостояния.Картинка                       = Новый Картинка;
		ОтображениеСостояния.Текст                          = НСтр("ru = 'Макет не сформирован. Нажмите ""Обновить макет"" для заполнения макета.'");
	Иначе
		ОтображениеСостояния.Видимость                      = Ложь;
		ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
		ОтображениеСостояния.Картинка                       = Новый Картинка;
		ОтображениеСостояния.Текст                          = "";
	КонецЕсли;

КонецПроцедуры

