&НаКлиентеНаСервереБезКонтекста
Функция ГруппировкиБюджета(Форма)

	Объект  = Форма.Объект;
	
	ЗначенияФильтра = Новый Массив; 
	ЗначенияФильтра.Добавить(ПредопределенноеЗначение("Перечисление.бит_СпособыЗаполненияИзмеренийВФормахВвода.Разворачивать"));
	ЗначенияФильтра.Добавить(ПредопределенноеЗначение("Перечисление.бит_СпособыЗаполненияИзмеренийВФормахВвода.РазворачиватьСИерархией"));
	
	Фильтры = Новый Структура("СпособЗаполнения", ЗначенияФильтра);
				
	Возврат НайтиСтрокиСканированием(Объект.Измерения, Фильтры);	

КонецФункции

&НаКлиентеНаСервереБезКонтекста 
Процедура УстановитьПараметрыВыбораСпособаЗаполнения(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	НовыеПараметры = Новый Массив; 
	НовыеПараметры.Добавить(Новый ПараметрВыбора("Отбор.Версия_2", Объект.Версия_2));
	
	Элементы.ИзмеренияСпособЗаполнения.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметры);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НастройкиГруппировокБюджета(Форма)

	Результат 	= ГруппировкиБюджета(Форма);
	НовыйСписок = Новый СписокЗначений;
	Для каждого СтрокаТаблицы Из Результат Цикл
		НовыйСписок.Добавить(СтрокаТаблицы.СпособЗаполнения, СтрокаТаблицы.Имя);	
	КонецЦикла;

	Возврат НовыйСписок;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеТаблицыИзмерения()

	Если ИзмеренияРедактируютсяПользователем Тогда
		Возврат;
	КонецЕсли;

	НовыеНастройкиГруппировок = НастройкиГруппировокБюджета(ЭтотОбъект);
	НадоОбновитьСКД		 	  = Ложь;
	
	Если ТекущиеНастройкиГруппировок.Количество() <> НовыеНастройкиГруппировок.Количество() Тогда
		НадоОбновитьТекстЗапроса = Истина;	
	Иначе
		Индекс = ТекущиеНастройкиГруппировок.Количество() - 1;
		
		// Проверка измерения порядка и настроек группировок для цели определения необходимости обновления схемы компоновки данных.
		Пока Индекс >= 0 Цикл
			СтаряЗапись = ТекущиеНастройкиГруппировок.Получить(Индекс);
			НоваяЗапись = НовыеНастройкиГруппировок.Получить(Индекс);
			Если СтаряЗапись.Значение <> НоваяЗапись.Значение ИЛИ СтаряЗапись.Представление <> НоваяЗапись.Представление Тогда
				НадоОбновитьСКД = Истина;
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		
		// Проверка измерения состава группировок для цели определения необходимости обновления текста запроса.
		КопияТекущиеНастройкиГруппировок = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ТекущиеНастройкиГруппировок);
		КопияНовыеНастройкиГруппировок 	 = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(НовыеНастройкиГруппировок);
		
		КопияТекущиеНастройкиГруппировок.СортироватьПоПредставлению();
		КопияНовыеНастройкиГруппировок.СортироватьПоПредставлению();
		
		Пока Индекс >= 0 Цикл
			СтаряЗапись = КопияТекущиеНастройкиГруппировок.Получить(Индекс);
			НоваяЗапись = КопияНовыеНастройкиГруппировок.Получить(Индекс);
			Если СтаряЗапись.Значение <> НоваяЗапись.Значение Тогда
				НадоОбновитьТекстЗапроса = Истина;
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;
	ТекущиеНастройкиГруппировок = НовыеНастройкиГруппировок;

	Если НадоОбновитьСКД И НЕ НадоОбновитьТекстЗапроса Тогда		
		ОбработатьИзменениеТаблицыИзмеренияНаСервере();
	КонецЕсли;
	
	Если НадоОбновитьСКД ИЛИ НадоОбновитьТекстЗапроса Тогда
		УстановитьСостояниеПоляТабличногоДокумента(Истина);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеТаблицыИзмеренияНаСервере()

	Объектформы = РеквизитФормыВЗначение("Объект");
	ИнициироватьКомпоновщик(Объектформы, Ложь);

КонецПроцедуры

