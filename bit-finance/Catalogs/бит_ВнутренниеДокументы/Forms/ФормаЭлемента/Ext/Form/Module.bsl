
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	Если Параметры.Ключ.Пустая() Тогда
		СгенерироватьНаименованиеДокумента(Объект);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяОбработчика", "Подключаемый_ЗаполнитьСИИ");
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ПодменюЗаполнить");
	бит_ИскусственныйИнтеллект.ДобавитьКомандуЗаполнения(ЭтотОбъект, ДополнительныеПараметры);
	
	ПодготовитьФормуНаСервере(СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПустаяСтрока(Объект.Номер)
		И ШаблонДляНомераУстановлен Тогда
		ЗаполнитьЗначениеРеквизитаПоШаблону("Номер");
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Наименование) Тогда
		СгенерироватьНаименованиеДокумента(Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	Если бит_НастройкиДоступностиЭлементовФормКлиентСервер.ФормаПодготовлена(ЭтотОбъект) Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// СтандартныеПодсистемы.Свойства
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.Свойства
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("Ссылка", Объект.Ссылка);
	ПараметрыОповещения.Вставить("ВидДокумента", Объект.ВидДокумента);
	Оповестить("ЗаписьЭлементаСправочникабит_ВнутренниеДокументы", ПараметрыОповещения, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененСтатус" И Источник = УникальныйИдентификатор Тогда
		ЗаполнитьРеквизитыСтатусаВФорме();
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	
	СгенерироватьНаименованиеДокумента(Объект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ОбновитьЭлементыДополнительныхРеквизитов();
	// Конец СтандартныеПодсистемы.Свойства
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура НомерПриИзменении(Элемент)
	
	СгенерироватьНаименованиеДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	СгенерироватьНаименованиеДокумента(Объект);
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Фильтр 		   = Новый Структура("Объект", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("Отбор",  Фильтр);
	ОткрытьФорму("РегистрСведений.бит_ИсторияИзмененияСтатусовОбъектов.ФормаСписка", 
		ПараметрыФормы, ЭтотОбъект, ЭтотОбъект,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
    ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(Знач ПараметрыВыполнения)
    ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// СтандартныеПодсистемы.Свойства
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
    УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры
// Конец СтандартныеПодсистемы.Свойства

&НаКлиенте
Процедура КомандаОтправитьНаСогласование(Команда)
	
	Объект.ОтправленНаСогласование = НЕ Объект.ОтправленНаСогласование;
	Если НЕ Записать() Тогда
		Объект.ОтправленНаСогласование = НЕ Объект.ОтправленНаСогласование;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьНомер(Команда)
	
	ОповещениеВопрос = Новый ОписаниеОповещения("ЗаполнитьНомерЗавершение", ЭтотОбъект);
	Если ЗначениеЗаполнено(Объект.Номер) И НЕ ИзмененыЗначимыеРеквизиты("Номер") Тогда		
		ТекстВопроса = НСтр("ru = 'Перезаполнить номер?';
							|en = 'Are you sure you want to refill the number?'");
		ПоказатьВопрос(ОповещениеВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 15, КодВозвратаДиалога.Нет);		
	Иначе		
		ВыполнитьОбработкуОповещения(ОповещениеВопрос, КодВозвратаДиалога.Да); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаполнитьСИИ(Команда)
	
	ОписаниеОкончанияЗаполнения = Новый ОписаниеОповещения("ПриОкочнанииЗаполненияИИДанныхФормы", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОписаниеЭлементов", ОписаниеЭлементовДляЗаполненияИИ());
	ПараметрыФормы.Вставить("Ссылка", Объект.Ссылка);
	
	ОткрытьФорму("Обработка.бит_ВзаимодейтсвиеСИИ.Форма.ЗаполнениеДанныхФормы", ПараметрыФормы, ЭтотОбъект,
		УникальныйИдентификатор,,, ОписаниеОкончанияЗаполнения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура Подключаемый_ЗаполнитьПроизвольноеПолеСИИ(Команда)
	
	КомандыЗаполнения = ЭтотОбъект["бит_КомандыЗаполненияПроизвольныхПолейИИ"].НайтиСтроки(
						Новый Структура("ИмяКомандыЗаполнения", Команда.Имя));
	Если КомандыЗаполнения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеКоманды = КомандыЗаполнения[0];
	
	ПараметрыЗаполненияПроизвольногоПоля = Новый Структура;
	ПараметрыЗаполненияПроизвольногоПоля.Вставить("ПолеЗаполнения", "");
	ПараметрыЗаполненияПроизвольногоПоля.Вставить("Ассистент",
		ПредопределенноеЗначение("Справочник.бит_АссистентыИИ.Робот"));
	ПараметрыЗаполненияПроизвольногоПоля.Вставить("Промпты", Новый СписокЗначений);
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполненияПроизвольногоПоля, ОписаниеКоманды);
	Если ОписаниеКоманды.ЗапросВложения Тогда
		ОписаниеОкончанияЗаполнения = Новый ОписаниеОповещения("ПриОкочнанииВыборФайлаДляЗаполненияПроизвольногоПоля",
										ЭтотОбъект, ПараметрыЗаполненияПроизвольногоПоля);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ссылка", Объект.Ссылка);
		ПараметрыФормы.Вставить("РежимВыбораФайла", Истина);
		
		ОткрытьФорму("Обработка.бит_ВзаимодейтсвиеСИИ.Форма.ЗаполнениеДанныхФормы", ПараметрыФормы, ЭтотОбъект,
			УникальныйИдентификатор,,, ОписаниеОкончанияЗаполнения);
	Иначе
		ВыполнитьЗаполнениеИИПроизвольногоПоля(ПараметрыЗаполненияПроизвольногоПоля);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ШаблонЗаполненияРеквизитов

&НаСервере
Процедура ПроверитьШаблоныЗаполненияРеквизитов()

	ШаблонДляНомераУстановлен = Ложь;
	
	ИмяРеквизита = "Номер";
	ИмяШаблона   = "СтруктураШаблона_Номер";
	
	// Поиск сохраненной структуры шаблона.
	Если СтруктураШаблоновЗаполненияРеквизитов = Неопределено Тогда
		СтруктураШаблоновЗаполненияРеквизитов = Новый Структура;
		СтруктураШаблоновЗаполненияРеквизитов.Вставить(ИмяШаблона);
	КонецЕсли;
	
	ПараметрыШаблонаТекущий = СтруктураШаблоновЗаполненияРеквизитов[ИмяШаблона];
	
	// Поиск новой структуры шаблона.
	ПараметрыШаблона = Справочники.бит_ШаблоныЗаполненияРеквизитов.СформироватьСтруктуруПараметровШаблона(Объект, ИмяРеквизита);
	Если ПараметрыШаблона = Неопределено Тогда
		Элементы.Номер.ТолькоПросмотр     = Ложь;
		Элементы.ЗаполнитьНомер.Видимость = Ложь;
		Если ПараметрыШаблонаТекущий <> Неопределено Тогда
			СтруктураШаблоновЗаполненияРеквизитов.Вставить(ИмяШаблона, ПараметрыШаблона);
			Объект[ИмяРеквизита] = "";
		КонецЕсли;   	
	Иначе
		Элементы.Номер.ТолькоПросмотр     = Истина;
		Элементы.ЗаполнитьНомер.Видимость = Истина;
		СтруктураШаблоновЗаполненияРеквизитов.Вставить(ИмяШаблона, ПараметрыШаблона);
		
		Если ПараметрыШаблонаТекущий = Неопределено
			И ЗначениеЗаполнено(Объект.Номер)Тогда
			ЗапомнитьЗначенияЗначимыхРеквизитов(ИмяРеквизита);			
		КонецЕсли;	
	КонецЕсли;

	ШаблонДляНомераУстановлен = (СтруктураШаблоновЗаполненияРеквизитов["СтруктураШаблона_Номер"] <> Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьЗначенияЗначимыхРеквизитов(ИмяРеквизита)

	Если НЕ ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураШаблона = СтруктураШаблоновЗаполненияРеквизитов["СтруктураШаблона_Номер"];
	Если СтруктураШаблона <> Неопределено Тогда
		СтруктураЗначимыхРеквизитов = СтруктураШаблона.СтруктураЗначимыхРеквизитов;
		СтруктураЗначимыхРеквизитов = СтруктураШаблоновЗаполненияРеквизитов["СтруктураШаблона_Номер"].СтруктураЗначимыхРеквизитов;
		Справочники.бит_ШаблоныЗаполненияРеквизитов.ЗапомнитьЗначенияЗначимыхРеквизитов(Объект, СтруктураЗначимыхРеквизитов);
	КонецЕсли;
  	
КонецПроцедуры

// Обработчик завершения выбора диалога вопрос.
//  См. Синтакс-помощник: ПоказатьВопрос().
// 
&НаКлиенте
Процедура ЗаполнитьНомерЗавершение(Ответ, ДопПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьСообщения();
		ЗаполнитьЗначениеРеквизитаПоШаблону("Номер");
		СгенерироватьНаименованиеДокумента(Объект);
		Модифицированность = Истина;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗначениеРеквизитаПоШаблону(Знач ИмяРеквизита)
	
	СтруктураШаблона  = СтруктураШаблоновЗаполненияРеквизитов["СтруктураШаблона_Номер"];
  	ЗначениеРезультат = Справочники.бит_ШаблоныЗаполненияРеквизитов.СформироватьЗначениеРеквизитаПоШаблону(Объект,
																											ИмяРеквизита,
																											СтруктураШаблона);
	Объект[ИмяРеквизита] = ЗначениеРезультат;
	Если СтруктураШаблона <> Неопределено Тогда
		ЗапомнитьЗначенияЗначимыхРеквизитов(ИмяРеквизита);
	КонецЕсли;
	
	Если ИмяРеквизита = "Номер" Тогда
		СгенерироватьНаименованиеДокумента(Объект);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ИзмененыЗначимыеРеквизиты(Знач ИмяРеквизита, Знач ПредставлениеЗаполняемогоРеквизита = Неопределено)

	Изменены = Ложь;
	Если ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда
		СтруктураШаблона = СтруктураШаблоновЗаполненияРеквизитов["СтруктураШаблона_Номер"];
		Если СтруктураШаблона <> Неопределено Тогда
			
			СтруктураЗначимыхРеквизитов = СтруктураШаблона.СтруктураЗначимыхРеквизитов;
		
			Изменены = Справочники.бит_ШаблоныЗаполненияРеквизитов.ПроверитьИзмененияЗначимыхРеквизитов(Объект
								, СтруктураЗначимыхРеквизитов
								, ПредставлениеЗаполняемогоРеквизита);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Изменены;

КонецФункции

#КонецОбласти

#Область ЗаполнениеПроизвольныхПолейИИ

&НаСервере
Процедура ДобавитьКомандыЗаполненияПроизвольныхПолейИИ()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяОбработчика", "Подключаемый_ЗаполнитьПроизвольноеПолеСИИ");
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ПодменюЗаполнить");
	ДополнительныеПараметры.Вставить("Объект", РеквизитФормыВЗначение("Объект"));
	бит_ИскусственныйИнтеллект.ДобавитьКомандыЗаполненияПроизвольныхПолей(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОкочнанииВыборФайлаДляЗаполненияПроизвольногоПоля(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗаполнениеИИПроизвольногоПоля(ДополнительныеПараметры, Результат);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗаполнениеИИПроизвольногоПоля(ПараметрыЗаполненияПроизвольногоПоля, ПараметрыФайла = Неопределено)
	
	ЗапросИИ = Новый Массив;
	Если ПараметрыФайла <> Неопределено Тогда
		ЗапросИИ.Добавить(ПараметрыФайла);
	КонецЕсли;
	Для каждого ЭлементСписка Из ПараметрыЗаполненияПроизвольногоПоля.Промпты Цикл
		ЗапросИИ.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	РезультатЗаполнения = бит_ИскусственныйИнтеллект.ОтветИИ(ЗапросИИ, ПараметрыЗаполненияПроизвольногоПоля.Ассистент);
	
	ПрефиксДопРеквизита = "ДополнительныйРеквизитЗначение_";
	ПолеЗаполнения      = ПараметрыЗаполненияПроизвольногоПоля.ПолеЗаполнения;
	Если ПолеЗаполнения = "ОписаниеИИ" Тогда
		Объект.ОписаниеИИ = РезультатЗаполнения;
		ЗаполнитьОписаниеИИ();
		УправлениеФормой();
	ИначеЕсли СтрНачинаетсяС(ПолеЗаполнения, "Объект.") Тогда
		ИмяРеквизита = Сред(ПараметрыЗаполненияПроизвольногоПоля.ПолеЗаполнения, 8);
		Объект[ИмяРеквизита] = РезультатЗаполнения;
	ИначеЕсли СтрНачинаетсяС(ПолеЗаполнения, ПрефиксДопРеквизита) Тогда
		ОкончаниеДопРеквизита = СтрЗаменить(ПолеЗаполнения, ПрефиксДопРеквизита, "");
		Для каждого ОписаниеДопРеквизита Из ЭтотОбъект.Свойства_ОписаниеДополнительныхРеквизитов Цикл
			Если НЕ СтрЗаканчиваетсяНа(ОписаниеДопРеквизита.ИмяРеквизитаЗначение, ОкончаниеДопРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			ЭтотОбъект[ОписаниеДопРеквизита.ИмяРеквизитаЗначение] = РезультатЗаполнения;
			Прервать;
		КонецЦикла;
	Иначе
		ЭтотОбъект[ПолеЗаполнения] = РезультатЗаполнения;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// СтандартныеПодсистемы.Свойства 
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
    УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

