Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
    УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
    УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.Свойства

&НаСервере
Процедура ПодготовитьФормуНаСервере(СтандартнаяОбработка = Ложь)
	
	бит_НастройкиДоступностиЭлементовФорм.ПодготовитьФорму(ЭтотОбъект, Объект, СтандартнаяОбработка);
	ЗаполнитьОписаниеИИ();
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	бит_НастройкиДоступностиЭлементовФорм.РазблокироватьЭлементы(ЭтотОбъект);
	
	Элементы.ОписаниеИИ.Видимость = НЕ ПустаяСтрока(Объект.ОписаниеИИ);
	
	ПроверитьШаблоныЗаполненияРеквизитов();
	
	ДобавитьКомандыЗаполненияПроизвольныхПолейИИ();
	
	Элементы.ФормаКомандаОтправитьНаСогласование.Заголовок = ?(Объект.ОтправленНаСогласование,
															НСтр("ru='Снять с согласования'"),
															НСтр("ru='Отправить на согласование'"));
	Элементы.ФормаКомандаОтправитьНаСогласование.Картинка = ?(Объект.ОтправленНаСогласование,
															БиблиотекаКартинок.Обсуждения,
															БиблиотекаКартинок.НовоеОбсуждение);
															
	бит_НастройкиДоступностиЭлементовФорм.ЗаблокироватьЭлементы(ЭтотОбъект);
	                 	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыСтатусаВФорме()
	
	бит_ВизированиеСервер.ЗаполнитьРеквизитыСтатусаВФорме(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СгенерироватьНаименованиеДокумента(Объект)
	
	Объект.Наименование = бит_ДелопроизводствоКлиентСервер.АвтоНаименованиеВнутреннегоДокумента(Объект);
	
КонецПроцедуры

&НаСервере
Функция ОписаниеЭлементовДляЗаполненияИИ()
	
	Возврат бит_ИскусственныйИнтеллект.ОписаниеЭлементовФормы(ЭтотОбъект);
	
КонецФункции

&НаКлиенте
Процедура ПриОкочнанииЗаполненияИИДанныхФормы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаполнения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "ЗначенияЗаполнения");
	Если ЗначенияЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ЗначениеЗаполнения Из ЗначенияЗаполнения Цикл
		ПутьКДанным = ЗначениеЗаполнения.ПутьКДанным;
		Если СтрНачинаетсяС(ПутьКДанным, "Объект.") Тогда
			Объект[СтрЗаменить(ПутьКДанным, "Объект.", "")] = ЗначениеЗаполнения.Значение;
		Иначе
			ЭтотОбъект[ПутьКДанным] = ЗначениеЗаполнения.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписаниеИИ()
	
	Если ПустаяСтрока(Объект.ОписаниеИИ) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщенияHTML = бит_ИскусственныйИнтеллектКлиентСервер.ОбработанныйТекстДляHTML(Объект.ОписаниеИИ);
	Оформление         = бит_ИскусственныйИнтеллектКлиентСервер.НовыеПараметрыОформленияHTML();
	Оформление.Выравнивание = ГоризонтальноеПоложение.Лево;
	Оформление.ЦветФона     = "Белый";
	ТекстСообщенияHTML = бит_ИскусственныйИнтеллектКлиентСервер.ТекстСообщенияHTMLСОформлением(
								ТекстСообщенияHTML, Оформление);
								
	ШаблонHTML = "<html><head></head><body>%1</body></html>";
	Структура = Новый Структура;
	ОписаниеИИ.УстановитьHTML(СтрШаблон(ШаблонHTML, ТекстСообщенияHTML), Структура);
	
КонецПроцедуры

#КонецОбласти