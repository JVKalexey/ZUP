Процедура ДобавитьЗаписьВРегистр(ПараметрыЗаписи, Результат)
	
	НаборЗаписей = РегистрыСведений.ДокументыОПредстоящейПоставке.СоздатьНаборЗаписей();
	НаборЗаписей.Заполнить(Неопределено);
	НаборЗаписей.Отбор.Организация.Установить(ПараметрыЗаписи.Организация);
	НаборЗаписей.Отбор.НомерДОПП.Установить(Результат.НомерУведомления);
	НаборЗаписей.Отбор.КБК.Установить(ПараметрыЗаписи.КБК);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Организация = ПараметрыЗаписи.Организация;
	НоваяЗапись.НомерДОПП   = Результат.НомерУведомления;
	НоваяЗапись.Контрагент  = Результат.Контрагент;
	НоваяЗапись.СуммаНалога = ПараметрыЗаписи.Сумма;
	НоваяЗапись.КБК         = ПараметрыЗаписи.КБК;
	НоваяЗапись.ПланируемаяДатаВвоза = ПараметрыЗаписи.ПланируемаяДатаВвоза;
	НоваяЗапись.КатегорияПодакцизногоТовара = ПараметрыЗаписи.Категория;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПолучитьРеквизитыДОПП(ДанныеУведомления)
	
	СтруктураДОПП = ДанныеУведомления.Получить();
	СуммаОП   = СтруктураДОПП.ДанныеУведомления.Титульная.СумОбПлат;
	НомКорр   = СтруктураДОПП.ДанныеУведомления.Титульная.НомКорр;
	ДатаВвоза = СтруктураДОПП.ДанныеУведомления.Титульная.ДатаВвоз;
	// Посчитаем сумму НДС со всех Листов Товары ДОПП
	СтраницыТовары = СтруктураДОПП.ДанныеМногостраничныхРазделов.ТоварДоговор;
	ФактурнаяСтоимость = 0;
	
	Для Каждого СтрокаТовары Из СтраницыТовары Цикл
		
		Если ЗначениеЗаполнено(СтрокаТовары.Значение.СтоимТов) Тогда
			ФактурнаяСтоимостьТ = СтрокаТовары.Значение.СтоимТов;
		Иначе
			ФактурнаяСтоимостьТ = 0;
		КонецЕсли;
		
		ФактурнаяСтоимость = ФактурнаяСтоимость + ФактурнаяСтоимостьТ;
		
	КонецЦикла;
	
	ДанныеДОПП = Новый Структура;
	ДанныеДОПП.Вставить("СуммаОП", СуммаОП);
	ДанныеДОПП.Вставить("НомерКорректировки",   НомКорр);
	ДанныеДОПП.Вставить("ПланируемаяДатаВвоза", ДатаВвоза);
	ДанныеДОПП.Вставить("ФактурнаяСтоимость",   ФактурнаяСтоимость);
	
	Возврат ДанныеДОПП;
		
КонецФункции

#КонецОбласти

