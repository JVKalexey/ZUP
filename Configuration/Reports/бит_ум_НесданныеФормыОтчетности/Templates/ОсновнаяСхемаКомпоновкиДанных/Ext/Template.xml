<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Выполнено</dataPath>
			<field>Выполнено</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидОформляемогоДокумента</dataPath>
			<field>ВидОформляемогоДокумента</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вид оформляемого документа</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Действие</dataPath>
			<field>Действие</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФизическоеЛицо</dataPath>
			<field>ФизическоеЛицо</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
				<dcscom:parentDimension>Сотрудник</dcscom:parentDimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сотрудник</dataPath>
			<field>Сотрудник</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
				<dcscom:parentDimension>Организация</dcscom:parentDimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Документ</dataPath>
			<field>Документ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОформления</dataPath>
			<field>ДатаОформления</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата оформления</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаВыполнения</dataPath>
			<field>ДатаВыполнения</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДействияПоСобытиям.Организация,
	ДействияПоСобытиям.Сотрудник,
	ДействияПоСобытиям.ФизическоеЛицо,
	ДействияПоСобытиям.Действие,
	ДействияПоСобытиям.Действие.ВидОформляемогоДокумента КАК ВидОформляемогоДокумента,
	ДействияПоСобытиям.Выполнено,
	ДействияПоСобытиям.ДатаВыполнения,
	ДействияПоСобытиям.Период КАК ДатаОформления,
	ВЫБОР
		КОГДА ДействияПоСобытиям.Действие = ЗНАЧЕНИЕ(Справочник.бит_ум_ДействияПоСобытиям.ПустаяСсылка)
				ИЛИ ДействияПоСобытиям.Действие.ВидОформляемогоДокумента = ЗНАЧЕНИЕ(Справочник.бит_ум_ВидыОформляемыхДокументов.ПустаяСсылка)
				ИЛИ ДействияПоСобытиям.Действие.ВидОформляемогоДокумента.ВидДокумента = ЗНАЧЕНИЕ(Справочник.бит_ум_ВидыДокументовИР.ПустаяСсылка)
				ИЛИ ДействияПоСобытиям.Выполнено = ЛОЖЬ
				ИЛИ ДействияПоСобытиям.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА "Не требуется"
		КОГДА ДокументыИР.Физлицо ЕСТЬ NULL 
			ТОГДА "Не оформлен"
		ИНАЧЕ "Оформлен"
	КОНЕЦ КАК Документ
ИЗ
	РегистрСведений.бит_ум_ВыполненныеДействия.СрезПоследних(&amp;Период, ) КАК ДействияПоСобытиям
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ум_ДокументыИР КАК ДокументыИР
		ПО ДействияПоСобытиям.ДатаВыполнения = ДокументыИР.Период
			И ДействияПоСобытиям.ФизическоеЛицо = ДокументыИР.Физлицо
			И (ДействияПоСобытиям.Действие &lt;&gt; ЗНАЧЕНИЕ(Справочник.бит_ум_ДействияПоСобытиям.ПустаяСсылка))
			И (ДействияПоСобытиям.Действие.ВидОформляемогоДокумента &lt;&gt; ЗНАЧЕНИЕ(Справочник.бит_ум_ВидыОформляемыхДокументов.ПустаяСсылка))
			И (ДействияПоСобытиям.Действие.ВидОформляемогоДокумента.ВидДокумента &lt;&gt; ЗНАЧЕНИЕ(Справочник.бит_ум_ВидыДокументовИР.ПустаяСсылка))
			И (ДействияПоСобытиям.Выполнено = ИСТИНА)
			И (ДействияПоСобытиям.ДатаВыполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1))
			И (ДокументыИР.ВидДокумента = ДействияПоСобытиям.Действие.ВидОформляемогоДокумента.ВидДокумента)</query>
	</dataSet>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
		<denyIncompleteValues>true</denyIncompleteValues>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ТекущаяДата</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
