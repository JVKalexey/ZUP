	ТекущиеКадровыеДанныеСотрудников.ДатаПриема,
	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения
ПОМЕСТИТЬ СписокСотрудников
ИЗ
	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников

ИНДЕКСИРОВАТЬ ПО
	ФизическоеЛицо
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СписокСотрудников.Сотрудник,
	СписокСотрудников.ФизическоеЛицо,
	СписокСотрудников.Организация,
	СписокСотрудников.Подразделение,
	ДопДанныеФизЛиц.РежимВъезда,
	ДопДанныеФизЛиц.Статус,
	ДопДанныеФизЛиц.ДатаПрибытия,
	ДопДанныеФизЛиц.ДатаУбытия,
	ДопДанныеФизЛиц.РучнойУчет,
	ДопДанныеФизЛиц.ПланируемаяДатаОкончанияТрудовойДеятельности,
	ВЫБОР
		КОГДА ДопДанныеФизЛиц.ДатаПрибытия &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				И &amp;Период &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА РАЗНОСТЬДАТ(ДопДанныеФизЛиц.ДатаПрибытия, КОНЕЦПЕРИОДА(&amp;Период, ДЕНЬ), ДЕНЬ)
		ИНАЧЕ 0
	КОНЕЦ КАК ДнейСДатыВъездаВРФ,
	ВЫБОР
		КОГДА ДопДанныеФизЛиц.ДатаУбытия &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				И &amp;Период &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА РАЗНОСТЬДАТ(КОНЕЦПЕРИОДА(&amp;Период, ДЕНЬ), ДопДанныеФизЛиц.ДатаУбытия, ДЕНЬ)
		ИНАЧЕ 0
	КОНЕЦ КАК ДнейДоУбытия,
	ГражданствоФизическихЛиц.Страна,
	СписокСотрудников.ДатаПриема,
	СписокСотрудников.ДатаУвольнения
ИЗ
	СписокСотрудников КАК СписокСотрудников
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ум_ДопДанныеФизЛиц.СрезПоследних(
				&amp;Период,
				Физлицо В
					(ВЫБРАТЬ
						СписокСотрудников.ФизическоеЛицо
					ИЗ
						СписокСотрудников КАК СписокСотрудников)) КАК ДопДанныеФизЛиц
		ПО СписокСотрудников.ФизическоеЛицо = ДопДанныеФизЛиц.Физлицо
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(
				&amp;Период,
				ФизическоеЛицо В
					(ВЫБРАТЬ
						СписокСотрудников.ФизическоеЛицо
					ИЗ
						СписокСотрудников КАК СписокСотрудников)) КАК ГражданствоФизическихЛиц
		ПО СписокСотрудников.ФизическоеЛицо = ГражданствоФизическихЛиц.ФизическоеЛицо</query>
