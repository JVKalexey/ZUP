#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьРезультатПроверки();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет самопроверку встраивания подсистемы и выводит результат в форму.
//
// Проверку запускает внедренец: он же прописывает вызовы подсистемы в переопределяемые
// модули целевой конфигурации и он же теряет их при очередном обновлении.
//
&НаСервере
Процедура ЗаполнитьРезультатПроверки()

	РезультатПроверки = бит_ум_ПроверкаВнедрения.РезультатПроверки();

	Успешно = РезультатПроверки.Успешно;

	Если Успешно Тогда
		Статус = НСтр("ru = 'Встраивание подсистемы выполнено полностью';
			|en = 'Subsystem implementation is complete'");
		Элементы.Статус.ЦветТекста = ЦветаСтиля.ЦветТекстаПоложительногоЗначения;
	Иначе
		Статус = НСтр("ru = 'Встраивание подсистемы выполнено не полностью';
			|en = 'Subsystem implementation is incomplete'");
		Элементы.Статус.ЦветТекста = ЦветаСтиля.ЦветТекстаОтрицательногоЗначения;
	КонецЕсли;

	ОтметкаУспеха = НСтр("ru = 'выполнено'; en = 'passed'");
	ОтметкаОшибки = НСтр("ru = 'НЕ ВЫПОЛНЕНО'; en = 'FAILED'");
	ОтметкаПропуска = НСтр("ru = 'не проверялось'; en = 'not checked'");

	Строки = Новый Массив;

	Для Каждого Проверка Из РезультатПроверки.Проверки Цикл

		// Пропущенная проверка неприменима к этой конфигурации и расхождением не считается,
		// но показать ее нужно: иначе список выглядит короче, чем есть.
		Если Проверка.Пропущена Тогда
			Строки.Добавить(Проверка.Представление + " — " + ОтметкаПропуска
				+ " (" + Проверка.Подробности + ")");
			Продолжить;
		КонецЕсли;

		Если Проверка.Успешно Тогда
			Строки.Добавить(Проверка.Представление + " — " + ОтметкаУспеха);
			Продолжить;
		КонецЕсли;

		Строки.Добавить(Проверка.Представление + " — " + ОтметкаОшибки + ":");

		// Подробности многострочные, отступ отделяет их от списка проверок.
		Для Каждого СтрокаПодробностей Из СтрРазделить(Проверка.Подробности, Символы.ПС) Цикл
			Строки.Добавить("    " + СтрокаПодробностей);
		КонецЦикла;

		Строки.Добавить("");

	КонецЦикла;

	Результат = СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

#КонецОбласти
