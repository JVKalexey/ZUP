// Заполнение пустой ИБ

Процедура ЗаполнитьСвойстваСотрудников_3_0_0_11() Экспорт
	
	СоздатьДополнительноеСведение("ДоверенностьНаРаботуСИностранцемНомер",
		НСтр("ru = 'Доверенность на работу с иностранцами №'"), 
		НСтр("ru = 'Номер доверенности для подачи отчетных форм по иностранным работникам'"),
		"Справочник_Сотрудники", ОбщегоНазначения.ОписаниеТипаСтрока(30));
	
	СоздатьДополнительноеСведение("ДоверенностьНаРаботуСИностранцемДата",
		НСтр("ru = 'Доверенность на работу с иностранцами дата'"), 
		НСтр("ru = 'Дата доверенности для подачи отчетных форм по иностранным работникам'"),
		"Справочник_Сотрудники", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
КонецПроцедуры

Функция СоздатьДополнительноеСведение(Имя, Наименование, Описание, Знач Набор, ТипЗначения)
	
	Если Метаданные.Справочники.НаборыДополнительныхРеквизитовИСведений.Реквизиты.Найти("ИмяПредопределенногоНабора") <> Неопределено Тогда
		Набор = УправлениеСвойствами.НаборСвойствПоИмени(Набор);
	Иначе
		Набор = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.НаборыДополнительныхРеквизитовИСведений." + Набор);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("НаборСвойств", Набор);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыИСведения.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Имя = &Имя
	|	И ДополнительныеРеквизитыИСведения.НаборСвойств = &НаборСвойств";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		
		НаименованиеНабора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Набор, "Наименование");
	
		ЭлементОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
		ЭлементОбъект.Имя = Имя;
		ЭлементОбъект.Заголовок = Наименование;
		ЭлементОбъект.Наименование = ЭлементОбъект.Заголовок + " (" + НаименованиеНабора + ")";
		ЭлементОбъект.НаборСвойств = Набор;
		ЭлементОбъект.ТипЗначения = ТипЗначения;
		ЭлементОбъект.Подсказка = Описание;
		ЭлементОбъект.ЭтоДополнительноеСведение = Истина;
	
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЭлементОбъект);
	
		ЭлементСсылка = ЭлементОбъект.Ссылка;
		
	КонецЕсли;
	
	ОбъектНаборСвойств = Набор.ПолучитьОбъект();
	ТабличнаяЧасть = ОбъектНаборСвойств.ДополнительныеСведения;
	НайденнаяСтрока = ТабличнаяЧасть.Найти(ЭлементСсылка, "Свойство");
	Если НайденнаяСтрока = Неопределено Тогда
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		НоваяСтрока.Свойство = ЭлементСсылка;
		ОбъектНаборСвойств.Записать();
	КонецЕсли;
	
	Возврат ЭлементСсылка;
	
КонецФункции

Процедура ОбновитьДополнительноеСведение(Имя, Наименование, Описание, Знач Набор, ТипЗначения)
	
	Если Метаданные.Справочники.НаборыДополнительныхРеквизитовИСведений.Реквизиты.Найти("ИмяПредопределенногоНабора") <> Неопределено Тогда
		Набор = УправлениеСвойствами.НаборСвойствПоИмени(Набор);
	Иначе
		Набор = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.НаборыДополнительныхРеквизитовИСведений." + Набор);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("НаборСвойств", Набор);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыИСведения.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Заголовок = &Наименование
	|	И ДополнительныеРеквизитыИСведения.НаборСвойств = &НаборСвойств";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		НаименованиеНабора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Набор, "Наименование");
	
		ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЭлементОбъект.Имя = Имя;
		ЭлементОбъект.Заголовок = Наименование;
		ЭлементОбъект.Наименование = ЭлементОбъект.Заголовок + " (" + НаименованиеНабора + ")";
		ЭлементОбъект.НаборСвойств = Набор;
		ЭлементОбъект.ТипЗначения = ТипЗначения;
		ЭлементОбъект.Подсказка = Описание;
		ЭлементОбъект.ЭтоДополнительноеСведение = Истина;
	
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ЭлементОбъект);
	
	КонецЕсли;

КонецПроцедуры

