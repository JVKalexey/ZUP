Процедура УстановитьКонстантуВариантНаименованияОрганизацииДляФормОтчетности_3_0_9_6() Экспорт
	
	Константы.бит_ум_ВариантНаименованияОрганизацииДляФормОтчетности.Установить(
		Перечисления.бит_ум_ВариантыНаименованияДляФормОтчетности.ПолноеНаименование);
	
КонецПроцедуры

Процедура ЗаполнитьКонстантуНачалоРаботы() Экспорт
	
	ВыполнятьНачальнуюНастройкуПрограммы = Константы.бит_ум_ВыполнятьНачальнуюНастройкуПрограммы.Получить();
	НеВыполнятьНачальнуюНастройкуПрограммы = Константы.бит_ум_НеВыполнятьНачальнуюНастройкуПрограммы.Получить();
	
	Если ВыполнятьНачальнуюНастройкуПрограммы <> НеВыполнятьНачальнуюНастройкуПрограммы Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ДействияПоСобытиям.Ссылка) КАК Ссылка
	|ИЗ
	|	Справочник.бит_ум_ДействияПоСобытиям КАК ДействияПоСобытиям";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Константы.бит_ум_ВыполнятьНачальнуюНастройкуПрограммы.Установить(НЕ Выборка.Следующий() ИЛИ Выборка.Ссылка = 0);
	
КонецПроцедуры

Процедура ПереходНаУчетМигрантов() Экспорт
	
	// Исправление ошибки в названии макета
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыОформляемыхДокументов.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ВидыОформляемыхДокументов.ИмяМакета = ""УведомлениеОПрибытииВМестоПребыванияСервыйФон_201912""
	|			ТОГДА ""УведомлениеОПрибытииВМестоПребыванияСерыйФон_201912""
	|		КОГДА ВидыОформляемыхДокументов.ИмяМакета = ""УведомлениеОПрибытииВМестоПребыванияСервыйФон_202006""
	|			ТОГДА ""УведомлениеОПрибытииВМестоПребыванияСерыйФон_202006""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ИмяМакета
	|ИЗ
	|	Справочник.бит_ум_ВидыОформляемыхДокументов КАК ВидыОформляемыхДокументов
	|ГДЕ
	|	(ВидыОформляемыхДокументов.ИмяМакета = ""УведомлениеОПрибытииВМестоПребыванияСервыйФон_201912""
	|			ИЛИ ВидыОформляемыхДокументов.ИмяМакета = ""УведомлениеОПрибытииВМестоПребыванияСервыйФон_202006"")";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.ИмяМакета) Тогда
			Продолжить;
		КонецЕсли;
	
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.ИмяМакета = Выборка.ИмяМакета;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		
	КонецЦикла;
	
	РежимВъездаПоУмолчанию = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("УчетИностранныхРаботников", "РежимВъездаИРВРФПоУмолчанию");
	СтатусПоУмолчанию = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("УчетИностранныхРаботников", "СтатусИРПоУмолчанию");	
	
	Если ЗначениеЗаполнено(РежимВъездаПоУмолчанию) Тогда
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("УчетМигрантов", "РежимВъездаИРВРФПоУмолчанию", РежимВъездаПоУмолчанию);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтатусПоУмолчанию) Тогда
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("УчетМигрантов", "СтатусИРПоУмолчанию", СтатусПоУмолчанию);
	КонецЕсли;
	
	ОбновитьДополнительноеСведение("ДоверенностьНаРаботуСИностранцемНомер",
		НСтр("ru = 'Доверенность на работу с иностранцами №'"), 
		НСтр("ru = 'Номер доверенности для подачи отчетных форм по иностранным работникам'"),
		"Справочник_Сотрудники", ОбщегоНазначения.ОписаниеТипаСтрока(15));
	
	ОбновитьДополнительноеСведение("ДоверенностьНаРаботуСИностранцемДата",
		НСтр("ru = 'Доверенность на работу с иностранцами дата'"), 
		НСтр("ru = 'Дата доверенности для подачи отчетных форм по иностранным работникам'"),
		"Справочник_Сотрудники", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
КонецПроцедуры

Процедура УстановитьКонстантуПредупреждениеОбОплатеПатентов_3_1_2_1() Экспорт
	
	Константы.бит_ум_ПредупреждениеОбОплатеПатентов.Установить(3);
	
КонецПроцедуры

// Включает использование разреза у вида документа "Патент": только у патентов работника может
// быть несколько одновременно действующих экземпляров.
//
Процедура УстановитьИспользованиеРазрезаПатента_3_1_12_2() Экспорт

	ВидПатента = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.бит_ум_ВидыДокументовИР.Патент");
	Если НЕ ЗначениеЗаполнено(ВидПатента)
		ИЛИ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидПатента, "ИспользоватьРазрез") Тогда
		Возврат;
	КонецЕсли;

	ВидДокумента = ВидПатента.ПолучитьОбъект();
	ВидДокумента.ИспользоватьРазрез = Истина;
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ВидДокумента);

КонецПроцедуры

Процедура УстановитьКонстантуРаботаВРежимеИнтеграции_3_1_5_4() Экспорт
	
	Константы.бит_ум_РаботаВРежимеИнтеграции.Установить(НЕ Константы.бит_ум_РаботаВРежимеОтдельногоПриложения.Получить());
	
КонецПроцедуры       

Процедура УстановитьКонстантуПереноситьДанныеПаспортаИзДокументовФизЛиц_3_1_9_1() Экспорт
	
	Константы.бит_ум_ПереноситьДанныеПаспортаИзДокументовФизЛиц.Установить(Истина);
	
КонецПроцедуры

