// обновления, а не оставляется на усмотрение пользователя.
//
Процедура ОбновитьВариантыОтчетов() Экспорт

	ПараметрыОбновленияНастроек = ВариантыОтчетов.ПараметрыОбновленияНастроек();
	ПараметрыОбновленияНастроек.Конфигурация = Истина;

	ВариантыОтчетов.Обновить(ПараметрыОбновленияНастроек);

КонецПроцедуры

#КонецОбласти