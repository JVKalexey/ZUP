// Самопроверка встраивания подсистемы "Учет мигрантов" в целевую конфигурацию.
//
// Встраивание сводится к тому, что в переопределяемые модули целевой конфигурации
// добавляются вызовы процедур бит_ум_СтандартныеПодсистемы. Вносятся они расширением
// интеграции, поэтому и теряются целиком: расширение отключили или не перенесли на новую
// версию конфигурации — и часть подсистемы молча перестает работать. Ошибки при этом нет.
//
// Поэтому проверка смотрит не на факт вызова, а на его результат: что зарегистрировано
// в базе и что подсистемы БСП фактически получают от целевой конфигурации.
//
// Проверяются не все точки интеграции, а те, у которых результат наблюдаем.
//

#Область ПрограммныйИнтерфейс

// Возвращает результат самопроверки встраивания подсистемы.
//
// Возвращаемое значение:
//   Структура:
//     * Успешно - Булево - Истина, если пройдены все выполнявшиеся проверки.
//     * Проверки - Массив из Структура:
//       ** Имя - Строка - краткое имя проверки, используется в журнале регистрации.
//       ** Представление - Строка - что проверялось, для показа человеку.
//       ** Успешно - Булево - результат проверки. У пропущенной проверки Истина.
//       ** Пропущена - Булево - Истина, если проверка неприменима к этой конфигурации.
//       ** Подробности - Строка - чего не хватает и что для этого сделать, а у пропущенной
//                        проверки — почему она не выполнялась. При успехе пустая строка.
//
Функция РезультатПроверки() Экспорт

	Результат = Новый Структура("Успешно, Проверки", Истина, Новый Массив);

	ПроверитьВерсиюПодсистемы(Результат.Проверки);
	ПроверитьПоставляемыйПрофиль(Результат.Проверки);
	ПроверитьРольВПоставляемомПрофиле(Результат.Проверки);
	ПроверитьНаборСвойств(Результат.Проверки);
	ПроверитьРазделДатЗапрета(Результат.Проверки);
	ПроверитьОбъектыПечати(Результат.Проверки);
	ПроверитьРазделыВариантовОтчетов(Результат.Проверки);
	ПроверитьВариантыОтчетов(Результат.Проверки);
	ПроверитьРазделыДополнительныхОтчетов(Результат.Проверки);
	ПроверитьРазделыДополнительныхОбработок(Результат.Проверки);
	ПроверитьСведенияОПерсональныхДанных(Результат.Проверки);

	Для Каждого Проверка Из Результат.Проверки Цикл
		Если Не Проверка.Успешно Тогда
			Результат.Успешно = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выполняет самопроверку и записывает результат в журнал регистрации.
//
// Параметры:
//   ПослеОбновления - Булево - Истина, если вызвано сразу после обновления информационной
//                     базы. В этот момент часть поставляемых данных может быть ещё
//                     не применена отложенными обработчиками, поэтому к расхождениям
//                     добавляется оговорка.
//
Процедура ПроверитьИЗаписатьРасхождения(ПослеОбновления = Ложь) Экспорт

	Результат = РезультатПроверки();

	Если Результат.Успешно Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация, , ,
			НСтр("ru = 'Встраивание подсистемы проверено, расхождений нет.';
				|en = 'Subsystem implementation checked, no discrepancies found.'"));
		Возврат;
	КонецЕсли;

	// Одна запись на прогон: разбираться удобнее по цельному списку, а не по отдельным
	// сообщениям, разбросанным по журналу.
	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Встраивание подсистемы выполнено не полностью:';
		|en = 'Subsystem implementation is incomplete:'"));

	Для Каждого Проверка Из Результат.Проверки Цикл
		Если Проверка.Успешно Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить("• " + Проверка.Представление + " — " + Проверка.Подробности);
	КонецЦикла;

	Если ПослеОбновления Тогда
		Строки.Добавить(НСтр(
			"ru = 'Часть поставляемых данных применяется отложенными обработчиками,
				|поэтому сразу после обновления расхождение может быть мнимым.
				|Повторите проверку из формы ""О программе"" после завершения обновления.';
			|en = 'Some supplied data is applied by deferred handlers, so right after
				|the update a discrepancy may be false. Repeat the check from the
				|""About"" form once the update is complete.'"));
	КонецЕсли;

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Ошибка, , ,
		СтрСоединить(Строки, Символы.ПС));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяСобытияЖурналаРегистрации()

	Возврат НСтр("ru = 'Учет мигрантов.Проверка внедрения';
		|en = 'Migrant accounting.Implementation check'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

// Добавляет результат одной проверки в общий список.
//
// Параметры:
//   Проверки - Массив - исходящий, см. РезультатПроверки.
//   Имя - Строка - краткое имя проверки.
//   Представление - Строка - что проверялось.
//   Успешно - Булево - результат.
//   Подробности - Строка - чего не хватает; при успехе не указывается.
//
Процедура ДобавитьРезультат(Проверки, Имя, Представление, Успешно, Подробности = "")

	Проверка = Новый Структура("Имя, Представление, Успешно, Пропущена, Подробности");
	Проверка.Имя           = Имя;
	Проверка.Представление = Представление;
	Проверка.Успешно       = Успешно;
	Проверка.Пропущена     = Ложь;
	Проверка.Подробности   = ?(Успешно, "", Подробности);

	Проверки.Добавить(Проверка);

КонецПроцедуры

// Отмечает проверку как неприменимую. Пропущенная проверка не считается расхождением:
// подсистемы БСП в целевой конфигурации может не быть, и это нормально.
//
// Параметры:
//   Проверки - Массив - исходящий, см. РезультатПроверки.
//   Имя - Строка - краткое имя проверки.
//   Представление - Строка - что проверялось.
//   Причина - Строка - почему проверка не выполнялась.
//
Процедура ПропуститьПроверку(Проверки, Имя, Представление, Причина)

	Проверка = Новый Структура("Имя, Представление, Успешно, Пропущена, Подробности");
	Проверка.Имя           = Имя;
	Проверка.Представление = Представление;
	Проверка.Успешно       = Истина;
	Проверка.Пропущена     = Истина;
	Проверка.Подробности   = Причина;

	Проверки.Добавить(Проверка);

КонецПроцедуры

// Формирует текст "что сделать", единый для всех расхождений: во всех случаях причина одна
// и та же — потерянный вызов в переопределяемом модуле целевой конфигурации.
//
// Параметры:
//   МодульЦелевойКонфигурации - Строка - имя переопределяемого модуля, где живет вызов.
//   ИмяПроцедуры - Строка - имя процедуры; в бит_ум_СтандартныеПодсистемы она называется так же.
//   ТребуетсяОбновление - Булево - Истина, если результат вызова появляется в базе только
//                         при обновлении информационной базы.
//
Функция ЧтоСделать(МодульЦелевойКонфигурации, ИмяПроцедуры, ТребуетсяОбновление = Ложь)

	Текст = СтрШаблон(НСтр(
		"ru = 'Проверьте, что в процедуре %1.%2 целевой конфигурации есть вызов
			|бит_ум_СтандартныеПодсистемы.%2. Вызов может быть внесен расширением
			|интеграции либо прямо в конфигурацию — посмотрите оба места. Если
			|используется расширение, убедитесь, что оно подключено и перенесено
			|на текущую версию конфигурации.';
		|en = 'Check that procedure %1.%2 of the target configuration calls
			|бит_ум_СтандартныеПодсистемы.%2. The call can be made by the integration
			|extension or embedded in the configuration itself — check both. If an
			|extension is used, make sure it is enabled and updated to the current
			|configuration version.'"),
		МодульЦелевойКонфигурации, ИмяПроцедуры);

	Если ТребуетсяОбновление Тогда
		Текст = Текст + " " + НСтр(
			"ru = 'После восстановления вызова выполните обновление информационной базы:
				|результат появляется только при обновлении.';
			|en = 'After restoring the call, run the infobase update: the result appears
				|during the update only.'");
	КонецЕсли;

	Возврат Текст;

КонецФункции

#Область Проверки

// Версия подсистемы регистрируется обработчиками обновления. Пустая версия означает,
// что подсистема не объявлена при добавлении подсистем либо обновление информационной
// базы еще не выполнялось.
//
Процедура ПроверитьВерсиюПодсистемы(Проверки)

	Представление = НСтр("ru = 'Версия подсистемы зарегистрирована';
		|en = 'Subsystem version is registered'");

	ЧтоСделатьТекст = ЧтоСделать("ПодсистемыКонфигурацииПереопределяемый",
		"ПриДобавленииПодсистем", Истина);

	ВерсияВБазе = ОбновлениеИнформационнойБазы.ВерсияИБ(ИмяПодсистемы());
	ВерсияКонфигурации = бит_ум_УчетМигрантовСервер.Версия();

	Если Не ЗначениеЗаполнено(ВерсияВБазе) Тогда
		ДобавитьРезультат(Проверки, "ВерсияПодсистемы", Представление, Ложь,
			СтрШаблон(НСтр("ru = 'версия подсистемы ""%1"" в базе не зарегистрирована.';
				|en = 'version of subsystem ""%1"" is not registered in the infobase.'"),
				ИмяПодсистемы()) + " " + ЧтоСделатьТекст);
		Возврат;
	КонецЕсли;

	Если ВерсияВБазе <> ВерсияКонфигурации Тогда
		ДобавитьРезультат(Проверки, "ВерсияПодсистемы", Представление, Ложь,
			СтрШаблон(НСтр("ru = 'в базе зарегистрирована версия %1, в конфигурации %2.
					|Выполните обновление информационной базы.';
				|en = 'version %1 is registered in the infobase, %2 in the configuration.
					|Run the infobase update.'"),
				ВерсияВБазе, ВерсияКонфигурации));
		Возврат;
	КонецЕсли;

	ДобавитьРезультат(Проверки, "ВерсияПодсистемы", Представление, Истина);

КонецПроцедуры

// Профиль создается подсистемой "Управление доступом" из описания, которое подсистема
// отдает при заполнении поставляемых профилей групп доступа.
//
Процедура ПроверитьПоставляемыйПрофиль(Проверки)

	Представление = НСтр("ru = 'Поставляемый профиль групп доступа создан';
		|en = 'Supplied access group profile is created'");

	ДобавитьРезультат(Проверки, "ПоставляемыйПрофиль", Представление, ПрофильНайден(),
		НСтр("ru = 'профиль ""Пользователь (Учет мигрантов)"" в базе не найден.';
			|en = 'profile ""User (Migrant accounting)"" is not found in the infobase.'")
		+ " " + ЧтоСделать("УправлениеДоступомПереопределяемый",
			"ПриЗаполненииПоставляемыхПрофилейГруппДоступа", Истина));

КонецПроцедуры

// Роль в профиле держится на описании переименований: у пользователей она называлась
// бит_ум_Пользователь315, и без описания переименования профиль после обновления
// останется без роли, то есть пользователи потеряют права.
//
Процедура ПроверитьРольВПоставляемомПрофиле(Проверки)

	Представление = НСтр("ru = 'Роль ""бит_ум_Пользователь"" входит в поставляемый профиль';
		|en = 'Role ""бит_ум_Пользователь"" is included in the supplied profile'");

	Если Не ПрофильНайден() Тогда
		ПропуститьПроверку(Проверки, "РольВПрофиле", Представление,
			НСтр("ru = 'сам профиль в базе не найден, проверять состав ролей не в чем';
				|en = 'the profile itself is not found, there are no roles to check'"));
		Возврат;
	КонецЕсли;

	Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
		Метаданные.Роли.бит_ум_Пользователь, Ложь);

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Идентификатор", Новый УникальныйИдентификатор(
		ИдентификаторПоставляемогоПрофиля()));
	Запрос.УстановитьПараметр("Роль", Идентификатор);

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Роли.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК Роли
	|ГДЕ
	|	Роли.Ссылка.ИдентификаторПоставляемыхДанных = &Идентификатор
	|	И Роли.Роль = &Роль";

	УстановитьПривилегированныйРежим(Истина);
	Найдена = Не Запрос.Выполнить().Пустой();
	УстановитьПривилегированныйРежим(Ложь);

	ДобавитьРезультат(Проверки, "РольВПрофиле", Представление, Найдена,
		НСтр("ru = 'роль в профиле отсутствует. Так бывает, если потеряно описание
				|переименования роли бит_ум_Пользователь315 в бит_ум_Пользователь.
				|Если роль убрали из профиля вручную, расхождение мнимое.';
			|en = 'the role is missing from the profile. This happens when the renaming
				|of role бит_ум_Пользователь315 to бит_ум_Пользователь is not described.
				|If the role was removed manually, the discrepancy is false.'")
		+ " " + ЧтоСделать("ОбщегоНазначенияПереопределяемый",
			"ПриДобавленииПереименованийОбъектовМетаданных", Истина));

КонецПроцедуры

// Набор регистрируется подсистемой "Свойства" при получении предопределенных наборов
// свойств. Идентификатор набора становится уникальным идентификатором ссылки.
//
Процедура ПроверитьНаборСвойств(Проверки)

	Представление = НСтр("ru = 'Набор дополнительных свойств создан';
		|en = 'Additional properties set is created'");

	Ссылка = Справочники.НаборыДополнительныхРеквизитовИСведений.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ИдентификаторНабораСвойств()));

	УстановитьПривилегированныйРежим(Истина);
	Найден = ОбщегоНазначения.СсылкаСуществует(Ссылка);
	УстановитьПривилегированныйРежим(Ложь);

	ДобавитьРезультат(Проверки, "НаборСвойств", Представление, Найден,
		НСтр("ru = 'набор дополнительных реквизитов и сведений документа
				|""Отчетность по иностранным работникам"" в базе не найден.';
			|en = 'additional attributes and information set for the document
				|""Foreign workers reporting"" is not found in the infobase.'")
		+ " " + ЧтоСделать("УправлениеСвойствамиПереопределяемый",
			"ПриПолученииПредопределенныхНаборовСвойств", Истина));

КонецПроцедуры

// Раздел создается подсистемой "Даты запрета изменения" при заполнении разделов.
// Идентификатор раздела становится уникальным идентификатором ссылки.
//
Процедура ПроверитьРазделДатЗапрета(Проверки)

	Представление = НСтр("ru = 'Раздел дат запрета изменения создан';
		|en = 'Period-end closing dates section is created'");

	Ссылка = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ИдентификаторРазделаДатЗапрета()));

	УстановитьПривилегированныйРежим(Истина);
	Найден = ОбщегоНазначения.СсылкаСуществует(Ссылка);
	УстановитьПривилегированныйРежим(Ложь);

	ДобавитьРезультат(Проверки, "РазделДатЗапрета", Представление, Найден,
		НСтр("ru = 'раздел дат запрета изменения ""Учет мигрантов"" в базе не найден.';
			|en = 'period-end closing dates section ""Migrant accounting"" is not found.'")
		+ " " + ЧтоСделать("ДатыЗапретаИзмененияПереопределяемый",
			"ПриЗаполненииРазделовДатЗапретаИзменения", Истина));

КонецПроцедуры

// Единственная проверка, которая спрашивает саму БСП, а не смотрит на данные: подсистема
// печати ничего не сохраняет, состав объектов печати собирается при каждом обращении.
// Расхождение здесь особенно коварно: до БСП 3.1.8 вызов назывался
// ПриОпределенииОбъектовСКомандамиПечати, устаревший вызов не падает — команды печати
// просто молча пропадают.
//
Процедура ПроверитьОбъектыПечати(Проверки)

	Представление = НСтр("ru = 'Документы подключены к подсистеме ""Печать""';
		|en = 'Documents are connected to the Print subsystem'");

	ОбъектыПечати = УправлениеПечатью.НастройкиПечати().ОбъектыПечати;

	Отсутствуют = Новый Массив;
	Для Каждого ОбъектМетаданных Из ДокументыСКомандамиПечати() Цикл
		Если ОбъектыПечати.Найти(Документы[ОбъектМетаданных.Имя]) = Неопределено Тогда
			Отсутствуют.Добавить(ОбъектМетаданных.Представление());
		КонецЕсли;
	КонецЦикла;

	Если Отсутствуют.Количество() = 0 Тогда
		ДобавитьРезультат(Проверки, "ОбъектыПечати", Представление, Истина);
		Возврат;
	КонецЕсли;

	ДобавитьРезультат(Проверки, "ОбъектыПечати", Представление, Ложь,
		СтрШаблон(НСтр("ru = 'к подсистеме печати не подключены документы: %1.';
			|en = 'the following documents are not connected to the Print subsystem: %1.'"),
			СтрСоединить(Отсутствуют, ", "))
		+ " " + ЧтоСделать("УправлениеПечатьюПереопределяемый", "ПриОпределенииНастроекПечати"));

КонецПроцедуры

// Без раздела панель отчетов подсистемы пуста: варианты отчетов есть, показывать их негде.
//
Процедура ПроверитьРазделыВариантовОтчетов(Проверки)

	Представление = НСтр("ru = 'Раздел объявлен разделом с вариантами отчетов';
		|en = 'The section is declared as a section with report options'");

	Разделы = ВариантыОтчетов.СписокРазделов();
	Найден = Разделы.НайтиПоЗначению(
		Метаданные.Подсистемы.УчетМигрантов.Подсистемы.ИностранныеРаботники) <> Неопределено;

	ДобавитьРезультат(Проверки, "РазделыВариантовОтчетов", Представление, Найден,
		НСтр("ru = 'раздел ""Иностранные работники"" не объявлен разделом с вариантами
				|отчетов, панель отчетов подсистемы будет пуста.';
			|en = 'section ""Foreign workers"" is not declared as a section with report
				|options, the subsystem report panel will be empty.'")
		+ " " + ЧтоСделать("ВариантыОтчетовПереопределяемый",
			"ОпределитьРазделыСВариантамиОтчетов"));

КонецПроцедуры

// Предопределенные варианты записываются в базу при обновлении, по описаниям из модулей
// менеджеров отчетов. Отсутствие варианта означает, что отчет до подсистемы не доехал.
//
Процедура ПроверитьВариантыОтчетов(Проверки)

	Представление = НСтр("ru = 'Предопределенные варианты отчетов зарегистрированы';
		|en = 'Predefined report options are registered'");

	ПолныеИмена = ПолныеИменаОтчетов();
	Идентификаторы = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ПолныеИмена, Ложь);

	СсылкиОтчетов = Новый Массив;
	Для Каждого КлючИЗначение Из Идентификаторы Цикл
		СсылкиОтчетов.Добавить(КлючИЗначение.Значение);
	КонецЦикла;

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Отчеты", СсылкиОтчетов);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Варианты.Отчет КАК Отчет
	|ИЗ
	|	Справочник.ПредопределенныеВариантыОтчетов КАК Варианты
	|ГДЕ
	|	Варианты.Отчет В (&Отчеты)";

	УстановитьПривилегированныйРежим(Истина);
	Зарегистрированные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Отчет");
	УстановитьПривилегированныйРежим(Ложь);

	Отсутствуют = Новый Массив;
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Идентификатор = Идентификаторы.Получить(ПолноеИмя);
		Если Идентификатор = Неопределено
			Или Зарегистрированные.Найти(Идентификатор) = Неопределено Тогда
			Отсутствуют.Добавить(Метаданные.НайтиПоПолномуИмени(ПолноеИмя).Представление());
		КонецЕсли;
	КонецЦикла;

	Если Отсутствуют.Количество() = 0 Тогда
		ДобавитьРезультат(Проверки, "ВариантыОтчетов", Представление, Истина);
		Возврат;
	КонецЕсли;

	ДобавитьРезультат(Проверки, "ВариантыОтчетов", Представление, Ложь,
		СтрШаблон(НСтр("ru = 'варианты не зарегистрированы у отчетов: %1.';
			|en = 'options are not registered for the following reports: %1.'"),
			СтрСоединить(Отсутствуют, ", "))
		+ " " + ЧтоСделать("ВариантыОтчетовПереопределяемый", "НастроитьВариантыОтчетов",
			Истина));

КонецПроцедуры

Процедура ПроверитьРазделыДополнительныхОтчетов(Проверки)

	Представление = НСтр("ru = 'Раздел доступен для дополнительных отчетов';
		|en = 'The section is available for additional reports'");

	ПроверитьРазделДополнительныхОбъектов(Проверки, "РазделыДополнительныхОтчетов",
		Представление, Истина, "ОпределитьРазделыСДополнительнымиОтчетами");

КонецПроцедуры

Процедура ПроверитьРазделыДополнительныхОбработок(Проверки)

	Представление = НСтр("ru = 'Раздел доступен для дополнительных обработок';
		|en = 'The section is available for additional data processors'");

	ПроверитьРазделДополнительныхОбъектов(Проверки, "РазделыДополнительныхОбработок",
		Представление, Ложь, "ОпределитьРазделыСДополнительнымиОбработками");

КонецПроцедуры

// Общая часть двух проверок: списки разделов дополнительных отчетов и обработок устроены
// одинаково и различаются только именем метода БСП и именем точки интеграции.
//
Процедура ПроверитьРазделДополнительныхОбъектов(Проверки, ИмяПроверки, Представление,
	ЭтоОтчеты, ИмяТочкиИнтеграции)

	ИмяПодсистемыБСП = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки";

	Если Не ОбщегоНазначения.ПодсистемаСуществует(ИмяПодсистемыБСП) Тогда
		ПропуститьПроверку(Проверки, ИмяПроверки, Представление,
			НСтр("ru = 'подсистема ""Дополнительные отчеты и обработки"" в конфигурации
					|отсутствует';
				|en = 'the ""Additional reports and data processors"" subsystem
					|is not present in the configuration'"));
		Возврат;
	КонецЕсли;

	Модуль = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
	Если ЭтоОтчеты Тогда
		Разделы = Модуль.РазделыДополнительныхОтчетов();
	Иначе
		Разделы = Модуль.РазделыДополнительныхОбработок();
	КонецЕсли;

	Найден = Разделы.Найти(Метаданные.Подсистемы.УчетМигрантов) <> Неопределено;

	ДобавитьРезультат(Проверки, ИмяПроверки, Представление, Найден,
		НСтр("ru = 'раздел ""Учет мигрантов"" в списке разделов отсутствует, размещать
				|дополнительные объекты в разделе будет нельзя.';
			|en = 'section ""Migrant accounting"" is missing from the list of sections,
				|additional objects cannot be placed in the section.'")
		+ " " + ЧтоСделать("ДополнительныеОтчетыИОбработкиПереопределяемый",
			ИмяТочкиИнтеграции));

КонецПроцедуры

// Без сведений о персональных данных регистры подсистемы не попадут ни в регистрацию
// событий доступа, ни в уничтожение данных субъекта.
//
Процедура ПроверитьСведенияОПерсональныхДанных(Проверки)

	Представление = НСтр("ru = 'Регистры подсистемы объявлены как персональные данные';
		|en = 'Subsystem registers are declared as personal data'");

	ИмяПодсистемыБСП = "СтандартныеПодсистемы.ЗащитаПерсональныхДанных";

	Если Не ОбщегоНазначения.ПодсистемаСуществует(ИмяПодсистемыБСП) Тогда
		ПропуститьПроверку(Проверки, "ПерсональныеДанные", Представление,
			НСтр("ru = 'подсистема ""Защита персональных данных"" в конфигурации отсутствует';
				|en = 'the ""Personal data protection"" subsystem is not present'"));
		Возврат;
	КонецЕсли;

	Модуль = ОбщегоНазначения.ОбщийМодуль("ЗащитаПерсональныхДанных");
	ТаблицаСведений = Модуль.СведенияОПерсональныхДанных();

	Отсутствуют = Новый Массив;
	Для Каждого ПолноеИмя Из ПолныеИменаРегистровПерсональныхДанных() Цикл
		Если ТаблицаСведений.Найти(ПолноеИмя, "Объект") = Неопределено Тогда
			Отсутствуют.Добавить(Метаданные.НайтиПоПолномуИмени(ПолноеИмя).Представление());
		КонецЕсли;
	КонецЦикла;

	Если Отсутствуют.Количество() = 0 Тогда
		ДобавитьРезультат(Проверки, "ПерсональныеДанные", Представление, Истина);
		Возврат;
	КонецЕсли;

	ДобавитьРезультат(Проверки, "ПерсональныеДанные", Представление, Ложь,
		СтрШаблон(НСтр("ru = 'не объявлены как персональные данные: %1.';
			|en = 'not declared as personal data: %1.'"),
			СтрСоединить(Отсутствуют, ", "))
		+ " " + ЧтоСделать("ЗащитаПерсональныхДанныхПереопределяемый",
			"ЗаполнитьСведенияОПерсональныхДанных"));

КонецПроцедуры

#КонецОбласти

#Область ПроверяемыеОбъекты

Функция ПрофильНайден()

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Идентификатор", Новый УникальныйИдентификатор(
		ИдентификаторПоставляемогоПрофиля()));

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПрофилиГруппДоступа.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
	|ГДЕ
	|	ПрофилиГруппДоступа.ИдентификаторПоставляемыхДанных = &Идентификатор
	|	И НЕ ПрофилиГруппДоступа.ПометкаУдаления";

	// Проверка выполняется под любым пользователем, а справочник профилей закрыт
	// ограничениями доступа.
	УстановитьПривилегированныйРежим(Истина);
	Найден = Не Запрос.Выполнить().Пустой();
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Найден;

КонецФункции

// Имя "Документы" для локальной переменной занято свойством глобального контекста,
// поэтому список собирается в ОбъектыМетаданных.
//
Функция ДокументыСКомандамиПечати()

	ОбъектыМетаданных = Новый Массив;
	ОбъектыМетаданных.Добавить(Метаданные.Документы.бит_ум_ОтчетностьПоИР);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.бит_ум_ЗаявлениеНаУменьшениеСуммыНДФЛ);
	ОбъектыМетаданных.Добавить(
		Метаданные.Документы.бит_ум_ПодтверждениеПраваНаУменьшениеСуммыНДФЛ);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.бит_ум_КвитанцияЗаПатент);

	Возврат ОбъектыМетаданных;

КонецФункции

Функция ПолныеИменаОтчетов()

	ПолныеИмена = Новый Массив;
	ПолныеИмена.Добавить(Метаданные.Отчеты.бит_ум_ДокументыИностранныхРаботников.ПолноеИмя());
	ПолныеИмена.Добавить(Метаданные.Отчеты.бит_ум_ИностранныеРаботники.ПолноеИмя());
	ПолныеИмена.Добавить(Метаданные.Отчеты.бит_ум_НесданныеФормыОтчетности.ПолноеИмя());
	ПолныеИмена.Добавить(Метаданные.Отчеты.бит_ум_ИнформацияОПатентах.ПолноеИмя());
	ПолныеИмена.Добавить(Метаданные.Отчеты.бит_ум_ВзаиморасчетыПоПатентам.ПолноеИмя());
	ПолныеИмена.Добавить(Метаданные.Отчеты.бит_ум_ИсторияДокументов.ПолноеИмя());

	Возврат ПолныеИмена;

КонецФункции

Функция ПолныеИменаРегистровПерсональныхДанных()

	ПолныеИмена = Новый Массив;
	ПолныеИмена.Добавить(Метаданные.РегистрыСведений.бит_ум_ДокументыИР.ПолноеИмя());
	ПолныеИмена.Добавить(Метаданные.РегистрыСведений.бит_ум_ДопДанныеФизЛиц.ПолноеИмя());

	Возврат ПолныеИмена;

КонецФункции

#КонецОбласти

