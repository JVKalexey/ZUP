
#Область СлужебныйПрограммныйИнтерфейс

#Область ВариантыОтчетов

// См. ОтчетыКлиентПереопределяемый.ОбработчикКоманды.
//
Процедура ОбработчикКоманды(ФормаОтчета, Команда, Результат) Экспорт
	
	Если ФормаОтчета.ИмяФормы = "Отчет.ОтчетыПоПроцессамНаграждения.Форма" Тогда
		
		Если ТипЗнч(Команда) = Тип("ТаблицаФормы") И (Команда.Имя = "ИнтервалыНаграждения" ИЛИ Команда.Имя = "МинимальныеСтажиРаботы") Тогда
			ПроцессыНагражденияКлиентСервер.ЗаполнитьПараметрыОтчетаНаградыФизическихЛиц(ФормаОтчета);
		ИначеЕсли Команда.Имя = "ИсключатьРанееНагражденных" Тогда
			ПроцессыНагражденияКлиентСервер.УстановитьДоступностьЭлементовОтчетаНаградыФизическихЛиц(ФормаОтчета);
		ИначеЕсли Команда.Имя = "ИсключатьПоСтажу" Тогда
			ПроцессыНагражденияКлиентСервер.УстановитьДоступностьЭлементовОтчетаНаградыФизическихЛиц(ФормаОтчета);
		КонецЕсли;
		
		Результат = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик расшифровки табличного документа формы отчета.
// См. "ОтчетыКлиентПереопределяемый.ОбработкаРасшифровки".
//
Процедура ОбработкаРасшифровки(ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка) Экспорт
	
	Если ФормаОтчета.НастройкиОтчета.ПолноеИмя = "Отчет.ОтчетыПоПроцессамНаграждения"
		И ФормаОтчета.НастройкиОтчета.КлючПредопределенногоВарианта = "ПодборКандидатов" Тогда
		
		НастройкиОтчетаРасшифровки = ПроцессыНагражденияВызовСервера.НастройкиОтчетаРасшифровки(ФормаОтчета.Отчет.КомпоновщикНастроек, ФормаОтчета.ОтчетДанныеРасшифровки, Расшифровка);
		
		Если Не НастройкиОтчетаРасшифровки = Неопределено Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ВариантыОтчетовКлиент.ОткрытьФормуОтчета(Неопределено, НастройкиОтчетаРасшифровки.ВариантОтчета);
			
			Оповестить(ИмяСобытияУстановитьОтборФормыОтчета(), НастройкиОтчетаРасшифровки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик широковещательного оповещения формы отчета.
// См. ОтчетыКлиентПереопределяемый.ОбработкаОповещения.
//
//
Процедура ОбработкаОповещения(ФормаОтчета, ИмяСобытия, Параметр, Источник, ОповещениеОбработано) Экспорт
	
	Если ИмяСобытия = ИмяСобытияУстановитьОтборФормыОтчета() И ФормаОтчета.КлючТекущегоВарианта = "ДисциплинарныеВзыскания" Тогда
		
		ВариантОтчета = Параметр.ВариантОтчета;
		КомпоновщикНастроек = ФормаОтчета.Отчет.КомпоновщикНастроек;
		ПользовательскиеНастройки = КомпоновщикНастроек.ПользовательскиеНастройки;
		
		НовыеПользовательскиеНастройки = НовыеПользовательскиеНастройки(КомпоновщикНастроек, ПользовательскиеНастройки, Параметр.Отбор);
		
		КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(НовыеПользовательскиеНастройки);
		
		Попытка
			
			ПараметрыОбновления = ОтчетыКлиентСервер.ПараметрыОбновленияФормыОтчета();
			ПараметрыОбновления.КомпоновщикНастроекКД = КомпоновщикНастроек;
			ПараметрыОбновления.Переформировать = Истина;
			ПараметрыОбновления.ОбновитьНастройкиВарианта = Истина;
			
			ФормаОтчета.ПрименитьНастройкиИПереформироватьОтчет(ПараметрыОбновления, Неопределено);
			
			ФормаОтчета.ВариантМодифицирован = Ложь;
			ФормаОтчета.ПользовательскиеНастройкиМодифицированы = Ложь;
			
		Исключение
			
			ОтчетыКлиент.СформироватьОтчет(ФормаОтчета);
			
		КонецПопытки;
		
		ОповещениеОбработано = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриИзмененииЭлементаТребованийПодбораКандидатов(Форма, Элемент) Экспорт
	
	ИмяЭлемента = Элемент.Имя;
	Если Не СтрНайти(ИмяЭлемента, "Флажок") = 0 Тогда
		ИмяЗависимогоЭлемента = СтрЗаменить(ИмяЭлемента, "Флажок", "");
		Элементформы = Форма.Элементы.Найти(ИмяЗависимогоЭлемента);
		Если Не Элементформы = Неопределено Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяЭлемента) Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЗависимогоЭлемента, "Доступность", Форма[ИмяЭлемента]);
			КонецЕсли;
		КонецЕсли;
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюНаграды(Форма, Отказ, ПараметрыЗаписи) Экспорт
	
	Если Не ПроцессыНагражденияВызовСервера.ИспользуютсяПроцессыНаграждения() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Форма.ФлажокМинимальныйВозраст Тогда
		Форма.Объект.МинимальныйВозраст = 0;
	КонецЕсли;
	
	Если Не Форма.ФлажокМаксимальныйВозраст Тогда
		Форма.Объект.МаксимальныйВозраст = 0;
	КонецЕсли;
	
	Если Не Форма.ФлажокМинимальныеСтажиРаботы Тогда
		Форма.Объект.МинимальныеСтажиРаботы.Очистить();
	КонецЕсли;
	
	Если Не Форма.ФлажокОграничениеДолжностей Тогда
		Форма.Объект.ОграничениеДолжностей.Очистить();
	КонецЕсли;
	
	Если Не Форма.ФлажокИнтервалыНаграждения Тогда
		Форма.Объект.ИнтервалыНаграждения.Очистить();
	КонецЕсли;
	
	Если Не Форма.ФлажокНаличиеНаград Тогда
		Форма.Объект.НаличиеНаград.Очистить();
	КонецЕсли;

КонецПроцедуры

Процедура НаградыФизическихЛицПриНачалеРедактирования(Элемент) Экспорт
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.ТекущиеДанные.ДокументРегистратор = Неопределено;
	
КонецПроцедуры

Процедура НаградыФизическихЛицПередУдалениемИзменением(Элемент, Отказ) Экспорт
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДокументРегистратор) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ИмяСобытияУстановитьОтборФормыОтчета()
	Возврат "УстановитьОтборФормыОтчета";
КонецФункции

Функция НовыеПользовательскиеНастройки(Знач КомпоновщикНастроек, Знач ПользовательскиеНастройки, Знач НастройкиОтбора)
	
	НастройкиОтчета = КомпоновщикНастроек.Настройки;
	
	Для Каждого ГруппаОтбора Из НастройкиОтбора Цикл
		
		Для Каждого ЭлементОтбора Из ГруппаОтбора.Значение Цикл
			
			ИмяПоля = СтрШаблон("%1.%2", ГруппаОтбора.Ключ, ЭлементОтбора.Ключ);
			
			Для Каждого ЭлементОтбораКомпоновкиДанных Из НастройкиОтчета.Отбор.Элементы Цикл
				
				Если Не ЭлементОтбораКомпоновкиДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля) Тогда
					Продолжить;
				КонецЕсли;
				
				ЭлементОтбораКомпоновкиДанных.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
				ЭлементНастройки = ПользовательскиеНастройки.Элементы.Найти(ЭлементОтбораКомпоновкиДанных.ИдентификаторПользовательскойНастройки);
				
				Если Не ЭлементНастройки = Неопределено Тогда
					
					ЭлементНастройки.Использование = Истина;
					ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					ЭлементНастройки.ПравоеЗначение = ЭлементОтбора.Значение;
					ЭлементНастройки.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
					
				КонецЕсли;
				
				Прервать;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПользовательскиеНастройки;
	
КонецФункции

#КонецОбласти
