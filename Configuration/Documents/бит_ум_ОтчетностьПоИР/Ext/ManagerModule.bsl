	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	ВыполняемоеДействие";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаВыполняемыеДействия.Добавить(), Выборка);
	КонецЦикла;
	
	ДанныеДляЗаполнения.Вставить("ТаблицаВыполняемыеДействия", ТаблицаВыполняемыеДействия);
	
	ПоместитьВоВременноеХранилище(ДанныеДляЗаполнения, АдресРезультата);
	
КонецПроцедуры

Функция ОпределитьСобытиеПоСотруднику(Сотрудник) Экспорт
	
	ФизическиеЛица = КадровыйУчет.ФизическиеЛицаСотрудников(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник));
		
	Если ФизическиеЛица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическиеЛица[0]);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.бит_ум_ВидыСобытийПоИР.Прибытие) КАК Событие,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ ВТПриоритетСобытий
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.бит_ум_ВидыСобытийПоИР.ПриемНаРаботу),
	|	2
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.бит_ум_ВидыСобытийПоИР.Увольнение),
	|	3
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.бит_ум_ВидыСобытийПоИР.Убытие),
	|	4
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВидыДействийПоСобытиямВидыИР.СтатусИР КАК СтатусИР,
	|	ВидыДействийПоСобытиямВидыИР.РежимВъездаИР КАК РежимВъездаИР,
	|	ВидыДействийПоСобытиямВидыИР.Ссылка КАК ВыполняемоеДействие,
	|	ВидыДействийПоСобытиямСобытия.Событие КАК Событие
	|ПОМЕСТИТЬ ВТПереченьДействий
	|ИЗ
