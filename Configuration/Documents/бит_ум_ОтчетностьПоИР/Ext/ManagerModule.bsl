// СтандартныеПодсистемы.ВерсионированиеОбъектов
// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
//  Настройки - Структура - настройки подсистемы.
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт

КонецПроцедуры
// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// Возвращает список реквизитов, которые не нужно редактировать
// с помощью обработки группового изменения объектов.
//
// Возвращаемое значение:
//   Массив - список имен реквизитов объекта.
//
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	НеРедактируемыеРеквизиты.Добавить("КраткийСоставДокумента");
	НеРедактируемыеРеквизиты.Добавить("ВсеВыполнено");
	
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Реестр действий
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "РеестрДействий";
	КомандаПечати.Представление = НСтр("ru = 'Реестр действий'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.МенеджерПечати = "Документ.бит_ум_ОтчетностьПоИР";	
	
	// Реестр документов
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "РеестрДокументов";
	КомандаПечати.Представление = НСтр("ru = 'Реестр документов'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.МенеджерПечати = "Документ.бит_ум_ОтчетностьПоИР";	
	
	// Печать всех документов
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ПечатьФормОтчетности";
	КомандаПечати.Представление = НСтр("ru = 'Печать всех документов'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.МенеджерПечати = "Документ.бит_ум_ОтчетностьПоИР";	
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РеестрДействий") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "РеестрДействий", НСтр("ru = 'Реестр действий'"), 
			ПечатьРеестраДействий(МассивОбъектов, ОбъектыПечати), , "Документ.бит_ум_ОтчетностьПоИР.ПФ_MXL_РеестрДействий");
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РеестрДокументов") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "РеестрДокументов", НСтр("ru = 'Реестр документов'"), 
			ПечатьРеестраДокументов(МассивОбъектов, ОбъектыПечати), , "Документ.бит_ум_ОтчетностьПоИР.ПФ_MXL_РеестрДокументов");
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьФормОтчетности") Тогда
		бит_ум_УчетМигрантовСервер.ПечатьФормОтчетности(МассивОбъектов, ПараметрыПечати,
			КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Вызывается при переходе на версию конфигурации 3.1.11.3.
//
Процедура ОбновлениеДокументов_3_1_11_3() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетностьПоИР.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.бит_ум_ОтчетностьПоИР КАК ОтчетностьПоИР
	|ГДЕ
	|	(ОтчетностьПоИР.ДатаСобытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ОтчетностьПоИР.Действия = """")";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ДатаСобытия = ДокументОбъект.Дата; 
		ДокументОбъект.Действия = СтрСоединить(ОбщегоНазначенияКлиентСервер.СвернутьМассив(
			ДокументОбъект.ВыполняемыеДействия.ВыгрузитьКолонку("Действие")), ", ");
			
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект, , , РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьРеестраДействий(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_бит_ум_ОтчетностьПоИР_РеестрДействий";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.бит_ум_ОтчетностьПоИР.ПФ_MXL_РеестрДействий");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетностьПоИРВыполняемыеДействия.Ссылка КАК Ссылка,
	|	ОтчетностьПоИРВыполняемыеДействия.Действие.КонтролирующийОрган КАК ВидДокументаКонтролирующийОрган,
	|	ОтчетностьПоИРВыполняемыеДействия.Сотрудник,
	|	ОтчетностьПоИРВыполняемыеДействия.Действие
	|ИЗ
	|	Документ.бит_ум_ОтчетностьПоИР.ВыполняемыеДействия КАК ОтчетностьПоИРВыполняемыеДействия
	|ГДЕ
	|	ОтчетностьПоИРВыполняемыеДействия.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ВидДокументаКонтролирующийОрган,
	|	ОтчетностьПоИРВыполняемыеДействия.Сотрудник.Наименование,
	|	ОтчетностьПоИРВыполняемыеДействия.Действие.Наименование
	|ИТОГИ ПО
	|	Ссылка,
	|	ВидДокументаКонтролирующийОрган";
	
	Результат = Запрос.Выполнить();
	Шапка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока Шапка.Следующий() Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
		
		ВыборкаВидДокументаКонтролирующийОрган = Шапка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаВидДокументаКонтролирующийОрган.Следующий() Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("ВидДокументаКонтролирующийОрган");
			ОбластьМакета.Параметры.Заполнить(ВыборкаВидДокументаКонтролирующийОрган);
			ТабличныйДокумент.Вывести(ОбластьМакета, ВыборкаВидДокументаКонтролирующийОрган.Уровень() - 1);
		
			ВыборкаДетали = ВыборкаВидДокументаКонтролирующийОрган.Выбрать();
		
			Пока ВыборкаДетали.Следующий() Цикл
				ОбластьМакета = Макет.ПолучитьОбласть("Детали");
				ОбластьМакета.Параметры.Заполнить(ВыборкаДетали);
				ТабличныйДокумент.Вывести(ОбластьМакета, ВыборкаДетали.Уровень() - 1);
			КонецЦикла;
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТаблицы");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьРеестраДокументов(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_бит_ум_ОтчетностьПоИР_РеестрДокументов";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.бит_ум_ОтчетностьПоИР.ПФ_MXL_РеестрДокументов");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетностьПоИРВыполняемыеДействия.Ссылка КАК Ссылка,
	|	ОтчетностьПоИРВыполняемыеДействия.Действие.КонтролирующийОрган КАК ВидДокументаКонтролирующийОрган,
	|	ОтчетностьПоИРВыполняемыеДействия.Сотрудник,
	|	ОтчетностьПоИРВыполняемыеДействия.Действие.ВидОформляемогоДокумента КАК ВидОформляемогоДокумента
	|ИЗ
	|	Документ.бит_ум_ОтчетностьПоИР.ВыполняемыеДействия КАК ОтчетностьПоИРВыполняемыеДействия
	|ГДЕ
	|	ОтчетностьПоИРВыполняемыеДействия.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ВидДокументаКонтролирующийОрган,
	|	ОтчетностьПоИРВыполняемыеДействия.Сотрудник.Наименование,
	|	ОтчетностьПоИРВыполняемыеДействия.Действие.ВидОформляемогоДокумента.Наименование
	|ИТОГИ ПО
	|	Ссылка,
	|	ВидДокументаКонтролирующийОрган";
	
	Результат = Запрос.Выполнить();
	Шапка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока Шапка.Следующий() Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
		
		ВыборкаВидДокументаКонтролирующийОрган = Шапка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаВидДокументаКонтролирующийОрган.Следующий() Цикл
			ОбластьМакета = Макет.ПолучитьОбласть("ВидДокументаКонтролирующийОрган");
			ОбластьМакета.Параметры.Заполнить(ВыборкаВидДокументаКонтролирующийОрган);
			ТабличныйДокумент.Вывести(ОбластьМакета, ВыборкаВидДокументаКонтролирующийОрган.Уровень() - 1);
		
			ВыборкаДетали = ВыборкаВидДокументаКонтролирующийОрган.Выбрать();
		
			Пока ВыборкаДетали.Следующий() Цикл
				ОбластьМакета = Макет.ПолучитьОбласть("Детали");
				ОбластьМакета.Параметры.Заполнить(ВыборкаДетали);
				ТабличныйДокумент.Вывести(ОбластьМакета, ВыборкаДетали.Уровень() - 1);
			КонецЦикла;
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
		
		ОбластьМакета = Макет.ПолучитьОбласть("ПодвалТаблицы");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабличныйДокумент.Вывести(ОбластьМакета);
	
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Процедура заполнения табличной части.
//
Процедура ПодготовитьДанныеДляЗаполнения(Параметры, АдресРезультата) Экспорт
	
	ДанныеДляЗаполнения = Новый Структура;
	
	ТаблицаВыполняемыеДействия = Параметры.ТаблицаВыполняемыеДействия;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("Период", Параметры.Дата);
	Запрос.УстановитьПараметр("Событие", Параметры.Событие);	
	Если Параметры.Свойство("Основание") Тогда
		Запрос.УстановитьПараметр("Основание", Параметры.Основание);
	КонецЕсли;
	
	Если НЕ Параметры.Свойство("Сотрудник") И НЕ Параметры.Свойство("Основание") И
		(Параметры.Событие = Перечисления.бит_ум_ВидыСобытийПоИР.ПриемНаРаботу
		ИЛИ Параметры.Событие = Перечисления.бит_ум_ВидыСобытийПоИР.Увольнение) Тогда    
		
		Запрос.Текст = 
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ДопДанныеФизЛицСрезПоследних.Физлицо КАК ФизическоеЛицо,
        |	ДопДанныеФизЛицСрезПоследних.РежимВъезда КАК РежимВъезда,
