	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ЗарплатаКадрыОбщиеНаборыДанных.РазделительЗапросов() +
	"ВЫБРАТЬ
	|	ВыполненныеДействия.Действие КАК Действие,
	|	ВыполненныеДействия.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ ВыполненныеДействия
	|ИЗ
	|	РегистрСведений.бит_ум_ВыполненныеДействия.СрезПоследних(
	|			&Период,
	|			Действие В
	|					(ВЫБРАТЬ
	|						ПереченьДействий.ВыполняемоеДействие
	|					ИЗ
	|						ПереченьДействий)
	|				И Организация = &Организация
