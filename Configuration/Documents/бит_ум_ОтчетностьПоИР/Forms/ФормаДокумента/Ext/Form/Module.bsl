#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ бит_ум_УчетМигрантовСервер.ПолучитьЛицензию(Истина) Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;	
	
	КадровыйУчетФормы.ФормаКадровогоДокументаПриСозданииНаСервере(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов	
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства	
	
	// ЗарплатаКадрыПодсистемы.ПодписиДокументов
	ПодписиДокументов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ЗарплатаКадрыПодсистемы.ПодписиДокументов
	
	СоздатьДополнительныеКомандыПечати();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ПодготовитьФормуНаСервере();
		УстановитьФункциональныеОпцииФормы();
		ЗаполнитьОтветственногоПоИностраннымРаботникам();
		
		Если ЗначениеЗаполнено(Параметры.Основание) Тогда
			Для Каждого СтрокаТаблицы Из Объект.ВыполняемыеДействия Цикл
				ОбновитьПараметры(СтрокаТаблицы.Действие, СтрокаТаблицы.КлючСвязи);
			КонецЦикла;
		КонецЕсли;
		
		Если Параметры.Свойство("Событие") Тогда
			Объект.Событие = Параметры.Событие;
		КонецЕсли;
		
		Если Параметры.Свойство("Организация") И ЗначениеЗаполнено(Параметры.Организация) Тогда
			Объект.Организация = Параметры.Организация;
		КонецЕсли;
		
		Если Параметры.Свойство("ВыполняемыеДействия") И ТипЗнч(Параметры.ВыполняемыеДействия) = Тип("Массив") Тогда
			Для Каждого Действие Из Параметры.ВыполняемыеДействия Цикл
				СтрокаТабличнойЧасти = Объект.ВыполняемыеДействия.Добавить();
				СтрокаТабличнойЧасти.КлючСвязи = ПоискПоТабличнойЧасти();
				ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, Действие);
				ОбновитьПараметры(СтрокаТабличнойЧасти.Действие, СтрокаТабличнойЧасти.КлючСвязи);
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			ОрганизацияПриИзмененииНаСервере();
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства	
	
 	// СтандартныеПодсистемы.ПодключаемыеКоманды
 	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
 	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом	
	
	ПодготовитьФормуНаСервере();
	УстановитьФункциональныеОпцииФормы();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства	
	
 	// СтандартныеПодсистемы.ПодключаемыеКоманды
 	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
 	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды		
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом	

	ПодготовитьФормуНаСервере();
	
	// ЗарплатаКадрыПодсистемы.ПодписиДокументов
	ПодписиДокументов.ПослеЗаписиНаСервере(ЭтотОбъект);
	// Конец ЗарплатаКадрыПодсистемы.ПодписиДокументов	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыбраноЗначениеПараметраДляЗаполнения" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("Параметр") И ЗначениеЗаполнено(Параметр.Параметр) Тогда
			Для Каждого СтрокаТаблицы Из Объект.ДополнительныеПараметрыПечати Цикл
				Если СтрокаТаблицы.Параметр = Параметр.Параметр Тогда
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Параметр, "Значение, ЗначениеЗначениеПолей, ЗначениеЗначение"); 
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыполняемыеДействия

&НаКлиенте
Процедура ВыполняемыеДействияПриАктивизацииСтроки(Элемент)

	ОтобразитьПараметрыПечати();
	ЗапомнитьТекущуюСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполняемыеДействияПередУдалением(Элемент, Отказ)

	КлючПоиска = Новый Структура("КлючСвязи", Элементы.ДополнительныеПараметрыПечати.ОтборСтрок.КлючСвязи);
	
	НайденныеСтроки = Объект.ДополнительныеПараметрыПечати.НайтиСтроки(КлючПоиска);
	
	Для Каждого Строка Из НайденныеСтроки Цикл
		Объект.ДополнительныеПараметрыПечати.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполняемыеДействияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Копирование Тогда
		ДействиеПредыдущий = Неопределено;
	Иначе
		ДействиеПредыдущий = Элементы.ВыполняемыеДействия.ТекущиеДанные.Действие;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		
		Кандидат = ПоискПоТабличнойЧасти();
		
		Элементы.ВыполняемыеДействия.ТекущиеДанные.КлючСвязи = Кандидат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполняемыеДействияПослеУдаления(Элемент)
	
	ОтобразитьПараметрыПечати();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполняемыеДействияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ТекущиеДанные = Элементы.ВыполняемыеДействия.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДействиеПредыдущий <> ТекущиеДанные.Действие Тогда
		ОбновитьПараметры(ТекущиеДанные.Действие, ТекущиеДанные.КлючСвязи);
	КонецЕсли;
	
	ОтобразитьПараметрыПечати();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДополнительныеПараметрыПечати

&НаКлиенте
Процедура ДополнительныеПараметрыПечатиПередНачаломИзменения(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.ПолеАдреса Тогда
		Элементы.ДополнительныеПараметрыПечатиЗначение.КнопкаВыбора = Истина;
		Элементы.ДополнительныеПараметрыПечатиЗначение.РедактированиеТекста = Ложь;
	ИначеЕсли Элемент.ТекущиеДанные.ЭтоДлиннаяСтрока Тогда
		Элементы.ДополнительныеПараметрыПечатиЗначение.КнопкаВыбора = Истина;
		Элементы.ДополнительныеПараметрыПечатиЗначение.РедактированиеТекста = Истина;
	Иначе	
		Элементы.ДополнительныеПараметрыПечатиЗначение.КнопкаВыбора = Неопределено;
		Элементы.ДополнительныеПараметрыПечатиЗначение.РедактированиеТекста = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеПараметрыПечатиЗначениеОчистка(Элемент, СтандартнаяОбработка)

	Элементы.ДополнительныеПараметрыПечати.ТекущиеДанные.ЗначениеЗначениеПолей = ""; 
	Элементы.ДополнительныеПараметрыПечати.ТекущиеДанные.ЗначениеЗначение = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеПараметрыПечатиЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДополнительныеПараметрыПечати.ТекущиеДанные;

	Если ТекущиеДанные.ПолеАдреса Тогда
		
  		ВидКонтактнойИнформацииАдреса = Новый Структура;
    	ВидКонтактнойИнформацииАдреса.Вставить("Тип",
			ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	    ВидКонтактнойИнформацииАдреса.Вставить("ТолькоНациональныйАдрес", Истина);
	    ВидКонтактнойИнформацииАдреса.Вставить("ВключатьСтрануВПредставление", Ложь);
    	ВидКонтактнойИнформацииАдреса.Вставить("СкрыватьНеактуальныеАдреса", Ложь);		
		
		ПараметрыОткрытия = УправлениеКонтактнойИнформациейКлиент.ПараметрыФормыКонтактнойИнформации(
			ВидКонтактнойИнформацииАдреса,
			?(ЗначениеЗаполнено(ТекущиеДанные.ЗначениеЗначение), ТекущиеДанные.ЗначениеЗначение, ТекущиеДанные.ЗначениеЗначениеПолей),
			ТекущиеДанные.Значение);
		ПараметрыОткрытия.Заголовок = Строка(ТекущиеДанные.Параметр);
				
		УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыОткрытия, Элемент);		
		
	ИначеЕсли ТекущиеДанные.ЭтоДлиннаяСтрока Тогда
		
		СтандартнаяОбработка = Ложь;
		ДополнительныеПараметры = Новый Структура("ТекущаяСтрока", Элементы.ДополнительныеПараметрыПечати.ТекущаяСтрока);
		Оповещение = Новый ОписаниеОповещения("ЗначениеНачалоВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение, ТекущиеДанные.Значение, 
			Строка(ТекущиеДанные.Параметр));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеПараметрыПечатиЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДополнительныеПараметрыПечати.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные.ПолеАдреса Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Значение = ВыбранноеЗначение.Представление;
	ТекущиеДанные.ЗначениеЗначениеПолей = ВыбранноеЗначение.КонтактнаяИнформация;
	ТекущиеДанные.ЗначениеЗначение = ВыбранноеЗначение.Значение;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ВыполняемыеДействия.Количество() > 0 Тогда
		
		Если Объект.Проведен Тогда
			ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а табличная часть будет очищена. Заполнить?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'");
		КонецЕсли;

		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьДействиямиПоСобытиюЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		ЗаполнитьДействиямиПоСобытию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначениеПараметра(Команда)
	
	СписокПараметров = Новый Массив;
	
	УникальныеЗначения = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из Объект.ДополнительныеПараметрыПечати Цикл
		Если УникальныеЗначения[СтрокаТаблицы.Параметр] = Неопределено Тогда
			СписокПараметров.Добавить(СтрокаТаблицы.Параметр);
			УникальныеЗначения.Вставить(СтрокаТаблицы.Параметр, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокПараметров.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Нет параметров для заполнения.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокПараметров", СписокПараметров);

	ОткрытьФорму("Документ.бит_ум_ОтчетностьПоИР.Форма.ВводЗначенияПараметра", ПараметрыФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПризнакВыполнено(Команда)
	
	ТекстПодсказки = НСтр("ru = 'Укажите дату выполнения'");
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДатыВыполнения", ЭтотОбъект);
	ПоказатьВводДаты(Оповещение, ТекущаяДата(), ТекстПодсказки, ЧастиДаты.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьПоВыбраннойСтроке(Команда)
	
	Если Элементы.ВыполняемыеДействия.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПечатьПоВыбраннойСтроке", Элементы.ВыполняемыеДействия.ТекущиеДанные.НомерСтроки);
	
	Если Объект.Ссылка.Пустая() ИЛИ ЭтаФорма.Модифицированность Тогда
		
		Если Объект.Ссылка.Пустая() Тогда
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Данные еще не записаны.
					|Выполнение действия ""%1"" возможно только после записи данных.
					|Данные будут записаны.'"),
				НСтр("ru = 'Печать по выбранной строке'"));
				
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьКомандуПечатиПодтверждениеЗаписи", ЭтаФорма, ДополнительныеПараметры);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
			Возврат;
		КонецЕсли;
		ВыполнитьКомандуПечатиПодтверждениеЗаписи(КодВозвратаДиалога.ОК, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ВыполнитьКомандуПечатиПодтверждениеЗаписи(Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

