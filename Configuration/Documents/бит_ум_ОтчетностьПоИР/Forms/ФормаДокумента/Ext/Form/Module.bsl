&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьСостояниеДокумента();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = СостояниеДокумента(Объект);
	
КонецПроцедуры

&НаСервере
Функция СостояниеДокумента(Объект)
	
	РучнаяКорректировка = Неопределено;
	
	Если Объект.ПометкаУдаления Тогда
		СостояниеДокумента = 2;
	ИначеЕсли Объект.Проведен Тогда
		СостояниеДокумента = 1;
	Иначе
		СостояниеДокумента = 0;
	КонецЕсли;
	
	Возврат СостояниеДокумента;
	
КонецФункции

&НаСервере
Функция ПоискПоТабличнойЧасти()
	
	НеУстановлено = Истина;
	Кандидат = Объект.ВыполняемыеДействия.Количество();

	Пока НеУстановлено Цикл
			
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("КлючСвязи", Кандидат);
			
		Если НЕ ЗначениеЗаполнено(Объект.ВыполняемыеДействия.НайтиСтроки(ПараметрыОтбора)) Тогда
			
			НеУстановлено = Ложь;

			Возврат Кандидат
			
		Иначе
			
			// Такое значение ключа уже использовано
			Кандидат = Кандидат + 1;

		КонецЕсли;

	КонецЦикла;

КонецФункции

&НаКлиенте
Процедура ОтобразитьПараметрыПечати()
	
	СтрокаТаблицы = Элементы.ВыполняемыеДействия.ТекущиеДанные;
	
	Если СтрокаТаблицы <> Неопределено Тогда
		ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСвязи", СтрокаТаблицы.КлючСвязи); 
		Элементы.ДополнительныеПараметрыПечати.ОтборСтрок = ОтборСтрок;
	Иначе
		Если Объект.ВыполняемыеДействия.Количество() = 0 Тогда
			Объект.ДополнительныеПараметрыПечати.Очистить();
		КонецЕсли;
		ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСвязи", -1); 
		Элементы.ДополнительныеПараметрыПечати.ОтборСтрок = ОтборСтрок;
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	ЗаполнитьОтветственногоПоИностраннымРаботникам();
	
	// ЗарплатаКадрыПодсистемы.ПодписиДокументов
	ПодписиДокументов.ЗаполнитьПодписиПоОрганизации(ЭтотОбъект);
	// Конец ЗарплатаКадрыПодсистемы.ПодписиДокументов
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ПараметрыФО = Новый Структура("Организация, Период", Объект.Организация, Объект.Дата);
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФО);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтветственногоПоИностраннымРаботникам()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Оформил = бит_ум_УчетМигрантовСервер.ПолучитьОтветственноеЛицо(Объект.Организация, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметры(Действие, КлючСвязи)
	
	СписокДоступныхПараметров = Новый Массив;
	
	Если ЗначениеЗаполнено(Действие) Тогда
		ВидОформляемогоДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Действие, "ВидОформляемогоДокумента");
	КонецЕсли;                                                                           
	
	Если ЗначениеЗаполнено(ВидОформляемогоДокумента) Тогда
		СписокДоступныхПараметров = бит_ум_УчетМигрантовПовтИсп.ПолучитьСписокПараметровПечати(ВидОформляемогоДокумента);
	КонецЕсли;
	
	НайденныеСтроки = Объект.ДополнительныеПараметрыПечати.НайтиСтроки(Новый Структура("КлючСвязи", КлючСвязи));
	
	// Добавим отсутствующие параметры
	Для Каждого Параметр Из СписокДоступныхПараметров Цикл
		
		ПараметрНайден = Ложь;
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если Строка.Параметр = Параметр Тогда
				ПараметрНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ПараметрНайден Тогда
			СтрокаТаблицы = Объект.ДополнительныеПараметрыПечати.Добавить();
			СтрокаТаблицы.КлючСвязи = КлючСвязи;
			СтрокаТаблицы.Параметр = Параметр;
			СтрокаТаблицы.Значение = СтрокаТаблицы.Параметр.ТипЗначения.ПривестиЗначение(Неопределено);
			ЗаполнитьДобавленныеКолонкиВСтрокеПараметров(СтрокаТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверим, что нет лишних параметров
	Для Каждого Строка Из НайденныеСтроки Цикл
		Если СписокДоступныхПараметров.Найти(Строка.Параметр) = Неопределено Тогда
			Объект.ДополнительныеПараметрыПечати.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Объект.ДополнительныеПараметрыПечати.Сортировать("КлючСвязи, РеквизитДопУпорядочивания, Параметр");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	Для Каждого СтрокаТаблицы Из Объект.ДополнительныеПараметрыПечати Цикл
		ЗаполнитьДобавленныеКолонкиВСтрокеПараметров(СтрокаТаблицы);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиВСтрокеПараметров(СтрокаТаблицы)
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.Параметр,
		"ТипЗначения, ПолеАдреса, РеквизитДопУпорядочивания");
	
	Если ЗначенияРеквизитов.ТипЗначения.Типы().Количество() = 1
		И ЗначенияРеквизитов.ТипЗначения.Типы()[0] = Тип("Строка")
		И ЗначенияРеквизитов.ТипЗначения.КвалификаторыСтроки.Длина > 10 Тогда
		СтрокаТаблицы.ЭтоДлиннаяСтрока = Истина;
	Иначе
		СтрокаТаблицы.ЭтоДлиннаяСтрока = Ложь;
	КонецЕсли;
	СтрокаТаблицы.ПолеАдреса = ЗначенияРеквизитов.ПолеАдреса;
	СтрокаТаблицы.РеквизитДопУпорядочивания = ЗначенияРеквизитов.РеквизитДопУпорядочивания;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеНачалоВыбораЗавершение(Знач ВведенныйТекст, Знач ДополнительныеПараметры) Экспорт
	
	Если ВведенныйТекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.ДополнительныеПараметрыПечати.НайтиПоИдентификатору(ДополнительныеПараметры.ТекущаяСтрока);
	ТекущиеДанные.Значение = ВведенныйТекст;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьТекущуюСтроку()
	
	Если Элементы.ВыполняемыеДействия.ТекущиеДанные = Неопределено Тогда
		ТекущаяСтрока = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Новый Структура("НомерСтроки, Сотрудник, Действие");
	КонецЕсли;
	
	Для Каждого Поле Из ТекущаяСтрока Цикл
		ТекущаяСтрока[Поле.Ключ] = Элементы.ВыполняемыеДействия.ТекущиеДанные[Поле.Ключ]; 
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДополнительныеКомандыПечати()
	
	Если Элементы.Найти("ПодменюПечать") <> Неопределено Тогда
		НовыйЭлемент = Элементы.Добавить("ФормаКоманднаяПанельПодменюПечатьПечатьПоВыбраннойСтроке", Тип("КнопкаФормы"), Элементы.ПодменюПечать);
	Иначе
		НовыйЭлемент = Элементы.Добавить("ФормаКоманднаяПанельПодменюПечатьПечатьПоВыбраннойСтроке", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанельПодменюПечать);
	КонецЕсли;
	НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды = "ПечатьПоВыбраннойСтроке";
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДействиямиПоСобытию()
	
	ДлительнаяОперация = НачатьЗаполнениеТаблицыВыполняемыеДействия();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения =
		НСтр("ru = 'Заполнение документа ""Отчетность по иностранным работникам""'");
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьДействиямиПоСобытиюЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДействиямиПоСобытиюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗагрузитьПодготовленныеДанные(Результат.АдресРезультата);
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2'"),
			ОбщегоНазначенияКлиент.ДатаСеанса(), Результат.ПодробноеПредставлениеОшибки));
	КонецЕсли;
	
	Если Результат.Сообщения <> Неопределено Тогда
		Для Каждого СообщениеПользователю Из Результат.Сообщения Цикл
			СообщениеПользователю.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(,Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
	ОтобразитьПараметрыПечати();
	ЗапомнитьТекущуюСтроку();
	
КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеТаблицыВыполняемыеДействия()
	
	ПараметрыПроцедуры = Новый Структура("Организация, Дата, Событие, Проведен");
	ЗаполнитьЗначенияСвойств(ПараметрыПроцедуры, Объект);
	
	Если ПараметрыПроцедуры.Проведен Тогда 
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
		Записать(ПараметрыЗаписи);
	КонецЕсли;
	
	Объект.ВыполняемыеДействия.Очистить();
	Объект.ДополнительныеПараметрыПечати.Очистить();
	
	ТаблицаВыполняемыеДействия = Объект.ВыполняемыеДействия.Выгрузить();
	ТаблицаВыполняемыеДействия.Очистить();
	
	ПараметрыПроцедуры.Вставить("ТаблицаВыполняемыеДействия", ТаблицаВыполняемыеДействия);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение документа ""Отчетность по иностранным работникам""'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.бит_ум_ОтчетностьПоИР.ПодготовитьДанныеДляЗаполнения", 
		ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьПодготовленныеДанные(АдресРезультата)

	СтруктураДанных = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(СтруктураДанных) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;                           

	Если СтруктураДанных.Свойство("ТаблицаВыполняемыеДействия") Тогда
		
		Объект.ВыполняемыеДействия.Загрузить(СтруктураДанных.ТаблицаВыполняемыеДействия);
		
		КлючСвязи = 0;
		
		Для Каждого СтрокаТаблицы Из Объект.ВыполняемыеДействия Цикл
			
			КлючСвязи = КлючСвязи + 1;
			
			СтрокаТаблицы.КлючСвязи = КлючСвязи;
			
			ОбновитьПараметры(СтрокаТаблицы.Действие, КлючСвязи);
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьДействиямиПоСобытиюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДействиямиПоСобытию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуПечатиПодтверждениеЗаписи(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		ОчиститьСообщения();
		ЭтаФорма.Записать();
		Если Объект.Ссылка.Пустая() Или ЭтаФорма.Модифицированность Тогда
			Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
		КонецЕсли;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Документ.бит_ум_ОтчетностьПоИР",
		"ПечатьФормОтчетности", Объект.Ссылка,
		ЭтаФорма, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДатыВыполнения(Дата, Параметры) Экспорт
	
	Если Дата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из Объект.ВыполняемыеДействия Цикл
		Если НЕ СтрокаТЧ.Выполнено Тогда
			СтрокаТЧ.Выполнено = Истина;
			СтрокаТЧ.ДатаВыполнения = Дата;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти