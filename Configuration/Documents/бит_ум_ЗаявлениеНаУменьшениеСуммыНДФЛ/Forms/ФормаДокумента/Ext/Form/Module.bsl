#Область ВыгрузкаОтчетаВФайл

&НаКлиенте
Функция ИзвлечьИмяФайлаИзТекстаXML(Знач ТекстXML)
	
	ИмяФайла = "";
	ВхождениеИдФайл = СтрНайти(ТекстXML, " ИдФайл");
	Если ВхождениеИдФайл <> 0 Тогда
		ТекстXML = Сред(ТекстXML, ВхождениеИдФайл);
		ВхождениеПервойКавычки = СтрНайти(ТекстXML, """");
		Если ВхождениеПервойКавычки <> 0 Тогда
			ТекстXML = Сред(ТекстXML, ВхождениеПервойКавычки + 1);
			ВхождениеВторойКавычки = СтрНайти(ТекстXML, """");
			Если ВхождениеВторойКавычки <> 0 Тогда
				ИмяФайла = СокрЛП(Лев(ТекстXML, ВхождениеВторойКавычки - 1)) + ".xml";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ИмяФайла;
	
КонецФункции

&НаСервере
Функция УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузки)
	
	Возврат бит_ум_УчетМигрантовСервер.ВыгрузкаВXMLЗаявленияНаУменьшениеСуммыНДФЛ(Объект.Ссылка, ТекстВыгрузки);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПоместитьФайлВыгрузкиВоВременноеХранилищеНаСервере(Текст, ТекСтрИмяФайла, КодировкаТекста, УникальныйИДФормы = Неопределено)
		
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("tmp");
		
	Текст.Записать(ИмяВременногоФайла, КодировкаТекста);	
	
	ФайлВыгрузки = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	Адрес = ПоместитьВоВременноеХранилище(ФайлВыгрузки, ?(ЗначениеЗаполнено(УникальныйИДФормы) = Истина, УникальныйИДФормы, Новый УникальныйИдентификатор()));
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Адрес;
	
КонецФункции

// Сохраняет файл выгрузки в каталог, выбранный пользователем.
//
// Каталог запрашивается диалогом платформы, файл передаёт сама платформа: клиенту
// не нужны ни временный файл, ни запись, ни перемещение. Вариант без диалога
// возвращает массив описаний переданных файлов, поэтому успех подтверждается
// достоверно и о нём сообщается.
//
// Параметры:
//   Текст - ТекстовыйДокумент - содержимое файла выгрузки.
//   ИмяКонечногоФайла - Строка - имя файла, полученное из текста выгрузки.
//   КодировкаТекстаВыгрузки - Строка - кодировка, в которой записывается файл.
//
&НаКлиенте
Асинх Процедура СохранитьФайлВыгрузкиВКаталог(Текст, ИмяКонечногоФайла, КодировкаТекстаВыгрузки)

	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Заголовок = НСтр("ru = 'Укажите каталог';
		|en = 'Specify a folder'");

	ВыбранныеКаталоги = Ждать ДиалогВыбораКаталога.ВыбратьАсинх();

	// Отказ от выбора каталога - штатный исход: файл даже не формируется.
	Если ВыбранныеКаталоги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПутьВыгрузки = ВыбранныеКаталоги[0];
	Если Прав(ПутьВыгрузки, 1) <> ПолучитьРазделительПути() Тогда
		ПутьВыгрузки = ПутьВыгрузки + ПолучитьРазделительПути();
	КонецЕсли;

	Попытка

		АдресФайлаВыгрузки = ПоместитьФайлВыгрузкиВоВременноеХранилищеНаСервере(
			Текст, ИмяКонечногоФайла, КодировкаТекстаВыгрузки, УникальныйИдентификатор);

		ПолучаемыеФайлы = Новый Массив;
		ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяКонечногоФайла, АдресФайлаВыгрузки));

		ПереданныеФайлы = Ждать ПолучитьФайлыССервераАсинх(ПолучаемыеФайлы, ПутьВыгрузки);

		Если ТипЗнч(ПереданныеФайлы) = Тип("Массив") И ПереданныеФайлы.Количество() > 0 Тогда

			ШаблонСообщения =
				НСтр("ru = 'Файл выгрузки регламентированного отчета ""%1"" сохранен в каталог ""%2"".'");

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(ШаблонСообщения, ИмяКонечногоФайла, ПутьВыгрузки);
			Сообщение.Сообщить();

		КонецЕсли;

	Исключение

		ТекстСообщения =
			НСтр("ru='Не удалось записать файл ""%1""! Возможно, недостаточно места на диске или диск защищен от записи.'");

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(ТекстСообщения, ИмяКонечногоФайла);
		Сообщение.Сообщить();

	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьФайлВыгрузкиВБраузере(Текст, ИмяКонечногоФайла, КодировкаТекстаВыгрузки)

	Попытка

		АдресФайлаВыгрузки = ПоместитьФайлВыгрузкиВоВременноеХранилищеНаСервере(
			Текст, ИмяКонечногоФайла, КодировкаТекстаВыгрузки, УникальныйИдентификатор);

		ПолучаемыеФайлы = Новый Массив;
		ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяКонечногоФайла, АдресФайлаВыгрузки));

		ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов(
			НСтр("ru = 'Укажите файл для сохранения';
				|en = 'Specify a file to save'"));

		// Результат всегда Неопределено и в веб-клиенте заполняется до показа диалога,
		// поэтому отличить сохранение от отмены нельзя. Отмена ошибкой не считается,
		// об успешном сохранении не сообщается.
		РезультатНеОпределяется = Ждать ПолучитьФайлыССервераАсинх(ПолучаемыеФайлы, ПараметрыДиалога);

	Исключение

		ТекстСообщения =
			НСтр("ru='Не удалось записать файл ""%1""! Возможно, недостаточно места на диске или диск защищен от записи.'");

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(ТекстСообщения, ИмяКонечногоФайла);
		Сообщение.Сообщить();

	КонецПопытки;

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьСостояниеДокумента();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеДокумента()
	
	СостояниеДокумента = СостояниеДокумента(Объект);
	
КонецПроцедуры

&НаСервере
Функция СостояниеДокумента(Объект)
	
	РучнаяКорректировка = Неопределено;
	
	Если Объект.ПометкаУдаления Тогда
		СостояниеДокумента = 2;
	ИначеЕсли Объект.Проведен Тогда
		СостояниеДокумента = 1;
	Иначе
		СостояниеДокумента = 0;
	КонецЕсли;
	
	Возврат СостояниеДокумента;
	
КонецФункции

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	ЗаполнитьОтветственногоПоИностраннымРаботникам();
	
	// ЗарплатаКадрыПодсистемы.ПодписиДокументов
	ПодписиДокументов.ЗаполнитьПодписиПоОрганизации(ЭтотОбъект);
	// Конец ЗарплатаКадрыПодсистемы.ПодписиДокументов	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ПараметрыФО = Новый Структура("Организация, Период", Объект.Организация, Объект.Дата);
	УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФО);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтветственногоПоИностраннымРаботникам()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Оформил = бит_ум_УчетМигрантовСервер.ПолучитьОтветственноеЛицо(Объект.Организация, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьСотрудникамиИмеющимиПатент(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСотрудникамиИмеющимиПатентНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСотрудникамиИмеющимиПатентНаКлиенте()
	
	ДлительнаяОперация = НачатьЗаполнениеТаблицыПереченьСотрудников();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения =
		НСтр("ru = 'Выполняется заполнение документа ""Заявление на уменьшение суммы НДФЛ"".'");
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьСотрудникамиИмеющимиПатентЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСотрудникамиИмеющимиПатентЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗагрузитьПодготовленныеДанные(Результат.АдресРезультата);
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2'"),
			ОбщегоНазначенияКлиент.ДатаСеанса(), Результат.ПодробноеПредставлениеОшибки));
	КонецЕсли;
	
	Если Результат.Сообщения <> Неопределено Тогда
		Для Каждого СообщениеПользователю Из Результат.Сообщения Цикл
			СообщениеПользователю.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(,Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеТаблицыПереченьСотрудников()
	
	ПараметрыПроцедуры = Новый Структура("Организация, Дата, Проведен");
	ЗаполнитьЗначенияСвойств(ПараметрыПроцедуры, Объект);
	
	Если ПараметрыПроцедуры.Проведен Тогда 
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
		Записать(ПараметрыЗаписи);
	КонецЕсли;
	
	Объект.ПереченьСотрудников.Очистить();
	
	ТаблицаПереченьСотрудников = Объект.ПереченьСотрудников.Выгрузить();
	ТаблицаПереченьСотрудников.Очистить();

	ПараметрыПроцедуры.Вставить("ТаблицаПереченьСотрудников", ТаблицаПереченьСотрудников);

	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение документа ""Заявление на уменьшение суммы НДФЛ""'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.бит_ум_ЗаявлениеНаУменьшениеСуммыНДФЛ.ПодготовитьДанныеДляЗаполнения", 
		ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьПодготовленныеДанные(АдресРезультата)

	СтруктураДанных = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(СтруктураДанных) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;                           

	Если СтруктураДанных.Свойство("ТаблицаПереченьСотрудников") Тогда
		Объект.ПереченьСотрудников.Загрузить(СтруктураДанных.ТаблицаПереченьСотрудников);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция АдресСпискаПодобранныхСотрудников()
	
	Возврат ПоместитьВоВременноеХранилище(Объект.ПереченьСотрудников.Выгрузить(,"Сотрудник").ВыгрузитьКолонку("Сотрудник"), УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура СотрудникиОбработкаВыбораНаСервере(ВыбранныеСотрудники)
	
	Если ТипЗнч(ВыбранныеСотрудники) = Тип("Массив") Тогда
		СписокСотрудников = ВыбранныеСотрудники;
	Иначе
		СписокСотрудников = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранныеСотрудники);
	КонецЕсли;
	
	ДобавляемыеСотрудники = Новый Массив;
	Для Каждого Сотрудник Из СписокСотрудников Цикл
		
		Если Объект.ПереченьСотрудников.НайтиСтроки(Новый Структура("Сотрудник", Сотрудник)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		ДобавляемыеСотрудники.Добавить(Сотрудник);
		
	КонецЦикла;
	
	Для каждого ДобавляемыйСотрудник Из ДобавляемыеСотрудники Цикл
		
		НоваяСтрокаСотрудников = Объект.ПереченьСотрудников.Добавить();
		НоваяСтрокаСотрудников.Сотрудник = ДобавляемыйСотрудник;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти