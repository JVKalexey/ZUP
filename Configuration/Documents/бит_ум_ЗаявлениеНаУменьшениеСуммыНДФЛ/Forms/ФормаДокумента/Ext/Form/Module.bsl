&НаКлиенте
Процедура ПодобратьСотрудников(Команда)
	
	КадровыйУчетКлиент.ВыбратьСотрудниковРаботающихНаДатуПоПараметрамОткрытияФормыСписка(
		Элементы.ПереченьСотрудников,
		Объект.Организация,
		,
		Объект.Дата,
		Истина,
		АдресСпискаПодобранныхСотрудников());

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСотрудникамиИмеющимиПатент(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект, "Организация");
		Возврат;
	КонецЕсли;
		
	Если Объект.ПереченьСотрудников.Количество() > 0 Тогда
		
		Если Объект.Проведен Тогда
			ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а табличная часть будет очищена. Заполнить?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'");
		КонецЕсли;

		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьСотрудникамиИмеющимиПатент", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		ЗаполнитьСотрудникамиИмеющимиПатентНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)

	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ОшибкаВыгрузки = Ложь;
	
	ТекстВыгрузкиВXML = "";
	
	Если НЕ УниверсальнаяВыгрузкаXMLНаСервере(ТекстВыгрузкиВXML) Тогда
		Возврат;
	КонецЕсли;
	
	#Если НЕ ВебКлиент Тогда
				
		ПутьВыгрузки = РегламентированнаяОтчетностьКлиент.ПолучитьПутьВыгрузки();
		Если ПутьВыгрузки = Ложь Тогда
			ОшибкаВыгрузки = Истина;
			Возврат;
		КонецЕсли;
				
	#КонецЕсли
	
	ИмяКонечногоФайла = ИзвлечьИмяФайлаИзТекстаXML(ТекстВыгрузкиВXML);
	
	Если НЕ ПустаяСтрока(ИмяКонечногоФайла) Тогда
		
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ТекстВыгрузкиВXML);
		
		КодировкаТекстаВыгрузки = "windows-1251";

		Попытка
			
			АдресФайлаВыгрузки = Неопределено;
			
			#Если ВебКлиент Тогда
				
				ПолучитьФайл(ПоместитьФайлВыгрузкиВоВременноеХранилищеНаСервере(
					Текст, ИмяКонечногоФайла, КодировкаТекстаВыгрузки), ИмяКонечногоФайла, Истина);
				
			#Иначе
				
				ИмяВременногоФайла = КаталогВременныхФайлов() + ИмяКонечногоФайла;
				ПолноеИмяКонечногоФайла = ПутьВыгрузки + ИмяКонечногоФайла;
				
				Если АдресФайлаВыгрузки <> Неопределено Тогда
					ДвоичныйФайл = ПолучитьИзВременногоХранилища(АдресФайлаВыгрузки);
					ДвоичныйФайл.Записать(ИмяВременногоФайла);
				Иначе
					Текст.Записать(ИмяВременногоФайла, КодировкаТекстаВыгрузки);
				КонецЕсли;
				
				ПереместитьФайл(ИмяВременногоФайла, ПолноеИмяКонечногоФайла);
				
				ТекстСообщения = НСтр("ru = 'Файл выгрузки регламентированного отчета ""%1"" сохранен в каталог ""%2"".'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, ИмяКонечногоФайла, ПутьВыгрузки);  
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон(НСтр("ru='%1'"), ТекстСообщения);
				Сообщение.Сообщить();
		
			#КонецЕсли
					
		Исключение
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(НСтр("ru='Не удалось записать файл ""%1""! Возможно, недостаточно места на диске или диск защищен от записи.'"),
				ИмяКонечногоФайла);
			Сообщение.Сообщить();
			
		КонецПопытки;
		
	КонецЕсли;

КонецПроцедуры

