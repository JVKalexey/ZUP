#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс	
	
// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
КонецПроцедуры

// Заполняет список текущих дел пользователя.
//
// Параметры:
//   ТекущиеДела - ТаблицаЗначений - таблица с колонками:
//     * Идентификатор           - Строка - внутренний идентификатор дела, используемый механизмом "Текущие дела".
//     * ЕстьДела                - Булево - если Истина, дело выводится в списке текущих дел пользователя.
//     * Важное                  - Булево - если Истина, дело будет выделено красным цветом.
//     * Представление           - Строка - представление дела, выводимое пользователю.
//     * Количество              - Число  - количественный показатель дела, выводится в строке заголовка дела.
//     * Форма                   - Строка - полный путь к форме, которую необходимо открыть при нажатии на
//         гиперссылку дела на панели "Текущие дела".
//     * ПараметрыФормы          - Структура - параметры, с которыми нужно открывать форму показателя.
//     * Владелец                - Строка, объект метаданных - строковый идентификатор дела,
//         которое будет владельцем для текущего или объект метаданных подсистема.
//     * Подсказка               - Строка - текст подсказки.
//
Процедура ПриЗаполненииСпискаТекущихДел(ТекущиеДела) Экспорт
	
    Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыНакопления.бит_ум_ОплатаПатентов) Тогда
        Возврат;
	КонецЕсли;	
	
	Если НЕ ПолучитьФункциональнуюОпцию("бит_ум_УчетПатентов") Тогда
		Возврат;
	КонецЕсли;
	
	МодульТекущиеДелаСервер = ОбщегоНазначения.ОбщийМодуль("ТекущиеДелаСервер");
	
	Если МодульТекущиеДелаСервер.ДелоОтключено("УМПросроченныеПатенты") Тогда
		Возврат;
	КонецЕсли;
	
	ПредупреждениеОбОплатеПатентов = бит_ум_УчетМигрантовПовтИсп.ПолучитьКонстантуИзНастроек("ПредупреждениеОбОплатеПатентов");
	Если НЕ ЗначениеЗаполнено(ПредупреждениеОбОплатеПатентов) Тогда
		Возврат;
	КонецЕсли;
	
	Дело = ТекущиеДела.Добавить();
	Дело.Идентификатор = "УМПросроченныеПатенты";
	Дело.Представление = НСтр("ru = 'Подходит срок оплаты патентов'");
	Дело.Владелец = Метаданные.Подсистемы.УчетМигрантов;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПредупреждениеОбОплатеПатентов", ПредупреждениеОбОплатеПатентов);
	                  
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыИР.Физлицо КАК ФизическоеЛицо
	|ПОМЕСТИТЬ ВТФизическиеЛица
	|ИЗ
	|	РегистрСведений.бит_ум_ДокументыИР.СрезПоследних({(&Период)}, ВидДокумента = ЗНАЧЕНИЕ(Справочник.бит_ум_ВидыДокументовИР.Патент)) КАК ДокументыИР
	|ГДЕ
	|	ДокументыИР.Архив = ЛОЖЬ
	|	И (ДокументыИР.СрокДействия >= &Период
	|			ИЛИ ДокументыИР.СрокДействия = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.Выполнить(); 
	
	ПараметрыПолученияСотрудников =
		КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоВременнойТаблице();
	
	ПараметрыПолученияСотрудников.ИмяВТФизическиеЛица = "ВТФизическиеЛица";	
	ПараметрыПолученияСотрудников.КадровыеДанные = "ДатаПриема,ДатаУвольнения,Организация";     
	
	КадровыйУчет.СоздатьВТСотрудникиОрганизации(
		МенеджерВременныхТаблиц, Истина, 
		ПараметрыПолученияСотрудников,
		"ВТСотрудникиФизическихЛиц");
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОплатаПатентов.ФизическоеЛицо КАК ФизическоеЛицо,
	|	МАКСИМУМ(ДОБАВИТЬКДАТЕ(ОплатаПатентов.ПериодВзаиморасчетов, МЕСЯЦ, 1)) КАК СрокОплаты,
	|	ВЫБОР
	|		КОГДА МАКСИМУМ(ДОБАВИТЬКДАТЕ(ОплатаПатентов.ПериодВзаиморасчетов, МЕСЯЦ, 1)) <= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Важное,
	|	ОплатаПатентов.Организация КАК Организация
	|ИЗ
	|	РегистрНакопления.бит_ум_ОплатаПатентов.Обороты(
	|			,
	|			&Период,
	|			,
	|			(Организация, ФизическоеЛицо) В
	|				(ВЫБРАТЬ
	|					ФизическиеЛица.Организация,
	|					ФизическиеЛица.ФизическоеЛицо
	|				ИЗ
	|					ВТСотрудникиФизическихЛиц КАК ФизическиеЛица
	|				ГДЕ
	|					(ФизическиеЛица.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1)
	|						ИЛИ ФизическиеЛица.ДатаУвольнения >= &Период))) КАК ОплатаПатентов
	|
	|СГРУППИРОВАТЬ ПО
	|	ОплатаПатентов.ФизическоеЛицо,
	|	ОплатаПатентов.Организация
	|
	|ИМЕЮЩИЕ
	|	ДОБАВИТЬКДАТЕ(МАКСИМУМ(ДОБАВИТЬКДАТЕ(ОплатаПатентов.ПериодВзаиморасчетов, МЕСЯЦ, 1)), ДЕНЬ, -1 * &ПредупреждениеОбОплатеПатентов) <= НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
	|ИТОГИ
	|	КОЛИЧЕСТВО(ФизическоеЛицо),
	|	МАКСИМУМ(Важное)
	|ПО
	|	ОБЩИЕ,
	|	Организация";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Дело.ЕстьДела = Ложь;
		Дело.Важное = Ложь;
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Выборка.Следующий();
	
	Дело.ЕстьДела = Истина;
	Дело.Важное = Выборка.Важное > 0;
	Дело.Количество = Выборка.ФизическоеЛицо;
	
	ПараметрыНастроек = Новый Структура;
	ПараметрыНастроек.Вставить("Период", Новый СтандартныйПериод('00010101',  ТекущаяДатаСеанса()));
    ПользовательскиеНастройки = УстановитьПользовательскиеНастройкиОтчета("бит_ум_ВзаиморасчетыПоПатентам", ПараметрыНастроек);
	
	ВыборкаОрганизаций = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОрганизаций.Следующий() Цикл
				
		ДелоОрганизации = ТекущиеДела.Добавить();
		ДелоОрганизации.Идентификатор = "УМПросроченныеПатенты" + СтрЗаменить(ВыборкаОрганизаций.Организация.УникальныйИдентификатор(), "-", "");
		ДелоОрганизации.Представление = ВыборкаОрганизаций.Организация; 
		ДелоОрганизации.Владелец = "УМПросроченныеПатенты";
		ДелоОрганизации.ЕстьДела = Истина;
		ДелоОрганизации.Важное = ВыборкаОрганизаций.Важное > 0;
		ДелоОрганизации.Количество = ВыборкаОрганизаций.ФизическоеЛицо;
		ДелоОрганизации.Форма = "Отчет.бит_ум_ВзаиморасчетыПоПатентам.ФормаОбъекта";
	
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", ВыборкаОрганизаций.Организация);
		Отбор.Вставить("ПодходитСрокОплаты", Истина);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		ПараметрыФормы.Вставить("КлючВарианта", "Основной");
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
		ПараметрыФормы.Вставить("Отбор", Отбор);
		
		ДелоОрганизации.ПараметрыФормы = ПараметрыФормы; 
		
	КонецЦикла;
	
КонецПроцедуры

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УстановитьПользовательскиеНастройкиОтчета(ТипОтчета,СтруктураПараметров)
	
    СтруктураНастроек = Новый Структура;
    ОтчетОбъект = Отчеты[ТипОтчета].Создать();
    
    ПользовательскиеНастройки = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки;
    Для Каждого ЭлПараметр  Из СтруктураПараметров Цикл
        Для Каждого ПараметрСКД Из ПользовательскиеНастройки.Элементы Цикл
            Если ТипЗнч(ПараметрСКД) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда  
                Если строка(ПараметрСКД.Параметр) = ЭлПараметр.Ключ Тогда 
                    ПараметрСКД.Значение = ЭлПараметр.Значение;
                    ПараметрСКД.Использование = Истина;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;    
    КонецЦикла;
        
    Возврат ПользовательскиеНастройки;
	
КонецФункции

#КонецОбласти
	
#КонецЕсли