#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ бит_ум_УчетМигрантовСервер.ПолучитьЛицензию(Истина) Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;	
	
	Если НЕ Объект.ВнешнийМакетИспользовать Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
	ВнешнийМакетЗарегистрирован = ВнешнийМакетЗарегистрирован(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УправлениеЭУ();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Объект.ВнешнийМакетИспользовать И НЕ ВнешнийМакетЗарегистрирован Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Макет отсутствует! Загрузите макет для продолжения.'"));
		Модифицированность = Истина;
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ЗначениеЗаполнено(АдресФайлаВоВременномХранилище) Тогда
		ТекущийОбъект.ВнешнийМакетХранилище = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище),
			Новый СжатиеДанных(9));
		УдалитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
		АдресФайлаВоВременномХранилище = Неопределено;
	ИначеЕсли ОчиститьХранилищеВнешнегоМакета Тогда 
		ТекущийОбъект.ВнешнийМакетХранилище = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИсточникМакетаФайлНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьВнешнийМакет();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникМакетаФайлОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	Если НЕ ВнешнийМакетЗарегистрирован Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолеИсточникМакетаФайлОчисткаЗавершение", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'Удалить хранящийся в информационной базе макет?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияВыгрузитьНажатие(Элемент)

	ВыгрузитьВнешнийМакет();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УправлениеЭУ()
	
	Если Модифицированность И ЗначениеЗаполнено(ПолноеИмяЗагруженногоВнешнегоМакета) Тогда
		ИсточникМакетаФайл = ПолноеИмяЗагруженногоВнешнегоМакета;
	Иначе
		ИсточникМакетаФайл = ?(ВнешнийМакетЗарегистрирован, НСтр("ru = 'Макет загружен в ИБ'"), "");
	КонецЕсли;
	
	Элементы.ДекорацияВыгрузить.Видимость = ВнешнийМакетЗарегистрирован И НЕ ОчиститьХранилищеВнешнегоМакета;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВнешнийМакетЗарегистрирован(СсылкаНаОбъект)
	
	Возврат НЕ СсылкаНаОбъект.ВнешнийМакетХранилище.Получить() = Неопределено;
	
КонецФункции

&НаКлиенте
Асинх Процедура ВыгрузитьВнешнийМакет()

	АдресДанныхВыгружаемогоФайла = ПолучитьВременныйФайл();

	Если НЕ ЗначениеЗаполнено(АдресДанныхВыгружаемогоФайла) Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяВыгружаемогоФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(
		?(ПустаяСтрока(Объект.Наименование), "", Объект.Наименование + ".mxl"));

	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПолноеИмяВыгружаемогоФайла, АдресДанныхВыгружаемогоФайла));

	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов(
		НСтр("ru = 'Укажите файл для сохранения';
			|en = 'Specify a file to save'"));

	// Результат этого вызова всегда Неопределено: платформа заполняет его до показа диалога
	// в веб-клиенте и сразу после в остальных, поэтому отличить сохранение от отмены нельзя.
	// Именно поэтому о результате выгрузки пользователю не сообщается.
	РезультатНеОпределяется = Ждать ПолучитьФайлыССервераАсинх(ПолучаемыеФайлы, ПараметрыДиалога);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьВнешнийМакет()

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов(
		НСтр("ru = 'Выберите файл табличного документа';
			|en = 'Select a spreadsheet document file'"),
		Ложь,
		НСтр("ru = 'Табличный документ (*.mxl)|*.mxl';
			|en = 'Spreadsheet document (*.mxl)|*.mxl'"));

	ПомещенныйФайл = Ждать ПоместитьФайлНаСерверАсинх(,,, ПараметрыДиалога, УникальныйИдентификатор);

	// Отмена выбора — штатный исход: адрес ранее загруженного макета не сбрасываем.
	Если ТипЗнч(ПомещенныйФайл) <> Тип("ОписаниеПомещенногоФайла")
		ИЛИ ПомещенныйФайл.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	АдресФайлаВоВременномХранилище = ПомещенныйФайл.Адрес;
	ПолноеИмяЗагруженногоВнешнегоМакета = ИмяВыбранногоФайла(ПомещенныйФайл);

	ПроверитьВнешнийМакет();

КонецПроцедуры

// Возвращает имя выбранного пользователем файла для показа в поле "Источник макета".
//
// Параметры:
//   ПомещенныйФайл - ОписаниеПомещенногоФайла - результат помещения файла во временное хранилище.
//
// Возвращаемое значение:
//   Строка - имя файла, а при его отсутствии — нейтральное описание источника.
//
&НаКлиенте
Функция ИмяВыбранногоФайла(ПомещенныйФайл)

	// Полного локального пути современный интерфейс не дает ни в одном клиенте,
	// а в веб-клиенте браузер может не сообщить и имя файла.
	СсылкаНаФайл = ПомещенныйФайл.СсылкаНаФайл;
	Если СсылкаНаФайл = Неопределено ИЛИ ПустаяСтрока(СсылкаНаФайл.Имя) Тогда
		Возврат НСтр("ru = 'Макет загружен из файла';
			|en = 'Template loaded from file'");
	КонецЕсли;

	Возврат СсылкаНаФайл.Имя;

КонецФункции

&НаКлиенте
Процедура ПроверитьВнешнийМакет()
	
	Состояние("ru = 'Проверка макета...'");
	
	ПрочитатьВнешнийМакет();
	УправлениеЭУ();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьВнешнийМакет()
	
	ИмяФайлаМакета = ПолучитьИмяВременногоФайла("mxl");
	ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище).Записать(ИмяФайлаМакета);
	УдалитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Попытка
		ТабличныйДокумент.Прочитать(ИмяФайлаМакета);
		АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ТабличныйДокумент, Новый УникальныйИдентификатор);
		ВнешнийМакетЗарегистрирован = Истина;
		Модифицированность = Истина;
		ОчиститьХранилищеВнешнегоМакета = Ложь;
	Исключение
		ТекстСообщения = НСтр("ru = 'Неверный формат файла.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		АдресФайлаВоВременномХранилище = Неопределено;
		ПолноеИмяЗагруженногоВнешнегоМакета = Неопределено;
	КонецПопытки;
	
	УдалитьФайлы(ИмяФайлаМакета);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВременныйФайл()
	
	Если ЗначениеЗаполнено(АдресФайлаВоВременномХранилище) Тогда
		ТабличныйДокумент = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
	Иначе
		ТабличныйДокумент = Объект.Ссылка.ВнешнийМакетХранилище.Получить();
	КонецЕсли;
	
	Если ТипЗнч(ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
		Возврат "";
	КонецЕсли;
	
	ВремФайл = ПолучитьИмяВременногоФайла();
	
	ТабличныйДокумент.Записать(ВремФайл);
	
	АдресДанныхВыгружаемогоФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ВремФайл), Новый УникальныйИдентификатор);
								
	УдалитьФайлы(ВремФайл);							
								
	Возврат АдресДанныхВыгружаемогоФайла;
	
КонецФункции

&НаКлиенте
Процедура ПолеИсточникМакетаФайлОчисткаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьХранилищеВнешнегоМакета = Истина;
	ВнешнийМакетЗарегистрирован = Ложь;
	Модифицированность = Истина;
	УправлениеЭУ();
	
КонецПроцедуры

#КонецОбласти