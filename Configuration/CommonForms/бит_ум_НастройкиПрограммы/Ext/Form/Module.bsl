	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Родитель",
		ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.СправочникФизическиеЛица"));
	ПараметрыОтбора.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	
	ПараметрыФормы = Новый Структура;
