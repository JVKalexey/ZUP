&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ГруппаКадровыйУчет.Видимость = бит_ум_УчетМигрантовПовтИсп.ЭтоУМ();
	
	Элементы.КадровыйУчетУпрощенный.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьКадровыйУчет);
		
	Элементы.КадровыйУчетПолный.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьКадровыйУчет);
		
	Элементы.СформироватьКадровыеДокументы.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьКадровыйУчет);
		
	КадровыйУчет = Константы.ИспользоватьКадровыйУчет.Получить();
	
	Элементы.бит_ум_ВидАдресаПостоянногоМестаЖительства.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.бит_ум_ВидАдресаПостоянногоМестаЖительства);
	Элементы.бит_ум_ВидАдресаМестаПребывания.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.бит_ум_ВидАдресаМестаПребывания);
	Элементы.бит_ум_ВидАдресаФактическогоОрганизации.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.бит_ум_ВидАдресаФактическогоОрганизации);
	Элементы.бит_ум_ВидАдресаМестонахожденияОрганизации.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.бит_ум_ВидАдресаМестонахожденияОрганизации);
	Элементы.бит_ум_ВыводитьИндексВАдресе.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.бит_ум_ВыводитьИндексВАдресе);
	Элементы.бит_ум_УчетПатентов.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.бит_ум_УчетПатентов);
	Элементы.бит_ум_УчетПатентов.Доступность = 
		ПравоДоступа("Изменение", Метаданные.Константы.бит_ум_ПредупреждениеОбОплатеПатентов);
		
	Если бит_ум_УчетМигрантовПовтИсп.ЭтоУМ() Тогда	
		УправлениеФормой(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

