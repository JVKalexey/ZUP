	ПараметрыФормы.Вставить("ТекущаяСтрока", НаборКонстант[Элемент.Имя]); 
	ОткрытьФорму("Справочник.ВидыКонтактнойИнформации.ФормаВыбора", ПараметрыФормы, Элемент);

