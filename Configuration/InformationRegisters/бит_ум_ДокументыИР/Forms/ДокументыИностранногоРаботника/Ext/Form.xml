	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Архив</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументыИР.Период,
	ДокументыИР.Физлицо,
	ДокументыИР.ВидДокумента, 
	ДокументыИР.Разрез,
	ДокументыИР.Серия,
	ДокументыИР.Номер,
	ДокументыИР.ДатаВыдачи,
	ДокументыИР.СрокДействия,
	ДокументыИР.ДопПоле,
	ДокументыИР.ДопПоле2,
	ДокументыИР.Архив,
	ДокументыИР.ГосударственныйОрган,
	ВЫБОР
		КОГДА ДокументыИР.ТерриторияДействия = ""
			ТОГДА ДокументыИР.ГосударственныйОрган.ТерриторияДействия
		ИНАЧЕ ДокументыИР.ТерриторияДействия
	КОНЕЦ КАК ТерриторияДействия,
	ВЫБОР
		КОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ДокументыИР.СрокДействия, ДЕНЬ, -1 * ДокументыИР.ВидДокумента.СрокНапоминания), ДЕНЬ) &lt; &amp;ТекущаяДата
				И КОНЕЦПЕРИОДА(ДокументыИР.СрокДействия, ДЕНЬ) &gt; &amp;ТекущаяДата
				И ДокументыИР.ВидДокумента.СрокНапоминания &gt; 0
				И ДокументыИР.СрокДействия &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ПодошелСрокНапоминания,
	ВЫБОР
		КОГДА КОНЕЦПЕРИОДА(ДокументыИР.СрокДействия, ДЕНЬ) &lt; &amp;ТекущаяДата
				И ДокументыИР.СрокДействия &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ПодошелСрокДействия,
	НЕ ДокументыИРСрезПоследних.Период ЕСТЬ NULL КАК АктуальнаяЗапись
ИЗ
	РегистрСведений.бит_ум_ДокументыИР КАК ДокументыИР
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ум_ДокументыИР.СрезПоследних КАК ДокументыИРСрезПоследних
		ПО ДокументыИР.Период = ДокументыИРСрезПоследних.Период
			И ДокументыИР.Физлицо = ДокументыИРСрезПоследних.Физлицо
			И ДокументыИР.ВидДокумента = ДокументыИРСрезПоследних.ВидДокумента 
			И ДокументыИР.Разрез = ДокументыИРСрезПоследних.Разрез</QueryText>
				<MainTable>InformationRegister.бит_ум_ДокументыИР</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>ВидДокумента</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Период</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:item>
							<dcsset:selection/>
							<dcsset:filter>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">Архив</dcsset:left>
									<dcsset:comparisonType>Equal</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
								</dcsset:item>
							</dcsset:filter>
							<dcsset:appearance>
								<dcscor:item xsi:type="dcsset:SettingsParameterValue">
									<dcscor:parameter>ЦветТекста</dcscor:parameter>
									<dcscor:value xsi:type="v8ui:Color">web:DarkGray</dcscor:value>
								</dcscor:item>
							</dcsset:appearance>
						</dcsset:item>
						<dcsset:item>
							<dcsset:selection/>
							<dcsset:filter>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">Архив</dcsset:left>
									<dcsset:comparisonType>Equal</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
								</dcsset:item>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">ПодошелСрокНапоминания</dcsset:left>
									<dcsset:comparisonType>Equal</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
								</dcsset:item>
								<dcsset:item xsi:type="dcsset:FilterItemComparison">
									<dcsset:left xsi:type="dcscor:Field">АктуальнаяЗапись</dcsset:left>
									<dcsset:comparisonType>Equal</dcsset:comparisonType>
									<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
								</dcsset:item>
							</dcsset:filter>
							<dcsset:appearance>
