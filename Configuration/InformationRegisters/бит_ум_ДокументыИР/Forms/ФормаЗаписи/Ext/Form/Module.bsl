#Область ОписаниеПеременных

&НаКлиенте
Перем ИсходныйКлюч; // Структура - период и измерения записи на момент открытия формы. Разрез входит в ключ,
                    // поэтому по нему отличаем смену разреза у существующей записи от ввода новой.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ИсходныйКлюч = КлючТекущейЗаписи();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если ПараметрыЗаписи.Свойство("РазрезПодтвержден")
		ИЛИ ИсходныйКлюч = Неопределено
		ИЛИ ИсходныйКлюч.Разрез = Запись.Разрез Тогда
		Возврат;
	КонецЕсли;

	// Записи с прежним ключом может не быть, если форму открыли для ввода новой записи, —
	// тогда переносить нечего и спрашивать не о чем.
	Если НЕ ЗаписьСуществует(ИсходныйКлюч) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Перенести", НСтр("ru = 'Перенести';
		|en = 'Move'"));
	Кнопки.Добавить("Добавить", НСтр("ru = 'Добавить второй';
		|en = 'Add second'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена';
		|en = 'Cancel'"));

	ТекстВопроса = НСтр("ru = 'Документ «%1» уже внесен в разрезе «%2», а сейчас выбран разрез «%3».
		|
		|Перенести — документ будет числиться только в новом разрезе.
		|Добавить второй — прежний документ останется, а в новом разрезе появится еще один.';
		|en = 'The «%1» document is already stored in the «%2» section, and now the «%3» section
		|is selected.
		|
		|Move — the document will be listed only in the new section.
		|Add second — the previous document remains, and one more appears in the new section.'");

	ТекстВопроса = СтрШаблон(ТекстВопроса, Запись.ВидДокумента,
		ПредставлениеРазреза(ИсходныйКлюч.Разрез), ПредставлениеРазреза(Запись.Разрез));

	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект, ПараметрыЗаписи),
		ТекстВопроса, Кнопки, , "Перенести");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Завершает запись после ответа на вопрос о смене разреза.
//
// Параметры:
//   Результат - Строка, КодВозвратаДиалога - выбранная пользователем кнопка.
//   ПараметрыЗаписи - Структура - параметры записи, переданные из ПередЗаписью.
//
&НаКлиенте
Процедура ПередЗаписьюЗавершение(Результат, ПараметрыЗаписи) Экспорт

	Если Результат <> "Перенести" И Результат <> "Добавить" Тогда
		Возврат;
	КонецЕсли;

	ПрежнийКлюч = ИсходныйКлюч;

	ПараметрыЗаписи.Вставить("РазрезПодтвержден", Истина);
	Если НЕ Записать(ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;

	// Прежнюю запись удаляем только после успешной записи новой: при обратном порядке сбой
	// записи оставил бы работника вообще без этого документа.
	Если Результат = "Перенести" Тогда
		УдалитьЗапись(ПрежнийКлюч);
	КонецЕсли;

	ИсходныйКлюч = КлючТекущейЗаписи();

КонецПроцедуры

// Возвращает период и измерения записи, открытой в форме.
//
// Возвращаемое значение:
//   Структура:
//     * Период - Дата
//     * Физлицо - СправочникСсылка.ФизическиеЛица
//     * ВидДокумента - СправочникСсылка.бит_ум_ВидыДокументовИР
//     * Разрез - СправочникСсылка.бит_ум_РазрезыДокументовИР
//
// Возвращает название разреза для сообщения пользователю.
//
// Параметры:
//   Разрез - СправочникСсылка.бит_ум_РазрезыДокументовИР - разрез, в том числе пустой.
//
// Возвращаемое значение:
//   Строка - наименование разреза, а для незаполненного — «Основной».
//
&НаКлиенте
Функция ПредставлениеРазреза(Разрез)

	Возврат ?(ЗначениеЗаполнено(Разрез), Строка(Разрез), НСтр("ru = 'Основной';
		|en = 'Main'"));

КонецФункции

&НаКлиенте
Функция КлючТекущейЗаписи()

	Возврат Новый Структура("Период, Физлицо, ВидДокумента, Разрез",
		Запись.Период, Запись.Физлицо, Запись.ВидДокумента, Запись.Разрез);

КонецФункции

&НаСервереБезКонтекста
Функция ЗаписьСуществует(Ключ)

	МенеджерЗаписи = РегистрыСведений.бит_ум_ДокументыИР.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Ключ);
	МенеджерЗаписи.Прочитать();

	Возврат МенеджерЗаписи.Выбран();

КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьЗапись(Ключ)

	МенеджерЗаписи = РегистрыСведений.бит_ум_ДокументыИР.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Ключ);
	МенеджерЗаписи.Удалить();

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Объект = Форма.Запись;
	Элементы = Форма.Элементы;	
	
	ДополнительныеПоля = НастройкаДополнительныхПолей(Объект.ВидДокумента);

	// Разрез применим не ко всем видам документов: паспорт или виза у работника один,
	// а патентов может быть несколько. Признак задается в виде документа.
	Элементы.Разрез.Видимость = ДополнительныеПоля.ИспользоватьРазрез = Истина;

	Элементы.ГруппаДополнительноеПоле.Видимость = ДополнительныеПоля.ИспользоватьДопПоле = Истина;
	Если Элементы.ГруппаДополнительноеПоле.Видимость Тогда
		Элементы.ДопПоле.Заголовок = ДополнительныеПоля.НазваниеДопПоля;
	КонецЕсли;
	
	Элементы.ГруппаДополнительноеПоле2.Видимость = ДополнительныеПоля.ИспользоватьДопПоле2 = Истина;
	Если Элементы.ГруппаДополнительноеПоле2.Видимость Тогда
		Элементы.ДопПоле2.Заголовок = ДополнительныеПоля.НазваниеДопПоля2;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкаДополнительныхПолей(ВидДокумента)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидДокумента,
		"ИспользоватьДопПоле, ИспользоватьДопПоле2, НазваниеДопПоля, НазваниеДопПоля2, ИспользоватьРазрез");

КонецФункции

#КонецОбласти