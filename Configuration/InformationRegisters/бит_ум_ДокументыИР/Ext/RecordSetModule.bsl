#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПредупредитьОСрокеДействияПатентов();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Предупреждает, если срок действия патента выходит за двенадцать месяцев со дня выдачи.
//
// Пункт 5 статьи 13.3 Федерального закона от 25.07.2002 № 115-ФЗ: патент выдается на срок от
// одного до двенадцати месяцев и может продлеваться неоднократно, но общий срок с учетом
// продлений не может составлять более двенадцати месяцев со дня выдачи.
//
// Запись не отклоняем: сведения вводят и задним числом, и по документам, выданным до изменения
// правил, — решение остается за пользователем.
//
Процедура ПредупредитьОСрокеДействияПатентов()

	ВидПатента = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.бит_ум_ВидыДокументовИР.Патент");

	Для Каждого ЗаписьРегистра Из ЭтотОбъект Цикл

		Если ЗаписьРегистра.ВидДокумента <> ВидПатента
			ИЛИ НЕ ЗначениеЗаполнено(ЗаписьРегистра.ДатаВыдачи)
			ИЛИ НЕ ЗначениеЗаполнено(ЗаписьРегистра.СрокДействия) Тогда
			Продолжить;
		КонецЕсли;

		ПредельныйСрок = ДобавитьМесяц(НачалоДня(ЗаписьРегистра.ДатаВыдачи), 12);
		Если НачалоДня(ЗаписьРегистра.СрокДействия) <= ПредельныйСрок Тогда
			Продолжить;
		КонецЕсли;

		ТекстПредупреждения = НСтр("ru = 'Срок действия патента, выданного %1, выходит за двенадцать
			|месяцев со дня выдачи (пункт 5 статьи 13.3 Федерального закона № 115-ФЗ).';
			|en = 'The validity period of the patent issued on %1 exceeds twelve months from the
			|issue date (clause 5 of article 13.3 of Federal Law No. 115-FZ).'");

		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(ТекстПредупреждения, Формат(ЗаписьРегистра.ДатаВыдачи, "ДЛФ=D")));

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
