#Область ОбработчикиПравилРегистрации

// См. ЗарплатаКадрыРасширенныйСинхронизацияДанных.ШаблонОбработчика
Процедура ПриЗаполненииНастроекОбработчиковПравилРегистрации(Настройки) Экспорт
	ЗарплатаКадрыРасширенныйСинхронизацияДанных.ДляРегистраПодчиненногоРегистратору(Настройки);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОбновления

// Параметры:
//  ПараметрыОбновления - Структура - параметры обработчика обновления.
Процедура ЗаполнитьВыявленныеВредныеФакторыСОУТ(ПараметрыОбновления) Экспорт

	ВредныеКлассы = КлассыУсловийТрудаКлиентСервер.ВредныеИОпасныеКлассыУсловийТруда();

	Запрос = Новый Запрос;
	
	// АПК:96-выкл Использование ОБЪЕДИНИТЬ оправдано
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВредныеФакторы.Ссылка КАК Регистратор,
	|	РабочиеМеста.РабочееМесто КАК РабочееМесто
	|ПОМЕСТИТЬ ВТВредныеРабочиеМестаСОУТ
	|ИЗ
	|	Документ.РезультатыСпецоценкиУсловийТруда.ВредныеФакторы КАК ВредныеФакторы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РезультатыСпецоценкиУсловийТруда.РабочиеМеста КАК РабочиеМеста
	|		ПО РабочиеМеста.Ссылка = ВредныеФакторы.Ссылка
	|			И РабочиеМеста.ИдентификаторСтрокиРабочегоМеста = ВредныеФакторы.ИдентификаторСтрокиРабочегоМеста
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АналогичныеМеста.Ссылка,
	|	АналогичныеМеста.АналогичноеМесто
	|ИЗ
	|	Документ.РезультатыСпецоценкиУсловийТруда.АналогичныеМеста КАК АналогичныеМеста
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РезультатыСпецоценкиУсловийТруда.РабочиеМеста КАК РабочиеМеста
	|		ПО РабочиеМеста.Ссылка = АналогичныеМеста.Ссылка
	|			И РабочиеМеста.ИдентификаторСтрокиРабочегоМеста = АналогичныеМеста.ИдентификаторСтрокиРабочегоМеста
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РезультатыСпецоценкиУсловийТруда.ВредныеФакторы КАК ВредныеФакторы
	|		ПО ВредныеФакторы.Ссылка = АналогичныеМеста.Ссылка
	|			И ВредныеФакторы.ИдентификаторСтрокиРабочегоМеста = РабочиеМеста.ИдентификаторСтрокиРабочегоМеста
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Результаты.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.РезультатыСпециальнойОценкиУсловийТруда КАК Результаты
	|ГДЕ
	|	НЕ Результаты.ВыявленыВредныеОпасныеФакторы
	|	И Результаты.КлассУсловийТруда В (&ВредныеКлассы)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Результаты.Регистратор
	|ИЗ
	|	РегистрСведений.РезультатыСпециальнойОценкиУсловийТруда КАК Результаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТВредныеРабочиеМестаСОУТ КАК ВТВредныеРабочиеМестаСОУТ
	|		ПО ВТВредныеРабочиеМестаСОУТ.Регистратор = Результаты.Регистратор
	|			И ВТВредныеРабочиеМестаСОУТ.РабочееМесто = Результаты.РабочееМесто
	|ГДЕ
	|	НЕ Результаты.ВыявленыВредныеОпасныеФакторы";
	// АПК:96-вкл

	Запрос.УстановитьПараметр("ВредныеКлассы", ВредныеКлассы);

	ОбновляемыеДанные = ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ВыполнитьЗапросПолученияОбновляемыхДанных(
		Запрос, ПараметрыОбновления);

	Если ОбновляемыеДанные.Пустой() Тогда
		ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ЗавершитьОбработчик(ПараметрыОбновления);
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазыЗарплатаКадрыБазовый.ПродолжитьОбработчик(ПараметрыОбновления);

	ВыборкаРегистраторов = ОбновляемыеДанные.Выбрать();
	Пока ВыборкаРегистраторов.Следующий() Цикл
		Регистратор = ВыборкаРегистраторов.Регистратор;

		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.РезультатыСпециальнойОценкиУсловийТруда.НаборЗаписей");
			ЭлементБлокировки.УстановитьЗначение("Регистратор", Регистратор);
			ЭлементБлокировки = Блокировка.Добавить("Документ.РезультатыСпецоценкиУсловийТруда");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Регистратор);
			Блокировка.Заблокировать();

			// 1. Заполняем флаг в ТЧ РабочиеМеста документа.
			ДокументОбъект = Регистратор.ПолучитьОбъект();

			ИдентификаторыСВреднымиФакторами = Новый Соответствие;
			ФлагиПоИдентификаторам = Новый Соответствие;
			ФлагиПоРабочимМестам = Новый Соответствие;
			Для Каждого СтрокаВФ Из ДокументОбъект.ВредныеФакторы Цикл
				ИдентификаторыСВреднымиФакторами.Вставить(СтрокаВФ.ИдентификаторСтрокиРабочегоМеста, Истина);
			КонецЦикла;

			ЕстьИзмененияДокумента = Ложь;
			Для Каждого СтрокаРМ Из ДокументОбъект.РабочиеМеста Цикл
				Если ВредныеКлассы.Найти(СтрокаРМ.КлассУсловийТруда) <> Неопределено Тогда
					ВыявленыВредныеФакторы = Истина;
				ИначеЕсли ИдентификаторыСВреднымиФакторами.Получить(СтрокаРМ.ИдентификаторСтрокиРабочегоМеста) <> Неопределено Тогда
					ВыявленыВредныеФакторы = Истина;
				Иначе
					ВыявленыВредныеФакторы = Ложь;
				КонецЕсли;
				Если СтрокаРМ.ВыявленыВредныеОпасныеФакторы <> ВыявленыВредныеФакторы Тогда
					СтрокаРМ.ВыявленыВредныеОпасныеФакторы = ВыявленыВредныеФакторы;
					ЕстьИзмененияДокумента = Истина;
				КонецЕсли;
				ФлагиПоИдентификаторам.Вставить(СтрокаРМ.ИдентификаторСтрокиРабочегоМеста, ВыявленыВредныеФакторы);
				ФлагиПоРабочимМестам.Вставить(СтрокаРМ.РабочееМесто, ВыявленыВредныеФакторы);
			КонецЦикла;

			Для Каждого СтрокаАналогичногоМеста Из ДокументОбъект.АналогичныеМеста Цикл
				ФлагВредныхФакторов = ФлагиПоИдентификаторам.Получить(СтрокаАналогичногоМеста.ИдентификаторСтрокиРабочегоМеста);
				Если ФлагВредныхФакторов = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ФлагиПоРабочимМестам.Вставить(СтрокаАналогичногоМеста.АналогичноеМесто, ФлагВредныхФакторов);
			КонецЦикла;

			Если ЕстьИзмененияДокумента Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
			КонецЕсли;

			// 2. Обновляем набор записей регистра.
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
			НаборЗаписей.Прочитать();

			Для Каждого Запись Из НаборЗаписей Цикл
				ФлагВредныхФакторов = ФлагиПоРабочимМестам.Получить(Запись.РабочееМесто);
				Если ФлагВредныхФакторов = Неопределено Тогда
					ФлагВредныхФакторов = ВредныеКлассы.Найти(Запись.КлассУсловийТруда) <> Неопределено;
				КонецЕсли;
				Запись.ВыявленыВредныеОпасныеФакторы = ФлагВредныхФакторов;
			КонецЦикла;

			НаборЗаписей.ДополнительныеСвойства.Вставить("ПроверятьБизнесЛогикуПриЗаписи");
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.РегистрыСведений.РезультатыСпециальнойОценкиУсловийТруда, ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
