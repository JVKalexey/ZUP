#Область ОбработчикиСобытий

Функция ДанныеПоЗарплатеGET(Запрос)
	
	РезультатПолученияПараметров = ОбязательныеПараметры("start, end, inn, position", Запрос);
	Если РезультатПолученияПараметров.Ошибки.Количество() Тогда
		
		СписокОшибок = СтрСоединить(РезультатПолученияПараметров.Ошибки, ";");
		
		Ответ = Новый HTTPСервисОтвет(400);
		ДобавитьЗаголовкиДанных(Ответ);
		Ответ.УстановитьТелоИзСтроки(СписокОшибок);
		Возврат Ответ;
		
	КонецЕсли;
	
	ПараметрыЗапроса = РезультатПолученияПараметров.Параметры;
	
	Ошибки = Новый Массив;
	ДатаНачала = СтроковыеФункцииКлиентСервер.СтрокаВДату(ПараметрыЗапроса.start);
	ДатаОкончания = СтроковыеФункцииКлиентСервер.СтрокаВДату(ПараметрыЗапроса.end);
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		Ошибки.Добавить("Не удалось распознать дату начала периода");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Ошибки.Добавить("Не удалось распознать дату окончания периода");
	КонецЕсли;
	
	Если Ошибки.Количество() Тогда
		
		СписокОшибок = СтрСоединить(РезультатПолученияПараметров.Ошибки, ";");
		
		Ответ = Новый HTTPСервисОтвет(400);
		ДобавитьЗаголовкиДанных(Ответ);
		Ответ.УстановитьТелоИзСтроки(СписокОшибок);
		Возврат Ответ;
		
	КонецЕсли;
	
	ДанныеПоЗарплате = ДанныеПоЗаработнойПлате(ПараметрыЗапроса.inn, ПараметрыЗапроса.position, ДатаНачала, ДатаОкончания);
	ТелоОтвета = СтрокаJSON(ДанныеПоЗарплате);
	
	Ответ = Новый HTTPСервисОтвет(200);
	ДобавитьЗаголовкиДанных(Ответ);
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
КонецФункции

Функция PingGET(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

