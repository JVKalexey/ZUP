&НаСервере
Процедура УВМ_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	// + СБит 2023-12-25 160495 
	Привилегии = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	
	// + СБит 2026-08-06 #УВМ
	Отбор = Новый Структура("Позиция", Объект.Ссылка);
	Должности = РегистрыСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних(ТекущаяДатаСеанса(), Отбор);
	Если Должности.Количество() = 0 Или ЭтаФорма["УВМ_ДолжностьУпр"] <> Должности[0].УВМ_ДолжностьУпр Тогда
		НаборЗаписей = РегистрыСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Позиция.Установить(Объект.Ссылка);
		НаборЗаписей.Отбор.Период.Установить(ТекущаяДатаСеанса());
		НаборЗаписей.Прочитать();
        Если НаборЗаписей.Количество() =0 Тогда
			Запись = НаборЗаписей.Добавить(); 
		Иначе	
			Запись = НаборЗаписей[0];
		КонецЕсли;	
		Запись.Период = ТекущаяДатаСеанса(); 
		Запись.Позиция = Объект.Ссылка;
		Запись.УВМ_ДолжностьУпр = ЭтаФорма["УВМ_ДолжностьУпр"];
		НаборЗаписей.Записать(Истина); 
	КонецЕсли;
	// - СБит 2026-08-06 #УВМ
	
	// + СБит 2024-03-12
	Если ЭтаФорма["ЗарегистрироватьКВыгрузке"] = Истина Тогда
		ОбменДаннымиПереопределяемый.ОбновитьИсториюСотрудниковПоШтатке(Объект.Ссылка);
	КонецЕсли;	
	// - СБит 2024-03-12
	УстановитьПривилегированныйРежим(Привилегии);
		
    // - СБит 2023-12-25 
КонецПроцедуры

