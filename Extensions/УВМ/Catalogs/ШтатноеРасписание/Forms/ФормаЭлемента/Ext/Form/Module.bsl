
&НаСервере
Процедура УВМ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	//+dar 20221102 (24881)
	ДопСвойства = Новый Структура;
	ДопСвойства.Вставить("Высота", 2);
	ДопСвойства.Вставить("АвтоМаксимальнаяШирина", Ложь);
	ДопСвойства.Вставить("МаксимальнаяШирина", 48);
	ДопСвойства.Вставить("РастягиватьПоВертикали", Ложь);
	
	УВМ_График = УВМ_РаботаСФормами.НовоеПоле(ЭтаФорма, "УВМ_ГрафикРаботы", Элементы.ГруппаУсловияПриемаКраткоеОписание, "Объект.УВМ_ГрафикРаботы", , Элементы.КраткоеОписание, , ДопСвойства);
	УВМ_Продолжительность = УВМ_РаботаСФормами.НовоеПоле(ЭтаФорма, "УВМ_ПродолжительностьСмены", Элементы.ГруппаУсловияПриемаКраткоеОписание, "Объект.УВМ_ПродолжительностьСмены", , Элементы.КраткоеОписание, , ДопСвойства);
	//-dar 20221102 (24881) 
	
	// + СБит 2023-12-25 160495 
	УВМ_РаботаСФормами.СоздатьРеквизит(ЭтаФорма, "ЗарегистрироватьКВыгрузке", Новый ОписаниеТипов("Булево")); 
	УВМ_РаботаСФормами.СоздатьРеквизит(ЭтаФорма, "УВМ_ДолжностьУпр", Новый ОписаниеТипов("СправочникСсылка.УВМ_ДолжностиУпр")); 
	НовыйЭлемент = УВМ_РаботаСФормами.НовоеПоле(ЭтаФорма, "УВМ_ДолжностьУпр", Элементы.ЛеваяКолонка, "УВМ_ДолжностьУпр",,,"Должность управленческая");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "УВМ_ДолжностьУпрПриИзменении");
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		// + СБит 2026-08-06 #УВМ
		Отбор = Новый Структура("Позиция", Объект.Ссылка);
		Должности = РегистрыСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних(ТекущаяДатаСеанса(), Отбор);
		// - СБит 2026-08-06 #УВМ
		Если Должности.Количество()>0 Тогда
			ЭтаФорма["УВМ_ДолжностьУпр"] = Должности[0].УВМ_ДолжностьУпр;
		КонецЕсли;
	КонецЕсли;
    // - СБит 2023-12-25
	
КонецПроцедуры

