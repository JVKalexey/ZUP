Процедура СформироватьДвиженияПоРуководителям(ТаблицаДвижений) Экспорт
	
	Если ТаблицаДвижений.Количество() > 0 Тогда
		УдалитьДвиженияПоРуководителям(ТаблицаДвижений[0].КадровыйДокумент);	
	КонецЕсли;
	
	Для Каждого СтрокаДвижения Из ТаблицаДвижений Цикл
		МенеджерЗаписи = РегистрыСведений.УВМ_Руководители.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = СтрокаДвижения.Период;
		МенеджерЗаписи.Физлицо = СтрокаДвижения.Физлицо;
		МенеджерЗаписи.Руководитель = СтрокаДвижения.Руководитель;
		МенеджерЗаписи.КадровыйДокумент = СтрокаДвижения.КадровыйДокумент;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДвижения, "ДействуетДо") Тогда
			МенеджерЗаписи.ДействуетДо = СтрокаДвижения.ДействуетДо;
		КонецЕсли;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьДвиженияПоРуководителям(КадровыйДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УВМ_Руководители.Период КАК Период,
	|	УВМ_Руководители.Физлицо КАК Физлицо
	|ИЗ
	|	РегистрСведений.УВМ_Руководители КАК УВМ_Руководители
	|ГДЕ
	|	УВМ_Руководители.КадровыйДокумент = &КадровыйДокумент";
	Запрос.УстановитьПараметр("КадровыйДокумент", КадровыйДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		НаборЗаписей = РегистрыСведений.УВМ_Руководители.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Отбор.Физлицо.Установить(Выборка.Физлицо);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьПодчиненные(Физлицо) Экспорт
	
	РезультатЗапроса = РезультатЗапросаПоРуководителямСотрудников(Физлицо);
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция ПодчиненныеСотрудника(Физлицо) Экспорт
	
	МсвПодчиненных = Новый Массив;
	
	РезультатЗапроса = РезультатЗапросаПоРуководителямСотрудников(Физлицо);
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			МсвПодчиненных.Добавить(Выборка.Физлицо);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МсвПодчиненных;
	
КонецФункции

Функция РуководительСотрудника(Физлицо) Экспорт
	
	Результат = Справочники.ФизическиеЛица.ПустаяСсылка();
	
	РезультатЗапроса = РезультатЗапросаПоРуководителямСотрудников(, Физлицо);
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Руководитель;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

Функция РезультатЗапросаПоРуководителямСотрудников(Руководитель = Неопределено, Физлицо = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УВМ_Руководители.Период КАК Период,
	|	УВМ_Руководители.Физлицо КАК Физлицо
	|ПОМЕСТИТЬ ВТ_Сотрудники
	|ИЗ
	|	РегистрСведений.УВМ_Руководители КАК УВМ_Руководители
	|ГДЕ
	|	УВМ_Руководители.Период <= &ТекущаяДатаСеанса
	|	И УВМ_Руководители.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УВМ_Руководители.Период,
	|	УВМ_Руководители.Физлицо
	|ИЗ
	|	РегистрСведений.УВМ_Руководители КАК УВМ_Руководители
	|ГДЕ
	|	УВМ_Руководители.Период <= &ТекущаяДатаСеанса
	|	И УВМ_Руководители.ДействуетДо >= &ТекущаяДатаСеанса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_Сотрудники.Период) КАК Период,
	|	ВТ_Сотрудники.Физлицо КАК Физлицо
	|ПОМЕСТИТЬ ВТ_АктуальныеСотрудники
	|ИЗ
	|	ВТ_Сотрудники КАК ВТ_Сотрудники
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Сотрудники.Физлицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УВМ_Руководители.Период КАК Период,
	|	УВМ_Руководители.Физлицо КАК Физлицо,
	|	УВМ_Руководители.Руководитель КАК Руководитель,
	|	УВМ_Руководители.ДействуетДо КАК ДействуетДо,
	|	УВМ_Руководители.КадровыйДокумент КАК КадровыйДокумент
	|ИЗ
	|	РегистрСведений.УВМ_Руководители КАК УВМ_Руководители
	|ГДЕ
	|	(УВМ_Руководители.Период, УВМ_Руководители.Физлицо) В
	|			(ВЫБРАТЬ
	|				ВТ_АктуальныеСотрудники.Период КАК Период,
	|				ВТ_АктуальныеСотрудники.Физлицо КАК Физлицо
	|			ИЗ
	|				ВТ_АктуальныеСотрудники КАК ВТ_АктуальныеСотрудники)
	|	И УВМ_Руководители.Руководитель = &Руководитель
	|	И УВМ_Руководители.Физлицо = &Физлицо";	
	
	Запрос.УстановитьПараметр("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
	Если ЗначениеЗаполнено(Руководитель) Тогда
		Запрос.УстановитьПараметр("Руководитель", Руководитель);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УВМ_Руководители.Руководитель = &Руководитель", "ИСТИНА");
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Физлицо) Тогда
		Запрос.УстановитьПараметр("Физлицо", Физлицо);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УВМ_Руководители.Физлицо = &Физлицо", "ИСТИНА");
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;

КонецФункции 

//++dar 26.01.26 (работа с константами из регистра)

// Получает значение из регистра сведений "Значения констант"
//
// Параметры:
//  <СтруктураОтбора>                      - <Структура>     - набор "ключей" для отбора, значение "Ключ" - обязательное 
//  <ЗначениеПоУмолчанию>                  - <Любое значение>- если результат работы функции Неопределено, функция вернет это значение
//
// Возвращаемое значение:
//   <Значение>      - значение ресурса по заданному ключу, если несколько (возвращается первый) 
//                    - если ключ не найден возвращается "Неопределено" или ЗначениеПоУмолчанию, если оно задано
// Пример вызова:
//		СтруктураОтбора = Новый Структура;
//		СтруктураОтбора.Вставить("Ключ",                    "Тест1");
//		 	
//			Не обязательные отборы:
//		СтруктураОтбора.Вставить("ГруппировочноеИзмерение", "ТестГр1");
//		СтруктураОтбора.Вставить("Организация",           Орг1);
//		СтруктураОтбора.Вставить("КлючДополнительный",        "КлючДоп1");
//
//		УВМ_ОбщиеДоработкиСервер.ЗначениеКонстантыИзРегистра(СтруктураОтбора)
//
Функция ЗначениеКонстантыИзРегистра(СтруктураОтбора, ЗначениеПоУмолчанию = Неопределено) Экспорт
    
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    УВМ_ЗначенияКонстант.Значение КАК Значение
	|ИЗ
	|    РегистрСведений.УВМ_ЗначенияКонстант КАК УВМ_ЗначенияКонстант
	|ГДЕ
	|    УВМ_ЗначенияКонстант.Ключ = &Ключ";
	
	ДопСтрока = "
	|    И УВМ_ЗначенияКонстант.Замена = &Замена";
	
	
	Для каждого ЭлементКоллекции Из СтруктураОтбора Цикл
		
		тКлюч = ЭлементКоллекции.Ключ;
		
		Запрос.УстановитьПараметр(тКлюч, ЭлементКоллекции.Значение);
		
		Если тКлюч <> "Ключ" Тогда 
			
			ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ДопСтрока,"Замена",тКлюч);
			
		КонецЕсли;    
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = ЗначениеПоУмолчанию;
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Значение;
	КонецЕсли;
	
	Возврат Результат;
    
КонецФункции

// Получает массив значений из регистра сведений "Значения констант" 
//
// Параметры:
//  <СтруктураОтбора>                      - <Структура>     - набор "ключей" для отбора, значение "Ключ" - обязательное 
//  <ЗначениеПоУмолчанию>                  - <Любое значение>- если результат работы функции Неопределено, функция вернет это значение
//
// Возвращаемое значение:
//   <Значение>      - <Массив>	-значение ресурсов по заданному ключу 
//                    - если ключ не найден возвращается "Неопределено" или ЗначениеПоУмолчанию, если оно задано
// Пример вызова:
//		СтруктураОтбора = Новый Структура;
//		СтруктураОтбора.Вставить("Ключ",                    "Тест1");
//		 	
//			Не обязательные отборы:
//		СтруктураОтбора.Вставить("ГруппировочноеИзмерение", "ТестГр1");
//		СтруктураОтбора.Вставить("Организация",           Орг1);
//		СтруктураОтбора.Вставить("КлючДополнительный",        "КлючДоп1");
//
//		УВМ_ОбщиеДоработкиСервер.ЗначениеКонстантыИзРегистра(СтруктураОтбора)
//
Функция ЗначенияКонстантИзРегистраМассивом(СтруктураОтбора, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|    УВМ_ЗначенияКонстант.Значение КАК Значение
	|ИЗ
	|    РегистрСведений.УВМ_ЗначенияКонстант КАК УВМ_ЗначенияКонстант
	|ГДЕ
	|    УВМ_ЗначенияКонстант.Ключ = &Ключ";
	
	ДопСтрока = "
	|    И УВМ_ЗначенияКонстант.Замена = &Замена";
	
	
	Для каждого ЭлементКоллекции Из СтруктураОтбора Цикл
		
		тКлюч = ЭлементКоллекции.Ключ;
		
		Запрос.УстановитьПараметр(тКлюч, ЭлементКоллекции.Значение);
		
		Если тКлюч <> "Ключ" Тогда 
			
			ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ДопСтрока,"Замена",тКлюч);
			
		КонецЕсли;    
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = ЗначениеПоУмолчанию;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Значение");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
    
	
КонецФункции

Функция ЗаписиКонстантВРегистре(СтруктураОтбора) Экспорт
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|  *
	|ИЗ
	|  РегистрСведений.УВМ_ЗначенияКонстант КАК УВМ_ЗначенияКонстант
	|ГДЕ
	|    УВМ_ЗначенияКонстант.Ключ = &Ключ";
	ДопСтрока = "
	|    И УВМ_ЗначенияКонстант.Замена = &Замена";

	Для каждого ЭлементКоллекции Из СтруктураОтбора Цикл
		тКлюч = ЭлементКоллекции.Ключ;
		Запрос.УстановитьПараметр(тКлюч, ЭлементКоллекции.Значение);
		Если тКлюч <> "Ключ" Тогда 
			ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ДопСтрока,"Замена",тКлюч);
		КонецЕсли;
	КонецЦикла;
	Запрос.Текст = ТекстЗапроса;
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура УстановитьЗначениеКонстантыВРегистре(СтруктураИзмерений, ЗначениеКонстанты, Замещать=Истина) Экспорт
	
	Если не ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"Ключ",Неопределено)) тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.УВМ_ЗначенияКонстант.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Ключ 					= СтруктураИзмерений.Ключ;
	МенеджерЗаписи.ГруппировочноеИзмерение 	= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"ГруппировочноеИзмерение","");
	МенеджерЗаписи.Организация 				= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"Организация",Справочники.Организации.ПустаяСсылка());
	МенеджерЗаписи.КлючДополнительный 		= ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИзмерений,"КлючДополнительный","");
	МенеджерЗаписи.Значение 				= ЗначениеКонстанты;	
	МенеджерЗаписи.Записать(Замещать);
		
КонецПроцедуры

Процедура ОчиститьЗаписиКонстантВРегистре(СтруктураОтбора) Экспорт
	Если не СтруктураОтбора.Свойство("Ключ") тогда
		Возврат;
	КонецЕсли;
	НаборЗаписей = РегистрыСведений.УВМ_ЗначенияКонстант.СоздатьНаборЗаписей();
	Для Каждого  ЭлементКоллекции Из СтруктураОтбора Цикл
		НаборЗаписей.Отбор[ЭлементКоллекции.Ключ].Установить(ЭлементКоллекции.Значение,Истина);
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
КонецПроцедуры
