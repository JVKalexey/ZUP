Функция ПолучитьДатуНачалаУчетаРМ() Экспорт
	ДатаПерехода = Константы.УВМ_ДатаНачалаУчетаРМ.Получить();
	Возврат ?(ЗначениеЗаполнено(ДатаПерехода), ДатаПерехода, Дата('39990101'));
КонецФункции

Функция СоздатьНовоеРабочееМесто(Организация, Подразделение, Должность) Экспорт
	
	ЕстьОшибка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ЕстьОшибка = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена организация!");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		ЕстьОшибка = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено подразделение!");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Должность) Тогда
		ЕстьОшибка = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена должность!");
	КонецЕсли;
	
	Если ЕстьОшибка Тогда
		Возврат Справочники.РабочиеМестаОхраныТруда.ПустаяСсылка();
	КонецЕсли;
	
	РабочееМестоОбъект = Справочники.РабочиеМестаОхраныТруда.СоздатьЭлемент();
	РабочееМестоОбъект.Владелец = Организация;
	РабочееМестоОбъект.Подразделение = Подразделение;
	РабочееМестоОбъект.Должность = Должность;
	//++dar 05.08.25 (263734)
	//РабочееМестоОбъект.ПорядковыйНомер = ПропущеныйНомерРабочегоМеста();
	РабочееМестоОбъект.ПорядковыйНомер = ПорядковыйНомерРабочегоМестаПоВозрастанию();
	//--dar 05.08.25 (263734)
	РабочееМестоОбъект.Номер = Формат(РабочееМестоОбъект.ПорядковыйНомер, "ЧГ=");
	РабочееМестоОбъект.Наименование = РабочиеМестаОхраныТруда.НаименованиеРабочегоМеста(
		РабочееМестоОбъект.Подразделение,
		РабочееМестоОбъект.Должность, 
		РабочееМестоОбъект.Номер);
	РабочееМестоОбъект.Записать();
	Возврат РабочееМестоОбъект.Ссылка;
КонецФункции

Функция ПропущеныйНомерРабочегоМеста()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РабочиеМестаОхраныТруда.ПорядковыйНомер КАК ПорядковыйНомер
	|ИЗ
	|	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
	|ГДЕ
	|	НЕ РабочиеМестаОхраныТруда.ПометкаУдаления
	|	И НЕ РабочиеМестаОхраныТруда.ВАрхиве
	|	И НЕ РабочиеМестаОхраныТруда.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПорядковыйНомерРМ = 1;
	Пока Выборка.Следующий() Цикл
		Если ПорядковыйНомерРМ <> Выборка.ПорядковыйНомер Тогда
			Прервать;
		Иначе
			ПорядковыйНомерРМ = ПорядковыйНомерРМ + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПорядковыйНомерРМ;
	
КонецФункции
