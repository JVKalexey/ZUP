Процедура ЗаполнитьВредныеФакторыИзРезультатовСпецоценки(РабочиеМеста) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочиеМеста", РабочиеМеста);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВредныеФакторыИВидыРаботРабочегоМеста.РабочееМесто КАК РабочееМесто,
	|	ВредныеФакторыИВидыРаботРабочегоМеста.ВредныйФактор.Код КАК ВредныйФактор
	|ИЗ
	|	РегистрСведений.ВредныеФакторыИВидыРаботРабочегоМеста КАК ВредныеФакторыИВидыРаботРабочегоМеста
	|ГДЕ
	|	ВредныеФакторыИВидыРаботРабочегоМеста.РабочееМесто В(&РабочиеМеста)
	|ИТОГИ ПО
	|	РабочееМесто";
	
	ВыборкаРабочееМесто = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СвойствоВредныеФакторы = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ВредныеФакторыИзРезультатовСпецоценки");
	
	ТаблицаСвойствИЗначений = Новый ТаблицаЗначений;
	ТаблицаСвойствИЗначений.Колонки.Добавить("Свойство");
	ТаблицаСвойствИЗначений.Колонки.Добавить("Значение");
	
	РабочиеМестаСФакторами = Новый Массив;
	
	Пока ВыборкаРабочееМесто.Следующий() Цикл
		РабочиеМестаСФакторами.Добавить(ВыборкаРабочееМесто.РабочееМесто);
		Выборка = ВыборкаРабочееМесто.Выбрать();
		КраткийСостав = "";
		Пока Выборка.Следующий() Цикл
			КраткийСостав = КраткийСостав + Выборка.ВредныйФактор + ", ";
		КонецЦикла;
		КраткийСостав = Сред(КраткийСостав, 1, СтрДлина(КраткийСостав) - 2);
		
		ТаблицаСвойствИЗначений.Очистить();
		НовСтр = ТаблицаСвойствИЗначений.Добавить();
		НовСтр.Свойство = СвойствоВредныеФакторы;
		НовСтр.Значение = КраткийСостав;
		УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(ВыборкаРабочееМесто.РабочееМесто, ТаблицаСвойствИЗначений);
	КонецЦикла;
	
	// Очистить доп.реквизиты, если нет вредных факторов
	МсвРабочихМестБезФакторов = ОбщегоНазначенияКлиентСервер.РазностьМассивов(РабочиеМеста, РабочиеМестаСФакторами);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Свойство",СвойствоВредныеФакторы);
	Для Каждого ВладелецСвойств Из МсвРабочихМестБезФакторов Цикл 
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ВладелецСвойств.Метаданные().ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ВладелецСвойств);
			Блокировка.Заблокировать();
			
			ВладелецСвойствОбъект = ВладелецСвойств.ПолучитьОбъект();
			ЗаблокироватьДанныеДляРедактирования(ВладелецСвойствОбъект.Ссылка);
			
			МассивУдаляемыхСтрок = ВладелецСвойствОбъект.ДополнительныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
			Если МассивУдаляемыхСтрок.Количество() > 0 Тогда
				Для Каждого ЭлементМассива из МассивУдаляемыхСтрок Цикл
					ВладелецСвойствОбъект.ДополнительныеРеквизиты.Удалить(ЭлементМассива);
				КонецЦикла;
				
				ВладелецСвойствОбъект.Записать();
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры
