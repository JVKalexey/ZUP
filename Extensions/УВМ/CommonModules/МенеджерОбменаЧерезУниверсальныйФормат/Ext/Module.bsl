&После("ЗаполнитьПравилаКонвертацииПредопределенныхДанных")
Процедура УВМ_ЗаполнитьПравилаКонвертацииПредопределенныхДанных(НаправлениеОбмена, ПравилаКонвертации)
	// + СБит 2024-03-05
	// Перечисление_ВидыКадровыхСобытий
	ПравилоКонвертации           = ПравилаКонвертации.Добавить();
	ПравилоКонвертации.ИмяПКПД   = "Перечисление_ВидыКадровыхСобытий";
	ПравилоКонвертации.ТипДанных = Метаданные.Перечисления.ВидыКадровыхСобытий;
	ПравилоКонвертации.ТипXDTO   = "ВидыКадровыхСобытий";

	ЗначенияДляОтправки = Новый Соответствие;
	ЗначенияДляОтправки.Вставить(Перечисления.ВидыКадровыхСобытий.Прием, "Прием");
	ЗначенияДляОтправки.Вставить(Перечисления.ВидыКадровыхСобытий.Перемещение, "Перемещение");
	ЗначенияДляОтправки.Вставить(Перечисления.ВидыКадровыхСобытий.Увольнение, "Увольнение");
	ЗначенияДляОтправки.Вставить(Перечисления.ВидыКадровыхСобытий.НачальныеДанные, "НачальныеДанные");
	ЗначенияДляОтправки.Вставить(Перечисления.ВидыКадровыхСобытий.ВосстановлениеВДолжности, "ВосстановлениеВДолжности");
	ЗначенияДляОтправки.Вставить(Перечисления.ВидыКадровыхСобытий.НеподтвержденныеДанные, "НеподтвержденныеДанные");
	ЗначенияДляОтправки.Вставить(Перечисления.ВидыКадровыхСобытий.ИзменениеОплатыТруда, "ИзменениеОплатыТруда");
	ПравилоКонвертации.КонвертацииЗначенийПриОтправке = ЗначенияДляОтправки;
	ЗначенияДляПолучения = Новый Соответствие;
	ЗначенияДляПолучения.Вставить("Прием", Перечисления.ВидыКадровыхСобытий.Прием);
	ЗначенияДляПолучения.Вставить("Перемещение", Перечисления.ВидыКадровыхСобытий.Перемещение);
	ЗначенияДляПолучения.Вставить("Увольнение", Перечисления.ВидыКадровыхСобытий.Увольнение);
	ЗначенияДляПолучения.Вставить("НачальныеДанные", Перечисления.ВидыКадровыхСобытий.НачальныеДанные);
	ЗначенияДляПолучения.Вставить("ВосстановлениеВДолжности", Перечисления.ВидыКадровыхСобытий.ВосстановлениеВДолжности);
	ЗначенияДляПолучения.Вставить("НеподтвержденныеДанные", Перечисления.ВидыКадровыхСобытий.НеподтвержденныеДанные);
	ЗначенияДляПолучения.Вставить("ИзменениеОплатыТруда", Перечисления.ВидыКадровыхСобытий.ИзменениеОплатыТруда);
	ПравилоКонвертации.КонвертацииЗначенийПриПолучении = ЗначенияДляПолучения;
	
КонецПроцедуры

&После("ВыполнитьПроцедуруМодуляМенеджера")
Процедура УВМ_ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры)
	Если ИмяПроцедуры = "ПКО_Регистр_УВМ_ИсторияСотрудников_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Регистр_УВМ_ИсторияСотрудников_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
			// + СБит 2025-07-30 255683
	ИначеЕсли ИмяПроцедуры = "ПКО_Регистр_УВМ_Руководители_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Регистр_УВМ_Руководители_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "ПКО_Справочник_УВМ_ДолжностиУпр_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Справочник_УВМ_ДолжностиУпр_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки); 
			// - СБит 2024-04-15
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
