#Область Справочник_Сотрудники_Пользователи

&ИзменениеИКонтроль("ДобавитьПКО_Справочник_Пользователи")
Процедура УВМ_ДобавитьПКО_Справочник_Пользователи(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                             = "Справочник_Пользователи";
	ПравилоКонвертации.ОбъектДанных                       = Метаданные.Справочники.Пользователи;
	ПравилоКонвертации.ОбъектФормата                      = "Справочник.Пользователи";
	ПравилоКонвертации.ПриОтправкеДанных                  = "ПКО_Справочник_Пользователи_ПриОтправкеДанных";
	ПравилоКонвертации.ВариантИдентификации               = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Наименование",   "Наименование");
	ДобавитьПКС(СвойстваШапки, "ФизическоеЛицо", "", 1, "Справочник_ФизическиеЛица_Получение");
	ДобавитьПКС(СвойстваШапки, "",               "ФизическоеЛицо", 1, "Справочник_ФизическиеЛица_Отправка");
	ПравилоКонвертации.ПоляПоиска.Добавить("Наименование,ФизическоеЛицо");
	ПравилоКонвертации.ПоляПоиска.Добавить("Наименование");
	
#Вставка
	ПространствоИмен = ПространствоРасширенияЗУП();
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, ПространствоИмен);

	ДобавитьПКС(СвойстваШапки, "", "Подразделение", 1, "Справочник_СтруктураПредприятия_Отправка", ПространствоИмен);
#КонецВставки
	
КонецПроцедуры


&ИзменениеИКонтроль("ПКО_Справочник_Пользователи_ПриОтправкеДанных")
Процедура УВМ_ПКО_Справочник_Пользователи_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		ДанныеXDTO.Вставить("ФизическоеЛицо", Новый Структура("Значение, ИмяПКО", ДанныеИБ.ФизическоеЛицо,"Справочник_ФизическиеЛица_Отправка"));
#Вставка
		ДопДанные = ПолучитьДополнительныеДанныеПользователя(ДанныеИБ.Ссылка);
		Если ЗначениеЗаполнено(ДанныеИБ.ФизическоеЛицо) Тогда
			ДанныеXDTO.Вставить("Подразделение", Новый Структура("Значение, ИмяПКО", ДопДанные.Подразделение,"Справочник_СтруктураПредприятия_Отправка"));
		КонецЕсли;
#КонецВставки
		Возврат;
	КонецЕсли;

	ДанныеXDTO.КлючевыеСвойства.Вставить("ФизическоеЛицо", Новый Структура("Значение, ИмяПКО", ДанныеИБ.ФизическоеЛицо,"Справочник_ФизическиеЛица_Отправка"));
#Вставка
	ДопДанные = ПолучитьДополнительныеДанныеПользователя(ДанныеИБ.Ссылка);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Наименование", ДопДанные.Наименование);
	Если ЗначениеЗаполнено(ДанныеИБ.ФизическоеЛицо) Тогда
		ДанныеXDTO.Вставить("Подразделение", Новый Структура("Значение, ИмяПКО", ДопДанные.Подразделение,"Справочник_СтруктураПредприятия_Отправка"));
	КонецЕсли;
#КонецВставки
КонецПроцедуры

//++dar 02.04.25 (228237)
Функция ПолучитьДополнительныеДанныеПользователя(Пользователь)
	
	ДопДанные = Новый Структура("ФизическоеЛицо,Наименование,Подразделение");
	ДанныеПользователя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Пользователь, "ФизическоеЛицо,Наименование");	
	
	Если НЕ ЗначениеЗаполнено(ДанныеПользователя.ФизическоеЛицо) Тогда
		ДопДанные.Наименование = ДанныеПользователя.Наименование;
		Возврат ДопДанные;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КадроваяИсторияСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	|	КадроваяИсторияСотрудников.ФизическоеЛицо.Наименование КАК Наименование,
	|	МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение КАК Подразделение
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних( , ФизическоеЛицо = &ФизическоеЛицо) КАК КадроваяИсторияСотрудников
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозицииШтатногоРасписанияВСтруктуреПредприятия
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних() КАК МестоПозицииШтатногоРасписанияВСтруктуреПредприятия
	|		ПО (КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию = МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Позиция)";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ДанныеПользователя.ФизическоеЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДопДанные, Выборка);
	КонецЕсли;
	
	Возврат ДопДанные;
	
КонецФункции	
//--dar 02.04.25 (228237)
