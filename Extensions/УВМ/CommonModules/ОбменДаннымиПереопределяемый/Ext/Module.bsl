			//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК СовмещаемаяПозицияШтатногоРасписания
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних() КАК СовмещаемаяПозицияШтатногоРасписания
			|		ПО (КадровыйДокумент.СовмещаемаяДолжность  = СовмещаемаяПозицияШтатногоРасписания.Позиция)
			
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудников
			|		ПО Сотрудники.ФизическоеЛицо = КадроваяИсторияСотрудников.ФизическоеЛицо
			|		И КадровыйДокумент.Организация = КадроваяИсторияСотрудников.ГоловнаяОрганизация
			//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК ШтатноеРасписание 
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних() КАК ШтатноеРасписание 
			|		ПО КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию = ШтатноеРасписание.Позиция
			
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
			|		ПО КадровыйДокумент.УВМ_РабочееМесто = РабочиеМестаОхраныТруда.Ссылка
			|ГДЕ
			|	КадровыйДокумент.Ссылка = &Ссылка
			|";
		КонецЕсли;	
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = ТекстСообщения + 
			СтрШаблон(НСтр("ru = 'Совмещение должностей сотрудника 
			|%1 
			|ДатаНачала 	%2
			|ДатаОкончания 	%3
			|Организация 	%4
			|ФИО 	%5
			|Дата рождения	%6
			|СНИЛС	%7
			|Рабочее место 	%8
			|'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			Выборка.Ссылка,
			Формат(Выборка.ДатаНачала, "ДФ=dd.MM.yyyy"),
			Формат(Выборка.ДатаОкончания, "ДФ=dd.MM.yyyy"),
			Выборка.Организация,
			Выборка.ФизическоеЛицо,
			Формат(Выборка.ФизическоеЛицоДатаРождения, "ДФ=dd.MM.yyyy"),
			Выборка.ФизическоеЛицоСтраховойНомерПФР,
			Выборка.РабочееМестоНомер
			);
			Если ПричинаСовмещения = Перечисления.ПричиныСовмещения.ИсполнениеОбязанностей Тогда
	 			ТекстСообщения = ТекстСообщения + 
				СтрШаблон(НСтр("ru = '
				|Причина совмещения	%1
				|Отсутствующий сотрудник %2
				|Основная должность	%3
				|Подразделение по основной должности %4
				|Совмещаемая должность %5
				|Подразделение по совмещаемой должности	%6
				|'", ОбщегоНазначения.КодОсновногоЯзыка()), 
				Выборка.ПричинаСовмещения,
				Выборка.ОтсутствующийСотрудник,
				Выборка.ОсновнаяДолжность,
				Выборка.ОсновноеПодразделение,
				Выборка.СовмещаемаяДолжность,
				Выборка.СовмещаемоеПодразделение
				) + Символы.ПС;
			Иначе
	 			ТекстСообщения = ТекстСообщения + 
				СтрШаблон(НСтр("ru = '
				|Причина совмещения	%1
				|Основная должность	%2
				|Подразделение по основной должности %3
				|Совмещаемая должность %4
				|Подразделение по совмещаемой должности	%5
				|'", ОбщегоНазначения.КодОсновногоЯзыка()), 
				Выборка.ПричинаСовмещения,
				Выборка.ОсновнаяДолжность,
				Выборка.ОсновноеПодразделение,
				Выборка.СовмещаемаяДолжность,
				Выборка.СовмещаемоеПодразделение
				) + Символы.ПС;
			КонецЕсли;	

			Подразделение = Выборка.ОсновноеПодразделение;
			ПодразделениеСтруктуры = Выборка.ОсновноеПодразделениеСтруктуры;
		КонецЦикла;	
		// - СБит 2025-11-25 #УВМ 
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.Увольнение") ИЛИ ТипИсточника = Тип("ДокументСсылка.УвольнениеСписком") Тогда 
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Источник);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КадровыйДокумент.Ссылка КАК Ссылка,
		|	КадровыйДокумент.Ссылка.Организация КАК Организация,
		|	КадроваяИсторияСотрудников.Подразделение КАК Подразделение,
		|	РабочиеМестаСотрудников.РабочееМесто КАК РабочееМесто,
		|	РабочиеМестаОхраныТруда.Номер КАК РабочееМестоНомер,
		|	ШтатноеРасписание.Подразделение КАК ПодразделениеСтруктуры, 
		|	ШтатноеРасписание.УВМ_ДолжностьУпр КАК УВМ_ДолжностьУпр, 
		|	КадровыйДокумент.Сотрудник КАК Сотрудник,
		|   КадроваяИсторияСотрудников.Подразделение,
		|   КадроваяИсторияСотрудников.Должность,
		|   КадроваяИсторияСотрудников.КоличествоСтавок,
		|	КадровыйДокумент.ФизическоеЛицо КАК ФизическоеЛицо,
		|	СпрФизическиеЛица.ДатаРождения КАК ФизическоеЛицоДатаРождения,
		|	СпрФизическиеЛица.СтраховойНомерПФР КАК ФизическоеЛицоСтраховойНомерПФР,
		|	КадровыйДокумент.ДатаУвольнения КАК ДатаУвольнения
		|ИЗ
		|	Документ.Увольнение КАК КадровыйДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК СпрФизическиеЛица
		|		ПО (КадровыйДокумент.ФизическоеЛицо = СпрФизическиеЛица.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудников
		|		ПО КадровыйДокумент.ФизическоеЛицо = КадроваяИсторияСотрудников.ФизическоеЛицо
		|		И КадровыйДокумент.Ссылка.Организация = КадроваяИсторияСотрудников.ГоловнаяОрганизация
		//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК ШтатноеРасписание 
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних() КАК ШтатноеРасписание 
		|		ПО КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию = ШтатноеРасписание.Позиция
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РабочиеМестаСотрудников.СрезПоследних КАК РабочиеМестаСотрудников
		|		ПО КадровыйДокумент.ФизическоеЛицо = РабочиеМестаСотрудников.ФизическоеЛицо
		|		И КадровыйДокумент.Организация = РабочиеМестаСотрудников.ГоловнаяОрганизация
		|		И КадровыйДокумент.Сотрудник = РабочиеМестаСотрудников.Сотрудник
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
		|		ПО РабочиеМестаСотрудников.РабочееМесто = РабочиеМестаОхраныТруда.Ссылка
		|ГДЕ
		|	КадровыйДокумент.Ссылка = &Ссылка
		|"; 
		Если ТипИсточника = Тип("ДокументСсылка.УвольнениеСписком") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Увольнение КАК КадровыйДокумент", "Документ.УвольнениеСписком.Сотрудники КАК КадровыйДокумент");  
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = ТекстСообщения + 
			СтрШаблон(НСтр("ru = 'Увольнение сотрудника 
			|%1 
			|Дата увольнения %2
			|Организация %3
			|'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			Выборка.Ссылка,
			Формат(Выборка.ДатаУвольнения, "ДФ=dd.MM.yyyy"),
			Выборка.Организация)
			+ СтрШаблон(НСтр("ru = '
			|Подразделение 	%1
			|Рабочее место 	%2
			|Кол-во ставок 	%3
			|Должность 	%4
			|ФИО %5
			|Дата рождения	%6
			|СНИЛС	%7
			|'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			Выборка.Подразделение,
			Выборка.РабочееМестоНомер,
			Выборка.КоличествоСтавок,
			Выборка.Должность,
			Выборка.ФизическоеЛицо,
			Формат(Выборка.ФизическоеЛицоДатаРождения, "ДФ=dd.MM.yyyy"),
			Выборка.ФизическоеЛицоСтраховойНомерПФР
			) + Символы.ПС;

			Подразделение = Выборка.Подразделение;
			ПодразделениеСтруктуры = Выборка.ПодразделениеСтруктуры;
		КонецЦикла;	

	КонецЕсли;
	
	Возврат Новый Структура("ТекстСообщения, Подразделение, ПодразделениеСтруктуры", ТекстСообщения, Подразделение, ПодразделениеСтруктуры);
КонецФункции

Функция ОтправитьУведомлениеПоEmail(Получатели, Тема, Тело, АдресОтвета="", ТипТекста) Экспорт
  	УстановитьПривилегированныйРежим(Истина);	
	
	Если БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыПисьма = Новый Структура;
	
	Кому ="";
	Если ТипЗнч(Получатели)=Тип("Массив") ИЛИ ТипЗнч(Получатели)=Тип("ТаблицаЗначений") Тогда
		Если ТипЗнч(Получатели)=Тип("Массив") Тогда
			мПолучатели = Получатели;
		Иначе
			мПолучатели = Получатели.ВыгрузитьКолонку("Получатель");
		КонецЕсли;
	Иначе 
		мПолучатели = Новый Массив;
		мПолучатели.Добавить(Получатели);
	КонецЕсли;	

	Для Каждого Строка Из мПолучатели Цикл
		Адрес = ПолучитьАдресИзКонтактов(Строка);
		Если ЗначениеЗаполнено(Адрес) Тогда 
			Кому =Кому+?(Кому="","",";")+Адрес;
		КонецЕсли;
	КонецЦикла; 

	Если ЗначениеЗаполнено(Кому) Тогда
		ПараметрыПисьма.Вставить("Кому", Кому);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыПисьма.Вставить("АдресОтвета", АдресОтвета);
	ПараметрыПисьма.Вставить("Тема", Тема);
	ПараметрыПисьма.Вставить("Тело", Тело);
	ПараметрыПисьма.Вставить("ТипТекста",  ТипТекста);
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ПараметрыПисьма);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьАдресИзКонтактов(Получатель) 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	Контакты.Представление КАК АдресЭлектроннойПочты
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК Контакты
	|ГДЕ
	|	Контакты.Ссылка = &Получатель
	|	И Контакты.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)");
	Запрос.УстановитьПараметр("Получатель", Получатель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.АдресЭлектроннойПочты;
	КонецЕсли;
	Возврат ""; 
	
КонецФункции

// + СБит 2024-03-12
Процедура ОбновитьИсториюСотрудниковПоШтатке(Позиции) Экспорт

	Если ТипЗнч(Позиции) = Тип("Массив") Тогда
		СписокПозиций = Позиции;
	ИначеЕсли ТипЗнч(Позиции) = Тип("СписокЗначений") Тогда
		СписокПозиций = Позиции;
	Иначе
		СписокПозиций = Новый Массив;
		СписокПозиций.Добавить(Позиции);
	КонецЕсли;	
		
	Узел = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.НайтиПоНаименованию("ERP");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КадроваяИсторияСотрудников.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ втСотрудники
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников КАК КадроваяИсторияСотрудников
	|ГДЕ
	|	КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию В (&СписокПозиций)
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КадроваяИсторияСотрудников.Период КАК Период,
	|	КадроваяИсторияСотрудников.Сотрудник КАК Пользователь, 
	// + СБит 2024-04-15
	|	КадроваяИсторияСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	|	КадроваяИсторияСотрудников.ГоловнаяОрганизация КАК Организация,
	|	ШтатноеРасписание.Подразделение КАК Подразделение,
	|	КадроваяИсторияСотрудников.Должность КАК Должность,
	|	ШтатноеРасписание.УВМ_ДолжностьУпр КАК ДолжностьУпр,
	|	КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписанию,
	|	КадроваяИсторияСотрудников.ВидСобытия КАК ВидСобытия
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников КАК КадроваяИсторияСотрудников
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК ШтатноеРасписание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних() КАК ШтатноеРасписание
	|		ПО КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию = ШтатноеРасписание.Позиция
	|
	|ГДЕ
	|	КадроваяИсторияСотрудников.Сотрудник В (ВЫБРАТЬ втСотрудники.Сотрудник ИЗ втСотрудники КАК втСотрудники)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователь,
	|	Организация,
	|	Период");
	Запрос.УстановитьПараметр("СписокПозиций", СписокПозиций);
	СтруктураСравнения = Новый Структура("Пользователь, ФизическоеЛицо, Организация, Подразделение, Должность, ДолжностьУпр, ВидСобытия");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Пользователь = СтруктураСравнения.Пользователь 
			И Выборка.ФизическоеЛицо = СтруктураСравнения.ФизическоеЛицо // + СБит 2024-04-15
			И Выборка.Организация = СтруктураСравнения.Организация 
			И Выборка.Подразделение = СтруктураСравнения.Подразделение 
			И Выборка.Должность = СтруктураСравнения.Должность 
			И Выборка.ДолжностьУпр = СтруктураСравнения.ДолжностьУпр 
			И Выборка.ВидСобытия = СтруктураСравнения.ВидСобытия
		Тогда
			Продолжить;
		КонецЕсли;
			
		НаборЗаписей = РегистрыСведений.УВМ_ИсторияСотрудников.СоздатьНаборЗаписей(); 
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период); 
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(Выборка.ФизическоеЛицо);  // + СБит 2024-04-15
		НаборЗаписей.Отбор.Пользователь.Установить(Выборка.Пользователь); 
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация); 
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		НаборЗаписей.Записать(Истина); 
		
		ЗаполнитьЗначенияСвойств(СтруктураСравнения, Запись);

		НаборЗаписей = РегистрыСведений.УВМ_ИсторияСотрудников.СоздатьНаборЗаписей(); 
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период); 
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(Выборка.ФизическоеЛицо);  // + СБит 2024-04-15
		НаборЗаписей.Отбор.Пользователь.Установить(Выборка.Пользователь); 
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация); 
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, НаборЗаписей);
	КонецЦикла;	

КонецПроцедуры

// + СБит 2025-08-04 255683 
// Зарегистрировать изменение структуры подчиненности сотрудников.
// 
// Параметры:
//  Источник - РегистрСведенийНаборЗаписей.УВМ_Руководители - Источник
//  Отказ - Булево - Отказ
//  Замещение - Булево - Замещение
Процедура УВМ_ЗарегистрироватьИзменениеСтруктурыПодчиненностиСотрудников(Источник, Отказ, Замещение) Экспорт 
	Если Источник.Количество() =0 Тогда
		Возврат;
	КонецЕсли;
	//ИсточникЗапись = Источник[0];
	
	Для Каждого ИсточникЗапись Из Источник Цикл
		НаборЗаписей = РегистрыСведений.УВМ_Руководители.СоздатьНаборЗаписей(); 
		НаборЗаписей.Отбор.Физлицо.Установить(ИсточникЗапись.Физлицо);   
		НаборЗаписей.Отбор.Период.Установить(ИсточникЗапись.Период);   
		НаборЗаписей.Прочитать();
		
		Узел = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.НайтиПоНаименованию("ERP");
		Если Метаданные.ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Состав.Содержит(НаборЗаписей.Метаданные()) Тогда
			НаборЗаписей = РегистрыСведений.УВМ_Руководители.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.Физлицо.Установить(ИсточникЗапись.Физлицо);  
			НаборЗаписей.Отбор.Период.Установить(ИсточникЗапись.Период); 
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, НаборЗаписей);	
		КонецЕсли;	
	КонецЦикла;	
	// - СБит 2024-02-26
	
КонецПроцедуры


