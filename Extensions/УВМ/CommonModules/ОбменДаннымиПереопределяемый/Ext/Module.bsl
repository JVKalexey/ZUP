			ДатаДо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ДатаНачала");
		Иначе
			ДатаДо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ДатаСобытия");
		КонецЕсли;	
		Если ЗначениеЗаполнено(ДатаДо) Тогда
			ДатаДо = ДатаДо - 1;
		Иначе	
			ДатаДо =ТекущаяДатаСеанса();
		КонецЕсли;
		Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КадровыйДокумент.Ссылка КАК Ссылка,
		|	КадровыйДокумент.Ссылка.Организация КАК Организация,
		|	КадровыйДокумент.ВидЗанятости КАК ВидЗанятости,
		|	КадровыйДокумент.Подразделение КАК Подразделение,
		|	ШтатноеРасписание.Подразделение КАК ПодразделениеСтруктуры, 
		|	ШтатноеРасписание.УВМ_ДолжностьУпр КАК УВМ_ДолжностьУпр, 
		|	КадровыйДокумент.Сотрудник КАК Сотрудник,
		|	КадровыйДокумент.ГрафикРаботы КАК ГрафикРаботы,
		|	КадровыйДокумент.КоличествоСтавок КАК КоличествоСтавок,
		|	КадровыйДокумент.РабочееМесто КАК РабочееМесто,
		|	РабочиеМестаОхраныТруда.Номер КАК РабочееМестоНомер,
		|	КадровыйДокумент.Должность КАК Должность,
		|	КадровыйДокумент.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ФизическиеЛица.ДатаРождения КАК ФизическоеЛицоДатаРождения,
		|	ФизическиеЛица.СтраховойНомерПФР КАК ФизическоеЛицоСтраховойНомерПФР,

		|	КадроваяИсторияСотрудников.Подразделение КАК ПодразделениеДо,
		|	ВЫБОР
		|		КОГДА КадровыйДокумент.Подразделение = КадроваяИсторияСотрудников.Подразделение
		|			ТОГДА Ложь
		|		ИНАЧЕ Истина
		|	КОНЕЦ КАК ИзмПодразделение, 
		|	КадроваяИсторияСотрудников.Должность КАК ДолжностьДо,
		|	ВЫБОР
		|		КОГДА КадровыйДокумент.Должность = КадроваяИсторияСотрудников.Должность
		|			ТОГДА Ложь
		|		ИНАЧЕ Истина
		|	КОНЕЦ КАК ИзмДолжность, 
		|	КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписаниюДо,
		|	ВЫБОР
		|		КОГДА КадровыйДокумент.ДолжностьПоШтатномуРасписанию = КадроваяИсторияСотрудников.ДолжностьПоШтатномуРасписанию
		|			ТОГДА Ложь
		|		ИНАЧЕ Истина
		|	КОНЕЦ КАК ИзмДолжностьШтат,
		
		|	КадровыйДокумент.ДатаНачала КАК ДатаПеревода
		|ИЗ
		|	Документ.КадровыйПеревод КАК КадровыйДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ПО КадровыйДокумент.ФизическоеЛицо = ФизическиеЛица.Ссылка
		//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК ШтатноеРасписание 
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.СрезПоследних(&ДатаДо, ) КАК ШтатноеРасписание 
		|		ПО КадровыйДокумент.ДолжностьПоШтатномуРасписанию = ШтатноеРасписание.Позиция
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаОхраныТруда
		|		ПО КадровыйДокумент.РабочееМесто = РабочиеМестаОхраныТруда.Ссылка
		
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&ДатаДо, ) КАК КадроваяИсторияСотрудников
		|		ПО КадровыйДокумент.Сотрудник = КадроваяИсторияСотрудников.Сотрудник
		|			И КадровыйДокумент.Ссылка.Организация = КадроваяИсторияСотрудников.ГоловнаяОрганизация
		|			И КадровыйДокумент.ФизическоеЛицо = КадроваяИсторияСотрудников.ФизическоеЛицо
		
		|ГДЕ
		|	КадровыйДокумент.Ссылка = &Ссылка"; 
		Если ТипИсточника = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.КадровыйПеревод КАК КадровыйДокумент", "Документ.КадровыйПереводСписком.Сотрудники КАК КадровыйДокумент");  
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
