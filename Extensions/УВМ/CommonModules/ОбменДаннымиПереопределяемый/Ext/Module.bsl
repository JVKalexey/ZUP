
Процедура УВМ_СинхронизацияДанныхЧерезУниверсальныйФорматРегистрацияДокумента(Источник, Отказ) Экспорт
	
	//++dar 03.05.23 (102491)                                                                              
	УстановитьПривилегированныйРежим(Истина);
	Если ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.Сотрудники") Тогда
		Результат = КадровыйУчет.КадровыеДанныеСотрудника(Истина, Источник.Ссылка, "ДатаПриема", ТекущаяДатаСеанса());
		Если Результат <> Неопределено Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ДатаПриема") И НЕ ЗначениеЗаполнено(Результат.ДатаПриема) Тогда
				Источник.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	//--dar 03.05.23 (102491)
	
	// ОбменДанными.Загрузка не требуется, т.к. подписка относится к плану обмена.
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписью("СинхронизацияДанныхЧерезУниверсальныйФормат", Источник, Отказ);
	
КонецПроцедуры

Процедура УВМ_СинхронизацияДанныхЧерезУниверсальныйФорматРегистрацияУдаления(Источник, Отказ) Экспорт
	
	// ОбменДанными.Загрузка не требуется, т.к. подписка относится к плану обмена.
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписью("СинхронизацияДанныхЧерезУниверсальныйФормат", Источник, Отказ);
	
КонецПроцедуры

// Зарегистрировать изменение кадровой истории сотрудников.
// 
// Параметры:
//  Источник - РегистрСведенийНаборЗаписей.КадроваяИсторияСотрудников - Источник
//  Отказ - Булево - Отказ
//  Замещение - Булево - Замещение
Процедура УВМ_ЗарегистрироватьИзменениеКадровойИсторииДляРасчетовERP(Источник, Отказ, Замещение) Экспорт
	
	// + СБит 2023-11-09 138579 
	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//++dar 05.06.26 (331252)
	//ИсточникЗапись = Источник[0];
	УзелЕРП = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.НайтиПоНаименованию("ERP");
	УзелНахабино = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.НайтиПоНаименованию("Нахабино");
	
	Для Каждого ИсточникЗапись Из Источник Цикл	
	//--dar 05.06.26 (331252)
		НачальныеЗначения = РегистрыСведений.УВМ_ИсторияСотрудников.СрезПоследних(ИсточникЗапись.Период, 
			Новый Структура("ФизическоеЛицо,Пользователь,Организация",  // + СБит 2024-04-15
			ИсточникЗапись.ФизическоеЛицо,
			ИсточникЗапись.Сотрудник,
			ИсточникЗапись.Организация));
		СтруктураСравнения = Новый Структура("ФизическоеЛицо,Пользователь,Организация,Подразделение,Должность,ДолжностьУпр,ВидСобытия");
		ЗаполнитьЗначенияСвойств(СтруктураСравнения,НачальныеЗначения); 
	
		//ЗаписьШР = РегистрыСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Получить(Новый Структура("Позиция", ИсточникЗапись.ДолжностьПоШтатномуРасписанию));
		ЗаписьШР = РегистрыСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Получить(ИсточникЗапись.Период, Новый Структура("Позиция", ИсточникЗапись.ДолжностьПоШтатномуРасписанию));
	
		Если ИсточникЗапись.Сотрудник 		= СтруктураСравнения.Пользователь
			и ИсточникЗапись.ФизическоеЛицо = СтруктураСравнения.ФизическоеЛицо // + СБит 2024-04-15
			и ИсточникЗапись.Организация 	= СтруктураСравнения.Организация
			и ЗаписьШР.Подразделение 		= СтруктураСравнения.Подразделение
			и ИсточникЗапись.Должность 		= СтруктураСравнения.Должность
			и ЗаписьШР.УВМ_ДолжностьУпр 	= СтруктураСравнения.ДолжностьУпр
			и ИсточникЗапись.ВидСобытия 	= СтруктураСравнения.ВидСобытия
		Тогда
			//++dar 05.06.26 (331252)
			//Возврат
			Продолжить;
			//--dar 05.06.26 (331252)
		КонецЕсли;	

		НаборЗаписей = РегистрыСведений.УВМ_ИсторияСотрудников.СоздатьНаборЗаписей(); 
		НаборЗаписей.Отбор.ФизическоеЛицо.Установить(ИсточникЗапись.ФизическоеЛицо);   
		НаборЗаписей.Отбор.Организация.Установить(ИсточникЗапись.Организация);   
		НаборЗаписей.Отбор.Пользователь.Установить(ИсточникЗапись.Сотрудник); 
		НаборЗаписей.Отбор.Период.Установить(ИсточникЗапись.Период);   
		
		Запись = НаборЗаписей.Добавить();
		Запись.Активность   = Истина;
		Запись.Пользователь	= ИсточникЗапись.Сотрудник;
		Запись.ФизическоеЛицо	= ИсточникЗапись.ФизическоеЛицо; // + СБит 2024-04-15
		Запись.Организация  = ИсточникЗапись.Организация;
		Запись.Подразделение= ЗаписьШР.Подразделение;
		Запись.Должность    = ИсточникЗапись.Должность;
		Запись.ДолжностьУпр = ЗаписьШР.УВМ_ДолжностьУпр;
		Запись.ДолжностьПоШтатномуРасписанию = ИсточникЗапись.ДолжностьПоШтатномуРасписанию;
		Запись.ВидСобытия 	= ИсточникЗапись.ВидСобытия; 
		Запись.НавигационнаяСсылкаДокумента = ПолучитьНавигационнуюСсылкуИнформационнойБазы()+"/#"+ПолучитьНавигационнуюСсылку(ИсточникЗапись.Регистратор);
		Запись.Период       = ИсточникЗапись.Период;

		НаборЗаписей.Записать(); 
		
		// + СБит 2024-02-26
		Если Метаданные.ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Состав.Содержит(НаборЗаписей.Метаданные()) Тогда
			НаборЗаписей = РегистрыСведений.УВМ_ИсторияСотрудников.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.Пользователь.Установить(ИсточникЗапись.Сотрудник); 
			НаборЗаписей.Отбор.ФизическоеЛицо.Установить(ИсточникЗапись.ФизическоеЛицо);  // + СБит 2024-04-15
			НаборЗаписей.Отбор.Организация.Установить(ИсточникЗапись.Организация); 
			НаборЗаписей.Отбор.Период.Установить(ИсточникЗапись.Период); 
			ПланыОбмена.ЗарегистрироватьИзменения(УзелЕРП, НаборЗаписей);	
		КонецЕсли;	
		// - СБит 2024-02-26
	
		//++dar 05.06.26 (331252)
		Если Не ЗначениеЗаполнено(ЗаписьШР.Подразделение) Тогда
			Продолжить;
		КонецЕсли;		
		//--dar 05.06.26 (331252)
		
		//++dar 05.06.26 (331252)
		СтруктураПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаписьШР.Подразделение, "УВМ_ЦФО,Наименование");
		Если НЕ ЗначениеЗаполнено(СтруктураПодразделения.УВМ_ЦФО) Тогда
			Продолжить;
		КонецЕсли;
		НаименованиеЦФО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураПодразделения.УВМ_ЦФО, "Наименование");
		//--dar 05.06.26 (331252)

		//+++$$$20241210(215678)
		Если СтрНайти(СтруктураПодразделения.Наименование, "Нахабино") > 0 ИЛИ СтрНайти(НаименованиеЦФО, "Нахабино") > 0 Тогда
			Если Метаданные.ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Состав.Содержит(НаборЗаписей.Метаданные()) Тогда
				НаборЗаписей = РегистрыСведений.УВМ_ИсторияСотрудников.СоздатьНаборЗаписей(); 
				НаборЗаписей.Отбор.Пользователь.Установить(ИсточникЗапись.Сотрудник); 
				НаборЗаписей.Отбор.ФизическоеЛицо.Установить(ИсточникЗапись.ФизическоеЛицо);  
				НаборЗаписей.Отбор.Организация.Установить(ИсточникЗапись.Организация); 
				НаборЗаписей.Отбор.Период.Установить(ИсточникЗапись.Период); 
				ПланыОбмена.ЗарегистрироватьИзменения(УзелНахабино, НаборЗаписей);
			КонецЕсли;	
		КонецЕсли;	
		//+++$$$20241210(215678)
		
	//++dar 05.06.26 (331252)
	КонецЦикла;
	//--dar 05.06.26 (331252)
		
КонецПроцедуры

// + СБит 2024-09-25
Процедура УВМ_ЗарегистрироватьИзменениеКадровойИсторииДляУведомлений(Источник, Отказ, Замещение) Экспорт
	Если НЕ Отказ Тогда 
		Если ЗначениеЗаполнено(Константы.УВМ_ДатаНачалаРассылки.Получить()) И Источник.Дата >= Константы.УВМ_ДатаНачалаРассылки.Получить()
			И Метаданные.РегистрыСведений.УВМ_Уведомления.Измерения.КадровыйДокумент.Тип.СодержитТип(ТипЗнч(Источник.Ссылка)) Тогда
			
			// исключения
			ТипИсточника = ТипЗнч(Источник);
			
			// + СБит 2025-05-05 240701 
			// перенесено в регламентную процедуру
			//Если ТипИсточника = Тип("ДокументОбъект.Увольнение") ИЛИ ТипИсточника = Тип("ДокументОбъект.УвольнениеСписком") Тогда 
			//	Запрос = Новый Запрос;
			//	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
			//	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			//	|	ИсполнителиЗадач.РольИсполнителя КАК РольИсполнителя,
			//	|	ИсполнителиЗадач.Исполнитель КАК Исполнитель
			//	|ИЗ
			//	|	Документ.Увольнение КАК КадровыйДокумент
			//	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК СпрПользователи
			//	|		ПО КадровыйДокумент.ФизическоеЛицо = СпрПользователи.ФизическоеЛицо
			//	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
			//	|		ПО (СпрПользователи.Ссылка = ИсполнителиЗадач.Исполнитель)
			//	|ГДЕ
			//	|	КадровыйДокумент.Ссылка = &Ссылка
			//	|	И НЕ ИсполнителиЗадач.Исполнитель ЕСТЬ NULL"; 
			//	Если ТипИсточника = Тип("ДокументОбъект.УвольнениеСписком") Тогда
			//		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Увольнение КАК КадровыйДокумент", "Документ.УвольнениеСписком.Сотрудники КАК КадровыйДокумент");  
			//	КонецЕсли;
			//	Выборка = Запрос.Выполнить().Выбрать();
			//	
			//	ИсполнителиЗадач = РегистрыСведений.ИсполнителиЗадач.СоздатьНаборЗаписей();
			//	Пока Выборка.Следующий() Цикл
			//		ИсполнителиЗадач.Отбор.РольИсполнителя.Установить(Выборка.РольИсполнителя);
			//		ИсполнителиЗадач.Отбор.Исполнитель.Установить(Выборка.Исполнитель);
			//		ИсполнителиЗадач.Записать();
			//	КонецЦикла;	
			//КонецЕсли;
			// - СБит 2025-05-05
			
			Если ТипИсточника = Тип("ДокументОбъект.БольничныйЛист") Тогда 
				ПричинаНетрудоспособности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ПричинаНетрудоспособности");
				Если ПричинаНетрудоспособности <> Перечисления.ПричиныНетрудоспособности.ПоБеременностиИРодам Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;	
		
			Попытка
				ПараметрыДокументов = ЗаполнитьТекстУведомления(Источник.Ссылка);
			Исключение
				Возврат;
			КонецПопытки;	
			ТекстСообщения = ПараметрыДокументов.ТекстСообщения;

			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнителиЗадач.Исполнитель КАК Исполнитель,
			|	СтруктураПредприятия.Ссылка КАК Подразделение
			|ПОМЕСТИТЬ Подразделения	
			|ИЗ
			|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктураПредприятия КАК СтруктураПредприятия
			|	по СтруктураПредприятия.Ссылка = ИсполнителиЗадач.ДополнительныйОбъектАдресации
			|	или СтруктураПредприятия.Ссылка.Родитель = ИсполнителиЗадач.ДополнительныйОбъектАдресации 
			|	или СтруктураПредприятия.Ссылка.Родитель.Родитель = ИсполнителиЗадач.ДополнительныйОбъектАдресации 
			|	или СтруктураПредприятия.Ссылка.Родитель.Родитель.Родитель = ИсполнителиЗадач.ДополнительныйОбъектАдресации 
			|	или СтруктураПредприятия.Ссылка.Родитель.Родитель.Родитель.Родитель = ИсполнителиЗадач.ДополнительныйОбъектАдресации 
			|ГДЕ
			|	НЕ СтруктураПредприятия.Ссылка Есть NULL
			|;	
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УВМ_Уведомления.КадровыйДокумент КАК КадровыйДокумент
			|ИЗ
			|	РегистрСведений.УВМ_Уведомления КАК УВМ_Уведомления
			|ГДЕ
			|	УВМ_Уведомления.КадровыйДокумент = &Источник
			|	И УВМ_Уведомления.УведомлениеОтправлено
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнителиЗадач.Исполнитель КАК Исполнитель
			|ИЗ
			|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
			|ГДЕ
			|	ИсполнителиЗадач.РольИсполнителя = ЗНАЧЕНИЕ(Справочник.РолиИсполнителей.ОтветственныйЗаИзменениеКадровыхДанных)
			|	И (ИсполнителиЗадач.ОсновнойОбъектАдресации = Неопределено ИЛИ ИсполнителиЗадач.ОсновнойОбъектАдресации = &Организация)
			|	И (ИсполнителиЗадач.ДополнительныйОбъектАдресации = Неопределено 
			|		ИЛИ (ИсполнителиЗадач.Исполнитель, &ПодразделениеСтруктуры) В (ВЫБРАТЬ Исполнитель, Подразделение ИЗ Подразделения)) 
			|"; 
			Запрос.УстановитьПараметр("Источник", Источник.Ссылка); 
			ОрганизацияДокумента = Источник.Организация;
			Если ТипИсточника = Тип("ДокументОбъект.ПеремещениеВДругоеПодразделение") Тогда 
				ОрганизацияДокумента = Источник.ОрганизацияНовая;
			КонецЕсли;
			Запрос.УстановитьПараметр("Организация", ОрганизацияДокумента); 
			Запрос.УстановитьПараметр("ПодразделениеСтруктуры", ПараметрыДокументов.ПодразделениеСтруктуры); 

			Попытка
				РезультатЗапроса = Запрос.ВыполнитьПакет();
			Исключение
				Возврат;
			КонецПопытки;	
				
			Отправленные = РезультатЗапроса[1].Выбрать();
			Если Отправленные.Следующий() Тогда
				Возврат;
			КонецЕсли;
			
			Получатели = РезультатЗапроса[2].Выгрузить().ВыгрузитьКолонку("Исполнитель");
			Если Получатели.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
				
			МенеджерЗаписи = РегистрыСведений.УВМ_Уведомления.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.КадровыйДокумент = Источник.Ссылка;
			МенеджерЗаписи.ДатаУведомить = ТекущаяДата();
			МенеджерЗаписи.ДатаИзменения = ТекущаяДата();
			МенеджерЗаписи.УведомлениеОтправлено = Ложь;
			МенеджерЗаписи.Записать(Истина);

			ЗаголовокСообщения = "Уведомление о кадровых изменениях"; 
			УспешныйУспех = ОтправитьУведомлениеПоEmail(Получатели, ЗаголовокСообщения, ТекстСообщения, , ТипТекстаПочтовогоСообщения.ПростойТекст); 
			Если УспешныйУспех Тогда
				МенеджерЗаписи = РегистрыСведений.УВМ_Уведомления.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.КадровыйДокумент = Источник.Ссылка;
				МенеджерЗаписи.Прочитать();
				МенеджерЗаписи.УведомлениеОтправлено = Истина;
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Функция ЗаполнитьТекстУведомления(Источник) Экспорт
	ТекстСообщения = "";
	ТипИсточника = ТипЗнч(Источник);
    Подразделение = Неопределено;
    ПодразделениеСтруктуры = Неопределено;
	
	Если ТипИсточника = Тип("ДокументСсылка.КадровыйПеревод") ИЛИ ТипИсточника = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Источник); 
